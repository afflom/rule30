{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "r30/register/1",
 "title": "The claim register (frontier list --json; view/register.json)",
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "id",
   "status",
   "statement"
  ],
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9-]*$"
   },
   "status": {
    "type": "string",
    "enum": [
     "open",
     "proved",
     "refuted",
     "retired",
     "observed"
    ]
   },
   "statement": {
    "type": "string"
   },
   "lean": {
    "type": "string"
   },
   "lexeme": {
    "type": "string"
   },
   "since": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "depends": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "relation": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "window": {
    "type": "integer"
   },
   "kappa": {
    "type": "string",
    "pattern": "^sha256:[0-9a-f]{64}$"
   }
  }
 }
}
