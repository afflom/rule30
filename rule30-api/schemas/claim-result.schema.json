{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "r30/claim-result/1",
 "title": "claim --json: one register entry with its dependents, Lean type, published statement and related facts",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "status",
  "statement",
  "dependents"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]*$"
  },
  "status": {
   "type": "string",
   "enum": [
    "open",
    "proved",
    "refuted",
    "retired",
    "observed"
   ]
  },
  "statement": {
   "type": "string"
  },
  "lean": {
   "type": "string"
  },
  "lexeme": {
   "type": "string"
  },
  "since": {
   "type": "string"
  },
  "note": {
   "type": "string"
  },
  "depends": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "relation": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "window": {
   "type": "integer"
  },
  "kappa": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "dependents": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "lean_type": {
   "type": "string"
  },
  "published": {
   "type": "string"
  },
  "published_in": {
   "type": "string"
  },
  "related": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "string"
    }
   }
  },
  "audit": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "theorem",
     "status",
     "open",
     "refutedBy"
    ],
    "additionalProperties": false,
    "properties": {
     "theorem": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "dead",
       "live-discharged",
       "open"
      ]
     },
     "open": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "refutedBy": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
