    },
    {
      "name": "centersAreKnown",
      "statement": "the first 32 centers are the literal knownCenters"
    },
    {
      "name": "rulerBackgroundIsKnown",
      "statement": "the first 32 values of rulerBackground are the literal knownRuler"
    },
    {
      "name": "rdiagOneIsTimeParity",
      "statement": "rdiag 1 t = timeParity t for t < 64"
    },
    {
      "name": "centerIsAntidiagonal",
      "statement": "center t = towerWord t t for t < 32"
    },
    {
      "name": "towerRecursionOnFirstWords",
      "statement": "towerWord (k+2) (s+1) = towerWord (k+2) s XOR (towerWord (k+1) s OR towerWord k s) for k < 4 and every s < 2^(k+2)"
    },
    {
      "name": "wordsArePeriodic",
      "statement": "rdiag j (t + 2^j) = rdiag j t for j < 5 and every t < 2^j"
    },
    {
      "name": "diagonalsHaveHalfPeriod",
      "statement": "rdiag j (t + 2^(j-1)) = rdiag j t for 2 <= j < 6 and every t < 2^j (rdiag_period_half)"
    },
    {
      "name": "rightRecursionAgrees",
      "statement": "the right-edge recursion of Core.lex.tex and the cell of the row agree for t < 10, j <= t"
    }
