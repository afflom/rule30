public theorem white_interior (llv0 : Bool) (llv1 : Bool) (llv2 : Bool) : (Eq llv0 Bool.false) → (Eq llv1 Bool.false) → (Eq llv2 Bool.false) → Eq (Rule30UOR.Core.rule llv0 llv1 llv2) Bool.false := by
  intro llh0 llh1 llh2
  rw [llh0, llh1, llh2]
  rfl

public theorem white_run_interior (llv0 : Nat) (llv1 : Int) : (Eq (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.leftOf llv1)) Bool.false) → (Eq (Rule30UOR.Core.cell llv0 llv1) Bool.false) → (Eq (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.rightOf llv1)) Bool.false) → Eq (Rule30UOR.Core.cell (Nat.succ llv0) llv1) Bool.false := by
  intro llh0 llh1 llh2
  rw [Rule30UOR.Core.cell_succ llv0 llv1, llh0, llh1, llh2]
  rfl

public theorem black_run_interior (llv0 : Nat) (llv1 : Int) : (Eq (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.leftOf llv1)) Bool.true) → (Eq (Rule30UOR.Core.cell llv0 llv1) Bool.true) → Eq (Rule30UOR.Core.cell (Nat.succ llv0) llv1) Bool.false := by
  intro llh0 llh1
  rw [Rule30UOR.Core.cell_succ llv0 llv1, llh0, llh1]
  exact Rule30UOR.Core.rule_black_black (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.rightOf llv1))

public theorem white_pair_right (llv0 : Nat) (llv1 : Int) : (Eq (Rule30UOR.Core.cell llv0 llv1) Bool.false) → (Eq (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.rightOf llv1)) Bool.false) → Eq (Rule30UOR.Core.cell (Nat.succ llv0) llv1) (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.leftOf llv1)) := by
  intro llh0 llh1
  rw [Rule30UOR.Core.cell_succ llv0 llv1, llh0, llh1, Rule30UOR.Core.rule_white_white (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.leftOf llv1))]

public theorem white_pair_left (llv0 : Nat) (llv1 : Int) : (Eq (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.leftOf llv1)) Bool.false) → (Eq (Rule30UOR.Core.cell llv0 llv1) Bool.false) → Eq (Rule30UOR.Core.cell (Nat.succ llv0) llv1) (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.rightOf llv1)) := by
  intro llh0 llh1
  rw [Rule30UOR.Core.cell_succ llv0 llv1, llh0, llh1, Rule30UOR.Core.rule_left_edge_of_white_pair (Rule30UOR.Core.cell llv0 (Rule30UOR.Core.rightOf llv1))]

public theorem white_run_shrinks (llv0 : Nat) (llv1 : Int) (llv2 : Int) : ((llv3 : Int) → (Int.le llv1 llv3) → (Int.le llv3 llv2) → Eq (Rule30UOR.Core.cell llv0 llv3) Bool.false) → (llv4 : Int) → (Int.le (Rule30UOR.Core.rightOf llv1) llv4) → (Int.le llv4 (Rule30UOR.Core.leftOf llv2)) → Eq (Rule30UOR.Core.cell (Nat.succ llv0) llv4) Bool.false := by
  intro llh0 llv4 llh1 llh2
  apply Rule30Paper.Paper.white_run_interior llv0 llv4
  exact llh0 (Rule30UOR.Core.leftOf llv4) (Int.le_sub_one_of_lt llh1) (Int.le_of_lt (Int.sub_one_lt_of_le (Int.le_of_lt (Int.lt_of_le_sub_one llh2))))
  exact llh0 llv4 (Int.le_of_lt llh1) (Int.le_of_lt (Int.lt_of_le_sub_one llh2))
  exact llh0 (Rule30UOR.Core.rightOf llv4) (Int.le_add_one (Int.le_of_lt llh1)) (Int.lt_of_le_sub_one llh2)

