  rw [hz1, hz0] at hstep
  revert hstep
  simp only [bxor_eq_xor]
  cases lhCenter t (p + 2) <;> cases lhCenter t (p + 1) <;> decide

theorem lhCenter_twin_before_zero_diag_prop (t p : Nat)
