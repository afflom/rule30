    ¬ IsZeroDiag (z + 2) := by
  intro hz2
  have hb := black_after_zero_diag z hz 0
  have hw := hz2 0
  rw [hb] at hw
  exact Bool.noConfusion hw

theorem not_isZeroDiag_add_two_prop (z : Nat) (hz : IsZeroDiag z) :
