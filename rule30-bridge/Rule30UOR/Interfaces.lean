    (hset : settle ((t - (p + 2)) + 2) ≤ t + 2)
    (h1 : lhCenter (t + 2) (p + 3) = false) :
    lhCenter (t + 4) (p + 2) = false := by
  have hrst := lhCenter_reset_after_zero_diag t (p + 1)
    (by rwa [show (p + 1) + 1 = p + 2 by omega])
    (by rwa [show (p + 1) + 1 = p + 2 by omega])
