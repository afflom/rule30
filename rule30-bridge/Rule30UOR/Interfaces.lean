    (Q z L k : Nat) (hd : DoublesAt Q z)
    (hpref : ∀ i : Nat, i < twopow k →
      lhCenter (((z + 1) + twopow k) + Q) (1 + i) = lhCenter ((z + 1) + twopow k) (1 + i))
