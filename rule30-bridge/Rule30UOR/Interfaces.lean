theorem not_centerPeriodic_of_rhColAgree_dyadic_pred_col_twopow
    (T P m t k K v S : Nat) (hP : 0 < P) (hm : 0 < m)
    (ht : T ≤ t) (htm : t + m * P = twopow k)
    (hS : twopow k ≤ S + 1)
    (hv : 1 ≤ v) (hK : ((t + S) + m * P) + 1 ≤ K)
    (hcol : RhColAgree (t + v * twopow K) (m * P) (v * twopow K - 1) S) :
