    lhCenter_late_twopow_sub_one_eq_zcenter_before_zero_diag t k hk hz hset0 hset2]

theorem winWitt_sector_one_xor_sector_two_sub_one_zcenter_before_zero_diag_prop (t k : Nat)
    (hk : t + 2 ≤ k)
