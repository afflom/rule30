theorem lhCenter_late_cross_linear_step_two_before_zero_diag_prop (t k r : Nat)
    (hk : (t + r) + 2 ≤ k)
    (hz : IsZeroDiag ((t + r) + 2))
    (hset : SettledBy ((t + r) + 2) (t + twopow k)) :
