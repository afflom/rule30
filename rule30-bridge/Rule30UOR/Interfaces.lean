theorem lhCenter_shift_agree_of_rhCenter_dyadic_sub_agree (t Q K v d s : Nat)
    (hv : 1 ≤ v) (hts : ((t + s) + Q) + d ≤ K)
    (h : rhCenter (((t + v * twopow K) + s) + Q) (v * twopow K - d) =
         rhCenter ((t + v * twopow K) + s) (v * twopow K - d)) :
