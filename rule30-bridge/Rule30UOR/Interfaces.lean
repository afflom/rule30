theorem periodic_rhCenter_step_one_eq_of_black_one (T P : Nat) (_hP : 0 < P)
    (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t : Nat) (ht : T ≤ t)
    (hbQ : rhCenter (t + m * P) 1 = true)
    (hb0 : rhCenter t 1 = true) :
