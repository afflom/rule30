  have hs0 := maskparity_step_diff_zero t k
  rw [show (t + m * P) + 1 = (t + 1) + m * P by omega,
    show (t + m * P) + twopow k = (t + twopow k) + m * P by omega] at hsQ
  rw [bxor_four_swap, ← hsQ, ← hs0, bxor_four_swap]

