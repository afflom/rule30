  rw [h, lhCenter_late_twopow_eq_zcenter (z + 1) k hk hset]

theorem lhCenter_late_shift_twopow_antiperiodic_zcenter_of_doubles_prop (P z k : Nat)
    (hk : z + 1 ≤ k)
