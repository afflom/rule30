theorem periodic_lhColAgree_one_late_scale_at_zero_diag_succ_of_doubles_prefix_and_single_lh_row_tail
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
