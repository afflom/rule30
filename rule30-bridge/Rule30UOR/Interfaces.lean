theorem periodic_maskparity_zero_agree_of_rhColAgree_dyadic_pred_col
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t K v S s : Nat) (ht : T ≤ t) (hv : 1 ≤ v)
    (hK : ((t + S) + m * P) + 1 ≤ K)
