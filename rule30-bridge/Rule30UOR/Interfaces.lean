theorem winWitt_testBit_scale_cross_zero_gap_step_one_of_zero_diag_prop (t k r : Nat)
    (htr : t < r) (hk : (t + r) + 2 ≤ k)
    (hz : IsZeroDiag (t + r))
    (hset : SettledBy ((t + r) + 2) ((t + 1) + twopow k)) :
    wittBitBool (winWitt (t + 1) (twopow k)) ((t + twopow (k + 1)) - r) = true :=
