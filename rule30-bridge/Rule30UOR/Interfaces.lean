theorem lhCenter_step_one_eq_true_at_shift_of_zero_diag_and_single_lhBandAgree (Q t p p0 L : Nat)
    (hz : IsZeroDiag ((t + Q) - (p + 2)))
    (hset0 : settle ((t + Q) - (p + 2)) ≤ t + Q)
    (hset2 : settle (((t + Q) - (p + 2)) + 2) ≤ t + Q)
    (hp0 : p0 ≤ p) (hL : p + 2 ≤ p0 + L)
