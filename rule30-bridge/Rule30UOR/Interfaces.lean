  have hc := winWitt_sector_two_step_complement_after_zero_diag t k r hk hz hset
  rw [rhCenter_gt_eq_false t (r + 1) (by omega),
    rhCenter_gt_eq_false (t + 1) (r + 2) (by omega)] at hc
  revert hc
