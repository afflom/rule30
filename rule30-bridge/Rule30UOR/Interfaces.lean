theorem not_centerPeriodic_of_rhBandAgree_one_sub_twopow_ge
    (T P m k S : Nat) (hP : 0 < P) (hm : 0 < m)
    (hmP : m * P ≤ twopow k) (ht : T + m * P ≤ twopow k)
