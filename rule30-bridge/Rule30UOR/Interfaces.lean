theorem periodic_lhBandAgree_steps_of_rhColAgree_one
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t L s : Nat) (ht : T ≤ t)
    (hrh : RhColAgree t (m * P) 1 (L + s)) :
