    (h : LhBandAgree t (m * P) 1 S)
    (hs : s ≤ S) :
    lhCenter ((t + s) + m * P) 1 = lhCenter (t + s) 1 := by
  have hsub : LhBandAgree t (m * P) 1 ((S - s) + s) := by
    intro i hi
    exact h i (by omega)
  have hstep := periodic_lhBandAgree_one_steps T P hP hper m t (S - s) s ht hsub
  have h0 := hstep 0 (by omega)
  simpa using h0

