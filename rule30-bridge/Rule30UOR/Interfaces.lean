        rdrv td tx ((a + (u + 2)) + c) (a + (u + 2)))) :
    bxor (rdrv td tx (((a + H) + k) + (c + 2)) ((a + H) + k))
         (rdrv td tx ((a + k) + (c + 2)) (a + k)) =
