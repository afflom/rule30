theorem rdrv_subdiag_accum_shift_xor (td tx c a H k : Nat)
    (hor : ∀ u : Nat, u < k →
      (rdrv td tx (((a + H) + (u + 1)) + (c + 1)) ((a + H) + (u + 1)) ||
