/-! ### Carrying `Q`-Periodicity from the Sector Times via Neighbourhood Agreement and Window Step 9.204 -/

/-- **Left-wing settled `restart` (`ldiag_settled_restart`)**: for every left diagonal `j ≤ k`, once `settle j ≤ t`, `ldiag j` repeats at every multiple `v * 2^k` uniformly for all `v : Nat`. -/
theorem ldiag_settled_restart (k j v t : Nat) (hj : j ≤ k) (hset : settle j ≤ t) :
    ldiag j (t + v * twopow k) = ldiag j t := by
  have hset' : settle j ≤ t + v * twopow k := by omega
  rw [Rule30UOR.Kit.ldiag_eq_D, Rule30UOR.Kit.ldiag_eq_D,
    ← Rule30UOR.Intent.E_eq_D j (t + v * twopow k) hset',
    ← Rule30UOR.Intent.E_eq_D j t hset,
    twopow_eq_pow k,
    show v * 2 ^ k = (v * 2 ^ (k - j)) * 2 ^ j by
      rw [Nat.mul_assoc, ← Nat.pow_add, show k - j + j = k by omega]]
  exact Rule30UOR.ZeroDiagonals.E_per_mul j (v * 2 ^ (k - j)) t

/-- **Zero-state center `restart` in `ldiag` coordinates (`zcenter_restart_ldiag`)**: for every `d ≤ k` with `SettledAt d k` and every positive multiple `u ≥ 1`, `ldiag d (d + u * 2^k) = zcenter d`. -/
theorem zcenter_restart_ldiag (k d u : Nat) (hd : d ≤ k) (hu : 1 ≤ u) (hset : SettledAt d k) :
    ldiag d (d + u * twopow k) = zcenter d := by
  have h1 : d + u * twopow k = (d + twopow k) + (u - 1) * twopow k := by
    have hmul : u * twopow k = 1 * twopow k + (u - 1) * twopow k := by
      rw [← Nat.right_distrib, show 1 + (u - 1) = u by omega]
    omega
  rw [h1, ldiag_settled_restart k d (u - 1) (d + twopow k) hd hset]
  exact ldiag_settled_eq_zcenter d k hd hset

/-- **Unmasking the Late Center-Slot Frobenius Defect at `zcenter (d + 1) = true` (`frobDefect_row_late_center_slot_of_zcenter_true`)**: for `d + 1 ≤ k` and `SettledAt (d + 1) k` at a sector residue with `zcenter (d + 1) = true` and white centers at `d + 1` and `(d + 1) + 2^k`, the `zcenter (d + 1)` factor is `true`, unmasking `maskparity ((d + 1) + 2^k) 0 ⊕ maskparity (d + 1) 0` directly as bit `(d + 1) + 2^(k+1)` of `frobDefect k (row ((d + 1) + 2^k))`. -/
theorem frobDefect_row_late_center_slot_of_zcenter_true
    (d k : Nat) (hk : d + 1 ≤ k) (hset : SettledAt (d + 1) k)
    (hz : zcenter (d + 1) = true)
    (hw1 : Rule30UOR.Core.center (d + 1) = false)
    (hw2 : Rule30UOR.Core.center ((d + 1) + twopow k) = false) :
    (frobDefect k (row ((d + 1) + twopow k))).testBit (((d + 1) + twopow k) + twopow k) =
      bxor (Rule30UOR.Scale.maskparity ((d + 1) + twopow k) 0)
        (Rule30UOR.Scale.maskparity (d + 1) 0) := by
  rw [frobDefect_row_late_center_slot_at_both_white_centers_eq_zcenter_and_maskparity_jump
    d k hk hset hw1 hw2, hz, Bool.true_and]

/-- **Unmasking the Window Step Triality of `maskparity · 0` at `zcenter (d + 1) = true` (`periodic_winWitt_step_late_center_slot_of_zcenter_true`)**: under `CenterPeriodic T P` (`0 < P`), for `T ≤ d + 1`, `d + 1 ≤ k`, `SettledAt (d + 1) k`, and `zcenter (d + 1) = true` with white centers at `d + 1`, `(d + 1) + lag P k`, and `(d + 1) + lag P (k + 1)`, the `maskparity · 0` triality is unmasked and equals the window step increment `wittRespBool ((d + 2) + 2^k) k ⊕ (phi (winWitt ((d + 1) + 2^k) (2^k))).testBit (((d + 2) + 2^k) + 2^k)`. -/
theorem periodic_winWitt_step_late_center_slot_of_zcenter_true
    (T P : Nat) (hP : 0 < P) (h : Rule30UOR.Scale.CenterPeriodic T P)
    (d k : Nat) (ht : T ≤ d + 1) (hk : d + 1 ≤ k) (hset : SettledAt (d + 1) k)
    (hz : zcenter (d + 1) = true)
    (hw0 : Rule30UOR.Core.center (d + 1) = false)
    (hw1 : Rule30UOR.Core.center ((d + 1) + Rule30UOR.Scale.lag P k) = false)
    (hw2 : Rule30UOR.Core.center ((d + 1) + Rule30UOR.Scale.lag P (k + 1)) = false) :
    bxor (Rule30UOR.Scale.maskparity ((d + 1) + twopow (k + 1)) 0)
      (bxor (Rule30UOR.Scale.maskparity ((d + 1) + twopow k) 0)
        (Rule30UOR.Scale.maskparity (d + 1) 0)) =
      bxor (wittRespBool ((d + 2) + twopow k) k)
        ((phi (winWitt ((d + 1) + twopow k) (twopow k))).testBit (((d + 2) + twopow k) + twopow k)) := by
  have hs := periodic_winWitt_step_late_center_slot_at_white_centers_eq_zcenter_and_maskparity_triality
    T P hP h d k ht hk hset hw0 hw1 hw2
  rw [hz, Bool.true_and] at hs
  rw [hs]
  simp only [bxor_eq_xor]
  cases (phi (winWitt ((d + 1) + twopow k) (twopow k))).testBit (((d + 2) + twopow k) + twopow k) <;>
    cases (Rule30UOR.Scale.maskparity ((d + 1) + twopow (k + 1)) 0 ^^
      (Rule30UOR.Scale.maskparity ((d + 1) + twopow k) 0 ^^
        Rule30UOR.Scale.maskparity (d + 1) 0)) <;> rfl

/-- **Unmasking the Window Step Triality of Column `-1` at `zcenter (d + 1) = true` (`periodic_winWitt_step_late_colm1_slot_of_zcenter_true`)**: under `CenterPeriodic T P` (`0 < P`), for `T ≤ d + 1`, `d + 2 ≤ k`, `SettledAt (d + 1) k`, and `zcenter (d + 1) = true` with white centers at `d + 1`, `(d + 1) + lag P k`, and `(d + 1) + lag P (k + 1)`, the column-`-1` triality is unmasked and equals the window step increment at `((d + 3) + 2^k) + 2^k`. -/
theorem periodic_winWitt_step_late_colm1_slot_of_zcenter_true
    (T P : Nat) (hP : 0 < P) (h : Rule30UOR.Scale.CenterPeriodic T P)
    (d k : Nat) (ht : T ≤ d + 1) (hk : d + 2 ≤ k) (hset : SettledAt (d + 1) k)
    (hz : zcenter (d + 1) = true)
    (hw0 : Rule30UOR.Core.center (d + 1) = false)
    (hw1 : Rule30UOR.Core.center ((d + 1) + Rule30UOR.Scale.lag P k) = false)
    (hw2 : Rule30UOR.Core.center ((d + 1) + Rule30UOR.Scale.lag P (k + 1)) = false) :
    bxor (ldiag (d + twopow (k + 1)) ((d + 1) + twopow (k + 1)))
      (bxor (ldiag (d + twopow k) ((d + 1) + twopow k)) (ldiag d (d + 1))) =
      bxor ((winWitt ((d + 2) + twopow k) (twopow k)).testBit (((d + 3) + twopow k) + twopow k))
        ((phi (winWitt ((d + 1) + twopow k) (twopow k))).testBit (((d + 3) + twopow k) + twopow k)) := by
  have hs := periodic_winWitt_step_late_colm1_slot_at_white_centers_eq_zcenter_and_colm1_triality
    T P hP h d k ht hk hset hw0 hw1 hw2
  rw [hz, Bool.true_and] at hs
  rw [hs]
  simp only [bxor_eq_xor]
  cases (phi (winWitt ((d + 1) + twopow k) (twopow k))).testBit (((d + 3) + twopow k) + twopow k) <;>
    cases (ldiag (d + twopow (k + 1)) ((d + 1) + twopow (k + 1)) ^^
      (ldiag (d + twopow k) ((d + 1) + twopow k) ^^ ldiag d (d + 1))) <;> rfl

/-- Neighbourhood `Q`-agreement of `row`: at time `t` and `t + Q`, `row (t + Q)` at bits `[a + Q, a + L + Q]` agrees with `row t` at bits `[a, a + L]`. -/
def RowAgree (t Q a L : Nat) : Prop :=
  ∀ i, i ≤ L → (row (t + Q)).testBit (a + i + Q) = (row t).testBit (a + i)

/-- Neighbourhood `Q`-agreement of `winWitt · (2^k)`: at time `t` and `t + Q`, `winWitt (t + Q) (2^k)` at bits `[a + Q, a + L + Q]` agrees with `winWitt t (2^k)` at bits `[a, a + L]`. -/
def WinWittAgree (t k Q a L : Nat) : Prop :=
  ∀ i, i ≤ L →
    (winWitt (t + Q) (twopow k)).testBit (a + i + Q) =
      (winWitt t (twopow k)).testBit (a + i)

/-- **Sub-interval monotonicity of `RowAgree` (`rowAgree_mono`)**: if `RowAgree t Q a L` holds on `[a, a + L]` and `[a', a' + L'] ⊆ [a, a + L]`, then `RowAgree t Q a' L'` holds. -/
theorem rowAgree_mono (t Q a L a' L' : Nat) (ha : a ≤ a') (hL : a' + L' ≤ a + L)
    (h : RowAgree t Q a L) : RowAgree t Q a' L' := by
  intro i hi
  have hj : (a' - a) + i ≤ L := by omega
  have heq := h ((a' - a) + i) hj
  rwa [show a + ((a' - a) + i) = a' + i by omega] at heq

/-- **Sub-interval monotonicity of `WinWittAgree` (`winWittAgree_mono`)**: if `WinWittAgree t k Q a L` holds on `[a, a + L]` and `[a', a' + L'] ⊆ [a, a + L]`, then `WinWittAgree t k Q a' L'` holds. -/
theorem winWittAgree_mono (t k Q a L a' L' : Nat) (ha : a ≤ a') (hL : a' + L' ≤ a + L)
    (h : WinWittAgree t k Q a L) : WinWittAgree t k Q a' L' := by
  intro i hi
  have hj : (a' - a) + i ≤ L := by omega
  have heq := h ((a' - a) + i) hj
  rwa [show a + ((a' - a) + i) = a' + i by omega] at heq

/-- **One-step Rule 30 propagation of `RowAgree` (`rowAgree_step`)**: each step `t ↦ t + 1` loses one cell of agreement on each side around the moving center (`[a, a + L + 2] ↦ [a + 2, (a + 2) + L]`). -/
theorem rowAgree_step (t Q a L : Nat) (h : RowAgree t Q a (L + 2)) :
    RowAgree (t + 1) Q (a + 2) L := by
  intro i hi
  have h0 := h i (by omega)
  have h1 := h (i + 1) (by omega)
  have h2 := h (i + 2) (by omega)
  rw [show (t + 1) + Q = (t + Q) + 1 by omega]
  change (phi (row (t + Q))).testBit ((a + 2) + i + Q) = (phi (row t)).testBit ((a + 2) + i)
  rw [show (a + 2) + i + Q = (a + i + Q) + 2 by omega,
    show (a + 2) + i = (a + i) + 2 by omega,
    phi_testBit_add_two (row (t + Q)) (a + i + Q),
    phi_testBit_add_two (row t) (a + i),
    show (a + i + Q) + 2 = a + (i + 2) + Q by omega,
    show (a + i + Q) + 1 = a + (i + 1) + Q by omega,
    show (a + i) + 2 = a + (i + 2) by omega,
    show (a + i) + 1 = a + (i + 1) by omega,
    h0, h1, h2]

/-- **`s`-step Rule 30 propagation of `RowAgree` (`rowAgree_steps`)**: advancing `s` steps from `t` to `t + s` carries `Q`-agreement from `[a, a + L + 2 * s]` to `[a + 2 * s, a + 2 * s + L]`. -/
theorem rowAgree_steps (t Q a L s : Nat) (h : RowAgree t Q a (L + 2 * s)) :
    RowAgree (t + s) Q (a + 2 * s) L := by
  induction s generalizing t a L with
  | zero =>
    simpa using h
  | succ s ih =>
    have h' : RowAgree t Q a ((L + 2 * s) + 2) := by
      simpa [Nat.mul_succ, Nat.add_assoc] using h
    have hstep := rowAgree_step t Q a (L + 2 * s) h'
    have ih' := ih (t + 1) (a + 2) L hstep
    intro i hi
    have heq := ih' i hi
    rwa [show (t + 1) + s = t + (s + 1) by omega,
      show (a + 2) + 2 * s + i = a + 2 * (s + 1) + i by omega] at heq

/-- **Scaled-row (`phiScale k (row t)`) agreement from three-sector `RowAgree` (`phiScale_row_testBit_eq_of_rowAgree`)**: for `2^(k+1) ≤ a` and `i ≤ L`, if `RowAgree` holds on the three shifted intervals `a - 2^(k+1)`, `a - 2^k`, and `a`, then `S_k(row (t + Q))` at bit `a + i + Q` agrees with `S_k(row t)` at bit `a + i`. -/
theorem phiScale_row_testBit_eq_of_rowAgree (t k Q a L i : Nat)
    (ha : twopow (k + 1) ≤ a) (hi : i ≤ L)
    (h0 : RowAgree t Q (a - twopow (k + 1)) L)
    (h1 : RowAgree t Q (a - twopow k) L)
    (h2 : RowAgree t Q a L) :
    (phiScale k (row (t + Q))).testBit (a + i + Q) =
      (phiScale k (row t)).testBit (a + i) := by
  have hstep : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  change (((row (t + Q)) ^^^ ((row (t + Q)) <<< twopow k)) ^^^
    ((row (t + Q)) <<< (twopow k + twopow k))).testBit (a + i + Q) =
    (((row t) ^^^ ((row t) <<< twopow k)) ^^^
      ((row t) <<< (twopow k + twopow k))).testBit (a + i)
  simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
  have d1 : decide (a + i + Q ≥ twopow k) = true := decide_eq_true (by omega)
  have d2 : decide (a + i + Q ≥ twopow k + twopow k) = true := decide_eq_true (by omega)
  have d3 : decide (a + i ≥ twopow k) = true := decide_eq_true (by omega)
  have d4 : decide (a + i ≥ twopow k + twopow k) = true := decide_eq_true (by omega)
  rw [d1, d2, d3, d4,
    show a + i + Q - twopow k = (a - twopow k) + i + Q by omega,
    show a + i + Q - (twopow k + twopow k) = (a - twopow (k + 1)) + i + Q by omega,
    show a + i - twopow k = (a - twopow k) + i by omega,
    show a + i - (twopow k + twopow k) = (a - twopow (k + 1)) + i by omega,
    h2 i hi, h1 i hi, h0 i hi]

/-- **Frobenius defect (`frobDefect k (row t)`) agreement from three-sector `RowAgree` (`frobDefect_row_testBit_eq_of_rowAgree`)**: for `2^(k+1) ≤ a` and `i ≤ L`, if `RowAgree` holds with width `L + 1` on `a - 2^(k+1)`, `a - 2^k`, and `a`, then `δ_k(row (t + Q))` at bit `a + i + 1 + Q` agrees with `δ_k(row t)` at bit `a + i + 1`. -/
theorem frobDefect_row_testBit_eq_of_rowAgree (t k Q a L i : Nat)
    (ha : twopow (k + 1) ≤ a) (hi : i ≤ L)
    (h0 : RowAgree t Q (a - twopow (k + 1)) (L + 1))
    (h1 : RowAgree t Q (a - twopow k) (L + 1))
    (h2 : RowAgree t Q a (L + 1)) :
    (frobDefect k (row (t + Q))).testBit (a + i + 1 + Q) =
      (frobDefect k (row t)).testBit (a + i + 1) := by
  have hstep : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hfQ := frobDefect_row_testBit_outside_cone (t + Q) k ((a - twopow k) + i + Q) (by omega)
  have hf0 := frobDefect_row_testBit_outside_cone t k ((a - twopow k) + i) (by omega)
  rw [show ((a - twopow k) + i + Q + 1) + twopow k = a + i + 1 + Q by omega,
    show (a - twopow k) + i + Q + 1 = (a - twopow k) + (i + 1) + Q by omega,
    show ((a - twopow k) + i + Q) - twopow k = (a - twopow (k + 1)) + i + Q by omega,
    show ((a - twopow k) + i + Q) + twopow k = a + i + Q by omega,
    show ((a - twopow k) + (i + 1) + Q) - twopow k = (a - twopow (k + 1)) + (i + 1) + Q by omega] at hfQ
  rw [show ((a - twopow k) + i + 1) + twopow k = a + i + 1 by omega,
    show (a - twopow k) + i + 1 = (a - twopow k) + (i + 1) by omega,
    show ((a - twopow k) + i) - twopow k = (a - twopow (k + 1)) + i by omega,
    show ((a - twopow k) + i) + twopow k = a + i by omega,
    show ((a - twopow k) + (i + 1)) - twopow k = (a - twopow (k + 1)) + (i + 1) by omega] at hf0
  have hr2_0 := h2 i (by omega)
  have hr2_1 := h2 (i + 1) (by omega)
  have hr1_0 := h1 i (by omega)
  have hr1_1 := h1 (i + 1) (by omega)
  have hr0_0 := h0 i (by omega)
  have hr0_1 := h0 (i + 1) (by omega)
  simp only [row_testBit] at hr2_0 hr2_1 hr1_0 hr1_1 hr0_0 hr0_1
  rw [hfQ, hf0,
    show a + i + 1 + Q = a + (i + 1) + Q by omega,
    show a + i + 1 = a + (i + 1) by omega,
    hr2_0, hr2_1, hr1_0, hr1_1, hr0_0, hr0_1]

/-- **Cross-carry (`crossCarry (phiScale k (row t)) (winWitt t (2^k))`) agreement from three-sector `RowAgree` and `WinWittAgree` (`crossCarry_testBit_eq_of_rowAgree_winWittAgree`)**: for `2^(k+1) ≤ a` and `i ≤ L`, if `WinWittAgree` and the three-sector `RowAgree` hold with width `L + 1`, then the cross-carry at `(t + Q, a + i + 1 + Q)` agrees with `(t, a + i + 1)`. -/
theorem crossCarry_testBit_eq_of_rowAgree_winWittAgree (t k Q a L i : Nat)
    (ha : twopow (k + 1) ≤ a) (hi : i ≤ L)
    (hw : WinWittAgree t k Q a (L + 1))
    (h0 : RowAgree t Q (a - twopow (k + 1)) (L + 1))
    (h1 : RowAgree t Q (a - twopow k) (L + 1))
    (h2 : RowAgree t Q a (L + 1)) :
    (crossCarry (phiScale k (row (t + Q))) (winWitt (t + Q) (twopow k))).testBit (a + i + 1 + Q) =
      (crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit (a + i + 1) := by
  have hstep : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hs0 := phiScale_row_testBit_eq_of_rowAgree t k Q a (L + 1) i ha (by omega) h0 h1 h2
  have hs1 := phiScale_row_testBit_eq_of_rowAgree t k Q a (L + 1) (i + 1) ha (by omega) h0 h1 h2
  have hw0 := hw i (by omega)
  have hw1 := hw (i + 1) (by omega)
  let SQ := phiScale k (row (t + Q))
  let S0 := phiScale k (row t)
  let WQ := winWitt (t + Q) (twopow k)
  let W0 := winWitt t (twopow k)
  change ((SQ &&& (WQ <<< 1)) ^^^ (WQ &&& (SQ <<< 1))).testBit (a + i + 1 + Q) =
    ((S0 &&& (W0 <<< 1)) ^^^ (W0 &&& (S0 <<< 1))).testBit (a + i + 1)
  simp only [Nat.testBit_xor, Nat.testBit_and, Nat.testBit_shiftLeft]
  have d1 : decide (a + i + 1 + Q ≥ 1) = true := decide_eq_true (by omega)
  have d2 : decide (a + i + 1 ≥ 1) = true := decide_eq_true (by omega)
  rw [d1, d2, Bool.true_and, Bool.true_and, Bool.true_and, Bool.true_and,
    show a + i + 1 + Q - 1 = a + i + Q by omega,
    show a + i + 1 - 1 = a + i by omega,
    show a + i + 1 + Q = a + (i + 1) + Q by omega,
    show a + i + 1 = a + (i + 1) by omega,
    hs0, hs1, hw0, hw1]

/-- **One-Step Window Propagation of `WinWittAgree` via Theorem 9.204 (`winWittAgree_step`)**:
    for `2^(k+1) ≤ a`, each step `t ↦ t + 1` of the window step 9.204 (`winWitt_step_frobDefect_testBit_succ`) loses one cell of agreement on each side, advancing `WinWittAgree t k Q a (L + 2)` to `WinWittAgree (t + 1) k Q (a + 2) L` whenever the rows at `t` and `t + Q` agree on the three-sector stencil of width `L + 1`! -/
theorem winWittAgree_step (t k Q a L : Nat) (ha : twopow (k + 1) ≤ a)
    (hw : WinWittAgree t k Q a (L + 2))
    (h0 : RowAgree t Q (a - twopow (k + 1)) (L + 1))
    (h1 : RowAgree t Q (a - twopow k) (L + 1))
    (h2 : RowAgree t Q a (L + 1)) :
    WinWittAgree (t + 1) k Q (a + 2) L := by
  intro i hi
  have hstepQ := winWitt_step_frobDefect_testBit_succ (t + Q) k (a + i + 1 + Q)
  have hstep0 := winWitt_step_frobDefect_testBit_succ t k (a + i + 1)
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    show (a + 2) + i + Q = (a + i + 1 + Q) + 1 by omega,
    show (a + 2) + i = (a + i + 1) + 1 by omega,
    hstepQ, hstep0]
  have hphi :
      (phi (winWitt (t + Q) (twopow k))).testBit ((a + i + 1 + Q) + 1) =
        (phi (winWitt t (twopow k))).testBit ((a + i + 1) + 1) := by
    rw [show (a + i + 1 + Q) + 1 = (a + i + Q) + 2 by omega,
      show (a + i + 1) + 1 = (a + i) + 2 by omega,
      phi_testBit_add_two (winWitt (t + Q) (twopow k)) (a + i + Q),
      phi_testBit_add_two (winWitt t (twopow k)) (a + i),
      show (a + i + Q) + 2 = a + (i + 2) + Q by omega,
      show (a + i + Q) + 1 = a + (i + 1) + Q by omega,
      show (a + i) + 2 = a + (i + 2) by omega,
      show (a + i) + 1 = a + (i + 1) by omega,
      hw i (by omega), hw (i + 1) (by omega), hw (i + 2) (by omega)]
  have hhw' : WinWittAgree t k Q a (L + 1) :=
    winWittAgree_mono t k Q a (L + 2) a (L + 1) (by omega) (by omega) hw
  have hcc := crossCarry_testBit_eq_of_rowAgree_winWittAgree t k Q a L i ha hi hhw' h0 h1 h2
  have hdf := frobDefect_row_testBit_eq_of_rowAgree t k Q a L i ha hi h0 h1 h2
  rw [hphi, hcc, hdf]

/-- **`s`-Step Window Propagation of `WinWittAgree` via Theorem 9.204 (`winWittAgree_steps`)**:
    for `2^(k+1) ≤ a` and any `s : Nat`, advancing `s` steps via the window step 9.204 carries `Q`-agreement from width `L + 2 * s` at time `t` to `[a + 2 * s, a + 2 * s + L]` at time `t + s`! -/
theorem winWittAgree_steps (t k Q a L s : Nat) (ha : twopow (k + 1) ≤ a)
    (hw : WinWittAgree t k Q a (L + 2 * s))
    (h0 : RowAgree t Q (a - twopow (k + 1)) (L + 2 * s))
    (h1 : RowAgree t Q (a - twopow k) (L + 2 * s))
    (h2 : RowAgree t Q a (L + 2 * s)) :
    WinWittAgree (t + s) k Q (a + 2 * s) L := by
  induction s generalizing t a L with
  | zero =>
    simpa using hw
  | succ s ih =>
    have hw' : WinWittAgree t k Q a ((L + 2 * s) + 2) := by
      simpa [Nat.mul_succ, Nat.add_assoc] using hw
    have h0' : RowAgree t Q (a - twopow (k + 1)) ((L + 2 * s) + 2) := by
      simpa [Nat.mul_succ, Nat.add_assoc] using h0
    have h1' : RowAgree t Q (a - twopow k) ((L + 2 * s) + 2) := by
      simpa [Nat.mul_succ, Nat.add_assoc] using h1
    have h2' : RowAgree t Q a ((L + 2 * s) + 2) := by
      simpa [Nat.mul_succ, Nat.add_assoc] using h2
    have h0_sub : RowAgree t Q (a - twopow (k + 1)) ((L + 2 * s) + 1) :=
      rowAgree_mono t Q (a - twopow (k + 1)) ((L + 2 * s) + 2) (a - twopow (k + 1)) ((L + 2 * s) + 1)
        (by omega) (by omega) h0'
    have h1_sub : RowAgree t Q (a - twopow k) ((L + 2 * s) + 1) :=
      rowAgree_mono t Q (a - twopow k) ((L + 2 * s) + 2) (a - twopow k) ((L + 2 * s) + 1)
        (by omega) (by omega) h1'
    have h2_sub : RowAgree t Q a ((L + 2 * s) + 1) :=
      rowAgree_mono t Q a ((L + 2 * s) + 2) a ((L + 2 * s) + 1)
        (by omega) (by omega) h2'
    have hw_step := winWittAgree_step t k Q a (L + 2 * s) ha hw' h0_sub h1_sub h2_sub
    have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
    have h0_step : RowAgree (t + 1) Q ((a + 2) - twopow (k + 1)) (L + 2 * s) := by
      rw [show (a + 2) - twopow (k + 1) = (a - twopow (k + 1)) + 2 by omega]
      exact rowAgree_step t Q (a - twopow (k + 1)) (L + 2 * s) h0'
    have h1_step : RowAgree (t + 1) Q ((a + 2) - twopow k) (L + 2 * s) := by
      rw [show (a + 2) - twopow k = (a - twopow k) + 2 by omega]
      exact rowAgree_step t Q (a - twopow k) (L + 2 * s) h1'
    have h2_step : RowAgree (t + 1) Q (a + 2) (L + 2 * s) :=
      rowAgree_step t Q a (L + 2 * s) h2'
    have ih' := ih (t + 1) (a + 2) L (by omega) hw_step h0_step h1_step h2_step
    intro i hi
    have heq := ih' i hi
    rwa [show (t + 1) + s = t + (s + 1) by omega,
      show (a + 2) + 2 * s + i = a + 2 * (s + 1) + i by omega] at heq

/-- **Carrying `Q`-Periodicity of `wittRespBool` Forward by `s` Steps via Window Step 9.204 (`wittRespBool_eq_of_winWittAgree_steps`)**:
    if at a time `t0` with `2^k + s ≤ t0`, `WinWittAgree` and the three-sector `RowAgree` hold on the symmetric neighbourhood of radius `s` (`width = 2 * s`) around the center slot `t0 + 2^k`, then `s` steps of 9.204 carry `Q`-periodicity to the center slot at time `t0 + s`: `wittRespBool (t0 + s + Q) k = wittRespBool (t0 + s) k`. -/
theorem wittRespBool_eq_of_winWittAgree_steps (t0 k Q s : Nat)
    (ht0 : twopow k + s ≤ t0)
    (hw : WinWittAgree t0 k Q ((t0 + twopow k) - s) (2 * s))
    (h0 : RowAgree t0 Q (((t0 + twopow k) - s) - twopow (k + 1)) (2 * s))
    (h1 : RowAgree t0 Q (((t0 + twopow k) - s) - twopow k) (2 * s))
    (h2 : RowAgree t0 Q ((t0 + twopow k) - s) (2 * s)) :
    wittRespBool ((t0 + s) + Q) k = wittRespBool (t0 + s) k := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hsteps := winWittAgree_steps t0 k Q ((t0 + twopow k) - s) 0 s (by omega)
    (by simpa using hw) (by simpa using h0) (by simpa using h1) (by simpa using h2)
  have h0_eq := hsteps 0 (by omega)
  rw [show ((t0 + twopow k) - s) + 2 * s + 0 + Q = ((t0 + s) + Q) + twopow k by omega,
    show ((t0 + twopow k) - s) + 2 * s + 0 = (t0 + s) + twopow k by omega] at h0_eq
  exact h0_eq

/-- **Carrying `Q`-Periodicity of Column `-1` Forward by `s` Steps from Neighbourhood Agreement (`colm1_eq_of_rowAgree_steps`)**:
    for `s ≤ t0 + 2`, if `RowAgree (t0 + 1) Q ((t0 + 2) - s) (2 * s)` holds on the radius-`s` neighbourhood around column `-1` at time `t0 + 1`, then `s` steps of Rule 30 carry `Q`-agreement to column `-1` at time `t0 + s + 1`: `ldiag ((t0 + s) + Q) ((t0 + s + 1) + Q) = ldiag (t0 + s) (t0 + s + 1)`. -/
theorem colm1_eq_of_rowAgree_steps (t0 Q s : Nat) (hs : s ≤ t0 + 2)
    (h : RowAgree (t0 + 1) Q ((t0 + 2) - s) (2 * s)) :
    ldiag ((t0 + s) + Q) ((t0 + s + 1) + Q) = ldiag (t0 + s) (t0 + s + 1) := by
  have hsteps := rowAgree_steps (t0 + 1) Q ((t0 + 2) - s) 0 s (by simpa using h)
  have h0_eq := hsteps 0 (by omega)
  rw [show (t0 + 1) + s + Q = ((t0 + s) + Q) + 1 by omega,
    show (t0 + 1) + s = (t0 + s) + 1 by omega,
    show ((t0 + 2) - s) + 2 * s + 0 + Q = ((t0 + s) + Q) + 2 * 1 by omega,
    show ((t0 + 2) - s) + 2 * s + 0 = (t0 + s) + 2 * 1 by omega,
    row_testBit, row_testBit,
    ← ldiag_eq_rdiag ((t0 + s) + Q) 1,
    ← ldiag_eq_rdiag (t0 + s) 1,
    show ((t0 + s) + Q) + 1 = (t0 + s + 1) + Q by omega] at h0_eq
  exact h0_eq

/-- **Carrying `m * P`-Periodicity of `maskparity · 0` Forward by `s` Steps from Neighbourhood Agreement (`maskparity_zero_eq_of_rowAgree_steps`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t0 + s + 1` and `s ≤ t0 + 2`, if `RowAgree (t0 + 1) (m * P) ((t0 + 2) - s) (2 * s)` holds at time `t0 + 1`, then `s` steps carry `m * P`-agreement to `maskparity · 0` at time `t0 + s + 1`! -/
theorem maskparity_zero_eq_of_rowAgree_steps
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t0 s : Nat) (ht : T ≤ t0 + s + 1) (hs : s ≤ t0 + 2)
    (h : RowAgree (t0 + 1) (m * P) ((t0 + 2) - s) (2 * s)) :
    Rule30UOR.Scale.maskparity ((t0 + s + 1) + m * P) 0 =
      Rule30UOR.Scale.maskparity (t0 + s + 1) 0 := by
  have hcol := colm1_eq_of_rowAgree_steps t0 (m * P) s hs h
  have hdef := periodic_maskparity_zero_defect_mul_eq_colm1_defect_mul T P hP hper m (t0 + s) ht
  rw [show ((t0 + s) + m * P) + 1 = (t0 + s + 1) + m * P by omega] at hdef
  rw [hcol, bxor_eq_xor, bxor_eq_xor, Bool.xor_self] at hdef
  revert hdef
  cases Rule30UOR.Scale.maskparity ((t0 + s + 1) + m * P) 0 <;>
    cases Rule30UOR.Scale.maskparity (t0 + s + 1) 0 <;> decide

/-- **Carrying `Q`-Periodicity from a Sector Residue Class `d + 1 (mod 2^k)` to Every Residue `mod 2^k` (`colNegOnePeriodic_of_sector_rowAgree`)**:
    if at a fixed scale `k` and sector residue `d + 1`, the radius-`2^k` neighbourhood agreement `RowAgree ((d + u * 2^k) + 1) Q (((d + u * 2^k) + 2) - 2^k) (2 * 2^k)` holds at all sector times `(d + 1) + u * 2^k` for `u ≥ U` (`1 ≤ U`), then advancing by `s = (t - (d + U * 2^k)) % 2^k < 2^k` steps carries `Q`-periodicity of column `-1` to EVERY residue `mod 2^k`, establishing `ColNegOnePeriodic (d + U * 2^k) Q`! -/
theorem colNegOnePeriodic_of_sector_rowAgree (k d U Q : Nat) (hU : 1 ≤ U)
    (hsec : ∀ u, U ≤ u →
      RowAgree ((d + u * twopow k) + 1) Q
        (((d + u * twopow k) + 2) - twopow k) (2 * twopow k)) :
    ColNegOnePeriodic (d + U * twopow k) Q := by
  intro t ht
  have hpos : 0 < twopow k := by
    have := twopow_gt_self k
    omega
  obtain ⟨delta, hdelta⟩ : ∃ delta, t = (d + U * twopow k) + delta := ⟨t - (d + U * twopow k), by omega⟩
  obtain ⟨q, s, hdiv, hs_lt⟩ : ∃ q s, delta = q * twopow k + s ∧ s < twopow k :=
    ⟨delta / twopow k, delta % twopow k,
      by rw [Nat.mul_comm, Nat.div_add_mod],
      Nat.mod_lt delta hpos⟩
  have hu : U ≤ U + q := by omega
  have ht0_eq : t = (d + (U + q) * twopow k) + s := by
    rw [Nat.add_mul]
    omega
  have hs_le : s ≤ (d + (U + q) * twopow k) + 2 := by
    have h1 : 1 * twopow k ≤ (U + q) * twopow k := Nat.mul_le_mul_right (twopow k) (by omega)
    omega
  have h_u := hsec (U + q) hu
  have h_sub : RowAgree ((d + (U + q) * twopow k) + 1) Q
      (((d + (U + q) * twopow k) + 2) - s) (2 * s) :=
    rowAgree_mono ((d + (U + q) * twopow k) + 1) Q
      (((d + (U + q) * twopow k) + 2) - twopow k) (2 * twopow k)
      (((d + (U + q) * twopow k) + 2) - s) (2 * s)
      (by omega) (by omega) h_u
  have hcol := colm1_eq_of_rowAgree_steps (d + (U + q) * twopow k) Q s hs_le h_sub
  rwa [← ht0_eq] at hcol

/-- **Refutation of Sector-Time Radius-`2^k` Neighbourhood Agreement at Any Multiple `Q = m * P` (`not_sector_rowAgree_mul`)**:
    under `CenterPeriodic T P` (`0 < P`), for any scale `k`, sector residue `d + 1`, threshold `U ≥ 1`, and positive multiple `m > 0`, the radius-`2^k` neighbourhood agreement `RowAgree ((d + u * 2^k) + 1) (m * P) (((d + u * 2^k) + 2) - 2^k) (2 * 2^k)` cannot hold for all `u ≥ U`, because carrying it across all residues `mod 2^k` yields `ColNegOnePeriodic`, refuted by `not_periodic_colm1_mul`! -/
theorem not_sector_rowAgree_mul
    (T P : Nat) (hP : 0 < P) (h : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U m : Nat) (hU : 1 ≤ U) (hm : 0 < m)
    (hsec : ∀ u, U ≤ u →
      RowAgree ((d + u * twopow k) + 1) (m * P)
        (((d + u * twopow k) + 2) - twopow k) (2 * twopow k)) :
    False := by
  have hcol := colNegOnePeriodic_of_sector_rowAgree k d U (m * P) hU hsec
  exact not_periodic_colm1_mul T P hP h (d + U * twopow k) m hm hcol

/-- Paper-facing predicate `SectorRowAgree k d U Q`: for all `u ≥ U`, `RowAgree ((d + u * 2^k) + 1) Q (((d + u * 2^k) + 2) - 2^k) (2 * 2^k)` holds at the sector time `(d + 1) + u * 2^k`. -/
def SectorRowAgree (k d U Q : Nat) : Prop :=
  ∀ u, U ≤ u →
    RowAgree ((d + u * twopow k) + 1) Q
      (((d + u * twopow k) + 2) - twopow k) (2 * twopow k)

theorem colNegOnePeriodic_of_sector_rowAgree_prop (k d U Q : Nat) (hU : 1 ≤ U)
    (hsec : SectorRowAgree k d U Q) :
    ColNegOnePeriodic (d + U * twopow k) Q :=
  colNegOnePeriodic_of_sector_rowAgree k d U Q hU hsec

theorem not_sector_rowAgree_mul_prop
    (T P : Nat) (hP : 0 < P) (h : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U m : Nat) (hU : 1 ≤ U) (hm : 0 < m) :
    ¬ SectorRowAgree k d U (m * P) :=
  not_sector_rowAgree_mul T P hP h k d U m hU hm

theorem zcenter_restart_ldiag_prop (k d u : Nat) (hd : d ≤ k) (hu : 1 ≤ u) (hset : SettledAt d k) :
    ZCenterEq d (ldiag d (d + u * twopow k)) := by
  unfold ZCenterEq
  exact (zcenter_restart_ldiag k d u hd hu hset).symm

theorem frobDefect_row_late_center_slot_of_zcenter_true_prop
    (d k : Nat) (hk : d + 1 ≤ k) (hset : SettledAt (d + 1) k)
    (hz : ZCenterEq (d + 1) true)
    (hw1 : Rule30UOR.Core.center (d + 1) = false)
    (hw2 : Rule30UOR.Core.center ((d + 1) + twopow k) = false) :
    BitFrobDefectEq k (row ((d + 1) + twopow k)) (((d + 1) + twopow k) + twopow k)
      (bxor (Rule30UOR.Scale.maskparity ((d + 1) + twopow k) 0)
        (Rule30UOR.Scale.maskparity (d + 1) 0)) := by
  unfold BitFrobDefectEq
  rw [bit_eq_bton_testBit,
    frobDefect_row_late_center_slot_of_zcenter_true d k hk hset hz hw1 hw2]

theorem periodic_winWitt_step_late_center_slot_of_zcenter_true_prop
    (T P : Nat) (hP : 0 < P) (h : Rule30UOR.Scale.CenterPeriodic T P)
    (d k : Nat) (ht : T ≤ d + 1) (hk : d + 1 ≤ k) (hset : SettledAt (d + 1) k)
    (hz : ZCenterEq (d + 1) true)
    (hw0 : Rule30UOR.Core.center (d + 1) = false)
    (hw1 : Rule30UOR.Core.center ((d + 1) + Rule30UOR.Scale.lag P k) = false)
    (hw2 : Rule30UOR.Core.center ((d + 1) + Rule30UOR.Scale.lag P (k + 1)) = false) :
    bxor (Rule30UOR.Scale.maskparity ((d + 1) + twopow (k + 1)) 0)
      (bxor (Rule30UOR.Scale.maskparity ((d + 1) + twopow k) 0)
        (Rule30UOR.Scale.maskparity (d + 1) 0)) =
      bxor (wittRespBool ((d + 2) + twopow k) k)
        (wittBitBool (phi (winWitt ((d + 1) + twopow k) (twopow k))) (((d + 2) + twopow k) + twopow k)) := by
  unfold wittBitBool
  exact periodic_winWitt_step_late_center_slot_of_zcenter_true
    T P hP h d k ht hk hset hz hw0 hw1 hw2

theorem periodic_winWitt_step_late_colm1_slot_of_zcenter_true_prop
    (T P : Nat) (hP : 0 < P) (h : Rule30UOR.Scale.CenterPeriodic T P)
    (d k : Nat) (ht : T ≤ d + 1) (hk : d + 2 ≤ k) (hset : SettledAt (d + 1) k)
    (hz : ZCenterEq (d + 1) true)
    (hw0 : Rule30UOR.Core.center (d + 1) = false)
    (hw1 : Rule30UOR.Core.center ((d + 1) + Rule30UOR.Scale.lag P k) = false)
    (hw2 : Rule30UOR.Core.center ((d + 1) + Rule30UOR.Scale.lag P (k + 1)) = false) :
    bxor (ldiag (d + twopow (k + 1)) ((d + 1) + twopow (k + 1)))
      (bxor (ldiag (d + twopow k) ((d + 1) + twopow k)) (ldiag d (d + 1))) =
      bxor (wittBitBool (winWitt ((d + 2) + twopow k) (twopow k)) (((d + 3) + twopow k) + twopow k))
        (wittBitBool (phi (winWitt ((d + 1) + twopow k) (twopow k))) (((d + 3) + twopow k) + twopow k)) := by
  unfold wittBitBool
  exact periodic_winWitt_step_late_colm1_slot_of_zcenter_true
    T P hP h d k ht hk hset hz hw0 hw1 hw2

theorem phiScale_row_testBit_eq_of_rowAgree_prop (t k Q a L i : Nat)
    (ha : twopow (k + 1) ≤ a) (hi : i ≤ L)
    (h0 : RowAgree t Q (a - twopow (k + 1)) L)
    (h1 : RowAgree t Q (a - twopow k) L)
    (h2 : RowAgree t Q a L) :
    wittBitBool (phiScale k (row (t + Q))) (a + i + Q) =
      wittBitBool (phiScale k (row t)) (a + i) := by
  unfold wittBitBool
  exact phiScale_row_testBit_eq_of_rowAgree t k Q a L i ha hi h0 h1 h2

theorem frobDefect_row_testBit_eq_of_rowAgree_prop (t k Q a L i : Nat)
    (ha : twopow (k + 1) ≤ a) (hi : i ≤ L)
    (h0 : RowAgree t Q (a - twopow (k + 1)) (L + 1))
    (h1 : RowAgree t Q (a - twopow k) (L + 1))
    (h2 : RowAgree t Q a (L + 1)) :
    BitFrobDefectEq k (row (t + Q)) (a + i + 1 + Q)
      (wittBitBool (frobDefect k (row t)) (a + i + 1)) := by
  unfold BitFrobDefectEq wittBitBool
  rw [bit_eq_bton_testBit,
    frobDefect_row_testBit_eq_of_rowAgree t k Q a L i ha hi h0 h1 h2]

theorem crossCarry_testBit_eq_of_rowAgree_winWittAgree_prop (t k Q a L i : Nat)
    (ha : twopow (k + 1) ≤ a) (hi : i ≤ L)
    (hw : WinWittAgree t k Q a (L + 1))
    (h0 : RowAgree t Q (a - twopow (k + 1)) (L + 1))
    (h1 : RowAgree t Q (a - twopow k) (L + 1))
    (h2 : RowAgree t Q a (L + 1)) :
    BitCrossCarryEq (phiScale k (row (t + Q))) (winWitt (t + Q) (twopow k)) (a + i + 1 + Q)
      (wittBitBool (crossCarry (phiScale k (row t)) (winWitt t (twopow k))) (a + i + 1)) := by
  unfold BitCrossCarryEq wittBitBool
  rw [bit_eq_bton_testBit,
    crossCarry_testBit_eq_of_rowAgree_winWittAgree t k Q a L i ha hi hw h0 h1 h2]

/-- The least common multiple `Q = lcm(P, 2^k) = (P / gcd(P, 2^k)) * 2^k`. -/
def lcmPeriod (P k : Nat) : Nat :=
  (P / Nat.gcd P (twopow k)) * twopow k

theorem lcmPeriod_eq_mul_twopow (P k : Nat) :
    lcmPeriod P k = (P / Nat.gcd P (twopow k)) * twopow k := rfl

theorem lcmPeriod_eq_mul_period (P k : Nat) :
    lcmPeriod P k = (twopow k / Nat.gcd P (twopow k)) * P := by
  unfold lcmPeriod
  obtain ⟨a, ha⟩ := Nat.gcd_dvd_left P (twopow k)
  obtain ⟨b, hb⟩ := Nat.gcd_dvd_right P (twopow k)
  rcases Nat.eq_zero_or_pos (Nat.gcd P (twopow k)) with hg0 | hg
  · rw [hg0, Nat.div_zero, Nat.div_zero, Nat.zero_mul, Nat.zero_mul]
  · have ha_div : P / Nat.gcd P (twopow k) = a := by
      have h0 : Nat.gcd P (twopow k) * a / Nat.gcd P (twopow k) = a := Nat.mul_div_right a hg
      rwa [← ha] at h0
    have hb_div : twopow k / Nat.gcd P (twopow k) = b := by
      have h0 : Nat.gcd P (twopow k) * b / Nat.gcd P (twopow k) = b := Nat.mul_div_right b hg
      rwa [← hb] at h0
    have hmul : a * twopow k = b * P := by
      have h1 : a * (Nat.gcd P (twopow k) * b) = b * (Nat.gcd P (twopow k) * a) := by
        rw [← Nat.mul_assoc, Nat.mul_comm a (Nat.gcd P (twopow k)),
          Nat.mul_comm (Nat.gcd P (twopow k) * a) b]
      rwa [← hb, ← ha] at h1
    rw [ha_div, hb_div, hmul]

theorem lcmPeriod_div_pos (P k : Nat) (hP : 0 < P) :
    0 < twopow k / Nat.gcd P (twopow k) := by
  obtain ⟨b, hb⟩ := Nat.gcd_dvd_right P (twopow k)
  have hpos : 0 < twopow k := by
    have := twopow_gt_self k
    omega
  have hg : 0 < Nat.gcd P (twopow k) := Nat.gcd_pos_of_pos_left (twopow k) hP
  have hb_div : twopow k / Nat.gcd P (twopow k) = b := by
    have h0 : Nat.gcd P (twopow k) * b / Nat.gcd P (twopow k) = b := Nat.mul_div_right b hg
    rwa [← hb] at h0
  rw [hb_div]
  rcases Nat.eq_zero_or_pos b with rfl | hb_pos
  · rw [Nat.mul_zero] at hb
    omega
  · exact hb_pos

/-- **Right-wing `Q`-invariance at `Q = lcm(P, 2^k)` (`rdiag_lcmPeriod_eq`)**: for every `P, k, j, t : Nat` with `j ≤ k`, `rdiag j (t + lcmPeriod P k) = rdiag j t`. -/
theorem rdiag_lcmPeriod_eq (P k j t : Nat) (hj : j ≤ k) :
    rdiag j (t + lcmPeriod P k) = rdiag j t :=
  rdiag_restart k j (P / Nat.gcd P (twopow k)) t hj

/-- **Left-wing settled `Q`-invariance at `Q = lcm(P, 2^k)` (`ldiag_lcmPeriod_eq`)**: for every `P, k, j, t : Nat` with `j ≤ k` and `settle j ≤ t`, `ldiag j (t + lcmPeriod P k) = ldiag j t`. -/
theorem ldiag_lcmPeriod_eq (P k j t : Nat) (hj : j ≤ k) (hset : settle j ≤ t) :
    ldiag j (t + lcmPeriod P k) = ldiag j t :=
  ldiag_settled_restart k j (P / Nat.gcd P (twopow k)) t hj hset

theorem ldiag_settled_restart_prop (k j v t : Nat) (hj : j ≤ k) (hset : SettledBy j t) :
    ldiag j (t + v * twopow k) = ldiag j t :=
  ldiag_settled_restart k j v t hj hset

theorem ldiag_lcmPeriod_eq_prop (P k j t : Nat) (hj : j ≤ k) (hset : SettledBy j t) :
    ldiag j (t + lcmPeriod P k) = ldiag j t :=
  ldiag_lcmPeriod_eq P k j t hj hset

/-- **Center `Q`-invariance at `Q = lcm(P, 2^k)` (`center_lcmPeriod_eq`)**: under `CenterPeriodic T P` (`0 < P`), for every `k, t : Nat` with `T ≤ t`, `center (t + lcmPeriod P k) = center t`. -/
theorem center_lcmPeriod_eq (T P : Nat) (_hP : 0 < P) (h : Rule30UOR.Scale.CenterPeriodic T P)
    (k t : Nat) (ht : T ≤ t) :
    Rule30UOR.Core.center (t + lcmPeriod P k) = Rule30UOR.Core.center t := by
  rw [lcmPeriod_eq_mul_period P k]
  exact Rule30UOR.Scale.center_mul h (twopow k / Nat.gcd P (twopow k)) t ht

/-- **Refutation of Sector-Time Radius-`2^k` Neighbourhood Agreement at `Q = lcm(P, 2^k)` (`not_sector_rowAgree_lcmPeriod`)**:
    under `CenterPeriodic T P` (`0 < P`), for any scale `k`, sector residue `d + 1`, and threshold `U ≥ 1`, `SectorRowAgree k d U (lcmPeriod P k)` is false! -/
theorem not_sector_rowAgree_lcmPeriod
    (T P : Nat) (hP : 0 < P) (h : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U : Nat) (hU : 1 ≤ U) :
    ¬ SectorRowAgree k d U (lcmPeriod P k) := by
  rw [lcmPeriod_eq_mul_period P k]
  exact not_sector_rowAgree_mul T P hP h k d U (twopow k / Nat.gcd P (twopow k)) hU
    (lcmPeriod_div_pos P k hP)

/-! ### Leftward Bijectivity, Symmetric Doubling of Right-Half Agreement Across the Periodic Center, and Window-Step 9.204 Sector Transport -/

/-- Leftward bijectivity of a single Rule 30 step on `row`: bit `j + 2` at time `t` equals bit `j + 2` at time `t + 1` XORed with the OR of bits `j + 1` and `j` at time `t`. -/
theorem row_testBit_add_two_of_step (t j : Nat) :
    (row t).testBit (j + 2) =
      bxor ((row (t + 1)).testBit (j + 2))
        ((row t).testBit (j + 1) || (row t).testBit j) := by
  have hstep : (row (t + 1)).testBit (j + 2) =
      bxor ((row t).testBit (j + 2)) ((row t).testBit (j + 1) || (row t).testBit j) := by
    rw [bxor_eq_xor]
    change (phi (row t)).testBit (j + 2) = _
    exact phi_testBit_add_two (row t) j
  rw [hstep, bxor_eq_xor, bxor_eq_xor]
  cases (row t).testBit (j + 2) <;>
    cases ((row t).testBit (j + 1) || (row t).testBit j) <;> rfl

/-- **1-Cell Leftward Spatial Extension of `RowAgree` (`rowAgree_extend_right`)**:
    if `RowAgree t Q a (L + 1)` holds on `[a, a + L + 1]` at time `t` and bit `a + L + 2` agrees between `t + 1` and `(t + 1) + Q`, then leftward bijectivity of Rule 30 forces bit `a + L + 2` to agree at time `t`, establishing `RowAgree t Q a (L + 2)`! -/
theorem rowAgree_extend_right (t Q a L : Nat)
    (h : RowAgree t Q a (L + 1))
    (hstep : (row ((t + 1) + Q)).testBit (a + L + 2 + Q) =
      (row (t + 1)).testBit (a + L + 2)) :
    RowAgree t Q a (L + 2) := by
  intro i hi
  rcases Nat.lt_or_eq_of_le hi with hlt | rfl
  · exact h i (by omega)
  · have h0 := h L (by omega)
    have h1 := h (L + 1) (by omega)
    rw [show a + (L + 2) + Q = (a + L + Q) + 2 by omega,
      show a + (L + 2) = (a + L) + 2 by omega,
      row_testBit_add_two_of_step (t + Q) (a + L + Q),
      row_testBit_add_two_of_step t (a + L),
      show (t + Q) + 1 = (t + 1) + Q by omega,
      show (a + L + Q) + 2 = a + L + 2 + Q by omega,
      show (a + L) + 2 = a + L + 2 by omega,
      show (a + L + Q) + 1 = a + (L + 1) + Q by omega,
      show (a + L) + 1 = a + (L + 1) by omega,
      hstep, h1, h0]

/-- **Unconditional Radius-`0` Center `RowAgree` under `CenterPeriodic T P` (`periodic_rowAgree_center`)**:
    under `CenterPeriodic T P` (`0 < P`), for every multiple `m` and every `t ≥ T`, `RowAgree t (m * P) t 0` holds at the center column `x = 0` (`bit t`). -/
theorem periodic_rowAgree_center
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t : Nat) (ht : T ≤ t) :
    RowAgree t (m * P) t 0 := by
  intro i hi
  have hi0 : i = 0 := by omega
  subst hi0
  rw [Nat.add_zero, row_testBit, row_testBit,
    ← core_center_eq_rdiag (t + m * P), ← core_center_eq_rdiag t]
  exact Rule30UOR.Scale.center_mul hper m t ht

/-- **Unconditional Column-`0` and Column-`-1` `RowAgree` at Every Black Center (`periodic_rowAgree_black_center`)**:
    under `CenterPeriodic T P` (`0 < P`), at every `t + 1 ≥ T` with `center (t + 1) = true`, the black center shields column `-1` (`ldiag t (t + 1)`) from column `+1`, so `RowAgree (t + 1) (m * P) (t + 1) 1` (agreement at both column `0` and column `-1` at time `t + 1`) holds unconditionally! -/
theorem periodic_rowAgree_black_center
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t : Nat) (ht : T ≤ t + 1) (hblk : Rule30UOR.Core.center (t + 1) = true) :
    RowAgree (t + 1) (m * P) (t + 1) 1 := by
  intro i hi
  rcases Nat.eq_zero_or_pos i with rfl | hpos
  · exact periodic_rowAgree_center T P hP hper m (t + 1) ht 0 (by omega)
  · have hi1 : i = 1 := by omega
    subst hi1
    have hdef := periodic_maskparity_zero_defect_mul_eq_colm1_defect_mul T P hP hper m t ht
    have hblk_mP : Rule30UOR.Core.center ((t + m * P) + 1) = true := by
      rw [show (t + m * P) + 1 = (t + 1) + m * P by omega,
        Rule30UOR.Scale.center_mul hper m (t + 1) ht, hblk]
    have hm0 : Rule30UOR.Scale.maskparity (t + 1) 0 = false := by
      have hand := maskparity_zero_and_center_eq_false (t + 1)
      rw [hblk, Bool.and_true] at hand
      exact hand
    have hm_mP : Rule30UOR.Scale.maskparity ((t + m * P) + 1) 0 = false := by
      have hand := maskparity_zero_and_center_eq_false ((t + m * P) + 1)
      rw [hblk_mP, Bool.and_true] at hand
      exact hand
    rw [hm0, hm_mP, bxor_eq_xor, Bool.xor_self] at hdef
    have hcol : ldiag (t + m * P) ((t + m * P) + 1) = ldiag t (t + 1) := by
      revert hdef
      rw [bxor_eq_xor]
      cases ldiag (t + m * P) ((t + m * P) + 1) <;> cases ldiag t (t + 1) <;> decide
    have hl1 : (row ((t + 1) + m * P)).testBit (t + 1 + 1 + m * P) =
        ldiag (t + m * P) ((t + m * P) + 1) := by
      rw [row_testBit,
        show (t + 1) + m * P = (t + m * P) + 1 by omega,
        show t + 1 + 1 + m * P = (t + m * P) + 2 * 1 by omega,
        ← ldiag_eq_rdiag (t + m * P) 1]
    have hl2 : (row (t + 1)).testBit (t + 1 + 1) = ldiag t (t + 1) := by
      rw [row_testBit,
        show t + 1 + 1 = t + 2 * 1 by omega,
        ← ldiag_eq_rdiag t 1]
    rw [hl1, hl2, hcol]

/-- **Symmetric Doubling of Right-Half `RowAgree` Across the Periodic Center (`periodic_rowAgree_symm_of_right`)**:
    under `CenterPeriodic T P` (`0 < P`), for every multiple `m`, time `t ≥ T`, and radius `R ≤ t`, if `RowAgree t (m * P) (t - R) R` holds on the one-sided right-wing neighbourhood `[t - R, t]` (spatial columns `x ∈ [0, R]`), then `RowAgree t (m * P) (t - R) (2 * R)` holds on the full two-sided symmetric neighbourhood `[t - R, t + R]` (spatial columns `x ∈ [-R, +R]`)! -/
theorem periodic_rowAgree_symm_of_right
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m R : Nat) :
    ∀ t : Nat, T ≤ t → R ≤ t →
      RowAgree t (m * P) (t - R) R →
      RowAgree t (m * P) (t - R) (2 * R) := by
  induction R with
  | zero =>
    intro t ht _ _
    simpa using periodic_rowAgree_center T P hP hper m t ht
  | succ R ih =>
    intro t ht hR hright
    have h_sub : RowAgree t (m * P) (t - R) R :=
      rowAgree_mono t (m * P) (t - (R + 1)) (R + 1) (t - R) R
        (by omega) (by omega) hright
    have h_symm_R : RowAgree t (m * P) (t - R) (2 * R) :=
      ih t ht (by omega) h_sub
    have h_2R1 : RowAgree t (m * P) (t - (R + 1)) (2 * R + 1) := by
      intro i hi
      rcases Nat.eq_zero_or_pos i with rfl | hpos
      · exact hright 0 (by omega)
      · obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
        have hj := h_symm_R j (by omega)
        rwa [show (t - R) + j = (t - (R + 1)) + (j + 1) by omega] at hj
    have h_step_bit :
        (row ((t + 1) + m * P)).testBit ((t - (R + 1)) + 2 * R + 2 + m * P) =
          (row (t + 1)).testBit ((t - (R + 1)) + 2 * R + 2) := by
      rcases Nat.eq_zero_or_pos R with rfl | hRpos
      · have hc := periodic_rowAgree_center T P hP hper m (t + 1) (by omega) 0 (by omega)
        simpa [show (t - 1) + 2 = t + 1 by omega] using hc
      · have h_2R1' : RowAgree t (m * P) (t - (R + 1)) ((2 * R - 1) + 2) := by
          intro i hi
          exact h_2R1 i (by omega)
        have h_step := rowAgree_step t (m * P) (t - (R + 1)) (2 * R - 1) h_2R1'
        have h_next_right : RowAgree (t + 1) (m * P) ((t + 1) - R) R :=
          rowAgree_mono (t + 1) (m * P) ((t - (R + 1)) + 2) (2 * R - 1) ((t + 1) - R) R
            (by omega) (by omega) h_step
        have h_next_symm : RowAgree (t + 1) (m * P) ((t + 1) - R) (2 * R) :=
          ih (t + 1) (by omega) (by omega) h_next_right
        have h_end := h_next_symm (2 * R) (by omega)
        rwa [show ((t + 1) - R) + 2 * R = (t - (R + 1)) + 2 * R + 2 by omega] at h_end
    have h_ext := rowAgree_extend_right t (m * P) (t - (R + 1)) (2 * R) h_2R1 h_step_bit
    simpa [Nat.mul_succ, Nat.add_assoc] using h_ext

/-- **Symmetric Doubling of Right-Half `RowAgree` at `Q = lcm(P, 2^k)` (`periodic_rowAgree_lcmPeriod_symm_of_right`)**:
    under `CenterPeriodic T P` (`0 < P`), for every scale `k`, time `t ≥ T`, and radius `R ≤ t`, one-sided right-wing agreement `RowAgree t (lcmPeriod P k) (t - R) R` implies full two-sided symmetric agreement `RowAgree t (lcmPeriod P k) (t - R) (2 * R)`. -/
theorem periodic_rowAgree_lcmPeriod_symm_of_right
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k R t : Nat) (ht : T ≤ t) (hR : R ≤ t)
    (hright : RowAgree t (lcmPeriod P k) (t - R) R) :
    RowAgree t (lcmPeriod P k) (t - R) (2 * R) := by
  rw [lcmPeriod_eq_mul_period P k] at hright ⊢
  exact periodic_rowAgree_symm_of_right T P hP hper (twopow k / Nat.gcd P (twopow k)) R t ht hR hright

/-- Paper-facing predicate `SectorRightRowAgree k d U Q`: at all sector times `(d + u * 2^k) + 1` (`u ≥ U`), the one-sided right-wing neighbourhood of width `2^k + 1` (`[((d + u * 2^k) + 1) - (2^k + 1), (d + u * 2^k) + 1]`, columns `x ∈ [0, 2^k + 1]`) agrees between `t` and `t + Q`. -/
def SectorRightRowAgree (k d U Q : Nat) : Prop :=
  ∀ u, U ≤ u →
    RowAgree ((d + u * twopow k) + 1) Q
      (((d + u * twopow k) + 1) - (twopow k + 1)) (twopow k + 1)

/-- **Carrying One-Sided Right Sector Agreement to Every Residue `mod 2^k` (`colNegOnePeriodic_of_sector_right_rowAgree`)**:
    under `CenterPeriodic T P` (`0 < P`), if `SectorRightRowAgree k d U (m * P)` holds (`1 ≤ U`, `1 ≤ d`, `T ≤ d + U * 2^k`), then symmetric doubling across the periodic center yields `SectorRowAgree k d U (m * P)` and hence `ColNegOnePeriodic (d + U * 2^k) (m * P)` across all residues `mod 2^k`! -/
theorem colNegOnePeriodic_of_sector_right_rowAgree
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U m : Nat) (hU : 1 ≤ U) (hd : 1 ≤ d) (ht : T ≤ d + U * twopow k)
    (hsec : SectorRightRowAgree k d U (m * P)) :
    ColNegOnePeriodic (d + U * twopow k) (m * P) := by
  refine colNegOnePeriodic_of_sector_rowAgree k d U (m * P) hU (fun u hu => ?_)
  have h1 : 1 * twopow k ≤ u * twopow k := Nat.mul_le_mul_right (twopow k) (by omega)
  have hU_le : U * twopow k ≤ u * twopow k := Nat.mul_le_mul_right (twopow k) hu
  have hright := hsec u hu
  have hsymm := periodic_rowAgree_symm_of_right T P hP hper m (twopow k + 1)
    ((d + u * twopow k) + 1) (by omega) (by omega) hright
  exact rowAgree_mono ((d + u * twopow k) + 1) (m * P)
    (((d + u * twopow k) + 1) - (twopow k + 1)) (2 * (twopow k + 1))
    (((d + u * twopow k) + 2) - twopow k) (2 * twopow k)
    (by omega) (by omega) hsymm

/-- **Refutation of One-Sided Right Sector Agreement at `Q = lcm(P, 2^k)` (`not_sector_right_rowAgree_lcmPeriod`)**:
    under `CenterPeriodic T P` (`0 < P`), for `1 ≤ U`, `1 ≤ d`, and `T ≤ d + U * 2^k`, `SectorRightRowAgree k d U (lcmPeriod P k)` is false! -/
theorem not_sector_right_rowAgree_lcmPeriod
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U : Nat) (hU : 1 ≤ U) (hd : 1 ≤ d) (ht : T ≤ d + U * twopow k) :
    ¬ SectorRightRowAgree k d U (lcmPeriod P k) := by
  intro hsec
  rw [lcmPeriod_eq_mul_period P k] at hsec
  have hcol := colNegOnePeriodic_of_sector_right_rowAgree T P hP hper
    k d U (twopow k / Nat.gcd P (twopow k)) hU hd ht hsec
  exact not_periodic_colm1_mul T P hP hper (d + U * twopow k)
    (twopow k / Nat.gcd P (twopow k)) (lcmPeriod_div_pos P k hP) hcol

/-- **1-Cell Leftward Spatial Extension of `WinWittAgree` via Theorem 9.204 (`winWittAgree_extend_right`)**:
    for `2^(k+1) ≤ a`, if `WinWittAgree t k Q a (L + 1)` and the three-sector `RowAgree` hold on width `L + 1` at time `t`, and bit `a + L + 2` of `winWitt · (2^k)` agrees at time `t + 1`, then Theorem 9.204 (`winWitt_step_frobDefect_testBit_succ`) forces bit `a + L + 2` of `winWitt · (2^k)` to agree at time `t`, establishing `WinWittAgree t k Q a (L + 2)`! -/
theorem winWittAgree_extend_right (t k Q a L : Nat)
    (ha : twopow (k + 1) ≤ a)
    (hw : WinWittAgree t k Q a (L + 1))
    (h0 : RowAgree t Q (a - twopow (k + 1)) (L + 1))
    (h1 : RowAgree t Q (a - twopow k) (L + 1))
    (h2 : RowAgree t Q a (L + 1))
    (hstep : (winWitt ((t + 1) + Q) (twopow k)).testBit (a + L + 2 + Q) =
      (winWitt (t + 1) (twopow k)).testBit (a + L + 2)) :
    WinWittAgree t k Q a (L + 2) := by
  intro i hi
  rcases Nat.lt_or_eq_of_le hi with hlt | rfl
  · exact hw i (by omega)
  · have hw0 := hw L (by omega)
    have hw1 := hw (L + 1) (by omega)
    have hcc := crossCarry_testBit_eq_of_rowAgree_winWittAgree t k Q a L L ha (by omega) hw h0 h1 h2
    have hfd := frobDefect_row_testBit_eq_of_rowAgree t k Q a L L ha (by omega) h0 h1 h2
    have hs_Q := winWitt_step_frobDefect_testBit_succ (t + Q) k (a + L + 1 + Q)
    have hs_0 := winWitt_step_frobDefect_testBit_succ t k (a + L + 1)
    rw [show a + (L + 1) + Q = a + L + 1 + Q by omega] at hw1
    rw [show a + (L + 1) = a + L + 1 by omega] at hw1
    rw [show (t + Q) + 1 = (t + 1) + Q by omega,
      show (a + L + 1 + Q) + 1 = (a + L + Q) + 2 by omega,
      phi_testBit_add_two (winWitt (t + Q) (twopow k)) (a + L + Q),
      show (a + L + Q) + 2 = a + L + 2 + Q by omega,
      show (a + L + Q) + 1 = a + L + 1 + Q by omega] at hs_Q
    rw [show (a + L + 1) + 1 = (a + L) + 2 by omega,
      phi_testBit_add_two (winWitt t (twopow k)) (a + L),
      show (a + L) + 2 = a + L + 2 by omega] at hs_0
    rw [hs_Q, hs_0, hcc, hfd, hw1, hw0] at hstep
    rw [show a + (L + 2) + Q = a + L + 2 + Q by omega,
      show a + (L + 2) = a + L + 2 by omega]
    revert hstep
    simp only [bxor_eq_xor]
    cases (winWitt (t + Q) (twopow k)).testBit (a + L + 2 + Q) <;>
      cases (winWitt t (twopow k)).testBit (a + L + 2) <;>
      cases ((winWitt t (twopow k)).testBit (a + L + 1) || (winWitt t (twopow k)).testBit (a + L)) <;>
      cases (crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit (a + L + 1) <;>
      cases (frobDefect k (row t)).testBit (a + L + 1) <;> decide

/-- **Equivalence of `WinWittAgree` and Late `RowAgree` under Three-Sector `RowAgree` (`winWittAgree_of_rowAgree_three_and_late`)**:
    for `2^(k+1) ≤ a`, if the three-sector `RowAgree` holds at time `t` and `RowAgree (t + 2^k) Q a L` holds at time `t + 2^k`, then `WinWittAgree t k Q a L` holds at time `t`. -/
theorem winWittAgree_of_rowAgree_three_and_late (t k Q a L : Nat)
    (ha : twopow (k + 1) ≤ a)
    (h0 : RowAgree t Q (a - twopow (k + 1)) L)
    (h1 : RowAgree t Q (a - twopow k) L)
    (h2 : RowAgree t Q a L)
    (hlate : RowAgree (t + twopow k) Q a L) :
    WinWittAgree t k Q a L := by
  intro i hi
  have hphi := phiScale_row_testBit_eq_of_rowAgree t k Q a L i ha hi h0 h1 h2
  have hrow := hlate i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega] at hrow
  have hw_Q : (winWitt (t + Q) (twopow k)).testBit (a + i + Q) =
      bxor ((row ((t + Q) + twopow k)).testBit (a + i + Q))
        ((phiScale k (row (t + Q))).testBit (a + i + Q)) := by
    have hsc := congrArg (fun n => n.testBit (a + i + Q)) (row_scale (t + Q) k)
    rw [Nat.testBit_xor] at hsc
    revert hsc
    simp only [bxor_eq_xor]
    cases (row ((t + Q) + twopow k)).testBit (a + i + Q) <;>
      cases (phiScale k (row (t + Q))).testBit (a + i + Q) <;>
      cases (winWitt (t + Q) (twopow k)).testBit (a + i + Q) <;> decide
  have hw_0 : (winWitt t (twopow k)).testBit (a + i) =
      bxor ((row (t + twopow k)).testBit (a + i))
        ((phiScale k (row t)).testBit (a + i)) := by
    have hsc := congrArg (fun n => n.testBit (a + i)) (row_scale t k)
    rw [Nat.testBit_xor] at hsc
    revert hsc
    simp only [bxor_eq_xor]
    cases (row (t + twopow k)).testBit (a + i) <;>
      cases (phiScale k (row t)).testBit (a + i) <;>
      cases (winWitt t (twopow k)).testBit (a + i) <;> decide
  rw [hw_Q, hw_0, hrow, hphi]

/-- **Converse Equivalence (`rowAgree_late_of_winWittAgree_and_three`)**:
    for `2^(k+1) ≤ a`, if the three-sector `RowAgree` and `WinWittAgree t k Q a L` hold at time `t`, then `RowAgree (t + 2^k) Q a L` holds at the late time `t + 2^k`. -/
theorem rowAgree_late_of_winWittAgree_and_three (t k Q a L : Nat)
    (ha : twopow (k + 1) ≤ a)
    (hw : WinWittAgree t k Q a L)
    (h0 : RowAgree t Q (a - twopow (k + 1)) L)
    (h1 : RowAgree t Q (a - twopow k) L)
    (h2 : RowAgree t Q a L) :
    RowAgree (t + twopow k) Q a L := by
  intro i hi
  have hphi := phiScale_row_testBit_eq_of_rowAgree t k Q a L i ha hi h0 h1 h2
  have hwi := hw i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    row_scale (t + Q) k, row_scale t k,
    Nat.testBit_xor, Nat.testBit_xor, hphi, hwi]

/-- Paper-facing predicate `SectorWinWittAgree k d U Q`: at all sector times `t_u = d + u * 2^k` (`u ≥ U`), `WinWittAgree` and the three-sector `RowAgree` hold on the radius-`2^k` neighbourhood (`width = 2 * 2^k`) around the center slot `t_u + 2^k`. -/
def SectorWinWittAgree (k d U Q : Nat) : Prop :=
  ∀ u, U ≤ u →
    WinWittAgree (d + u * twopow k) k Q (((d + u * twopow k) + twopow k) - twopow k) (2 * twopow k) ∧
    RowAgree (d + u * twopow k) Q ((((d + u * twopow k) + twopow k) - twopow k) - twopow (k + 1)) (2 * twopow k) ∧
    RowAgree (d + u * twopow k) Q ((((d + u * twopow k) + twopow k) - twopow k) - twopow k) (2 * twopow k) ∧
    RowAgree (d + u * twopow k) Q (((d + u * twopow k) + twopow k) - twopow k) (2 * twopow k)

/-- **Carrying `wittRespBool` `Q`-Periodicity from Sector Times Across Every Residue `mod 2^k` via Window Step 9.204 (`wittRespBool_periodic_of_sector_winWittAgree`)**:
    if `SectorWinWittAgree k d U Q` holds (`2 ≤ U`), then advancing by `s = (t - (d + U * 2^k)) % 2^k < 2^k` steps of the window step 9.204 (`wittRespBool_eq_of_winWittAgree_steps`) carries `wittRespBool (t + Q) k = wittRespBool t k` to EVERY residue `mod 2^k` (`∀ t ≥ d + U * 2^k`)! -/
theorem wittRespBool_periodic_of_sector_winWittAgree (k d U Q : Nat) (hU : 2 ≤ U)
    (hsec : SectorWinWittAgree k d U Q) :
    ∀ t, d + U * twopow k ≤ t → wittRespBool (t + Q) k = wittRespBool t k := by
  intro t ht
  have hpos : 0 < twopow k := by
    have := twopow_gt_self k
    omega
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  obtain ⟨delta, hdelta⟩ : ∃ delta, t = (d + U * twopow k) + delta := ⟨t - (d + U * twopow k), by omega⟩
  obtain ⟨q, s, hdiv, hs_lt⟩ : ∃ q s, delta = q * twopow k + s ∧ s < twopow k :=
    ⟨delta / twopow k, delta % twopow k,
      by rw [Nat.mul_comm, Nat.div_add_mod],
      Nat.mod_lt delta hpos⟩
  have hu : U ≤ U + q := by omega
  let t0 := d + (U + q) * twopow k
  have ht0_eq : t = t0 + s := by
    dsimp [t0]
    rw [Nat.add_mul]
    omega
  have h2_le : 2 * twopow k ≤ (U + q) * twopow k := Nat.mul_le_mul_right (twopow k) (by omega)
  have ht0_bound : twopow k + s ≤ t0 := by
    dsimp [t0]
    omega
  obtain ⟨hw, h0, h1, h2⟩ := hsec (U + q) hu
  have hw_sub : WinWittAgree t0 k Q ((t0 + twopow k) - s) (2 * s) :=
    winWittAgree_mono t0 k Q ((t0 + twopow k) - twopow k) (2 * twopow k)
      ((t0 + twopow k) - s) (2 * s) (by omega) (by omega) hw
  have h0_sub : RowAgree t0 Q (((t0 + twopow k) - s) - twopow (k + 1)) (2 * s) :=
    rowAgree_mono t0 Q (((t0 + twopow k) - twopow k) - twopow (k + 1)) (2 * twopow k)
      (((t0 + twopow k) - s) - twopow (k + 1)) (2 * s) (by omega) (by omega) h0
  have h1_sub : RowAgree t0 Q (((t0 + twopow k) - s) - twopow k) (2 * s) :=
    rowAgree_mono t0 Q (((t0 + twopow k) - twopow k) - twopow k) (2 * twopow k)
      (((t0 + twopow k) - s) - twopow k) (2 * s) (by omega) (by omega) h1
  have h2_sub : RowAgree t0 Q ((t0 + twopow k) - s) (2 * s) :=
    rowAgree_mono t0 Q ((t0 + twopow k) - twopow k) (2 * twopow k)
      ((t0 + twopow k) - s) (2 * s) (by omega) (by omega) h2
  have hresp := wittRespBool_eq_of_winWittAgree_steps t0 k Q s ht0_bound hw_sub h0_sub h1_sub h2_sub
  rwa [← ht0_eq] at hresp

/-- **Right-Boundary Row Neighbourhood `Q`-Invariance at `Q = lcm(P, 2^k)` (`right_boundary_row_lcmPeriod_eq`)**:
    for every `P, k, j, t : Nat` with `j ≤ k`, bit `j` of `row (t + lcmPeriod P k)` equals bit `j` of `row t`. -/
theorem right_boundary_row_lcmPeriod_eq (P k j t : Nat) (hj : j ≤ k) :
    (row (t + lcmPeriod P k)).testBit j = (row t).testBit j := by
  rw [row_testBit, row_testBit]
  exact rdiag_lcmPeriod_eq P k j t hj

/-- **Left-Boundary Settled Row Neighbourhood `Q`-Invariance at `Q = lcm(P, 2^k)` (`left_boundary_row_lcmPeriod_eq`)**:
    for every `P, k, j, t : Nat` with `j ≤ k`, `j ≤ t`, and `settle j ≤ t`, bit `2 * (t + lcmPeriod P k) - j` of `row (t + lcmPeriod P k)` equals bit `2 * t - j` of `row t`. -/
theorem left_boundary_row_lcmPeriod_eq (P k j t : Nat)
    (hj : j ≤ k) (hjt : j ≤ t) (hset : settle j ≤ t) :
    (row (t + lcmPeriod P k)).testBit (2 * (t + lcmPeriod P k) - j) =
      (row t).testBit (2 * t - j) := by
  have h1 : (row (t + lcmPeriod P k)).testBit (2 * (t + lcmPeriod P k) - j) =
      ldiag j (t + lcmPeriod P k) := by
    have hd := ldiag_eq_rdiag j ((t + lcmPeriod P k) - j)
    rw [show j + ((t + lcmPeriod P k) - j) = t + lcmPeriod P k by omega,
      show j + 2 * ((t + lcmPeriod P k) - j) = 2 * (t + lcmPeriod P k) - j by omega,
      ← row_testBit (t + lcmPeriod P k) (2 * (t + lcmPeriod P k) - j)] at hd
    exact hd.symm
  have h2 : (row t).testBit (2 * t - j) = ldiag j t := by
    have hd := ldiag_eq_rdiag j (t - j)
    rw [show j + (t - j) = t by omega,
      show j + 2 * (t - j) = 2 * t - j by omega,
      ← row_testBit t (2 * t - j)] at hd
    exact hd.symm
  rw [h1, h2]
  exact ldiag_lcmPeriod_eq P k j t hj hset

/-- **Sector-1 `frobDefect` `Q`-Difference Factored by `Q = lcm(P, 2^k)` at Sector Times (`frobDefect_row_sector_one_lcmPeriod_xor`)**:
    for `d + 1 ≤ k` and every sector time `t_u = (d + 1) + u * 2^k`, because `2^k ∣ lcmPeriod P k`, both `t_u` and `t_u + lcmPeriod P k` share the exact same Sector-0 boundary bits `center (d + 1)` and `rdiag d (d + 1)`, so their Sector-1 `frobDefect` difference factors cleanly! -/
theorem frobDefect_row_sector_one_lcmPeriod_xor (P d k u : Nat) (hk : d + 1 ≤ k) :
    bxor
      ((frobDefect k (row (((d + 1) + u * twopow k) + lcmPeriod P k))).testBit ((d + 1) + twopow k))
      ((frobDefect k (row ((d + 1) + u * twopow k))).testBit ((d + 1) + twopow k)) =
      bxor
        (bxor
          (rdiag ((d + 1) + twopow k) (((d + 1) + u * twopow k) + lcmPeriod P k))
          (rdiag ((d + 1) + twopow k) ((d + 1) + u * twopow k)) && rdiag d (d + 1))
        (Rule30UOR.Core.center (d + 1) &&
          bxor
            (rdiag (d + twopow k) (((d + 1) + u * twopow k) + lcmPeriod P k))
            (rdiag (d + twopow k) ((d + 1) + u * twopow k))) := by
  have hQ : ((d + 1) + u * twopow k) + lcmPeriod P k =
      (d + 1) + (u + P / Nat.gcd P (twopow k)) * twopow k := by
    rw [lcmPeriod_eq_mul_twopow, Nat.add_mul, Nat.add_assoc]
  rw [hQ,
    frobDefect_row_sector_one_restart d k (u + P / Nat.gcd P (twopow k)) hk,
    frobDefect_row_sector_one_restart d k u hk]
  simp only [bxor_eq_xor]
  cases rdiag ((d + 1) + twopow k) ((d + 1) + (u + P / Nat.gcd P (twopow k)) * twopow k) <;>
    cases rdiag ((d + 1) + twopow k) ((d + 1) + u * twopow k) <;>
    cases rdiag d (d + 1) <;>
    cases Rule30UOR.Core.center (d + 1) <;>
    cases rdiag (d + twopow k) ((d + 1) + (u + P / Nat.gcd P (twopow k)) * twopow k) <;>
    cases rdiag (d + twopow k) ((d + 1) + u * twopow k) <;> rfl

theorem rowAgree_extend_right_prop (t Q a L : Nat)
    (h : RowAgree t Q a (L + 1))
    (hstep : wittBitBool (row ((t + 1) + Q)) (a + L + 2 + Q) =
      wittBitBool (row (t + 1)) (a + L + 2)) :
    RowAgree t Q a (L + 2) :=
  rowAgree_extend_right t Q a L h hstep

theorem winWittAgree_extend_right_prop (t k Q a L : Nat)
    (ha : twopow (k + 1) ≤ a)
    (hw : WinWittAgree t k Q a (L + 1))
    (h0 : RowAgree t Q (a - twopow (k + 1)) (L + 1))
    (h1 : RowAgree t Q (a - twopow k) (L + 1))
    (h2 : RowAgree t Q a (L + 1))
    (hstep : wittBitBool (winWitt ((t + 1) + Q) (twopow k)) (a + L + 2 + Q) =
      wittBitBool (winWitt (t + 1) (twopow k)) (a + L + 2)) :
    WinWittAgree t k Q a (L + 2) :=
  winWittAgree_extend_right t k Q a L ha hw h0 h1 h2 hstep

theorem right_boundary_row_lcmPeriod_eq_prop (P k j t : Nat) (hj : j ≤ k) :
    wittBitBool (row (t + lcmPeriod P k)) j = wittBitBool (row t) j :=
  right_boundary_row_lcmPeriod_eq P k j t hj

theorem left_boundary_row_lcmPeriod_eq_prop (P k j t : Nat)
    (hj : j ≤ k) (hjt : j ≤ t) (hset : SettledBy j t) :
    wittBitBool (row (t + lcmPeriod P k)) (2 * (t + lcmPeriod P k) - j) =
      wittBitBool (row t) (2 * t - j) :=
  left_boundary_row_lcmPeriod_eq P k j t hj hjt hset

theorem frobDefect_row_sector_one_lcmPeriod_xor_prop (P d k u : Nat) (hk : d + 1 ≤ k) :
    bxor
      (wittBitBool (frobDefect k (row (((d + 1) + u * twopow k) + lcmPeriod P k))) ((d + 1) + twopow k))
      (wittBitBool (frobDefect k (row ((d + 1) + u * twopow k))) ((d + 1) + twopow k)) =
      bxor
        (bxor
          (rdiag ((d + 1) + twopow k) (((d + 1) + u * twopow k) + lcmPeriod P k))
          (rdiag ((d + 1) + twopow k) ((d + 1) + u * twopow k)) && rdiag d (d + 1))
        (Rule30UOR.Core.center (d + 1) &&
          bxor
            (rdiag (d + twopow k) (((d + 1) + u * twopow k) + lcmPeriod P k))
            (rdiag (d + twopow k) ((d + 1) + u * twopow k))) :=
  frobDefect_row_sector_one_lcmPeriod_xor P d k u hk

/-! ### The Driven Right Half `rhCenter`, the `Φ` Fixed-Point Law from §6 (`Rule30UOR.Fixed`), Inward Right-Half Agreement (`RhBandAgree`), and Window-Step 9.204 Sector Refutations -/

/-- Paper-facing readout of the driven right half `Rh center` at time `t` and non-negative column `p`:
    `rhCenter t p = Rule30UOR.Fixed.Rh Rule30Prize.center t (p : Int)`. -/
def rhCenter (t p : Nat) : Bool :=
  Rule30UOR.Fixed.Rh Ruliology.CellularAutomata.Rule30Prize.center t (p : Int)

/-- Paper-facing readout of the driven left half `Lh center` at time `t` and non-positive column `-p`:
    `lhCenter t p = Rule30UOR.Fixed.Lh Rule30Prize.center t (- (p : Int))`. -/
def lhCenter (t p : Nat) : Bool :=
  Rule30UOR.Fixed.Lh Ruliology.CellularAutomata.Rule30Prize.center t (- (p : Int))

/-- Band `Q`-agreement of the driven right half `rhCenter`: at time `t` and `t + Q`, `rhCenter` agrees on columns `[p0, p0 + L]`. -/
def RhBandAgree (t Q p0 L : Nat) : Prop :=
  ∀ i, i ≤ L → rhCenter (t + Q) (p0 + i) = rhCenter t (p0 + i)

/-- **Exact Identity Between the Driven Right Half `rhCenter` and `rdiag` (`rhCenter_eq_rdiag`)**:
    for all `t, p : Nat` with `p ≤ t`, column `p` of the driven right half `rhCenter t p` equals right diagonal `rdiag (t - p) t`. -/
theorem rhCenter_eq_rdiag (t p : Nat) (hp : p ≤ t) :
    rhCenter t p = rdiag (t - p) t := by
  unfold rhCenter
  rw [Rule30UOR.Fixed.Rh_center t (p : Int) (by omega),
    Rule30UOR.Right.rdiag_eq_R]
  unfold Ruliology.CellularAutomata.Rule30Diagonals.R
  exact congrArg (Ruliology.CellularAutomata.Rule30Jen.cell t) (by omega)

/-- **Exact Identity Between `rhCenter` and `row` Bit Readout (`rhCenter_eq_row_testBit`)**:
    for all `t, p : Nat` with `p ≤ t`, `rhCenter t p = (row t).testBit (t - p)`. -/
theorem rhCenter_eq_row_testBit (t p : Nat) (hp : p ≤ t) :
    rhCenter t p = (row t).testBit (t - p) := by
  rw [row_testBit, rhCenter_eq_rdiag t p hp]

/-- **Exact Identity Between the Driven Left Half `lhCenter` and `ldiag` (`lhCenter_eq_ldiag`)**:
    for all `t, p : Nat` with `p ≤ t`, column `-p` of the driven left half `lhCenter t p` equals left diagonal `ldiag (t - p) t`. -/
theorem lhCenter_eq_ldiag (t p : Nat) (hp : p ≤ t) :
    lhCenter t p = ldiag (t - p) t := by
  unfold lhCenter
  rw [Rule30UOR.Fixed.Lh_center t (- (p : Int)) (by omega)]
  have h0 := ldiag_eq_cell_neg (t - p) p
  rw [show t - p + p = t by omega, Rule30UOR.Scale.cell_eq_kit] at h0
  exact h0.symm

/-- **Exact Identity Between `lhCenter` and `row` Bit Readout (`lhCenter_eq_row_testBit`)**:
    for all `t, p : Nat` with `p ≤ t`, `lhCenter t p = (row t).testBit (t + p)`. -/
theorem lhCenter_eq_row_testBit (t p : Nat) (hp : p ≤ t) :
    lhCenter t p = (row t).testBit (t + p) := by
  have hd := ldiag_eq_rdiag (t - p) p
  rw [show t - p + p = t by omega,
    show t - p + 2 * p = t + p by omega] at hd
  rw [lhCenter_eq_ldiag t p hp, row_testBit, hd]

/-- **Boundary Readouts of `rhCenter` (`rhCenter_zero_eq_center`, `rhCenter_self_eq_true`, `rhCenter_gt_eq_false`)**:
    at `p = 0`, `rhCenter t 0 = center t`; at the right edge `p = t`, `rhCenter t t = true`; and outside the light cone (`t < p`), `rhCenter t p = false`. -/
theorem rhCenter_zero_eq_center (t : Nat) :
    rhCenter t 0 = Rule30UOR.Core.center t := by
  rw [rhCenter_eq_rdiag t 0 (by omega), Nat.sub_zero, core_center_eq_rcenter]
  rfl

theorem rhCenter_self_eq_true (t : Nat) :
    rhCenter t t = true := by
  rw [rhCenter_eq_rdiag t t (by omega), Nat.sub_self]
  rcases t with _ | t <;> rfl

theorem rhCenter_gt_eq_false (t p : Nat) (h : t < p) :
    rhCenter t p = false := by
  unfold rhCenter
  induction t generalizing p with
  | zero =>
    simp [Rule30UOR.Fixed.Rh]
    omega
  | succ t ih =>
    rcases p with _ | p
    · omega
    · have hpos : (0 : Int) < ((p + 1 : Nat) : Int) := by omega
      simp only [Rule30UOR.Fixed.Rh, if_pos hpos, Ruliology.CellularAutomata.Rule30Jen.rule]
      rw [show ((p + 1 : Nat) : Int) - 1 = (p : Int) by omega,
        show ((p + 1 : Nat) : Int) + 1 = ((p + 2 : Nat) : Int) by omega,
        ih p (by omega), ih (p + 1) (by omega), ih (p + 2) (by omega)]
      rfl

/-- **Structural Unfolding of the §6 `Φ` Recombination Operator (`phiCenter_eq_lhCenter_rhCenter`)**:
    for every `t : Nat`, `phiCenter t` is the Rule 30 recombination `bxor (lhCenter t 1) (center t || rhCenter t 1)` of the driven left half at `-1`, the center at `0`, and the driven right half at `+1`. -/
theorem phiCenter_eq_lhCenter_rhCenter (t : Nat) :
    Rule30UOR.Fixed.phiCenter t =
      bxor (lhCenter t 1) (Rule30UOR.Core.center t || rhCenter t 1) := by
  unfold Rule30UOR.Fixed.phiCenter Rule30UOR.Fixed.Phi lhCenter rhCenter Ruliology.CellularAutomata.Rule30Jen.rule
  rw [← Rule30UOR.Scale.center_eq_kit t, bxor_eq_xor]
  rfl

/-- **The §6 `Φ` Fixed-Point Law Solved for the Left-Half Neighbour (`lhCenter_one_eq_of_center_fixed`)**:
    combining `center (t + 1) = phiCenter t` (`Rule30UOR.Fixed.center_fixed_readout`) with `phiCenter_eq_lhCenter_rhCenter` expresses `lhCenter t 1` directly in terms of `center (t + 1)`, `center t`, and `rhCenter t 1`! -/
theorem lhCenter_one_eq_of_center_fixed (t : Nat) :
    lhCenter t 1 =
      bxor (Rule30UOR.Core.center (t + 1))
        (Rule30UOR.Core.center t || rhCenter t 1) := by
  have hfix := Rule30UOR.Fixed.center_fixed_readout t
  rw [← Rule30UOR.Scale.center_eq_kit (t + 1), phiCenter_eq_lhCenter_rhCenter t] at hfix
  rw [hfix, bxor_eq_xor, bxor_eq_xor]
  cases lhCenter t 1 <;>
    cases (Rule30UOR.Core.center t || rhCenter t 1) <;> rfl

/-- **Period-Shift Defect of the §6 `Φ` Fixed-Point Law (`periodic_lhCenter_one_defect_eq_not_center_and_rhCenter_one_defect`)**:
    under `CenterPeriodic T P` (`0 < P`), for every multiple `m` and `t ≥ T`, the `Φ` fixed-point law `center (t + 1) = phiCenter t` equates the `m * P`-defect of `lhCenter · 1` with `!center t && (rhCenter (t + m * P) 1 ⊕ rhCenter t 1)`! -/
theorem periodic_lhCenter_one_defect_eq_not_center_and_rhCenter_one_defect
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t : Nat) (ht : T ≤ t) :
    bxor (lhCenter (t + m * P) 1) (lhCenter t 1) =
      (!Rule30UOR.Core.center t &&
        bxor (rhCenter (t + m * P) 1) (rhCenter t 1)) := by
  have hc0 : Rule30UOR.Core.center (t + m * P) = Rule30UOR.Core.center t :=
    Rule30UOR.Scale.center_mul hper m t ht
  have hc1 : Rule30UOR.Core.center ((t + m * P) + 1) = Rule30UOR.Core.center (t + 1) := by
    rw [show (t + m * P) + 1 = (t + 1) + m * P by omega]
    exact Rule30UOR.Scale.center_mul hper m (t + 1) (by omega)
  rw [lhCenter_one_eq_of_center_fixed (t + m * P),
    lhCenter_one_eq_of_center_fixed t,
    hc0, hc1]
  simp only [bxor_eq_xor]
  cases Rule30UOR.Core.center (t + 1) <;>
    cases Rule30UOR.Core.center t <;>
    cases rhCenter (t + m * P) 1 <;>
    cases rhCenter t 1 <;> rfl

/-- **Evolution Law of the Driven Right Half `rhCenter` (`rhCenter_step_succ`)**:
    for all `t, p : Nat`, column `p + 1 > 0` of `rhCenter (t + 1)` evolves by Rule 30 from columns `p, p + 1, p + 2` of `rhCenter t`. -/
theorem rhCenter_step_succ (t p : Nat) :
    rhCenter (t + 1) (p + 1) =
      bxor (rhCenter t p) (rhCenter t (p + 1) || rhCenter t (p + 2)) := by
  unfold rhCenter
  have hpos : (0 : Int) < ((p + 1 : Nat) : Int) := by omega
  simp only [Rule30UOR.Fixed.Rh, if_pos hpos]
  rw [show ((p + 1 : Nat) : Int) - 1 = (p : Int) by omega,
    show ((p + 1 : Nat) : Int) + 1 = ((p + 2 : Nat) : Int) by omega]
  unfold Ruliology.CellularAutomata.Rule30Jen.rule
  rw [bxor_eq_xor]

/-- **Inward Step Law of the Driven Right Half from the Right Edge Toward Column 1 (`rhCenter_inward_step`)**:
    for all `t, p : Nat`, solving `rhCenter_step_succ` for `rhCenter t p` expresses column `p` at time `t` in terms of columns `p + 1, p + 2` (further toward the right edge) at time `t` and column `p + 1` at time `t + 1`! -/
theorem rhCenter_inward_step (t p : Nat) :
    rhCenter t p =
      bxor (rhCenter (t + 1) (p + 1))
        (rhCenter t (p + 1) || rhCenter t (p + 2)) := by
  rw [rhCenter_step_succ t p, bxor_eq_xor, bxor_eq_xor]
  cases rhCenter t p <;>
    cases (rhCenter t (p + 1) || rhCenter t (p + 2)) <;> rfl

/-- **1-Column Inward Extension of `RhBandAgree` Toward Column 1 (`rhBandAgree_extend_inward`)**:
    if `RhBandAgree t Q (p0 + 1) (L + 1)` holds on columns `[p0 + 1, p0 + L + 2]` at time `t`, and column `p0 + 1` agrees at time `t + 1`, then `rhCenter_inward_step` forces column `p0` to agree at time `t`, establishing `RhBandAgree t Q p0 (L + 2)`! -/
theorem rhBandAgree_extend_inward (t Q p0 L : Nat)
    (h : RhBandAgree t Q (p0 + 1) (L + 1))
    (hstep : rhCenter ((t + 1) + Q) (p0 + 1) = rhCenter (t + 1) (p0 + 1)) :
    RhBandAgree t Q p0 (L + 2) := by
  intro i hi
  rcases Nat.eq_zero_or_pos i with rfl | hpos
  · have h1 := h 0 (by omega)
    have h2 := h 1 (by omega)
    rw [Nat.add_zero,
      rhCenter_inward_step (t + Q) p0,
      rhCenter_inward_step t p0,
      show (t + Q) + 1 = (t + 1) + Q by omega,
      show p0 + 1 = (p0 + 1) + 0 by omega,
      show p0 + 2 = (p0 + 1) + 1 by omega]
    rw [show (p0 + 1) + 0 = p0 + 1 by omega] at h1 ⊢
    rw [hstep, h1, h2]
  · obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
    have hj := h j (by omega)
    rwa [show p0 + (j + 1) = (p0 + 1) + j by omega]

/-- **One-Step Forward Propagation of `RhBandAgree` (`rhBandAgree_step`)**:
    each step `t ↦ t + 1` in the driven right half carries `RhBandAgree t Q p0 (L + 2)` on `[p0, p0 + L + 2]` to `RhBandAgree (t + 1) Q (p0 + 1) L` on `[p0 + 1, p0 + 1 + L]`. -/
theorem rhBandAgree_step (t Q p0 L : Nat)
    (h : RhBandAgree t Q p0 (L + 2)) :
    RhBandAgree (t + 1) Q (p0 + 1) L := by
  intro i hi
  have h0 := h i (by omega)
  have h1 := h (i + 1) (by omega)
  have h2 := h (i + 2) (by omega)
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    show (p0 + 1) + i = (p0 + i) + 1 by omega,
    rhCenter_step_succ (t + Q) (p0 + i),
    rhCenter_step_succ t (p0 + i),
    show (p0 + i) + 1 = p0 + (i + 1) by omega,
    show (p0 + i) + 2 = p0 + (i + 2) by omega,
    h0, h1, h2]

/-- **Equivalence of Right-Half `RhBandAgree` and `RowAgree` (`rowAgree_right_of_rhBandAgree`)**:
    for `p0 + L ≤ t`, `RhBandAgree t Q p0 L` on columns `[p0, p0 + L]` in the driven right half implies `RowAgree t Q (t - (p0 + L)) L` on `[t - (p0 + L), t - p0]`. -/
theorem rowAgree_right_of_rhBandAgree (t Q p0 L : Nat)
    (hp : p0 + L ≤ t) (h : RhBandAgree t Q p0 L) :
    RowAgree t Q (t - (p0 + L)) L := by
  intro i hi
  have hrh := h (L - i) (by omega)
  rw [rhCenter_eq_row_testBit (t + Q) (p0 + (L - i)) (by omega),
    rhCenter_eq_row_testBit t (p0 + (L - i)) (by omega),
    show (t + Q) - (p0 + (L - i)) = (t - (p0 + L)) + i + Q by omega,
    show t - (p0 + (L - i)) = (t - (p0 + L)) + i by omega] at hrh
  exact hrh

/-- **Converse Equivalence (`rhBandAgree_of_rowAgree_right`)**:
    for `p0 + L ≤ t`, `RowAgree t Q (t - (p0 + L)) L` implies `RhBandAgree t Q p0 L`. -/
theorem rhBandAgree_of_rowAgree_right (t Q p0 L : Nat)
    (hp : p0 + L ≤ t) (h : RowAgree t Q (t - (p0 + L)) L) :
    RhBandAgree t Q p0 L := by
  intro i hi
  have hrow := h (L - i) (by omega)
  rw [rhCenter_eq_row_testBit (t + Q) (p0 + i) (by omega),
    rhCenter_eq_row_testBit t (p0 + i) (by omega),
    show (t + Q) - (p0 + i) = (t - (p0 + L)) + (L - i) + Q by omega,
    show t - (p0 + i) = (t - (p0 + L)) + (L - i) by omega]
  exact hrow

/-- Paper-facing predicate `SectorRhBandAgree k d U Q`: at all sector times `t_u = (d + u * 2^k) + 1` (`u ≥ U`), `RhBandAgree t_u Q 0 (2^k + 1)` holds across the driven right half from column `0` to column `2^k + 1`. -/
def SectorRhBandAgree (k d U Q : Nat) : Prop :=
  ∀ u, U ≤ u → RhBandAgree ((d + u * twopow k) + 1) Q 0 (twopow k + 1)

/-- **Establishing `SectorRightRowAgree` from Driven Right-Half Band Agreement (`sectorRightRowAgree_of_rhBandAgree`)**:
    if at every sector time `t_u = (d + u * 2^k) + 1` (`u ≥ U`, `1 ≤ U`, `1 ≤ d`), `RhBandAgree t_u Q 0 (2^k + 1)` holds across the right half from column `0` to column `2^k + 1`, then `SectorRightRowAgree k d U Q` holds! -/
theorem sectorRightRowAgree_of_rhBandAgree (k d U Q : Nat)
    (hU : 1 ≤ U) (hd : 1 ≤ d)
    (hsec : SectorRhBandAgree k d U Q) :
    SectorRightRowAgree k d U Q := by
  intro u hu
  have h1 : 1 * twopow k ≤ u * twopow k := Nat.mul_le_mul_right (twopow k) (by omega)
  have hrh := hsec u hu
  have hrow := rowAgree_right_of_rhBandAgree ((d + u * twopow k) + 1) Q 0 (twopow k + 1)
    (by omega) hrh
  simpa using hrow

/-- **Refutation of Driven Right-Half Band Agreement at Sector Times for `Q = lcm(P, 2^k)` (`not_sector_rhBandAgree_lcmPeriod`)**:
    under `CenterPeriodic T P` (`0 < P`), for `1 ≤ U`, `1 ≤ d`, and `T ≤ d + U * 2^k`, `SectorRhBandAgree k d U (lcmPeriod P k)` is false! -/
theorem not_sector_rhBandAgree_lcmPeriod
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U : Nat) (hU : 1 ≤ U) (hd : 1 ≤ d) (ht : T ≤ d + U * twopow k) :
    ¬ SectorRhBandAgree k d U (lcmPeriod P k) := by
  intro hsec
  have hsr := sectorRightRowAgree_of_rhBandAgree k d U (lcmPeriod P k) hU hd hsec
  exact not_sector_right_rowAgree_lcmPeriod T P hP hper k d U hU hd ht hsr

/-- **Right-Edge Band `Q`-Invariance of `rhCenter` at `Q = lcm(P, 2^k)` (`rhCenter_right_edge_lcmPeriod_eq`)**:
    for every `P, k, j, t : Nat` with `j ≤ k` and `j ≤ t`, column `(t + lcmPeriod P k) - j` of `rhCenter (t + lcmPeriod P k)` equals column `t - j` of `rhCenter t`. -/
theorem rhCenter_right_edge_lcmPeriod_eq (P k j t : Nat) (hj : j ≤ k) (hjt : j ≤ t) :
    rhCenter (t + lcmPeriod P k) ((t + lcmPeriod P k) - j) = rhCenter t (t - j) := by
  rw [rhCenter_eq_rdiag (t + lcmPeriod P k) ((t + lcmPeriod P k) - j) (by omega),
    rhCenter_eq_rdiag t (t - j) (by omega),
    show (t + lcmPeriod P k) - ((t + lcmPeriod P k) - j) = j by omega,
    show t - (t - j) = j by omega]
  exact rdiag_lcmPeriod_eq P k j t hj

/-- **Carrying `SectorWinWittAgree` to `ColNegOnePeriodic` Across Every Residue `mod 2^k` via Window Step 9.204 (`colNegOnePeriodic_of_sector_winWittAgree`)**:
    if `SectorWinWittAgree k d U Q` holds (`2 ≤ U`), then for every `t ≥ d + (U + 1) * 2^k`, writing `(t + 1) - 2^k = t_u + s` with `u ≥ U` and `s < 2^k`, the sub-interval `[(t_u + 2^k) - s, (t_u + 2^k) - s + 1 + 2 * s] ⊆ [t_u, t_u + 2 * 2^k]` advances by `s` steps of Window Step 9.204 (`winWittAgree_steps` with `L = 1`) and `rowAgree_steps` to establish `RowAgree ((t + 1)) Q (t + 1) 1`, yielding `ColNegOnePeriodic (d + (U + 1) * 2^k) Q` across all residues `mod 2^k`! -/
theorem colNegOnePeriodic_of_sector_winWittAgree (k d U Q : Nat) (hU : 2 ≤ U)
    (hsec : SectorWinWittAgree k d U Q) :
    ColNegOnePeriodic (d + (U + 1) * twopow k) Q := by
  intro t ht
  have hpos : 0 < twopow k := by
    have := twopow_gt_self k
    omega
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have ht_ge : d + U * twopow k + twopow k ≤ t := by
    have hm : (U + 1) * twopow k = U * twopow k + twopow k := by
      rw [Nat.add_mul, Nat.one_mul]
    omega
  have h_base1 : d + U * twopow k ≤ (t + 1) - twopow k := by omega
  obtain ⟨delta, hdelta⟩ : ∃ delta, (t + 1) - twopow k = (d + U * twopow k) + delta :=
    ⟨((t + 1) - twopow k) - (d + U * twopow k), by omega⟩
  obtain ⟨q, s, hdiv, hs_lt⟩ : ∃ q s, delta = q * twopow k + s ∧ s < twopow k :=
    ⟨delta / twopow k, delta % twopow k,
      by rw [Nat.mul_comm, Nat.div_add_mod],
      Nat.mod_lt delta hpos⟩
  have hu : U ≤ U + q := by omega
  let t0 := d + (U + q) * twopow k
  have ht1_eq : t + 1 = (t0 + s) + twopow k := by
    dsimp [t0]
    rw [Nat.add_mul]
    omega
  have h2_le : 2 * twopow k ≤ (U + q) * twopow k := Nat.mul_le_mul_right (twopow k) (by omega)
  obtain ⟨hw, h0, h1, h2⟩ := hsec (U + q) hu
  have hw_sub : WinWittAgree t0 k Q ((t0 + twopow k) - s) (1 + 2 * s) :=
    winWittAgree_mono t0 k Q ((t0 + twopow k) - twopow k) (2 * twopow k)
      ((t0 + twopow k) - s) (1 + 2 * s) (by omega) (by omega) hw
  have h0_sub : RowAgree t0 Q (((t0 + twopow k) - s) - twopow (k + 1)) (1 + 2 * s) :=
    rowAgree_mono t0 Q (((t0 + twopow k) - twopow k) - twopow (k + 1)) (2 * twopow k)
      (((t0 + twopow k) - s) - twopow (k + 1)) (1 + 2 * s) (by omega) (by omega) h0
  have h1_sub : RowAgree t0 Q (((t0 + twopow k) - s) - twopow k) (1 + 2 * s) :=
    rowAgree_mono t0 Q (((t0 + twopow k) - twopow k) - twopow k) (2 * twopow k)
      (((t0 + twopow k) - s) - twopow k) (1 + 2 * s) (by omega) (by omega) h1
  have h2_sub : RowAgree t0 Q ((t0 + twopow k) - s) (1 + 2 * s) :=
    rowAgree_mono t0 Q ((t0 + twopow k) - twopow k) (2 * twopow k)
      ((t0 + twopow k) - s) (1 + 2 * s) (by omega) (by omega) h2
  have hw_steps := winWittAgree_steps t0 k Q ((t0 + twopow k) - s) 1 s (by omega)
    hw_sub h0_sub h1_sub h2_sub
  have h0_steps := rowAgree_steps t0 Q (((t0 + twopow k) - s) - twopow (k + 1)) 1 s h0_sub
  have h1_steps := rowAgree_steps t0 Q (((t0 + twopow k) - s) - twopow k) 1 s h1_sub
  have h2_steps := rowAgree_steps t0 Q ((t0 + twopow k) - s) 1 s h2_sub
  rw [show ((t0 + twopow k) - s) + 2 * s = (t0 + s) + twopow k by omega] at hw_steps h2_steps
  rw [show (((t0 + twopow k) - s) - twopow (k + 1)) + 2 * s =
      ((t0 + s) + twopow k) - twopow (k + 1) by omega] at h0_steps
  rw [show (((t0 + twopow k) - s) - twopow k) + 2 * s =
      ((t0 + s) + twopow k) - twopow k by omega] at h1_steps
  have hlate := rowAgree_late_of_winWittAgree_and_three (t0 + s) k Q
    ((t0 + s) + twopow k) 1 (by omega) hw_steps h0_steps h1_steps h2_steps
  have hbit1 := hlate 1 (by omega)
  rw [← ht1_eq] at hbit1
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    ldiag_eq_rdiag (t + Q) 1,
    ldiag_eq_rdiag t 1,
    ← row_testBit ((t + Q) + 1) ((t + Q) + 2 * 1),
    ← row_testBit (t + 1) (t + 2 * 1)]
  rwa [show (t + 1) + Q = (t + Q) + 1 by omega,
    show (t + 1) + 1 + Q = (t + Q) + 2 * 1 by omega,
    show (t + 1) + 1 = t + 2 * 1 by omega] at hbit1

/-- **Refutation of `SectorWinWittAgree` at `Q = lcm(P, 2^k)` via Window Step 9.204 (`not_sector_winWittAgree_lcmPeriod`)**:
    under `CenterPeriodic T P` (`0 < P`), for any `k, d, U : Nat` with `2 ≤ U`, `SectorWinWittAgree k d U (lcmPeriod P k)` is false! -/
theorem not_sector_winWittAgree_lcmPeriod
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U : Nat) (hU : 2 ≤ U) :
    ¬ SectorWinWittAgree k d U (lcmPeriod P k) := by
  intro hsec
  have hcol := colNegOnePeriodic_of_sector_winWittAgree k d U (lcmPeriod P k) hU hsec
  rw [lcmPeriod_eq_mul_period P k] at hcol
  exact not_periodic_colm1_mul T P hP hper (d + (U + 1) * twopow k)
    (twopow k / Nat.gcd P (twopow k)) (lcmPeriod_div_pos P k hP) hcol

/-- Paper-facing predicate `SectorWideRowAgree k d U Q`: at all sector times `t_u = d + u * 2^k` (`u ≥ U`), the two-sided symmetric neighbourhood of radius `2^(k+1)` (`[t_u - 2^(k+1), t_u + 2^(k+1)]`) agrees between `t_u` and `t_u + Q`. -/
def SectorWideRowAgree (k d U Q : Nat) : Prop :=
  ∀ u, U ≤ u →
    RowAgree (d + u * twopow k) Q
      ((d + u * twopow k) - twopow (k + 1)) (2 * twopow (k + 1))

/-- Paper-facing predicate `SectorWideRightRowAgree k d U Q`: at all sector times `t_u = d + u * 2^k` (`u ≥ U`), the one-sided right-wing neighbourhood of width `2^(k+1)` (`[t_u - 2^(k+1), t_u]`, columns `p ∈ [0, 2^(k+1)]` of `rhCenter`) agrees between `t_u` and `t_u + Q`. -/
def SectorWideRightRowAgree (k d U Q : Nat) : Prop :=
  ∀ u, U ≤ u →
    RowAgree (d + u * twopow k) Q
      ((d + u * twopow k) - twopow (k + 1)) (twopow (k + 1))

/-- **Establishing `SectorWinWittAgree` from Pure Sector-Time Row Agreement (`sectorWinWittAgree_of_sectorWideRowAgree`)**:
    for `2 ≤ U`, because `t_u + 2^k = d + (u + 1) * 2^k = t_{u+1}` is the next sector time, `SectorWideRowAgree k d U Q` supplies both the three-sector `RowAgree` at `t_u` and the late `RowAgree` at `t_u + 2^k = t_{u+1}`, establishing `SectorWinWittAgree k d U Q` via `winWittAgree_of_rowAgree_three_and_late`! -/
theorem sectorWinWittAgree_of_sectorWideRowAgree (k d U Q : Nat) (hU : 2 ≤ U)
    (hsec : SectorWideRowAgree k d U Q) :
    SectorWinWittAgree k d U Q := by
  intro u hu
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have h2_le : 2 * twopow k ≤ u * twopow k := Nat.mul_le_mul_right (twopow k) (by omega)
  have hu_row := hsec u hu
  have hu1_row := hsec (u + 1) (by omega)
  have h0 : RowAgree (d + u * twopow k) Q
      ((((d + u * twopow k) + twopow k) - twopow k) - twopow (k + 1)) (2 * twopow k) :=
    rowAgree_mono (d + u * twopow k) Q
      ((d + u * twopow k) - twopow (k + 1)) (2 * twopow (k + 1))
      ((((d + u * twopow k) + twopow k) - twopow k) - twopow (k + 1)) (2 * twopow k)
      (by omega) (by omega) hu_row
  have h1 : RowAgree (d + u * twopow k) Q
      ((((d + u * twopow k) + twopow k) - twopow k) - twopow k) (2 * twopow k) :=
    rowAgree_mono (d + u * twopow k) Q
      ((d + u * twopow k) - twopow (k + 1)) (2 * twopow (k + 1))
      ((((d + u * twopow k) + twopow k) - twopow k) - twopow k) (2 * twopow k)
      (by omega) (by omega) hu_row
  have h2 : RowAgree (d + u * twopow k) Q
      (((d + u * twopow k) + twopow k) - twopow k) (2 * twopow k) :=
    rowAgree_mono (d + u * twopow k) Q
      ((d + u * twopow k) - twopow (k + 1)) (2 * twopow (k + 1))
      (((d + u * twopow k) + twopow k) - twopow k) (2 * twopow k)
      (by omega) (by omega) hu_row
  have hlate : RowAgree ((d + u * twopow k) + twopow k) Q
      (((d + u * twopow k) + twopow k) - twopow k) (2 * twopow k) := by
    have h_eq : (d + u * twopow k) + twopow k = d + (u + 1) * twopow k := by
      rw [Nat.add_mul, Nat.one_mul, Nat.add_assoc]
    rw [h_eq]
    exact rowAgree_mono (d + (u + 1) * twopow k) Q
      ((d + (u + 1) * twopow k) - twopow (k + 1)) (2 * twopow (k + 1))
      ((d + (u + 1) * twopow k) - twopow k) (2 * twopow k)
      (by omega) (by omega) hu1_row
  have hw := winWittAgree_of_rowAgree_three_and_late (d + u * twopow k) k Q
    (((d + u * twopow k) + twopow k) - twopow k) (2 * twopow k)
    (by omega) h0 h1 h2 hlate
  exact ⟨hw, h0, h1, h2⟩

/-- **Establishing `SectorWinWittAgree` from One-Sided Right-Wing Sector Row Agreement (`sectorWinWittAgree_of_sectorWideRightRowAgree`)**:
    under `CenterPeriodic T P` (`0 < P`), for `2 ≤ U` and `T ≤ d + U * 2^k`, one-sided right-wing `SectorWideRightRowAgree k d U (m * P)` doubles across the periodic center via `periodic_rowAgree_symm_of_right` (`Φ` fixed-point reflection!) to `SectorWideRowAgree k d U (m * P)` and hence implies `SectorWinWittAgree k d U (m * P)`! -/
theorem sectorWinWittAgree_of_sectorWideRightRowAgree
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U m : Nat) (hU : 2 ≤ U) (ht : T ≤ d + U * twopow k)
    (hsec : SectorWideRightRowAgree k d U (m * P)) :
    SectorWinWittAgree k d U (m * P) := by
  refine sectorWinWittAgree_of_sectorWideRowAgree k d U (m * P) hU (fun u hu => ?_)
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have h2_le : 2 * twopow k ≤ u * twopow k := Nat.mul_le_mul_right (twopow k) (by omega)
  have hU_le : U * twopow k ≤ u * twopow k := Nat.mul_le_mul_right (twopow k) hu
  exact periodic_rowAgree_symm_of_right T P hP hper m (twopow (k + 1))
    (d + u * twopow k) (by omega) (by omega) (hsec u hu)

/-- **Refutation of One-Sided Wide Right-Wing Sector Agreement at `Q = lcm(P, 2^k)` via Window Step 9.204 (`not_sectorWideRightRowAgree_lcmPeriod`)**:
    under `CenterPeriodic T P` (`0 < P`), for `2 ≤ U` and `T ≤ d + U * 2^k`, `SectorWideRightRowAgree k d U (lcmPeriod P k)` is false! -/
theorem not_sectorWideRightRowAgree_lcmPeriod
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U : Nat) (hU : 2 ≤ U) (ht : T ≤ d + U * twopow k) :
    ¬ SectorWideRightRowAgree k d U (lcmPeriod P k) := by
  intro hsec
  rw [lcmPeriod_eq_mul_period P k] at hsec
  have hwin := sectorWinWittAgree_of_sectorWideRightRowAgree T P hP hper
    k d U (twopow k / Nat.gcd P (twopow k)) hU ht hsec
  rw [← lcmPeriod_eq_mul_period P k] at hwin
  exact not_sector_winWittAgree_lcmPeriod T P hP hper k d U hU hwin

theorem rhCenter_eq_row_testBit_prop (t p : Nat) (hp : p ≤ t) :
    rhCenter t p = wittBitBool (row t) (t - p) :=
  rhCenter_eq_row_testBit t p hp

theorem lhCenter_eq_row_testBit_prop (t p : Nat) (hp : p ≤ t) :
    lhCenter t p = wittBitBool (row t) (t + p) :=
  lhCenter_eq_row_testBit t p hp

theorem not_sector_rhBandAgree_lcmPeriod_prop
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U : Nat) (hU : 1 ≤ U) (hd : 1 ≤ d) (ht : T ≤ d + U * twopow k) :
    ¬ (∀ u, U ≤ u → RhBandAgree ((d + u * twopow k) + 1) (lcmPeriod P k) 0 (twopow k + 1)) :=
  not_sector_rhBandAgree_lcmPeriod T P hP hper k d U hU hd ht

/-- **Boundary Readouts of the Driven Left Half `lhCenter` (`lhCenter_zero_eq_center`, `lhCenter_self_eq_true`, `lhCenter_gt_eq_false`)**:
    at `p = 0`, `lhCenter t 0 = center t`; at the left edge `p = t`, `lhCenter t t = true`; and outside the light cone (`t < p`), `lhCenter t p = false`. -/
theorem lhCenter_zero_eq_center (t : Nat) :
    lhCenter t 0 = Rule30UOR.Core.center t := by
  have h1 := lhCenter_eq_row_testBit t 0 (by omega)
  have h2 := rhCenter_eq_row_testBit t 0 (by omega)
  rw [Nat.add_zero] at h1
  rw [Nat.sub_zero] at h2
  rw [h1, ← h2, rhCenter_zero_eq_center]

theorem lhCenter_self_eq_true (t : Nat) :
    lhCenter t t = true := by
  rw [lhCenter_eq_ldiag t t (by omega), Nat.sub_self]
  rcases t with _ | t <;> rfl

theorem lhCenter_gt_eq_false (t p : Nat) (h : t < p) :
    lhCenter t p = false := by
  unfold lhCenter
  induction t generalizing p with
  | zero =>
    simp [Rule30UOR.Fixed.Lh]
    omega
  | succ t ih =>
    rcases p with _ | p
    · omega
    · have hneg : (- ((p + 1 : Nat) : Int)) < 0 := by omega
      simp only [Rule30UOR.Fixed.Lh, if_pos hneg, Ruliology.CellularAutomata.Rule30Jen.rule]
      rw [show (- ((p + 1 : Nat) : Int)) - 1 = (- ((p + 2 : Nat) : Int)) by omega,
        show (- ((p + 1 : Nat) : Int)) + 1 = (- (p : Int)) by omega,
        ih (p + 2) (by omega), ih (p + 1) (by omega), ih p (by omega)]
      rfl

/-- **Evolution Law of the Driven Left Half `lhCenter` (`lhCenter_step_succ`)**:
    for all `t, p : Nat`, column `-(p + 1)` of `lhCenter (t + 1)` evolves by Rule 30 from columns `-(p + 2), -(p + 1), -p` of `lhCenter t`. -/
theorem lhCenter_step_succ (t p : Nat) :
    lhCenter (t + 1) (p + 1) =
      bxor (lhCenter t (p + 2)) (lhCenter t (p + 1) || lhCenter t p) := by
  unfold lhCenter
  have hneg : (- ((p + 1 : Nat) : Int)) < 0 := by omega
  simp only [Rule30UOR.Fixed.Lh, if_pos hneg]
  rw [show (- ((p + 1 : Nat) : Int)) - 1 = (- ((p + 2 : Nat) : Int)) by omega,
    show (- ((p + 1 : Nat) : Int)) + 1 = (- (p : Int)) by omega]
  unfold Ruliology.CellularAutomata.Rule30Jen.rule
  rw [bxor_eq_xor]

/-- **Outward Step Law of the Driven Left Half from the Center Toward the Left Edge (`lhCenter_outward_step`)**:
    for all `t, p : Nat`, solving `lhCenter_step_succ` for `lhCenter t (p + 2)` expresses column `-(p + 2)` at time `t` in terms of column `-(p + 1)` at time `t + 1` and columns `-(p + 1), -p` at time `t`. -/
theorem lhCenter_outward_step (t p : Nat) :
    lhCenter t (p + 2) =
      bxor (lhCenter (t + 1) (p + 1)) (lhCenter t (p + 1) || lhCenter t p) := by
  rw [lhCenter_step_succ t p, bxor_eq_xor, bxor_eq_xor]
  cases lhCenter t (p + 2) <;>
    cases (lhCenter t (p + 1) || lhCenter t p) <;> rfl

/-- **Pure Right-Half Unfolding of the Center Column (`center_eq_rhCenter_inward_zero`)**:
    evaluating `rhCenter_inward_step` at `p = 0` expresses `center t` purely in terms of the driven right half `rhCenter (t + 1) 1`, `rhCenter t 1`, and `rhCenter t 2`! -/
theorem center_eq_rhCenter_inward_zero (t : Nat) :
    Rule30UOR.Core.center t =
      bxor (rhCenter (t + 1) 1) (rhCenter t 1 || rhCenter t 2) := by
  rw [← rhCenter_zero_eq_center t, rhCenter_inward_step t 0]

/-- **Periodic Center-Bounce Equivalence at Column 1 (`periodic_rhCenter_step_one_eq_of_or_eq` and `periodic_rhCenter_or_eq_of_step_one_eq`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `t ≥ T` and `m : Nat`, `rhCenter ((t + 1) + m * P) 1 = rhCenter (t + 1) 1` holds if and only if `(rhCenter (t + m * P) 1 || rhCenter (t + m * P) 2) = (rhCenter t 1 || rhCenter t 2)`. -/
theorem periodic_rhCenter_step_one_eq_of_or_eq
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t : Nat) (ht : T ≤ t)
    (hor : (rhCenter (t + m * P) 1 || rhCenter (t + m * P) 2) =
      (rhCenter t 1 || rhCenter t 2)) :
    rhCenter ((t + 1) + m * P) 1 = rhCenter (t + 1) 1 := by
  have hc : rhCenter (t + m * P) 0 = rhCenter t 0 := by
    rw [rhCenter_zero_eq_center, rhCenter_zero_eq_center]
    exact Rule30UOR.Scale.center_mul hper m t ht
  rw [show (t + 1) + m * P = (t + m * P) + 1 by omega,
    rhCenter_step_succ (t + m * P) 0,
    rhCenter_step_succ t 0,
    hc, hor]

theorem periodic_rhCenter_or_eq_of_step_one_eq
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t : Nat) (ht : T ≤ t)
    (hstep : rhCenter ((t + 1) + m * P) 1 = rhCenter (t + 1) 1) :
    (rhCenter (t + m * P) 1 || rhCenter (t + m * P) 2) =
      (rhCenter t 1 || rhCenter t 2) := by
  have hc0 := center_eq_rhCenter_inward_zero t
  have hcQ := center_eq_rhCenter_inward_zero (t + m * P)
  have hcm : Rule30UOR.Core.center (t + m * P) = Rule30UOR.Core.center t :=
    Rule30UOR.Scale.center_mul hper m t ht
  rw [show (t + m * P) + 1 = (t + 1) + m * P by omega, hstep, hcm] at hcQ
  rw [hc0] at hcQ
  revert hcQ
  simp only [bxor_eq_xor]
  cases rhCenter (t + 1) 1 <;>
    cases (rhCenter (t + m * P) 1 || rhCenter (t + m * P) 2) <;>
    cases (rhCenter t 1 || rhCenter t 2) <;> decide

/-- **Multi-Step Forward Propagation of Right-Half Band Agreement (`rhBandAgree_steps`)**:
    by induction on `s : Nat`, `RhBandAgree t Q p0 (L + 2 * s)` implies `RhBandAgree (t + s) Q (p0 + s) L`. -/
theorem rhBandAgree_steps (t Q p0 L s : Nat)
    (h : RhBandAgree t Q p0 (L + 2 * s)) :
    RhBandAgree (t + s) Q (p0 + s) L := by
  induction s generalizing t p0 L with
  | zero =>
    simpa using h
  | succ s ih =>
    have h' : RhBandAgree t Q p0 ((L + 2 * s) + 2) := by
      intro i hi
      exact h i (by omega)
    have h1 := rhBandAgree_step t Q p0 (L + 2 * s) h'
    have h2 := ih (t + 1) (p0 + 1) L h1
    rw [show (t + 1) + s = t + (s + 1) by omega,
      show (p0 + 1) + s = p0 + (s + 1) by omega] at h2
    exact h2

/-- **Free Inward Extension of `RhBandAgree` from Column 1 to Column 0 under `CenterPeriodic` (`periodic_rhBandAgree_zero_of_one`)**:
    under `CenterPeriodic T P` (`0 < P`), for `t ≥ T`, `RhBandAgree t (m * P) 1 L` automatically extends inward to `RhBandAgree t (m * P) 0 (L + 1)` because `rhCenter · 0 = center ·` is `m * P`-periodic! -/
theorem periodic_rhBandAgree_zero_of_one
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t L : Nat) (ht : T ≤ t)
    (h : RhBandAgree t (m * P) 1 L) :
    RhBandAgree t (m * P) 0 (L + 1) := by
  intro i hi
  rcases i with _ | i
  · simp only [Nat.zero_add, rhCenter_zero_eq_center]
    exact Rule30UOR.Scale.center_mul hper m t ht
  · have hi' : i ≤ L := by omega
    have h1 := h i hi'
    rw [show 1 + i = 0 + (i + 1) by omega] at h1
    exact h1

/-- **Center-Anchored Forward Step of `RhBandAgree` at `p0 = 0` (`periodic_rhBandAgree_zero_step` and `periodic_rhBandAgree_zero_steps`)**:
    under `CenterPeriodic T P` (`0 < P`), for `t ≥ T`, `RhBandAgree t (m * P) 0 (L + 1)` steps forward in time to `RhBandAgree (t + 1) (m * P) 0 L`, keeping `p0 = 0` fixed and losing only 1 column on the right (instead of 2) because column 0 is resupplied at `t + 1` by the periodic center! -/
theorem periodic_rhBandAgree_zero_step
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t L : Nat) (ht : T ≤ t)
    (h : RhBandAgree t (m * P) 0 (L + 1)) :
    RhBandAgree (t + 1) (m * P) 0 L := by
  rcases L with _ | L
  · intro i hi
    have hi0 : i = 0 := by omega
    subst hi0
    simp only [Nat.zero_add, rhCenter_zero_eq_center]
    exact Rule30UOR.Scale.center_mul hper m (t + 1) (by omega)
  · have hstep := rhBandAgree_step t (m * P) 0 L h
    exact periodic_rhBandAgree_zero_of_one T P hP hper m (t + 1) L (by omega) hstep

theorem periodic_rhBandAgree_zero_steps
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t L s : Nat) (ht : T ≤ t)
    (h : RhBandAgree t (m * P) 0 (L + s)) :
    RhBandAgree (t + s) (m * P) 0 L := by
  induction s generalizing t L with
  | zero =>
    simpa using h
  | succ s ih =>
    have h' : RhBandAgree t (m * P) 0 ((L + s) + 1) := by
      intro i hi
      exact h i (by omega)
    have h1 := periodic_rhBandAgree_zero_step T P hP hper m t (L + s) ht h'
    have h2 := ih (t + 1) L (by omega) h1
    rw [show (t + 1) + s = t + (s + 1) by omega] at h2
    exact h2

/-- **Multi-Step Inward Extension of `RhBandAgree` from the Right Edge Toward the Center (`rhBandAgree_extend_inward_steps`)**:
    if `RhBandAgree t Q (p0 + S) (L + 1)` holds at the right end of `[p0, p0 + S + L + 1]` at time `t` and `RhBandAgree (t + 1) Q (p0 + 1) S` holds at time `t + 1`, then `S` applications of `rhBandAgree_extend_inward` yield `RhBandAgree t Q p0 (L + 1 + S)` across the entire band at time `t`! -/
theorem rhBandAgree_extend_inward_steps (t Q p0 S L : Nat)
    (h : RhBandAgree t Q (p0 + S) (L + 1))
    (hstep : RhBandAgree (t + 1) Q (p0 + 1) S) :
    RhBandAgree t Q p0 (L + 1 + S) := by
  induction S generalizing L with
  | zero =>
    simpa using h
  | succ S ih =>
    have h_ext : RhBandAgree t Q (p0 + S) ((L + 1) + 1) := by
      have h_in := rhBandAgree_extend_inward t Q (p0 + S) L
      apply h_in
      · intro i hi
        have := h i hi
        rw [show p0 + (S + 1) + i = (p0 + S + 1) + i by omega] at this
        exact this
      · have hs := hstep (S + 1) (by omega)
        rw [show (p0 + 1) + (S + 1) = (p0 + S) + 1 + 1 by omega] at hs
        have hs0 := hstep S (by omega)
        rw [show (p0 + 1) + S = (p0 + S) + 1 by omega] at hs0
        exact hs0
    have hstep' : RhBandAgree (t + 1) Q (p0 + 1) S := by
      intro i hi
      exact hstep i (by omega)
    have hres := ih (L + 1) h_ext hstep'
    intro i hi
    exact hres i (by omega)

/-- **Right-to-Center Full Band Agreement from Right-Boundary Pair and Next-Step Interior (`rhBandAgree_zero_of_edge_and_succ`)**:
    specializing `rhBandAgree_extend_inward_steps` to `p0 = 0` yields `RhBandAgree t Q 0 (L + 1 + S)` from `RhBandAgree t Q S (L + 1)` at time `t` and `RhBandAgree (t + 1) Q 1 S` at time `t + 1`. -/
theorem rhBandAgree_zero_of_edge_and_succ (t Q S L : Nat)
    (h : RhBandAgree t Q S (L + 1))
    (hstep : RhBandAgree (t + 1) Q 1 S) :
    RhBandAgree t Q 0 (L + 1 + S) := by
  have h0 : RhBandAgree t Q (0 + S) (L + 1) := by simpa using h
  have h1 : RhBandAgree (t + 1) Q (0 + 1) S := by simpa using hstep
  exact rhBandAgree_extend_inward_steps t Q 0 S L h0 h1

/-- **Center-Bounce Inward Extension of `RhBandAgree` (`periodic_rhBandAgree_bounce_zero` and `periodic_rhBandAgree_bounce_succ`)**:
    under `CenterPeriodic T P` (`0 < P`), for `t ≥ T`, agreement starting at column `2` at time `t + 1` (`RhBandAgree (t + 1) (m * P) 2 S`) combined with `RhBandAgree t (m * P) (S + 1) (L + 1)` at time `t` marches inward to column `1` at time `t`, picks up column `0` from the periodic center to give `RhBandAgree t (m * P) 0 (L + 2 + S)` at time `t`, and bounces forward off `(t, 0)` to give `RhBandAgree (t + 1) (m * P) 0 (L + 1 + S)` at time `t + 1`! -/
theorem periodic_rhBandAgree_bounce_zero
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t S L : Nat) (ht : T ≤ t)
    (h : RhBandAgree t (m * P) (S + 1) (L + 1))
    (hstep : RhBandAgree (t + 1) (m * P) 2 S) :
    RhBandAgree t (m * P) 0 (L + 2 + S) := by
  have h_in := rhBandAgree_extend_inward_steps t (m * P) 1 S L
    (by intro i hi; have := h i hi; rw [show S + 1 + i = 1 + S + i by omega] at this; exact this)
    hstep
  have h_zero := periodic_rhBandAgree_zero_of_one T P hP hper m t (L + 1 + S) ht h_in
  intro i hi
  exact h_zero i (by omega)

theorem periodic_rhBandAgree_bounce_succ
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t S L : Nat) (ht : T ≤ t)
    (h : RhBandAgree t (m * P) (S + 1) (L + 1))
    (hstep : RhBandAgree (t + 1) (m * P) 2 S) :
    RhBandAgree (t + 1) (m * P) 0 (L + 1 + S) := by
  have hb := periodic_rhBandAgree_bounce_zero T P hP hper m t S L ht h hstep
  have hb' : RhBandAgree t (m * P) 0 ((L + 1 + S) + 1) := by
    intro i hi
    exact hb i (by omega)
  exact periodic_rhBandAgree_zero_step T P hP hper m t (L + 1 + S) ht hb'

/-- **Direct Right-Half Propagation of `SectorRhBandAgree` to Every-Time Column `+1` Periodicity (`rhCenter_one_periodic_of_sector_rhBandAgree`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ d + U * 2^k`, `SectorRhBandAgree k d U (m * P)` implies that `rhCenter (t + m * P) 1 = rhCenter t 1` holds for EVERY time `t ≥ (d + U * 2^k) + 1` (every residue `mod 2^k`) via `periodic_rhBandAgree_zero_steps` purely inside the right half! -/
theorem rhCenter_one_periodic_of_sector_rhBandAgree
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U m : Nat) (ht : T ≤ d + U * twopow k)
    (hsec : SectorRhBandAgree k d U (m * P)) :
    ∀ t, (d + U * twopow k) + 1 ≤ t →
      rhCenter (t + m * P) 1 = rhCenter t 1 := by
  intro t ht_ge
  have hpos : 0 < twopow k := by
    have := twopow_gt_self k
    omega
  obtain ⟨delta, hdelta⟩ : ∃ delta, t = ((d + U * twopow k) + 1) + delta :=
    ⟨t - ((d + U * twopow k) + 1), by omega⟩
  obtain ⟨q, s, hdiv, hs_lt⟩ : ∃ q s, delta = q * twopow k + s ∧ s < twopow k :=
    ⟨delta / twopow k, delta % twopow k,
      by rw [Nat.mul_comm, Nat.div_add_mod],
      Nat.mod_lt delta hpos⟩
  have hu : U ≤ U + q := by omega
  let t0 := (d + (U + q) * twopow k) + 1
  have ht0_eq : t = t0 + s := by
    dsimp [t0]
    rw [hdelta, hdiv, Nat.add_mul]
    omega
  have h_u := hsec (U + q) hu
  have h_sub : RhBandAgree t0 (m * P) 0 (1 + s) := by
    intro i hi
    exact h_u i (by omega)
  have hU_le : U * twopow k ≤ (U + q) * twopow k := Nat.mul_le_mul_right (twopow k) hu
  have h_steps := periodic_rhBandAgree_zero_steps T P hP hper m t0 1 s (by omega) h_sub
  rw [← ht0_eq] at h_steps
  exact h_steps 1 (by omega)

/-- **Direct Right-Half-to-`Φ`-Fixed-Point Propagation of `SectorRhBandAgree` to Every-Time Column `-1` Periodicity (`lhCenter_one_periodic_of_sector_rhBandAgree`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ d + U * 2^k`, combining `rhCenter_one_periodic_of_sector_rhBandAgree` with the §6 `Φ` fixed-point law `lhCenter_one_eq_of_center_fixed` proves `lhCenter (t + m * P) 1 = lhCenter t 1` for EVERY time `t ≥ (d + U * 2^k) + 1` without reflecting row segments to the left half! -/
theorem lhCenter_one_periodic_of_sector_rhBandAgree
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U m : Nat) (ht : T ≤ d + U * twopow k)
    (hsec : SectorRhBandAgree k d U (m * P)) :
    ∀ t, (d + U * twopow k) + 1 ≤ t →
      lhCenter (t + m * P) 1 = lhCenter t 1 := by
  intro t ht_ge
  have hrh := rhCenter_one_periodic_of_sector_rhBandAgree T P hP hper k d U m ht hsec t ht_ge
  have hc0 : Rule30UOR.Core.center (t + m * P) = Rule30UOR.Core.center t :=
    Rule30UOR.Scale.center_mul hper m t (by omega)
  have hc1 : Rule30UOR.Core.center ((t + m * P) + 1) = Rule30UOR.Core.center (t + 1) := by
    rw [show (t + m * P) + 1 = (t + 1) + m * P by omega]
    exact Rule30UOR.Scale.center_mul hper m (t + 1) (by omega)
  rw [lhCenter_one_eq_of_center_fixed (t + m * P),
    lhCenter_one_eq_of_center_fixed t,
    hc0, hc1, hrh]

/-- **Unconditional Right-Edge Diagonal `2^k`-Shift Invariance of `rhCenter` (`rhCenter_diag_shift_twopow_eq` and `rhCenter_sector_diag_eq_center`)**:
    for all `k, t, p, v : Nat` with `p ≤ t` and `t - p ≤ k` (no settling condition required!), `rhCenter (t + v * 2^k) (p + v * 2^k) = rhCenter t p`, and in particular `rhCenter (j + u * 2^k) (u * 2^k) = center j` for all `j ≤ k`. -/
theorem rhCenter_diag_shift_twopow_eq (k t p v : Nat)
    (hp : p ≤ t) (hj : t - p ≤ k) :
    rhCenter (t + v * twopow k) (p + v * twopow k) = rhCenter t p := by
  rw [rhCenter_eq_rdiag (t + v * twopow k) (p + v * twopow k) (by omega),
    rhCenter_eq_rdiag t p hp,
    show (t + v * twopow k) - (p + v * twopow k) = t - p by omega]
  exact rdiag_restart k (t - p) v t hj

theorem rhCenter_sector_diag_eq_center (j k u : Nat) (hj : j ≤ k) :
    rhCenter (j + u * twopow k) (u * twopow k) = Rule30UOR.Core.center j := by
  have h := rhCenter_diag_shift_twopow_eq k j 0 u (by omega) (by omega)
  rw [Nat.zero_add, rhCenter_zero_eq_center] at h
  exact h

/-- **Exact `2^k`-Scale Forward and Inward Step Laws of the Driven Right Half `rhCenter` (`rhCenter_scale_step` and `rhCenter_scale_inward_step`)**:
    for `p + 2^(k+1) ≤ t`, `rhCenter (t + 2^k) (p + 2^k)` evolves linearly (via `bxor`) from `rhCenter t p`, `rhCenter t (p + 2^k)`, and `rhCenter t (p + 2^(k+1))` corrected by bit `t - p` of `winWitt t (2^k)`! -/
theorem rhCenter_scale_step (t k p : Nat) (hp : p + twopow (k + 1) ≤ t) :
    rhCenter (t + twopow k) (p + twopow k) =
      bxor
        (bxor (bxor (rhCenter t p) (rhCenter t (p + twopow k)))
          (rhCenter t (p + twopow (k + 1))))
        ((winWitt t (twopow k)).testBit (t - p)) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  rw [rhCenter_eq_row_testBit (t + twopow k) (p + twopow k) (by omega),
    show (t + twopow k) - (p + twopow k) = t - p by omega,
    row_scale t k, Nat.testBit_xor]
  have hphi : (phiScale k (row t)).testBit (t - p) =
      bxor (bxor (rhCenter t p) (rhCenter t (p + twopow k)))
        (rhCenter t (p + twopow (k + 1))) := by
    change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
      ((row t) <<< (twopow k + twopow k))).testBit (t - p) = _
    simp only [Nat.testBit_xor, Nat.testBit_shiftLeft, bxor_eq_xor]
    have d1 : decide (t - p ≥ twopow k) = true := decide_eq_true (by omega)
    have d2 : decide (t - p ≥ twopow k + twopow k) = true := decide_eq_true (by omega)
    rw [d1, d2, Bool.true_and, Bool.true_and,
      show t - p - twopow k = t - (p + twopow k) by omega,
      show t - p - (twopow k + twopow k) = t - (p + twopow (k + 1)) by omega,
      ← rhCenter_eq_row_testBit t p (by omega),
      ← rhCenter_eq_row_testBit t (p + twopow k) (by omega),
      ← rhCenter_eq_row_testBit t (p + twopow (k + 1)) (by omega)]
  rw [hphi]
  simp only [bxor_eq_xor]

theorem rhCenter_scale_inward_step (t k p : Nat) (hp : p + twopow (k + 1) ≤ t) :
    rhCenter t p =
      bxor
        (bxor (bxor (rhCenter (t + twopow k) (p + twopow k)) (rhCenter t (p + twopow k)))
          (rhCenter t (p + twopow (k + 1))))
        ((winWitt t (twopow k)).testBit (t - p)) := by
  rw [rhCenter_scale_step t k p hp]
  simp only [bxor_eq_xor]
  cases rhCenter t p <;>
    cases rhCenter t (p + twopow k) <;>
    cases rhCenter t (p + twopow (k + 1)) <;>
    cases (winWitt t (twopow k)).testBit (t - p) <;> rfl

/-! ### Multi-Step Right-Half Window Determination (`RhOrAgree`), Unconditional Right-Edge `RhBandAgree`, and `2^k`-Scale Band Transport -/

/-- Time-trace `Q`-agreement of column `p0` of `rhCenter`:
    at times `t + s` and `(t + s) + Q` (`s ≤ S`), column `p0` of `rhCenter` agrees. -/
def RhColAgree (t Q p0 S : Nat) : Prop :=
  ∀ s, s ≤ S →
    rhCenter ((t + s) + Q) p0 = rhCenter (t + s) p0

instance (t Q p0 S : Nat) : Decidable (RhColAgree t Q p0 S) := by
  unfold RhColAgree
  infer_instance

/-- Band `Q`-agreement of the right-half `OR` input `rhCenter · p0 || rhCenter · (p0 + 1)`:
    at times `t + s` and `(t + s) + Q` (`s < S`), the right-half OR inputs agree at column `p0`. -/
def RhOrAgree (t Q p0 S : Nat) : Prop :=
  ∀ s, s < S →
    (rhCenter ((t + s) + Q) p0 || rhCenter ((t + s) + Q) (p0 + 1)) =
      (rhCenter (t + s) p0 || rhCenter (t + s) (p0 + 1))

/-- **Sub-interval Monotonicity of `RhBandAgree` (`rhBandAgree_mono`)**:
    if `RhBandAgree t Q p0 L` holds on `[p0, p0 + L]` and `[p0', p0' + L'] ⊆ [p0, p0 + L]`, then `RhBandAgree t Q p0' L'` holds. -/
theorem rhBandAgree_mono (t Q p0 L p0' L' : Nat)
    (hp : p0 ≤ p0') (hL : p0' + L' ≤ p0 + L)
    (h : RhBandAgree t Q p0 L) :
    RhBandAgree t Q p0' L' := by
  intro i hi
  have hj : (p0' - p0) + i ≤ L := by omega
  have heq := h ((p0' - p0) + i) hj
  rwa [show p0 + ((p0' - p0) + i) = p0' + i by omega] at heq

/-- **Sub-interval Monotonicity of `RhColAgree` (`rhColAgree_mono`)**:
    if `RhColAgree t Q p0 S` holds on `[t, t + S]` and `[t + s0, t + s0 + S'] ⊆ [t, t + S]`, then `RhColAgree (t + s0) Q p0 S'` holds. -/
theorem rhColAgree_mono (t Q p0 S s0 S' : Nat)
    (hs : s0 + S' ≤ S)
    (h : RhColAgree t Q p0 S) :
    RhColAgree (t + s0) Q p0 S' := by
  intro s hs'
  have heq := h (s0 + s) (by omega)
  rwa [show t + (s0 + s) = (t + s0) + s by omega] at heq

/-- **Sub-interval Monotonicity of `RhOrAgree` (`rhOrAgree_mono`)**:
    if `RhOrAgree t Q p0 S` holds on `[t, t + S)` and `[t + s0, t + s0 + S') ⊆ [t, t + S)`, then `RhOrAgree (t + s0) Q p0 S'` holds. -/
theorem rhOrAgree_mono (t Q p0 S s0 S' : Nat)
    (hs : s0 + S' ≤ S)
    (h : RhOrAgree t Q p0 S) :
    RhOrAgree (t + s0) Q p0 S' := by
  intro s hs'
  have heq := h (s0 + s) (by omega)
  rwa [show t + (s0 + s) = (t + s0) + s by omega] at heq

/-- **Right-Half `RhOrAgree` from Column-`p0` Time-Trace Agreement (`rhOrAgree_of_col_agree`)**:
    if `RhColAgree t Q p0 S` holds on `[t, t + S]` and column `p0 + 1` agrees at times `t + 1 + s` (`s < S`), then `rhCenter_inward_step` forces `RhOrAgree t Q (p0 + 1) S`! -/
theorem rhOrAgree_of_col_agree (t Q p0 S : Nat)
    (hcol : RhColAgree t Q p0 S)
    (hnext : ∀ s, s < S →
      rhCenter ((t + (s + 1)) + Q) (p0 + 1) = rhCenter (t + (s + 1)) (p0 + 1)) :
    RhOrAgree t Q (p0 + 1) S := by
  intro s hs
  have hc := hcol s (by omega)
  have hn := hnext s hs
  have hinQ := rhCenter_inward_step ((t + s) + Q) p0
  have hin0 := rhCenter_inward_step (t + s) p0
  rw [show ((t + s) + Q) + 1 = (t + (s + 1)) + Q by omega] at hinQ
  rw [show (t + s) + 1 = t + (s + 1) by omega] at hin0
  rw [hinQ, hin0, hn] at hc
  rw [show (p0 + 1) + 1 = p0 + 2 by omega]
  revert hc
  simp only [bxor_eq_xor]
  cases rhCenter (t + (s + 1)) (p0 + 1) <;>
    cases (rhCenter ((t + s) + Q) (p0 + 1) || rhCenter ((t + s) + Q) (p0 + 2)) <;>
    cases (rhCenter (t + s) (p0 + 1) || rhCenter (t + s) (p0 + 2)) <;> decide

/-- **Center `RhOrAgree` Equivalence (`periodic_rhOrAgree_one_of_col_one` and `periodic_col_one_of_rhOrAgree_one`)**:
    under `CenterPeriodic T P` (`0 < P`), for `t ≥ T`, `RhOrAgree t (m * P) 1 S` holds if and only if column `1` of `rhCenter` agrees on `[t + 1, t + S]`. -/
theorem periodic_rhOrAgree_one_of_col_one
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t S : Nat) (ht : T ≤ t)
    (h1 : ∀ s, s < S → rhCenter ((t + (s + 1)) + m * P) 1 = rhCenter (t + (s + 1)) 1) :
    RhOrAgree t (m * P) 1 S := by
  have h := rhOrAgree_of_col_agree t (m * P) 0 S (fun s _ => by
    rw [rhCenter_zero_eq_center, rhCenter_zero_eq_center]
    exact Rule30UOR.Scale.center_mul hper m (t + s) (by omega)) h1
  simpa using h

theorem periodic_col_one_of_rhOrAgree_one
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t S : Nat) (ht : T ≤ t)
    (hor : RhOrAgree t (m * P) 1 S) :
    ∀ s, s < S → rhCenter ((t + (s + 1)) + m * P) 1 = rhCenter (t + (s + 1)) 1 := by
  intro s hs
  have h_or := hor s hs
  rw [show t + (s + 1) = (t + s) + 1 by omega]
  exact periodic_rhCenter_step_one_eq_of_or_eq T P hP hper m (t + s) (by omega) h_or

/-- **1-Column Inward Step of Right-Half Window Determination (`rhCenter_inward_determine_step`)**:
    if `RhColAgree t Q (p0 + 1) (S + 1)` and `RhOrAgree t Q (p0 + 1) (S + 1)` hold, then `RhColAgree t Q p0 S` and `RhOrAgree t Q p0 S` hold! -/
theorem rhCenter_inward_determine_step (t Q p0 S : Nat)
    (hcol : RhColAgree t Q (p0 + 1) (S + 1))
    (hor : RhOrAgree t Q (p0 + 1) (S + 1)) :
    RhColAgree t Q p0 S ∧ RhOrAgree t Q p0 S := by
  have hcol0 : RhColAgree t Q p0 S := by
    intro s hs
    have h1 := hcol (s + 1) (by omega)
    have h_or := hor s (by omega)
    rw [show (p0 + 1) + 1 = p0 + 2 by omega] at h_or
    rw [rhCenter_inward_step ((t + s) + Q) p0,
      rhCenter_inward_step (t + s) p0,
      show ((t + s) + Q) + 1 = (t + (s + 1)) + Q by omega,
      show (t + s) + 1 = t + (s + 1) by omega,
      h1, h_or]
  refine ⟨hcol0, fun s hs => ?_⟩
  rw [hcol0 s (by omega), hcol s (by omega)]

/-- **Multi-Column Inward Right-Half Window Determination (`rhCenter_inward_determine`)**:
    in the driven right half `rhCenter`, if `RhColAgree t Q (p0 + K) (S + K)` and `RhOrAgree t Q (p0 + K) (S + K)` hold, then marching `K` columns inward toward column 0 determines `RhColAgree t Q p0 S` and `RhOrAgree t Q p0 S`! -/
theorem rhCenter_inward_determine (t Q p0 S K : Nat)
    (hcol : RhColAgree t Q (p0 + K) (S + K))
    (hor : RhOrAgree t Q (p0 + K) (S + K)) :
    RhColAgree t Q p0 S ∧ RhOrAgree t Q p0 S := by
  induction K generalizing p0 S with
  | zero =>
    simpa using And.intro hcol hor
  | succ K ih =>
    have hcol' : RhColAgree t Q ((p0 + 1) + K) ((S + 1) + K) := by
      intro s hs
      have := hcol s (by omega)
      rwa [show p0 + (K + 1) = (p0 + 1) + K by omega] at this
    have hor' : RhOrAgree t Q ((p0 + 1) + K) ((S + 1) + K) := by
      intro s hs
      have := hor s (by omega)
      rwa [show p0 + (K + 1) = (p0 + 1) + K by omega] at this
    obtain ⟨hc1, ho1⟩ := ih (p0 + 1) (S + 1) hcol' hor'
    exact rhCenter_inward_determine_step t Q p0 S hc1 ho1

/-- **Right-Half Spatial Band Agreement from Right-Boundary Column Trace (`rhBandAgree_of_inward_determine`)**:
    if `RhColAgree t Q (p0 + L) L` holds on `[t, t + L]` and `RhOrAgree t Q (p0 + L) L` holds on `[t, t + L)`, then `rhCenter_inward_determine` at `s = 0` proves `RhBandAgree t Q p0 L` across the entire spatial band `[p0, p0 + L]` at time `t`! -/
theorem rhBandAgree_of_inward_determine (t Q p0 L : Nat)
    (hcol : RhColAgree t Q (p0 + L) L)
    (hor : RhOrAgree t Q (p0 + L) L) :
    RhBandAgree t Q p0 L := by
  intro i hi
  have hcol_i : RhColAgree t Q ((p0 + i) + (L - i)) (i + (L - i)) := by
    intro s hs
    have := hcol s (by omega)
    rwa [show p0 + L = (p0 + i) + (L - i) by omega] at this
  have hor_i : RhOrAgree t Q ((p0 + i) + (L - i)) (i + (L - i)) := by
    intro s hs
    have := hor s (by omega)
    rwa [show p0 + L = (p0 + i) + (L - i) by omega] at this
  have hdet := (rhCenter_inward_determine t Q (p0 + i) i (L - i) hcol_i hor_i).1 0 (by omega)
  simpa using hdet

/-- **Unconditional Right-Edge `RhBandAgree` Outside the Light Cone (`rhBandAgree_outside_cone`)**:
    for `t + Q < p0`, `RhBandAgree t Q p0 L` holds unconditionally. -/
theorem rhBandAgree_outside_cone (t Q p0 L : Nat) (h : t + Q < p0) :
    RhBandAgree t Q p0 L := by
  intro i _
  rw [rhCenter_gt_eq_false (t + Q) (p0 + i) (by omega),
    rhCenter_gt_eq_false t (p0 + i) (by omega)]

/-- **`2^k`-Scale Forward Band Transport of `RhBandAgree` (`rhBandAgree_scale_step`)**:
    for `p0 + L + 2^(k+1) ≤ t`, if `RhBandAgree` holds on the three `2^k`-spaced bands `[p0, p0 + L]`, `[p0 + 2^k, p0 + 2^k + L]`, and `[p0 + 2^(k+1), p0 + 2^(k+1) + L]` at time `t`, and `WinWittAgree t k Q (t - (p0 + L)) L` holds at time `t`, then `rhCenter_scale_step` transports agreement forward by `2^k` steps to `RhBandAgree (t + 2^k) Q (p0 + 2^k) L`! -/
theorem rhBandAgree_scale_step (t k Q p0 L : Nat)
    (hp : p0 + L + twopow (k + 1) ≤ t)
    (h0 : RhBandAgree t Q p0 L)
    (h1 : RhBandAgree t Q (p0 + twopow k) L)
    (h2 : RhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hw : WinWittAgree t k Q (t - (p0 + L)) L) :
    RhBandAgree (t + twopow k) Q (p0 + twopow k) L := by
  intro i hi
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hsQ := rhCenter_scale_step (t + Q) k (p0 + i) (by omega)
  have hs0 := rhCenter_scale_step t k (p0 + i) (by omega)
  have hb0 := h0 i hi
  have hb1 := h1 i hi
  have hb2 := h2 i hi
  have hwi := hw (L - i) (by omega)
  rw [show (t - (p0 + L)) + (L - i) + Q = (t + Q) - (p0 + i) by omega,
    show (t - (p0 + L)) + (L - i) = t - (p0 + i) by omega] at hwi
  rw [show ((t + twopow k) + Q) = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega,
    hsQ, hs0,
    show (p0 + i) + twopow k = (p0 + twopow k) + i by omega,
    show (p0 + i) + twopow (k + 1) = (p0 + twopow (k + 1)) + i by omega,
    hb0, hb1, hb2, hwi]

/-- **`2^k`-Scale Inward Band Transport of `RhBandAgree` (`rhBandAgree_scale_inward_step`)**:
    for `p0 + L + 2^(k+1) ≤ t`, if `RhBandAgree (t + 2^k) Q (p0 + 2^k) L` holds at time `t + 2^k`, `RhBandAgree` holds on `[p0 + 2^k, p0 + 2^k + L]` and `[p0 + 2^(k+1), p0 + 2^(k+1) + L]` at time `t`, and `WinWittAgree t k Q (t - (p0 + L)) L` holds at time `t`, then `rhCenter_scale_inward_step` transports agreement inward by `2^k` columns to `RhBandAgree t Q p0 L`! -/
theorem rhBandAgree_scale_inward_step (t k Q p0 L : Nat)
    (hp : p0 + L + twopow (k + 1) ≤ t)
    (hlate : RhBandAgree (t + twopow k) Q (p0 + twopow k) L)
    (h1 : RhBandAgree t Q (p0 + twopow k) L)
    (h2 : RhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hw : WinWittAgree t k Q (t - (p0 + L)) L) :
    RhBandAgree t Q p0 L := by
  intro i hi
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hsQ := rhCenter_scale_inward_step (t + Q) k (p0 + i) (by omega)
  have hs0 := rhCenter_scale_inward_step t k (p0 + i) (by omega)
  have hbl := hlate i hi
  have hb1 := h1 i hi
  have hb2 := h2 i hi
  have hwi := hw (L - i) (by omega)
  rw [show (t - (p0 + L)) + (L - i) + Q = (t + Q) - (p0 + i) by omega,
    show (t - (p0 + L)) + (L - i) = t - (p0 + i) by omega] at hwi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hbl
  rw [hsQ, hs0, hbl,
    show (p0 + i) + twopow k = (p0 + twopow k) + i by omega,
    show (p0 + i) + twopow (k + 1) = (p0 + twopow (k + 1)) + i by omega,
    hb1, hb2, hwi]

/-- **`WinWittAgree` from `RhBandAgree` on Three `2^k`-Bands and Late Band (`winWittAgree_of_rhBandAgree_scale`)**:
    for `p0 + L + 2^(k+1) ≤ t`, if `RhBandAgree` holds on `[p0, p0 + L]`, `[p0 + 2^k, p0 + 2^k + L]`, and `[p0 + 2^(k+1), p0 + 2^(k+1) + L]` at time `t` and `RhBandAgree (t + 2^k) Q (p0 + 2^k) L` holds at time `t + 2^k`, then `WinWittAgree t k Q (t - (p0 + L)) L` holds at time `t`! -/
theorem winWittAgree_of_rhBandAgree_scale (t k Q p0 L : Nat)
    (hp : p0 + L + twopow (k + 1) ≤ t)
    (h0 : RhBandAgree t Q p0 L)
    (h1 : RhBandAgree t Q (p0 + twopow k) L)
    (h2 : RhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hlate : RhBandAgree (t + twopow k) Q (p0 + twopow k) L) :
    WinWittAgree t k Q (t - (p0 + L)) L := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hr0 : RowAgree t Q ((t - (p0 + L)) - twopow (k + 1)) L := by
    have := rowAgree_right_of_rhBandAgree t Q (p0 + twopow (k + 1)) L (by omega) h2
    rwa [show t - ((p0 + twopow (k + 1)) + L) = (t - (p0 + L)) - twopow (k + 1) by omega] at this
  have hr1 : RowAgree t Q ((t - (p0 + L)) - twopow k) L := by
    have := rowAgree_right_of_rhBandAgree t Q (p0 + twopow k) L (by omega) h1
    rwa [show t - ((p0 + twopow k) + L) = (t - (p0 + L)) - twopow k by omega] at this
  have hr2 : RowAgree t Q (t - (p0 + L)) L :=
    rowAgree_right_of_rhBandAgree t Q p0 L (by omega) h0
  have hrl : RowAgree (t + twopow k) Q (t - (p0 + L)) L := by
    have := rowAgree_right_of_rhBandAgree (t + twopow k) Q (p0 + twopow k) L (by omega) hlate
    rwa [show (t + twopow k) - ((p0 + twopow k) + L) = t - (p0 + L) by omega] at this
  exact winWittAgree_of_rowAgree_three_and_late t k Q (t - (p0 + L)) L
    (by omega) hr0 hr1 hr2 hrl

/-- **Establishing `SectorRhBandAgree` from Right-Half Window Determination at Sector Times (`sectorRhBandAgree_of_inward_determine`)**:
    if at every sector time `t_u = (d + u * 2^k) + 1` (`u ≥ U`), `RhColAgree t_u Q (2^k + 1) (2^k + 1)` and `RhOrAgree t_u Q (2^k + 1) (2^k + 1)` hold, then `SectorRhBandAgree k d U Q` holds! -/
theorem sectorRhBandAgree_of_inward_determine (k d U Q : Nat)
    (hcol : ∀ u, U ≤ u → RhColAgree ((d + u * twopow k) + 1) Q (twopow k + 1) (twopow k + 1))
    (hor : ∀ u, U ≤ u → RhOrAgree ((d + u * twopow k) + 1) Q (twopow k + 1) (twopow k + 1)) :
    SectorRhBandAgree k d U Q := by
  intro u hu
  have hcol_u : RhColAgree ((d + u * twopow k) + 1) Q (0 + (twopow k + 1)) (twopow k + 1) := by
    simpa using hcol u hu
  have hor_u : RhOrAgree ((d + u * twopow k) + 1) Q (0 + (twopow k + 1)) (twopow k + 1) := by
    simpa using hor u hu
  exact rhBandAgree_of_inward_determine ((d + u * twopow k) + 1) Q 0 (twopow k + 1) hcol_u hor_u

/-- **Refutation of Right-Half Window Agreement at Column `2^k + 1` for `Q = lcm(P, 2^k)` (`not_sector_inward_determine_lcmPeriod`)**:
    under `CenterPeriodic T P` (`0 < P`), for `1 ≤ U`, `1 ≤ d`, and `T ≤ d + U * 2^k`, if `RhColAgree ((d + u * 2^k) + 1) (lcmPeriod P k) (2^k + 1) (2^k + 1)` holds for all `u ≥ U`, then it is impossible that `RhOrAgree ((d + u * 2^k) + 1) (lcmPeriod P k) (2^k + 1) (2^k + 1)` holds for all `u ≥ U`! -/
theorem not_sector_inward_determine_lcmPeriod
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U : Nat) (hU : 1 ≤ U) (hd : 1 ≤ d) (ht : T ≤ d + U * twopow k)
    (hcol : ∀ u, U ≤ u → RhColAgree ((d + u * twopow k) + 1) (lcmPeriod P k) (twopow k + 1) (twopow k + 1))
    (hor : ∀ u, U ≤ u → RhOrAgree ((d + u * twopow k) + 1) (lcmPeriod P k) (twopow k + 1) (twopow k + 1)) :
    False := by
  have hsec := sectorRhBandAgree_of_inward_determine k d U (lcmPeriod P k) hcol hor
  exact not_sector_rhBandAgree_lcmPeriod T P hP hper k d U hU hd ht hsec

theorem not_sector_inward_determine_lcmPeriod_prop
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U : Nat) (hU : 1 ≤ U) (hd : 1 ≤ d) (ht : T ≤ d + U * twopow k)
    (hcol : ∀ u, U ≤ u → RhColAgree ((d + u * twopow k) + 1) (lcmPeriod P k) (twopow k + 1) (twopow k + 1)) :
    ¬ (∀ u, U ≤ u → RhOrAgree ((d + u * twopow k) + 1) (lcmPeriod P k) (twopow k + 1) (twopow k + 1)) := by
  intro hor
  exact not_sector_inward_determine_lcmPeriod T P hP hper k d U hU hd ht hcol hor

/-! ### Unrestricted `2^k`-Scale `rhCenter` Laws (`p ≤ t`), Black-Cell Masking, `Z_down` Splitting, and Right-Threshold Geometry in `rhCenter` -/

/-- **Unrestricted `2^k`-Scale Forward Step of `rhCenter` (`rhCenter_scale_step_le`)**:
    because `rhCenter t q = false` outside the light cone (`q > t`), the `2^k`-scale step identity holds for ALL `p ≤ t` right up to the right edge `p = t` (weakening `p + 2^(k+1) ≤ t` to `p ≤ t`)! -/
theorem rhCenter_scale_step_le (t k p : Nat) (hp : p ≤ t) :
    rhCenter (t + twopow k) (p + twopow k) =
      bxor
        (bxor (bxor (rhCenter t p) (rhCenter t (p + twopow k)))
          (rhCenter t (p + twopow (k + 1))))
        ((winWitt t (twopow k)).testBit (t - p)) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  rw [rhCenter_eq_row_testBit (t + twopow k) (p + twopow k) (by omega),
    show (t + twopow k) - (p + twopow k) = t - p by omega]
  have hsc := congrArg (fun n => n.testBit (t - p)) (row_scale t k)
  rw [Nat.testBit_xor] at hsc
  have hphi : (phiScale k (row t)).testBit (t - p) =
      ((rhCenter t p ^^ rhCenter t (p + twopow k)) ^^
        rhCenter t (p + twopow (k + 1))) := by
    change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
      ((row t) <<< (twopow k + twopow k))).testBit (t - p) = _
    simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
    have h0 : (row t).testBit (t - p) = rhCenter t p :=
      (rhCenter_eq_row_testBit t p hp).symm
    have h1 : (decide (t - p ≥ twopow k) && (row t).testBit ((t - p) - twopow k)) =
        rhCenter t (p + twopow k) := by
      by_cases hle1 : p + twopow k ≤ t
      · have d1 : decide (t - p ≥ twopow k) = true := decide_eq_true (by omega)
        rw [d1, Bool.true_and, show (t - p) - twopow k = t - (p + twopow k) by omega,
          ← rhCenter_eq_row_testBit t (p + twopow k) hle1]
      · have d1 : decide (t - p ≥ twopow k) = false := decide_eq_false (by omega)
        rw [d1, Bool.false_and, rhCenter_gt_eq_false t (p + twopow k) (by omega)]
    have h2 : (decide (t - p ≥ twopow k + twopow k) &&
        (row t).testBit ((t - p) - (twopow k + twopow k))) =
        rhCenter t (p + twopow (k + 1)) := by
      by_cases hle2 : p + twopow (k + 1) ≤ t
      · have d2 : decide (t - p ≥ twopow k + twopow k) = true := decide_eq_true (by omega)
        rw [d2, Bool.true_and,
          show (t - p) - (twopow k + twopow k) = t - (p + twopow (k + 1)) by omega,
          ← rhCenter_eq_row_testBit t (p + twopow (k + 1)) hle2]
      · have d2 : decide (t - p ≥ twopow k + twopow k) = false := decide_eq_false (by omega)
        rw [d2, Bool.false_and, rhCenter_gt_eq_false t (p + twopow (k + 1)) (by omega)]
    rw [h0, h1, h2]
  rw [hsc, hphi]
  simp only [bxor_eq_xor]

/-- **Unrestricted `2^k`-Scale Inward Step of `rhCenter` (`rhCenter_scale_inward_step_le`)**:
    for ALL `p ≤ t` (right up to the right edge `p = t`), `rhCenter t p` is determined by `rhCenter (t + 2^k) (p + 2^k)`, `rhCenter t (p + 2^k)`, `rhCenter t (p + 2^(k+1))`, and `(winWitt t (2^k)).testBit (t - p)`. -/
theorem rhCenter_scale_inward_step_le (t k p : Nat) (hp : p ≤ t) :
    rhCenter t p =
      bxor
        (bxor (bxor (rhCenter (t + twopow k) (p + twopow k)) (rhCenter t (p + twopow k)))
          (rhCenter t (p + twopow (k + 1))))
        ((winWitt t (twopow k)).testBit (t - p)) := by
  rw [rhCenter_scale_step_le t k p hp]
  simp only [bxor_eq_xor]
  cases rhCenter t p <;>
    cases rhCenter t (p + twopow k) <;>
    cases rhCenter t (p + twopow (k + 1)) <;>
    cases (winWitt t (twopow k)).testBit (t - p) <;> rfl

/-- **Unrestricted `2^k`-Scale Forward Band Transport of `RhBandAgree` (`rhBandAgree_scale_step_le`)**:
    weakens `p0 + L + 2^(k+1) ≤ t` in `rhBandAgree_scale_step` to `p0 + L ≤ t` (allowing `[p0, p0 + L]` to reach all the way to the right edge `t`)! -/
theorem rhBandAgree_scale_step_le (t k Q p0 L : Nat)
    (hp : p0 + L ≤ t)
    (h0 : RhBandAgree t Q p0 L)
    (h1 : RhBandAgree t Q (p0 + twopow k) L)
    (h2 : RhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hw : WinWittAgree t k Q (t - (p0 + L)) L) :
    RhBandAgree (t + twopow k) Q (p0 + twopow k) L := by
  intro i hi
  have hsQ := rhCenter_scale_step_le (t + Q) k (p0 + i) (by omega)
  have hs0 := rhCenter_scale_step_le t k (p0 + i) (by omega)
  have hb0 := h0 i hi
  have hb1 := h1 i hi
  have hb2 := h2 i hi
  have hwi := hw (L - i) (by omega)
  rw [show (t - (p0 + L)) + (L - i) + Q = (t + Q) - (p0 + i) by omega,
    show (t - (p0 + L)) + (L - i) = t - (p0 + i) by omega] at hwi
  rw [show ((t + twopow k) + Q) = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega,
    hsQ, hs0,
    show (p0 + i) + twopow k = (p0 + twopow k) + i by omega,
    show (p0 + i) + twopow (k + 1) = (p0 + twopow (k + 1)) + i by omega,
    hb0, hb1, hb2, hwi]

/-- **Unrestricted `2^k`-Scale Inward Band Transport of `RhBandAgree` (`rhBandAgree_scale_inward_step_le`)**:
    weakens `p0 + L + 2^(k+1) ≤ t` in `rhBandAgree_scale_inward_step` to `p0 + L ≤ t` (allowing `[p0, p0 + L]` to reach all the way to the right edge `t`)! -/
theorem rhBandAgree_scale_inward_step_le (t k Q p0 L : Nat)
    (hp : p0 + L ≤ t)
    (hlate : RhBandAgree (t + twopow k) Q (p0 + twopow k) L)
    (h1 : RhBandAgree t Q (p0 + twopow k) L)
    (h2 : RhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hw : WinWittAgree t k Q (t - (p0 + L)) L) :
    RhBandAgree t Q p0 L := by
  intro i hi
  have hsQ := rhCenter_scale_inward_step_le (t + Q) k (p0 + i) (by omega)
  have hs0 := rhCenter_scale_inward_step_le t k (p0 + i) (by omega)
  have hbl := hlate i hi
  have hb1 := h1 i hi
  have hb2 := h2 i hi
  have hwi := hw (L - i) (by omega)
  rw [show (t - (p0 + L)) + (L - i) + Q = (t + Q) - (p0 + i) by omega,
    show (t - (p0 + L)) + (L - i) = t - (p0 + i) by omega] at hwi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hbl
  rw [hsQ, hs0, hbl,
    show (p0 + i) + twopow k = (p0 + twopow k) + i by omega,
    show (p0 + i) + twopow (k + 1) = (p0 + twopow (k + 1)) + i by omega,
    hb1, hb2, hwi]

/-- **Unrestricted `WinWittAgree` from `RhBandAgree` on Three `2^k`-Bands and Late Band (`winWittAgree_of_rhBandAgree_scale_le`)**:
    weakens `p0 + L + 2^(k+1) ≤ t` in `winWittAgree_of_rhBandAgree_scale` to `p0 + L ≤ t`! -/
theorem winWittAgree_of_rhBandAgree_scale_le (t k Q p0 L : Nat)
    (hp : p0 + L ≤ t)
    (h0 : RhBandAgree t Q p0 L)
    (h1 : RhBandAgree t Q (p0 + twopow k) L)
    (h2 : RhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hlate : RhBandAgree (t + twopow k) Q (p0 + twopow k) L) :
    WinWittAgree t k Q (t - (p0 + L)) L := by
  intro j hj
  have i := L - j
  have hi : L - j ≤ L := by omega
  have hsQ := rhCenter_scale_step_le (t + Q) k (p0 + (L - j)) (by omega)
  have hs0 := rhCenter_scale_step_le t k (p0 + (L - j)) (by omega)
  have hb0 := h0 (L - j) hi
  have hb1 := h1 (L - j) hi
  have hb2 := h2 (L - j) hi
  have hbl := hlate (L - j) hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega] at hbl
  rw [show (p0 + (L - j)) + twopow k = (p0 + twopow k) + (L - j) by omega,
    show (p0 + (L - j)) + twopow (k + 1) = (p0 + twopow (k + 1)) + (L - j) by omega] at hsQ hs0
  rw [show (t - (p0 + L)) + j + Q = (t + Q) - (p0 + (L - j)) by omega,
    show (t - (p0 + L)) + j = t - (p0 + (L - j)) by omega]
  rw [hbl, hb0, hb1, hb2] at hsQ
  revert hsQ hs0
  simp only [bxor_eq_xor]
  cases rhCenter (t + twopow k) ((p0 + twopow k) + (L - j)) <;>
    cases rhCenter t (p0 + (L - j)) <;>
    cases rhCenter t ((p0 + twopow k) + (L - j)) <;>
    cases rhCenter t ((p0 + twopow (k + 1)) + (L - j)) <;>
    cases (winWitt (t + Q) (twopow k)).testBit ((t + Q) - (p0 + (L - j))) <;>
    cases (winWitt t (twopow k)).testBit (t - (p0 + (L - j))) <;> decide

/-- **Multi-Step `2^k`-Scale Inward Iteration of `RhBandAgree` (`rhBandAgree_scale_inward_steps`)**:
    for `p0 + M * 2^k + L ≤ t`, if `RhBandAgree` holds on the two outer bands `p0 + M * 2^k` and `p0 + (M + 1) * 2^k` at time `t`, and for every `m < M`, `RhBandAgree (t + 2^k) Q (p0 + (m + 1) * 2^k) L` and `WinWittAgree t k Q (t - (p0 + m * 2^k + L)) L` hold, then `RhBandAgree t Q p0 L` holds (marching `M * 2^k` columns inward across `M` scale steps)! -/
theorem rhBandAgree_scale_inward_steps (t k Q p0 L M : Nat)
    (hp : p0 + M * twopow k + L ≤ t)
    (hM : RhBandAgree t Q (p0 + M * twopow k) L)
    (hM1 : RhBandAgree t Q (p0 + (M + 1) * twopow k) L)
    (hlate : ∀ m, m < M → RhBandAgree (t + twopow k) Q (p0 + (m + 1) * twopow k) L)
    (hw : ∀ m, m < M → WinWittAgree t k Q (t - (p0 + m * twopow k + L)) L) :
    RhBandAgree t Q p0 L := by
  have hpair : RhBandAgree t Q p0 L ∧ RhBandAgree t Q (p0 + twopow k) L := by
    induction M generalizing p0 with
    | zero =>
      simp only [Nat.zero_mul, Nat.add_zero, Nat.zero_add, Nat.one_mul] at hM hM1
      exact ⟨hM, hM1⟩
    | succ M ih =>
      have hp' : (p0 + twopow k) + M * twopow k + L ≤ t := by
        rw [Nat.add_mul, Nat.one_mul] at hp; omega
      have hM' : RhBandAgree t Q ((p0 + twopow k) + M * twopow k) L := by
        rwa [show (p0 + twopow k) + M * twopow k = p0 + (M + 1) * twopow k by
          rw [Nat.add_mul, Nat.one_mul]; omega]
      have hM1' : RhBandAgree t Q ((p0 + twopow k) + (M + 1) * twopow k) L := by
        rwa [show (p0 + twopow k) + (M + 1) * twopow k = p0 + (M + 1 + 1) * twopow k by
          rw [Nat.add_mul (M + 1) 1 (twopow k), Nat.one_mul]; omega]
      have hlate' : ∀ m, m < M →
          RhBandAgree (t + twopow k) Q ((p0 + twopow k) + (m + 1) * twopow k) L := by
        intro m hm
        have := hlate (m + 1) (by omega)
        rwa [show p0 + (m + 1 + 1) * twopow k = (p0 + twopow k) + (m + 1) * twopow k by
          rw [Nat.add_mul (m + 1) 1 (twopow k), Nat.one_mul]; omega] at this
      have hw' : ∀ m, m < M →
          WinWittAgree t k Q (t - ((p0 + twopow k) + m * twopow k + L)) L := by
        intro m hm
        have := hw (m + 1) (by omega)
        rwa [show p0 + (m + 1) * twopow k + L = (p0 + twopow k) + m * twopow k + L by
          rw [Nat.add_mul, Nat.one_mul]; omega] at this
      obtain ⟨hb1, hb2⟩ := ih (p0 + twopow k) hp' hM' hM1' hlate' hw'
      have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
      have hb2_eq : RhBandAgree t Q (p0 + twopow (k + 1)) L := by
        rwa [show p0 + twopow (k + 1) = (p0 + twopow k) + twopow k by omega]
      have hl0 : RhBandAgree (t + twopow k) Q (p0 + twopow k) L := by
        have := hlate 0 (by omega)
        simpa using this
      have hw0 : WinWittAgree t k Q (t - (p0 + L)) L := by
        have := hw 0 (by omega)
        simpa using this
      have hb0 := rhBandAgree_scale_inward_step_le t k Q p0 L (by omega) hl0 hb1 hb2_eq hw0
      exact ⟨hb0, hb1⟩
  exact hpair.1

/-- **Black-Left Masking in `rhCenter` Inward Step (`rhCenter_inward_of_black_left`)**:
    whenever `rhCenter t (p + 1) = true`, the OR `rhCenter t (p + 1) || rhCenter t (p + 2)` is `true` regardless of column `p + 2`, so `rhCenter t p = !rhCenter (t + 1) (p + 1)`! -/
theorem rhCenter_inward_of_black_left (t p : Nat)
    (hb : rhCenter t (p + 1) = true) :
    rhCenter t p = !rhCenter (t + 1) (p + 1) := by
  rw [rhCenter_inward_step t p, hb, Bool.true_or, bxor_eq_xor]
  cases rhCenter (t + 1) (p + 1) <;> rfl

/-- **Black-Right Masking in `rhCenter` Inward Step (`rhCenter_inward_of_black_right`)**:
    whenever `rhCenter t (p + 2) = true`, the OR `rhCenter t (p + 1) || rhCenter t (p + 2)` is `true` regardless of column `p + 1` at time `t`, so `rhCenter t p = !rhCenter (t + 1) (p + 1)`! -/
theorem rhCenter_inward_of_black_right (t p : Nat)
    (hb : rhCenter t (p + 2) = true) :
    rhCenter t p = !rhCenter (t + 1) (p + 1) := by
  rw [rhCenter_inward_step t p, hb, Bool.or_true, bxor_eq_xor]
  cases rhCenter (t + 1) (p + 1) <;> rfl

/-- **Inward `Q`-Agreement Across a Black Column (`rhCenter_agree_of_black_left`)**:
    whenever `rhCenter (t + Q) (p + 1) = true` and `rhCenter t (p + 1) = true`, agreement of column `p + 1` at `t + 1` (`rhCenter ((t + 1) + Q) (p + 1) = rhCenter (t + 1) (p + 1)`) immediately implies `rhCenter (t + Q) p = rhCenter t p` without needing column `p + 2`! -/
theorem rhCenter_agree_of_black_left (t Q p : Nat)
    (hbQ : rhCenter (t + Q) (p + 1) = true)
    (hb0 : rhCenter t (p + 1) = true)
    (hnext : rhCenter ((t + 1) + Q) (p + 1) = rhCenter (t + 1) (p + 1)) :
    rhCenter (t + Q) p = rhCenter t p := by
  rw [rhCenter_inward_of_black_left (t + Q) p hbQ,
    rhCenter_inward_of_black_left t p hb0,
    show (t + Q) + 1 = (t + 1) + Q by omega,
    hnext]

/-- **White-Pair Splitting from Constant Diagonal Step (`rhCenter_white_pair_of_diag_eq`, `Z_down` in `rhCenter`)**:
    whenever `rhCenter (t + 1) (p + 1) = rhCenter t p`, the OR input `rhCenter t (p + 1) || rhCenter t (p + 2)` must be `false`, forcing BOTH `rhCenter t (p + 1) = false` and `rhCenter t (p + 2) = false` simultaneously! -/
theorem rhCenter_white_pair_of_diag_eq (t p : Nat)
    (heq : rhCenter (t + 1) (p + 1) = rhCenter t p) :
    rhCenter t (p + 1) = false ∧ rhCenter t (p + 2) = false := by
  have hs := rhCenter_step_succ t p
  rw [heq] at hs
  revert hs
  simp only [bxor_eq_xor]
  cases rhCenter t p <;>
    cases rhCenter t (p + 1) <;>
    cases rhCenter t (p + 2) <;> decide

/-- **Constant Diagonal Step from White Pair (`rhCenter_diag_eq_of_white_pair`)**:
    whenever `rhCenter t (p + 1) = false` and `rhCenter t (p + 2) = false`, `rhCenter (t + 1) (p + 1) = rhCenter t p`. -/
theorem rhCenter_diag_eq_of_white_pair (t p : Nat)
    (hw1 : rhCenter t (p + 1) = false)
    (hw2 : rhCenter t (p + 2) = false) :
    rhCenter (t + 1) (p + 1) = rhCenter t p := by
  rw [rhCenter_step_succ t p, hw1, hw2, Bool.false_or, bxor_eq_xor, Bool.xor_false]

/-- **Right-Threshold Diagonal Shift Law in `rhCenter` (`rhCenter_diag_shift_twopow_eq_of_threshold`)**:
    for `IsRightThreshold k J` and `s ≤ J` (up to the full 2-adic threshold `J` of scale `k`), shifting both time and column by any multiple `u * 2^k` preserves `rhCenter`:
    `rhCenter ((p + s) + u * 2^k) (p + u * 2^k) = rhCenter (p + s) p`. -/
theorem rhCenter_diag_shift_twopow_eq_of_threshold (k J p s u : Nat)
    (hJ : IsRightThreshold k J) (hs : s ≤ J) :
    rhCenter ((p + s) + u * twopow k) (p + u * twopow k) = rhCenter (p + s) p := by
  rw [rhCenter_eq_rdiag ((p + s) + u * twopow k) (p + u * twopow k) (by omega),
    rhCenter_eq_rdiag (p + s) p (by omega),
    show ((p + s) + u * twopow k) - (p + u * twopow k) = s by omega,
    show (p + s) - p = s by omega]
  exact rdiag_restart_of_threshold k J s u (p + s) hJ hs

/-- **Right-Threshold Sector-Column Center Law in `rhCenter` (`rhCenter_sector_diag_eq_center_of_threshold`)**:
    for `IsRightThreshold k J` and `s ≤ J`, column `u * 2^k` of `rhCenter` at time `s + u * 2^k` equals `center s`! -/
theorem rhCenter_sector_diag_eq_center_of_threshold (k J s u : Nat)
    (hJ : IsRightThreshold k J) (hs : s ≤ J) :
    rhCenter (s + u * twopow k) (u * twopow k) = Rule30UOR.Core.center s := by
  have h := rhCenter_diag_shift_twopow_eq_of_threshold k J 0 s u hJ hs
  simpa [rhCenter_zero_eq_center] using h

/-- **Right-Edge White Zero-Gap of Width `J` at Multiples of `2^k` in `rhCenter` (`rhCenter_zero_gap_of_threshold`)**:
    for `IsRightThreshold k J`, `1 ≤ j ≤ J`, and `j ≤ u * 2^k`, `rhCenter (u * 2^k) (u * 2^k - j) = false` (a white gap of width `J` immediately inside the right edge at every multiple `u * 2^k`)! -/
theorem rhCenter_zero_gap_of_threshold (k J u j : Nat)
    (hJ : IsRightThreshold k J) (hj1 : 1 ≤ j) (hjJ : j ≤ J) (hju : j ≤ u * twopow k) :
    rhCenter (u * twopow k) (u * twopow k - j) = false := by
  rw [rhCenter_eq_rdiag (u * twopow k) (u * twopow k - j) (by omega),
    show u * twopow k - (u * twopow k - j) = j by omega,
    show u * twopow k = 0 + u * twopow k by omega,
    rdiag_restart_of_threshold k J j u 0 hJ hjJ]
  exact rdiag_gt_two_mul 0 j (by omega)

/-- **Right-Edge Black Run of Width `J + 1` at `t = (u + 1) * 2^k - 1` in `rhCenter` (`rhCenter_last_one_of_threshold`)**:
    for `IsRightThreshold k J`, `j ≤ J`, and `j ≤ (u + 1) * 2^k - 1`, `rhCenter ((u + 1) * 2^k - 1) (((u + 1) * 2^k - 1) - j) = true` (every cell within distance `J` of the right edge is black one step before each multiple of `2^k`)! -/
theorem rhCenter_last_one_of_threshold (k J u j : Nat)
    (hJ : IsRightThreshold k J) (hjJ : j ≤ J) (hju : j ≤ (u + 1) * twopow k - 1) :
    rhCenter ((u + 1) * twopow k - 1) (((u + 1) * twopow k - 1) - j) = true := by
  have hp : 0 < twopow k := by
    rw [twopow_eq_pow k]
    exact Nat.two_pow_pos k
  rw [rhCenter_eq_rdiag ((u + 1) * twopow k - 1) (((u + 1) * twopow k - 1) - j) (by omega),
    show ((u + 1) * twopow k - 1) - (((u + 1) * twopow k - 1) - j) = j by omega,
    show (u + 1) * twopow k - 1 = (twopow k - 1) + u * twopow k by
      rw [Nat.add_mul, Nat.one_mul]; omega,
    rdiag_restart_of_threshold k J j u (twopow k - 1) hJ hjJ,
    Rule30UOR.Right.rdiag_eq_R, twopow_eq_pow k]
  exact Rule30UOR.KitConstructive.last_one j k
    (Rule30UOR.KitConstructive.per_mono_le hjJ hJ.1)

/-- **Right-Half Windowed Witt Column Agreement (`RhWinWittAgree`)**:
    the `2^k`-windowed Witt vector `winWitt · (2^k)` at rows `t + Q` and `t` has identical testBits at `t + Q - (p0 + i)` and `t - (p0 + i)` for all `0 ≤ i ≤ L`! -/
def RhWinWittAgree (t k Q p0 L : Nat) : Prop :=
  ∀ i : Nat, i ≤ L →
    (winWitt (t + Q) (twopow k)).testBit ((t + Q) - (p0 + i)) =
      (winWitt t (twopow k)).testBit (t - (p0 + i))

/-- **Bit `0` of `winWitt` is Always `false` (`winWitt_testBit_zero`)**:
    for all `t, n : Nat`, `(winWitt t n).testBit 0 = false` because every carry contribution in `winWitt_step` is shifted left by 1! -/
theorem winWitt_testBit_zero (t n : Nat) :
    (winWitt t n).testBit 0 = false := by
  induction n with
  | zero =>
    change (0 : Nat).testBit 0 = false
    decide
  | succ m ih =>
    have d1 : decide (0 ≥ 1) = false := rfl
    have d2 : decide (0 ≥ 2) = false := rfl
    change (((winWitt t m) ^^^ ((winWitt t m) <<< 1)) ^^^
      ((winWitt t m) <<< 2) ^^^ (carry (row (t + m)) <<< 1)).testBit 0 = false
    simp only [Nat.testBit_xor, Nat.testBit_shiftLeft, ih, d1, d2, Bool.false_and, Bool.xor_false]

/-- **Unconditional `2^k`-Scale Step of `rhCenter` (`rhCenter_scale_step_uncond`)**:
    for all `t, k, p` (with no bound `p ≤ t` required!), `rhCenter (t + 2^k) (p + 2^k) = bxor (bxor (bxor (rhCenter t p) (rhCenter t (p + 2^k))) (rhCenter t (p + 2^(k+1)))) ((winWitt t (2^k)).testBit (t - p))`! -/
theorem rhCenter_scale_step_uncond (t k p : Nat) :
    rhCenter (t + twopow k) (p + twopow k) =
      bxor
        (bxor (bxor (rhCenter t p) (rhCenter t (p + twopow k)))
          (rhCenter t (p + twopow (k + 1))))
        ((winWitt t (twopow k)).testBit (t - p)) := by
  by_cases hpt : p ≤ t
  · exact rhCenter_scale_step_le t k p hpt
  · have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
    have hsub : t - p = 0 := by omega
    rw [rhCenter_gt_eq_false (t + twopow k) (p + twopow k) (by omega),
      rhCenter_gt_eq_false t p (by omega),
      rhCenter_gt_eq_false t (p + twopow k) (by omega),
      rhCenter_gt_eq_false t (p + twopow (k + 1)) (by omega),
      hsub, winWitt_testBit_zero t (twopow k)]
    rfl

/-- **Unconditional `2^k`-Scale Inward Step of `rhCenter` (`rhCenter_scale_inward_step_uncond`)**:
    for all `t, k, p` (with no bound `p ≤ t` required!), `rhCenter t p = bxor (bxor (bxor (rhCenter (t + 2^k) (p + 2^k)) (rhCenter t (p + 2^k))) (rhCenter t (p + 2^(k+1)))) ((winWitt t (2^k)).testBit (t - p))`! -/
theorem rhCenter_scale_inward_step_uncond (t k p : Nat) :
    rhCenter t p =
      bxor
        (bxor (bxor (rhCenter (t + twopow k) (p + twopow k)) (rhCenter t (p + twopow k)))
          (rhCenter t (p + twopow (k + 1))))
        ((winWitt t (twopow k)).testBit (t - p)) := by
  rw [rhCenter_scale_step_uncond t k p]
  simp only [bxor_eq_xor]
  cases rhCenter t p <;>
    cases rhCenter t (p + twopow k) <;>
    cases rhCenter t (p + twopow (k + 1)) <;>
    cases (winWitt t (twopow k)).testBit (t - p) <;> rfl

/-- **`RhWinWittAgree` from `WinWittAgree` Inside the Light Cone (`rhWinWittAgree_of_winWittAgree`)**:
    for `p0 + L ≤ t`, `WinWittAgree t k Q (t - (p0 + L)) L` implies `RhWinWittAgree t k Q p0 L`! -/
theorem rhWinWittAgree_of_winWittAgree (t k Q p0 L : Nat) (hpt : p0 + L ≤ t)
    (hw : WinWittAgree t k Q (t - (p0 + L)) L) :
    RhWinWittAgree t k Q p0 L := by
  intro i hi
  have hwi := hw (L - i) (by omega)
  rwa [show (t - (p0 + L)) + (L - i) + Q = (t + Q) - (p0 + i) by omega,
    show (t - (p0 + L)) + (L - i) = t - (p0 + i) by omega] at hwi

/-- **`RhWinWittAgree` Outside the Light Cone (`rhWinWittAgree_outside_cone`)**:
    if `t + Q ≤ p0`, then `RhWinWittAgree t k Q p0 L` holds unconditionally (since both `(t + Q) - (p0 + i) = 0` and `t - (p0 + i) = 0`, where bit `0` of `winWitt` is always `false`)! -/
theorem rhWinWittAgree_outside_cone (t k Q p0 L : Nat) (hout : t + Q ≤ p0) :
    RhWinWittAgree t k Q p0 L := by
  intro i _hi
  rw [show (t + Q) - (p0 + i) = 0 by omega,
    show t - (p0 + i) = 0 by omega,
    winWitt_testBit_zero (t + Q) (twopow k),
    winWitt_testBit_zero t (twopow k)]

/-- **Unconditional `2^k`-Scale Inward Step of `RhBandAgree` (`rhBandAgree_scale_inward_step_uncond`)**:
    for all `t, k, Q, p0, L`, `RhBandAgree (t + 2^k) Q (p0 + 2^k) L`, `RhBandAgree t Q (p0 + 2^k) L`, `RhBandAgree t Q (p0 + 2^(k+1)) L`, and `RhWinWittAgree t k Q p0 L` imply `RhBandAgree t Q p0 L`! -/
theorem rhBandAgree_scale_inward_step_uncond (t k Q p0 L : Nat)
    (hlate : RhBandAgree (t + twopow k) Q (p0 + twopow k) L)
    (h1 : RhBandAgree t Q (p0 + twopow k) L)
    (h2 : RhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hw : RhWinWittAgree t k Q p0 L) :
    RhBandAgree t Q p0 L := by
  intro i hi
  have hsQ := rhCenter_scale_inward_step_uncond (t + Q) k (p0 + i)
  have hs0 := rhCenter_scale_inward_step_uncond t k (p0 + i)
  have hbl := hlate i hi
  have hb1 := h1 i hi
  have hb2 := h2 i hi
  have hwi := hw i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hbl
  rw [hsQ, hs0, hbl,
    show (p0 + i) + twopow k = (p0 + twopow k) + i by omega,
    show (p0 + i) + twopow (k + 1) = (p0 + twopow (k + 1)) + i by omega,
    hb1, hb2, hwi]

/-- **Multi-Step Unconditional `2^k`-Scale Inward Propagation of `RhBandAgree` (`rhBandAgree_scale_inward_steps_uncond`)**:
    propagates `RhBandAgree` inward across `M` blocks of width `2^k` down to `RhBandAgree t Q p0 L` with no light-cone bound required! -/
theorem rhBandAgree_scale_inward_steps_uncond (t k Q p0 L M : Nat)
    (hM : RhBandAgree t Q (p0 + M * twopow k) L)
    (hM1 : RhBandAgree t Q (p0 + (M + 1) * twopow k) L)
    (hlate : ∀ m : Nat, m < M → RhBandAgree (t + twopow k) Q (p0 + (m + 1) * twopow k) L)
    (hw : ∀ m : Nat, m < M → RhWinWittAgree t k Q (p0 + m * twopow k) L) :
    RhBandAgree t Q p0 L := by
  have hpair : RhBandAgree t Q p0 L ∧ RhBandAgree t Q (p0 + twopow k) L := by
    induction M generalizing p0 with
    | zero =>
      simp only [Nat.zero_mul, Nat.add_zero, Nat.zero_add, Nat.one_mul] at hM hM1
      exact ⟨hM, hM1⟩
    | succ M ih =>
      have hM' : RhBandAgree t Q ((p0 + twopow k) + M * twopow k) L := by
        rwa [show (p0 + twopow k) + M * twopow k = p0 + (M + 1) * twopow k by
          rw [Nat.add_mul, Nat.one_mul]; omega]
      have hM1' : RhBandAgree t Q ((p0 + twopow k) + (M + 1) * twopow k) L := by
        rwa [show (p0 + twopow k) + (M + 1) * twopow k = p0 + (M + 1 + 1) * twopow k by
          rw [Nat.add_mul (M + 1) 1 (twopow k), Nat.one_mul]; omega]
      have hlate' : ∀ m, m < M →
          RhBandAgree (t + twopow k) Q ((p0 + twopow k) + (m + 1) * twopow k) L := by
        intro m hm
        have := hlate (m + 1) (by omega)
        rwa [show p0 + (m + 1 + 1) * twopow k = (p0 + twopow k) + (m + 1) * twopow k by
          rw [Nat.add_mul (m + 1) 1 (twopow k), Nat.one_mul]; omega] at this
      have hw' : ∀ m, m < M →
          RhWinWittAgree t k Q ((p0 + twopow k) + m * twopow k) L := by
        intro m hm
        have := hw (m + 1) (by omega)
        rwa [show p0 + (m + 1) * twopow k = (p0 + twopow k) + m * twopow k by
          rw [Nat.add_mul, Nat.one_mul]; omega] at this
      obtain ⟨hb1, hb2⟩ := ih (p0 + twopow k) hM' hM1' hlate' hw'
      have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
      have hb2_eq : RhBandAgree t Q (p0 + twopow (k + 1)) L := by
        rwa [show p0 + twopow (k + 1) = (p0 + twopow k) + twopow k by omega]
      have hl0 : RhBandAgree (t + twopow k) Q (p0 + twopow k) L := by
        have := hlate 0 (by omega)
        simpa using this
      have hw0 : RhWinWittAgree t k Q p0 L := by
        have := hw 0 (by omega)
        simpa using this
      have hb0 := rhBandAgree_scale_inward_step_uncond t k Q p0 L hl0 hb1 hb2_eq hw0
      exact ⟨hb0, hb1⟩
  exact hpair.1

/-- **Inward `2^k`-Scale Cone Reduction of `RhBandAgree` (`rhBandAgree_of_scale_inward_cone`)**:
    if `t + Q < p0 + M * 2^k` (so `p0 + M * 2^k` and `p0 + (M + 1) * 2^k` lie strictly outside the light cone of `t + Q`), then `RhBandAgree t Q p0 L` follows purely from `RhBandAgree (t + 2^k) Q (p0 + (m + 1) * 2^k) L` and `RhWinWittAgree t k Q (p0 + m * 2^k) L` for `m < M` (with both outer boundary conditions at time `t` discharged automatically by `rhBandAgree_outside_cone`)! -/
theorem rhBandAgree_of_scale_inward_cone (t k Q p0 L M : Nat)
    (hcone : t + Q < p0 + M * twopow k)
    (hlate : ∀ m : Nat, m < M → RhBandAgree (t + twopow k) Q (p0 + (m + 1) * twopow k) L)
    (hw : ∀ m : Nat, m < M → RhWinWittAgree t k Q (p0 + m * twopow k) L) :
    RhBandAgree t Q p0 L := by
  have hM1_cone : t + Q < p0 + (M + 1) * twopow k := by
    rw [Nat.add_mul, Nat.one_mul]; omega
  exact rhBandAgree_scale_inward_steps_uncond t k Q p0 L M
    (rhBandAgree_outside_cone t Q (p0 + M * twopow k) L hcone)
    (rhBandAgree_outside_cone t Q (p0 + (M + 1) * twopow k) L hM1_cone)
    hlate
    hw

/-- **Diagonal Difference of `rhCenter` Equals OR of Right Pair (`rhCenter_diag_diff_eq_or`)**:
    for all `t, p`, `bxor (rhCenter (t + 1) (p + 1)) (rhCenter t p) = (rhCenter t (p + 1) || rhCenter t (p + 2))`! -/
theorem rhCenter_diag_diff_eq_or (t p : Nat) :
    bxor (rhCenter (t + 1) (p + 1)) (rhCenter t p) =
      (rhCenter t (p + 1) || rhCenter t (p + 2)) := by
  rw [rhCenter_step_succ t p]
  cases rhCenter t p <;> cases rhCenter t (p + 1) <;> cases rhCenter t (p + 2) <;> rfl

/-- **Right-Half `Q`-Defect Diagonal Conservation Law (`rhCenter_defect_diag_step`)**:
    for all `t, Q, p`, `bxor (bxor (rhCenter (t + 1 + Q) (p + 1)) (rhCenter (t + 1) (p + 1))) (bxor (rhCenter (t + Q) p) (rhCenter t p)) = bxor (rhCenter (t + Q) (p + 1) || rhCenter (t + Q) (p + 2)) (rhCenter t (p + 1) || rhCenter t (p + 2))`! -/
theorem rhCenter_defect_diag_step (t Q p : Nat) :
    bxor (bxor (rhCenter (t + 1 + Q) (p + 1)) (rhCenter (t + 1) (p + 1)))
      (bxor (rhCenter (t + Q) p) (rhCenter t p)) =
      bxor (rhCenter (t + Q) (p + 1) || rhCenter (t + Q) (p + 2))
        (rhCenter t (p + 1) || rhCenter t (p + 2)) := by
  rw [show t + 1 + Q = (t + Q) + 1 by omega,
    rhCenter_step_succ (t + Q) p, rhCenter_step_succ t p]
  cases rhCenter (t + Q) p <;>
    cases rhCenter (t + Q) (p + 1) <;>
    cases rhCenter (t + Q) (p + 2) <;>
    cases rhCenter t p <;>
    cases rhCenter t (p + 1) <;>
    cases rhCenter t (p + 2) <;>
    rfl

/-- **Generalized Masked-Jen Gate for `rhCenter` Defect Under Column `p + 1` Agreement (`rhCenter_defect_diag_step_of_col_eq`)**:
    if `rhCenter (t + Q) (p + 1) = rhCenter t (p + 1)`, then the diagonal step of the `Q`-defect equals the masked defect at column `p + 2`:
    `bxor (bxor (rhCenter (t + 1 + Q) (p + 1)) (rhCenter (t + 1) (p + 1))) (bxor (rhCenter (t + Q) p) (rhCenter t p)) = ((!rhCenter t (p + 1)) && bxor (rhCenter (t + Q) (p + 2)) (rhCenter t (p + 2)))`! -/
theorem rhCenter_defect_diag_step_of_col_eq (t Q p : Nat)
    (hp1 : rhCenter (t + Q) (p + 1) = rhCenter t (p + 1)) :
    bxor (bxor (rhCenter (t + 1 + Q) (p + 1)) (rhCenter (t + 1) (p + 1)))
      (bxor (rhCenter (t + Q) p) (rhCenter t p)) =
      ((!rhCenter t (p + 1)) && bxor (rhCenter (t + Q) (p + 2)) (rhCenter t (p + 2))) := by
  rw [rhCenter_defect_diag_step t Q p, hp1]
  cases rhCenter t (p + 1) <;>
    cases rhCenter (t + Q) (p + 2) <;>
    cases rhCenter t (p + 2) <;>
    rfl

/-- **Inward `Q`-Defect Gate Under Two-Time Agreement at Column `p + 1` (`rhCenter_defect_inward_of_col_eq_two`)**:
    if column `p + 1` agrees at `t` and `t + 1`, then the `Q`-defect at `(t, p)` equals the masked `Q`-defect at `(t, p + 2)`:
    `bxor (rhCenter (t + Q) p) (rhCenter t p) = ((!rhCenter t (p + 1)) && bxor (rhCenter (t + Q) (p + 2)) (rhCenter t (p + 2)))`! -/
theorem rhCenter_defect_inward_of_col_eq_two (t Q p : Nat)
    (hp1 : rhCenter (t + Q) (p + 1) = rhCenter t (p + 1))
    (hp1_succ : rhCenter (t + 1 + Q) (p + 1) = rhCenter (t + 1) (p + 1)) :
    bxor (rhCenter (t + Q) p) (rhCenter t p) =
      ((!rhCenter t (p + 1)) && bxor (rhCenter (t + Q) (p + 2)) (rhCenter t (p + 2))) := by
  have h := rhCenter_defect_diag_step_of_col_eq t Q p hp1
  rw [hp1_succ] at h
  revert h
  cases rhCenter (t + 1) (p + 1) <;>
    cases rhCenter (t + Q) p <;>
    cases rhCenter t p <;>
    cases rhCenter t (p + 1) <;>
    cases rhCenter (t + Q) (p + 2) <;>
    cases rhCenter t (p + 2) <;>
    decide

/-- **Local Right-Permutive Step Across a White Cell in `rhCenter` (`rhCenter_outward_of_white_mid`)**:
    when `rhCenter t (p + 1) = false`, column `p + 2` is determined uniquely by `(t + 1, p + 1)` and `(t, p)`:
    `rhCenter t (p + 2) = bxor (rhCenter (t + 1) (p + 1)) (rhCenter t p)`! -/
theorem rhCenter_outward_of_white_mid (t p : Nat)
    (hw : rhCenter t (p + 1) = false) :
    rhCenter t (p + 2) = bxor (rhCenter (t + 1) (p + 1)) (rhCenter t p) := by
  rw [rhCenter_step_succ t p, hw]
  cases rhCenter t p <;> cases rhCenter t (p + 2) <;> rfl

/-- **Outward `Q`-Agreement Across a White Cell in `rhCenter` (`rhCenter_agree_outward_of_white_mid`)**:
    if `rhCenter t (p + 1) = false`, `rhCenter (t + Q) p = rhCenter t p`, `rhCenter (t + Q) (p + 1) = rhCenter t (p + 1)`, and `rhCenter (t + 1 + Q) (p + 1) = rhCenter (t + 1) (p + 1)`, then `rhCenter (t + Q) (p + 2) = rhCenter t (p + 2)`! -/
theorem rhCenter_agree_outward_of_white_mid (t Q p : Nat)
    (hw : rhCenter t (p + 1) = false)
    (hp : rhCenter (t + Q) p = rhCenter t p)
    (hp1 : rhCenter (t + Q) (p + 1) = rhCenter t (p + 1))
    (hp1_succ : rhCenter (t + 1 + Q) (p + 1) = rhCenter (t + 1) (p + 1)) :
    rhCenter (t + Q) (p + 2) = rhCenter t (p + 2) := by
  have hwQ : rhCenter (t + Q) (p + 1) = false := by rw [hp1, hw]
  rw [rhCenter_outward_of_white_mid (t + Q) p hwQ,
    rhCenter_outward_of_white_mid t p hw,
    show t + Q + 1 = t + 1 + Q by omega,
    hp1_succ, hp]

/-- **Inward-Outward `Q`-Defect Equality Across a White Cell in `rhCenter` (`rhCenter_defect_inward_of_white_mid`)**:
    when `rhCenter t (p + 1) = false`, `rhCenter (t + Q) (p + 1) = rhCenter t (p + 1)`, and `rhCenter (t + 1 + Q) (p + 1) = rhCenter (t + 1) (p + 1)`, the `Q`-defect at `(t, p)` equals the `Q`-defect at `(t, p + 2)`:
    `bxor (rhCenter (t + Q) p) (rhCenter t p) = bxor (rhCenter (t + Q) (p + 2)) (rhCenter t (p + 2))`! -/
theorem rhCenter_defect_inward_of_white_mid (t Q p : Nat)
    (hw : rhCenter t (p + 1) = false)
    (hp1 : rhCenter (t + Q) (p + 1) = rhCenter t (p + 1))
    (hp1_succ : rhCenter (t + 1 + Q) (p + 1) = rhCenter (t + 1) (p + 1)) :
    bxor (rhCenter (t + Q) p) (rhCenter t p) =
      bxor (rhCenter (t + Q) (p + 2)) (rhCenter t (p + 2)) := by
  rw [rhCenter_defect_inward_of_col_eq_two t Q p hp1 hp1_succ, hw]
  rfl

/-- **Inward `Q`-Agreement from Vanishing Masked Defect Under Two-Time Agreement at Column `p + 1` (`rhCenter_agree_inward_of_col_eq_two`)**:
    if column `p + 1` agrees at `t` and `t + 1`, and `((!rhCenter t (p + 1)) && bxor (rhCenter (t + Q) (p + 2)) (rhCenter t (p + 2))) = false`, then `rhCenter (t + Q) p = rhCenter t p`! -/
theorem rhCenter_agree_inward_of_col_eq_two (t Q p : Nat)
    (hp1 : rhCenter (t + Q) (p + 1) = rhCenter t (p + 1))
    (hp1_succ : rhCenter (t + 1 + Q) (p + 1) = rhCenter (t + 1) (p + 1))
    (hmask : ((!rhCenter t (p + 1)) && bxor (rhCenter (t + Q) (p + 2)) (rhCenter t (p + 2))) = false) :
    rhCenter (t + Q) p = rhCenter t p := by
  have h := rhCenter_defect_inward_of_col_eq_two t Q p hp1 hp1_succ
  rw [hmask] at h
  revert h
  cases rhCenter (t + Q) p <;> cases rhCenter t p <;> decide

/-! ### Batch 6: Finite-Horizon Left-Light-Cone Refutation Engine (`LhBandAgree`, `LhColAgree`), Finite-Sector Refutation of `RhBandAgree`, and Linear Defect Derivative at Column `-2` -/

/-- Spatial band `Q`-agreement of the driven left half `lhCenter`:
    at rows `t` and `t + Q`, columns `-(p0 + i)` (`0 ≤ i ≤ L`) of `lhCenter` agree. -/
def LhBandAgree (t Q p0 L : Nat) : Prop :=
  ∀ i : Nat, i ≤ L →
    lhCenter (t + Q) (p0 + i) = lhCenter t (p0 + i)

/-- Time-trace `Q`-agreement of column `-p0` of the driven left half `lhCenter`:
    at times `t + s` and `(t + s) + Q` (`s ≤ S`), column `-p0` of `lhCenter` agrees. -/
def LhColAgree (t Q p0 S : Nat) : Prop :=
  ∀ s : Nat, s ≤ S →
    lhCenter ((t + s) + Q) p0 = lhCenter (t + s) p0

/-- **Unconditional Left-Light-Cone Obstruction to `LhBandAgree` (`not_lhBandAgree_of_lt_add`)**:
    for any `t, Q, L` with `0 < Q` and `t + Q ≤ L`, `LhBandAgree t Q 0 L` is impossible because at `i = t + Q`, `lhCenter (t + Q) (t + Q) = true` while `lhCenter t (t + Q) = false`! -/
theorem not_lhBandAgree_of_lt_add (t Q L : Nat)
    (hQ : 0 < Q) (hL : t + Q ≤ L) :
    ¬ LhBandAgree t Q 0 L := by
  intro h
  have hi := h (t + Q) hL
  rw [Nat.zero_add,
    lhCenter_self_eq_true (t + Q),
    lhCenter_gt_eq_false t (t + Q) (by omega)] at hi
  revert hi; decide

/-- **1-Column Outward Step of Left-Half Time-Trace Determination (`lhCenter_outward_determine_step`)**:
    by left-permutivity (`lhCenter_outward_step`), if `LhColAgree t Q p0 (S + 1)` and `LhColAgree t Q (p0 + 1) (S + 1)` hold, then `LhColAgree t Q (p0 + 2) S` holds! -/
theorem lhCenter_outward_determine_step (t Q p0 S : Nat)
    (h0 : LhColAgree t Q p0 (S + 1))
    (h1 : LhColAgree t Q (p0 + 1) (S + 1)) :
    LhColAgree t Q (p0 + 2) S := by
  intro s hs
  have hs0 := h0 s (by omega)
  have hs1 := h1 s (by omega)
  have hnext1 := h1 (s + 1) (by omega)
  rw [lhCenter_outward_step ((t + s) + Q) p0,
    lhCenter_outward_step (t + s) p0,
    show ((t + s) + Q) + 1 = (t + (s + 1)) + Q by omega,
    show (t + s) + 1 = t + (s + 1) by omega,
    hnext1, hs1, hs0]

/-- **Multi-Column Outward Left-Half Time-Trace Determination (`lhCenter_outward_determine`)**:
    if `LhColAgree t Q p0 (S + K)` and `LhColAgree t Q (p0 + 1) (S + K)` hold, then marching `K` columns outward toward the left edge determines `LhColAgree t Q (p0 + K) S ∧ LhColAgree t Q (p0 + K + 1) S`! -/
theorem lhCenter_outward_determine (t Q p0 S K : Nat)
    (h0 : LhColAgree t Q p0 (S + K))
    (h1 : LhColAgree t Q (p0 + 1) (S + K)) :
    LhColAgree t Q (p0 + K) S ∧ LhColAgree t Q (p0 + K + 1) S := by
  induction K generalizing p0 S with
  | zero =>
    simpa using And.intro h0 h1
  | succ K ih =>
    have h0' : LhColAgree t Q p0 ((S + 1) + K) := by
      intro s hs; exact h0 s (by omega)
    have h1' : LhColAgree t Q (p0 + 1) ((S + 1) + K) := by
      intro s hs; exact h1 s (by omega)
    obtain ⟨hcK, hcK1⟩ := ih p0 (S + 1) h0' h1'
    have hcK2 := lhCenter_outward_determine_step t Q (p0 + K) S hcK hcK1
    refine ⟨?_, ?_⟩
    · intro s hs
      have := hcK1 s (by omega)
      rwa [show p0 + (K + 1) = p0 + K + 1 by omega]
    · intro s hs
      have := hcK2 s hs
      rwa [show p0 + (K + 1) + 1 = (p0 + K) + 2 by omega]

/-- **Spatial Left-Half Band Agreement from Center Time-Trace (`lhBandAgree_of_outward_determine`)**:
    if `LhColAgree t Q p0 L` and `LhColAgree t Q (p0 + 1) L` hold on `[t, t + L]`, then `LhBandAgree t Q p0 (L + 1)` holds across the entire spatial band `[p0, p0 + L + 1]` at time `t`! -/
theorem lhBandAgree_of_outward_determine (t Q p0 L : Nat)
    (h0 : LhColAgree t Q p0 L)
    (h1 : LhColAgree t Q (p0 + 1) L) :
    LhBandAgree t Q p0 (L + 1) := by
  intro i hi
  rcases Nat.eq_zero_or_pos i with rfl | hpos
  · have := h0 0 (by omega)
    simpa using this
  · obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
    have hj : j ≤ L := by omega
    have h0_j : LhColAgree t Q p0 (0 + j) := by
      intro s hs; exact h0 s (by omega)
    have h1_j : LhColAgree t Q (p0 + 1) (0 + j) := by
      intro s hs; exact h1 s (by omega)
    have hdet := (lhCenter_outward_determine t Q p0 0 j h0_j h1_j).2 0 (by omega)
    simpa [Nat.add_assoc] using hdet

/-- **Finite-Horizon Incompatibility of `LhColAgree` at Columns `0` and `1` (`not_lhColAgree_zero_one_of_pos`)**:
    for any `t, Q, S` with `0 < Q` and `t + Q ≤ S + 1`, `LhColAgree t Q 0 S` and `LhColAgree t Q 1 S` cannot both hold! -/
theorem not_lhColAgree_zero_one_of_pos (t Q S : Nat)
    (hQ : 0 < Q) (hS : t + Q ≤ S + 1)
    (h0 : LhColAgree t Q 0 S) :
    ¬ LhColAgree t Q 1 S := by
  intro h1
  have hband := lhBandAgree_of_outward_determine t Q 0 S h0 h1
  exact not_lhBandAgree_of_lt_add t Q (S + 1) hQ hS hband

/-- **Periodic Center Supplies `LhColAgree` at Column `0` (`periodic_lhColAgree_zero`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, S` with `T ≤ t`, `LhColAgree t (m * P) 0 S` holds unconditionally! -/
theorem periodic_lhColAgree_zero
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t S : Nat) (ht : T ≤ t) :
    LhColAgree t (m * P) 0 S := by
  intro s _hs
  rw [lhCenter_zero_eq_center, lhCenter_zero_eq_center]
  exact Rule30UOR.Scale.center_mul hper m (t + s) (by omega)

/-- **Finite-Horizon Death Clock for Column `-1` Under Periodic Center (`not_periodic_lhColAgree_one_horizon`)**:
    under `CenterPeriodic T P` (`0 < P`), for any `m, t, S` with `0 < m`, `T ≤ t`, and `t + m * P ≤ S + 1`, column `-1` (`lhCenter · 1`) cannot agree with period `m * P` across the finite horizon `[t, t + S]`! -/
theorem not_periodic_lhColAgree_one_horizon
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t S : Nat) (hm : 0 < m) (ht : T ≤ t) (hS : t + m * P ≤ S + 1) :
    ¬ LhColAgree t (m * P) 1 S := by
  have hQ : 0 < m * P := Nat.mul_pos hm hP
  exact not_lhColAgree_zero_one_of_pos t (m * P) S hQ hS
    (periodic_lhColAgree_zero T P hP hper m t S ht)

/-- **Transfer of Time-Trace Agreement from `rhCenter · 1` to `lhCenter · 1` via the §6 `Φ` Fixed-Point Law (`periodic_lhColAgree_one_of_rhColAgree_one`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, S` with `T ≤ t`, `RhColAgree t (m * P) 1 S` implies `LhColAgree t (m * P) 1 S`! -/
theorem periodic_lhColAgree_one_of_rhColAgree_one
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t S : Nat) (ht : T ≤ t)
    (hrh : RhColAgree t (m * P) 1 S) :
    LhColAgree t (m * P) 1 S := by
  intro s hs
  have hr := hrh s hs
  have hc0 : Rule30UOR.Core.center ((t + s) + m * P) = Rule30UOR.Core.center (t + s) :=
    Rule30UOR.Scale.center_mul hper m (t + s) (by omega)
  have hc1 : Rule30UOR.Core.center (((t + s) + m * P) + 1) = Rule30UOR.Core.center ((t + s) + 1) := by
    rw [show ((t + s) + m * P) + 1 = ((t + s) + 1) + m * P by omega]
    exact Rule30UOR.Scale.center_mul hper m ((t + s) + 1) (by omega)
  rw [lhCenter_one_eq_of_center_fixed ((t + s) + m * P),
    lhCenter_one_eq_of_center_fixed (t + s),
    hc0, hc1, hr]

/-- **Finite-Horizon Death Clock for Right-Half Column `+1` Under Periodic Center (`not_periodic_rhColAgree_one_horizon`)**:
    under `CenterPeriodic T P` (`0 < P`), for any `m, t, S` with `0 < m`, `T ≤ t`, and `t + m * P ≤ S + 1`, column `+1` of the driven right half (`rhCenter · 1`) cannot agree with period `m * P` across the finite horizon `[t, t + S]`! -/
theorem not_periodic_rhColAgree_one_horizon
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t S : Nat) (hm : 0 < m) (ht : T ≤ t) (hS : t + m * P ≤ S + 1) :
    ¬ RhColAgree t (m * P) 1 S := by
  intro hrh
  exact not_periodic_lhColAgree_one_horizon T P hP hper m t S hm ht hS
    (periodic_lhColAgree_one_of_rhColAgree_one T P hP hper m t S ht hrh)

/-- **Time-Trace Agreement `RhColAgree` at Column `+1` from Spatial `RhBandAgree` (`periodic_rhColAgree_one_of_rhBandAgree_zero`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, S` with `T ≤ t`, `RhBandAgree t (m * P) 0 (S + 1)` at time `t` implies `RhColAgree t (m * P) 1 S` across `[t, t + S]`! -/
theorem periodic_rhColAgree_one_of_rhBandAgree_zero
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t S : Nat) (ht : T ≤ t)
    (hband : RhBandAgree t (m * P) 0 (S + 1)) :
    RhColAgree t (m * P) 1 S := by
  intro s hs
  have hsub : RhBandAgree t (m * P) 0 (1 + s) := by
    intro i hi
    exact hband i (by omega)
  have hstep := periodic_rhBandAgree_zero_steps T P hP hper m t 1 s ht hsub
  exact hstep 1 (by omega)

/-- **Gluing `M` Finite Sector Bands into `RhColAgree` Across `M * 2^k` Steps (`periodic_rhColAgree_one_of_finite_sectors`)**:
    under `CenterPeriodic T P` (`0 < P`), for `1 ≤ M` and `T ≤ d + U * 2^k`, if `RhBandAgree ((d + (U + j) * 2^k) + 1) (m * P) 0 (2^k + 1)` holds for `j < M` (only `M` finite sector times!), then `RhColAgree ((d + U * 2^k) + 1) (m * P) 1 (M * 2^k)` holds! -/
theorem periodic_rhColAgree_one_of_finite_sectors
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U M m : Nat) (hM : 1 ≤ M) (ht : T ≤ d + U * twopow k)
    (hsec : ∀ j : Nat, j < M →
      RhBandAgree ((d + (U + j) * twopow k) + 1) (m * P) 0 (twopow k + 1)) :
    RhColAgree ((d + U * twopow k) + 1) (m * P) 1 (M * twopow k) := by
  rcases M with _ | M
  · omega
  · clear hM
    induction M with
    | zero =>
      have h0 := hsec 0 (by omega)
      rw [Nat.add_zero] at h0
      rw [Nat.one_mul]
      exact periodic_rhColAgree_one_of_rhBandAgree_zero T P hP hper m
        ((d + U * twopow k) + 1) (twopow k) (by omega) h0
    | succ M ih =>
      have h_prev := ih (fun j hj => hsec j (by omega))
      have h_last := hsec (M + 1) (by omega)
      have hU_le : U * twopow k ≤ (U + (M + 1)) * twopow k :=
        Nat.mul_le_mul_right (twopow k) (by omega)
      have h_last_col := periodic_rhColAgree_one_of_rhBandAgree_zero T P hP hper m
        ((d + (U + (M + 1)) * twopow k) + 1) (twopow k) (by omega) h_last
      intro s hs
      by_cases hle : s ≤ (M + 1) * twopow k
      · exact h_prev s hle
      · have hs' : s - (M + 1) * twopow k ≤ twopow k := by
          rw [Nat.add_mul (M + 1) 1 (twopow k), Nat.one_mul] at hs; omega
        have hstep := h_last_col (s - (M + 1) * twopow k) hs'
        have heq : ((d + (U + (M + 1)) * twopow k) + 1) + (s - (M + 1) * twopow k) =
            ((d + U * twopow k) + 1) + s := by
          rw [Nat.add_mul U (M + 1) (twopow k)]; omega
        rwa [heq] at hstep

/-- **Finite-Sector Refutation of `RhBandAgree` at Any Multiple `Q = m * P` (`not_periodic_finite_sector_rhBandAgree_mul`)**:
    under `CenterPeriodic T P` (`0 < P`), for `1 ≤ M`, `0 < m`, `T ≤ d + U * 2^k`, and `(d + U * 2^k) + m * P ≤ M * 2^k`, it is impossible that `RhBandAgree ((d + (U + j) * 2^k) + 1) (m * P) 0 (2^k + 1)` holds for all `j < M`! -/
theorem not_periodic_finite_sector_rhBandAgree_mul
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U M m : Nat) (hM : 1 ≤ M) (hm : 0 < m)
    (ht : T ≤ d + U * twopow k)
    (hS : (d + U * twopow k) + m * P ≤ M * twopow k) :
    ¬ (∀ j : Nat, j < M →
      RhBandAgree ((d + (U + j) * twopow k) + 1) (m * P) 0 (twopow k + 1)) := by
  intro hsec
  have hcol := periodic_rhColAgree_one_of_finite_sectors T P hP hper k d U M m hM ht hsec
  exact not_periodic_rhColAgree_one_horizon T P hP hper m
    ((d + U * twopow k) + 1) (M * twopow k) hm (by omega) (by omega) hcol

/-- **Finite-Sector Refutation of `RhBandAgree` at `Q = lcm(P, 2^k)` (`not_periodic_finite_sector_rhBandAgree_lcmPeriod`)**:
    under `CenterPeriodic T P` (`0 < P`), for `1 ≤ M`, `T ≤ d + U * 2^k`, and `(d + U * 2^k) + lcmPeriod P k ≤ M * 2^k`, it is impossible that `RhBandAgree ((d + (U + j) * 2^k) + 1) (lcmPeriod P k) 0 (2^k + 1)` holds for all `j < M` (eliminating the infinite quantifier `∀ u ≥ U` in `not_sector_rhBandAgree_lcmPeriod`)! -/
theorem not_periodic_finite_sector_rhBandAgree_lcmPeriod
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (k d U M : Nat) (hM : 1 ≤ M)
    (ht : T ≤ d + U * twopow k)
    (hS : (d + U * twopow k) + lcmPeriod P k ≤ M * twopow k) :
    ¬ (∀ j : Nat, j < M →
      RhBandAgree ((d + (U + j) * twopow k) + 1) (lcmPeriod P k) 0 (twopow k + 1)) := by
  intro hsec
  have hm : 0 < twopow k / Nat.gcd P (twopow k) := lcmPeriod_div_pos P k hP
  have hsec' : ∀ j : Nat, j < M →
      RhBandAgree ((d + (U + j) * twopow k) + 1)
        ((twopow k / Nat.gcd P (twopow k)) * P) 0 (twopow k + 1) := by
    intro j hj
    rw [← lcmPeriod_eq_mul_period P k]
    exact hsec j hj
  have hS' : (d + U * twopow k) + (twopow k / Nat.gcd P (twopow k)) * P ≤ M * twopow k := by
    rwa [← lcmPeriod_eq_mul_period P k]
  exact not_periodic_finite_sector_rhBandAgree_mul T P hP hper k d U M
    (twopow k / Nat.gcd P (twopow k)) hM hm ht hS' hsec'

/-- **Exact Linearization of the Center-Adjacent OR Defect in `lhCenter` via the §6 `Φ` Fixed-Point Law (`periodic_lhCenter_or_zero_defect_eq`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t` with `T ≤ t`, because `lhCenter · 1` defect already vanishes at black center times by `lhCenter_one_eq_of_center_fixed`, the `m * P`-defect of `lhCenter · 1 || lhCenter · 0` equals the `m * P`-defect of `lhCenter · 1`! -/
theorem periodic_lhCenter_or_zero_defect_eq
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t : Nat) (ht : T ≤ t) :
    bxor (lhCenter (t + m * P) 1 || lhCenter (t + m * P) 0)
      (lhCenter t 1 || lhCenter t 0) =
      bxor (lhCenter (t + m * P) 1) (lhCenter t 1) := by
  have hc0 : Rule30UOR.Core.center (t + m * P) = Rule30UOR.Core.center t :=
    Rule30UOR.Scale.center_mul hper m t ht
  have hc1 : Rule30UOR.Core.center ((t + m * P) + 1) = Rule30UOR.Core.center (t + 1) := by
    rw [show (t + m * P) + 1 = (t + 1) + m * P by omega]
    exact Rule30UOR.Scale.center_mul hper m (t + 1) (by omega)
  rw [lhCenter_zero_eq_center (t + m * P), lhCenter_zero_eq_center t,
    lhCenter_one_eq_of_center_fixed (t + m * P),
    lhCenter_one_eq_of_center_fixed t,
    hc0, hc1]
  cases Rule30UOR.Core.center (t + 1) <;>
    cases Rule30UOR.Core.center t <;>
    cases rhCenter (t + m * P) 1 <;>
    cases rhCenter t 1 <;> rfl

/-- **Exact Linear Time-Derivative Law for the Column `-2` Defect in `lhCenter` (`periodic_lhCenter_two_defect_eq`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t` with `T ≤ t`, the `m * P`-defect of `lhCenter · 2` equals the linear discrete time-derivative of the `lhCenter · 1` defect:
    `bxor (lhCenter (t + m * P) 2) (lhCenter t 2) = bxor (bxor (lhCenter ((t + 1) + m * P) 1) (lhCenter (t + 1) 1)) (bxor (lhCenter (t + m * P) 1) (lhCenter t 1))`! -/
theorem periodic_lhCenter_two_defect_eq
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t : Nat) (ht : T ≤ t) :
    bxor (lhCenter (t + m * P) 2) (lhCenter t 2) =
      bxor
        (bxor (lhCenter ((t + 1) + m * P) 1) (lhCenter (t + 1) 1))
        (bxor (lhCenter (t + m * P) 1) (lhCenter t 1)) := by
  have hor := periodic_lhCenter_or_zero_defect_eq T P hP hper m t ht
  rw [lhCenter_outward_step (t + m * P) 0,
    lhCenter_outward_step t 0,
    show (t + m * P) + 1 = (t + 1) + m * P by omega]
  change bxor
      (bxor (lhCenter ((t + 1) + m * P) 1) (lhCenter (t + m * P) 1 || lhCenter (t + m * P) 0))
      (bxor (lhCenter (t + 1) 1) (lhCenter t 1 || lhCenter t 0)) = _
  rw [← hor]
  cases lhCenter ((t + 1) + m * P) 1 <;>
    cases lhCenter (t + 1) 1 <;>
    cases (lhCenter (t + m * P) 1 || lhCenter (t + m * P) 0) <;>
    cases (lhCenter t 1 || lhCenter t 0) <;> rfl

/-- **Unconditional Identity Between `lhCenter` and `row` Bit Readout (`lhCenter_eq_row_testBit_uncond`)**:
    for ALL `t, p : Nat` (no light-cone bound `p ≤ t` required, since both sides vanish when `t < p`), `lhCenter t p = (row t).testBit (t + p)`! -/
theorem lhCenter_eq_row_testBit_uncond (t p : Nat) :
    lhCenter t p = (row t).testBit (t + p) := by
  by_cases hp : p ≤ t
  · exact lhCenter_eq_row_testBit t p hp
  · rw [lhCenter_gt_eq_false t p (by omega),
      row_testBit,
      rdiag_gt_two_mul t (t + p) (by omega)]

theorem lhCenter_eq_row_testBit_uncond_prop (t p : Nat) :
    lhCenter t p = wittBitBool (row t) (t + p) :=
  lhCenter_eq_row_testBit_uncond t p

/-- **Fully Unconditional `2^k`-Scale Forward Step of `lhCenter` (`lhCenter_scale_step_uncond`)**:
    for ALL `t, k, p : Nat` (no light-cone bound required!), `lhCenter (t + 2^k) (p + 2^k)` equals `bxor (bxor (bxor (lhCenter t p) (lhCenter t (p + 2^k))) (lhCenter t (p + 2^(k+1)))) ((winWitt t (2^k)).testBit (t + p + 2^(k+1)))`! -/
theorem lhCenter_scale_step_uncond (t k p : Nat) :
    lhCenter (t + twopow k) (p + twopow k) =
      bxor
        (bxor (bxor (lhCenter t p) (lhCenter t (p + twopow k)))
          (lhCenter t (p + twopow (k + 1))))
        ((winWitt t (twopow k)).testBit (t + p + twopow (k + 1))) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  rw [lhCenter_eq_row_testBit_uncond (t + twopow k) (p + twopow k),
    show (t + twopow k) + (p + twopow k) = t + p + twopow (k + 1) by omega]
  have hsc := congrArg (fun n => n.testBit (t + p + twopow (k + 1))) (row_scale t k)
  rw [Nat.testBit_xor] at hsc
  have hphi : (phiScale k (row t)).testBit (t + p + twopow (k + 1)) =
      ((lhCenter t p ^^ lhCenter t (p + twopow k)) ^^
        lhCenter t (p + twopow (k + 1))) := by
    change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
      ((row t) <<< (twopow k + twopow k))).testBit (t + p + twopow (k + 1)) = _
    simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
    have d1 : decide (t + p + twopow (k + 1) ≥ twopow k) = true := decide_eq_true (by omega)
    have d2 : decide (t + p + twopow (k + 1) ≥ twopow k + twopow k) = true := decide_eq_true (by omega)
    rw [d1, d2, Bool.true_and, Bool.true_and,
      show t + p + twopow (k + 1) - twopow k = t + (p + twopow k) by omega,
      show t + p + twopow (k + 1) - (twopow k + twopow k) = t + p by omega,
      show t + p + twopow (k + 1) = t + (p + twopow (k + 1)) by omega,
      ← lhCenter_eq_row_testBit_uncond t (p + twopow (k + 1)),
      ← lhCenter_eq_row_testBit_uncond t (p + twopow k),
      ← lhCenter_eq_row_testBit_uncond t p]
    cases lhCenter t p <;>
      cases lhCenter t (p + twopow k) <;>
      cases lhCenter t (p + twopow (k + 1)) <;> rfl
  rw [hsc, hphi]
  simp only [bxor_eq_xor]

theorem lhCenter_scale_step_uncond_prop (t k p : Nat) :
    lhCenter (t + twopow k) (p + twopow k) =
      bxor
        (bxor (bxor (lhCenter t p) (lhCenter t (p + twopow k)))
          (lhCenter t (p + twopow (k + 1))))
        (wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1))) :=
  lhCenter_scale_step_uncond t k p

/-- **Fully Unconditional `2^k`-Scale Outward Step of `lhCenter` (`lhCenter_scale_outward_step_uncond`)**:
    for ALL `t, k, p : Nat`, solving `lhCenter_scale_step_uncond` for the outer column `lhCenter t (p + 2^(k+1))` expresses it in terms of `lhCenter (t + 2^k) (p + 2^k)`, `lhCenter t p`, `lhCenter t (p + 2^k)`, and `(winWitt t (2^k)).testBit (t + p + 2^(k+1))`! -/
theorem lhCenter_scale_outward_step_uncond (t k p : Nat) :
    lhCenter t (p + twopow (k + 1)) =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t p))
          (lhCenter t (p + twopow k)))
        ((winWitt t (twopow k)).testBit (t + p + twopow (k + 1))) := by
  rw [lhCenter_scale_step_uncond t k p]
  simp only [bxor_eq_xor]
  cases lhCenter t p <;>
    cases lhCenter t (p + twopow k) <;>
    cases lhCenter t (p + twopow (k + 1)) <;>
    cases (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) <;> rfl

theorem lhCenter_scale_outward_step_uncond_prop (t k p : Nat) :
    lhCenter t (p + twopow (k + 1)) =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t p))
          (lhCenter t (p + twopow k)))
        (wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1))) :=
  lhCenter_scale_outward_step_uncond t k p

/-- **Unconditional Cross-Center `2^k`-Scale Step Between `lhCenter` and `rhCenter` (`lhCenter_scale_cross_step`)**:
    for ALL `t, k, r : Nat` with `r ≤ 2^k` (no light-cone bound `r ≤ t` required!), `lhCenter (t + 2^k) (2^k - r)` equals `bxor (bxor (bxor (rhCenter t r) (lhCenter t (2^k - r))) (lhCenter t (2^(k+1) - r))) ((winWitt t (2^k)).testBit ((t + 2^(k+1)) - r))`! -/
theorem lhCenter_scale_cross_step (t k r : Nat) (hr : r ≤ twopow k) :
    lhCenter (t + twopow k) (twopow k - r) =
      bxor
        (bxor (bxor (rhCenter t r) (lhCenter t (twopow k - r)))
          (lhCenter t (twopow (k + 1) - r)))
        ((winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r)) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  rw [lhCenter_eq_row_testBit_uncond (t + twopow k) (twopow k - r),
    show (t + twopow k) + (twopow k - r) = (t + twopow (k + 1)) - r by omega]
  have hsc := congrArg (fun n => n.testBit ((t + twopow (k + 1)) - r)) (row_scale t k)
  rw [Nat.testBit_xor] at hsc
  have hphi : (phiScale k (row t)).testBit ((t + twopow (k + 1)) - r) =
      ((rhCenter t r ^^ lhCenter t (twopow k - r)) ^^
        lhCenter t (twopow (k + 1) - r)) := by
    change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
      ((row t) <<< (twopow k + twopow k))).testBit ((t + twopow (k + 1)) - r) = _
    simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
    have d1 : decide ((t + twopow (k + 1)) - r ≥ twopow k) = true := decide_eq_true (by omega)
    have h0 : (row t).testBit ((t + twopow (k + 1)) - r) = lhCenter t (twopow (k + 1) - r) := by
      rw [show (t + twopow (k + 1)) - r = t + (twopow (k + 1) - r) by omega,
        ← lhCenter_eq_row_testBit_uncond t (twopow (k + 1) - r)]
    have h1 : (decide ((t + twopow (k + 1)) - r ≥ twopow k) &&
        (row t).testBit (((t + twopow (k + 1)) - r) - twopow k)) =
        lhCenter t (twopow k - r) := by
      rw [d1, Bool.true_and,
        show ((t + twopow (k + 1)) - r) - twopow k = t + (twopow k - r) by omega,
        ← lhCenter_eq_row_testBit_uncond t (twopow k - r)]
    have h2 : (decide ((t + twopow (k + 1)) - r ≥ twopow k + twopow k) &&
        (row t).testBit (((t + twopow (k + 1)) - r) - (twopow k + twopow k))) =
        rhCenter t r := by
      by_cases hrt : r ≤ t
      · have d2 : decide ((t + twopow (k + 1)) - r ≥ twopow k + twopow k) = true :=
          decide_eq_true (by omega)
        rw [d2, Bool.true_and,
          show ((t + twopow (k + 1)) - r) - (twopow k + twopow k) = t - r by omega,
          ← rhCenter_eq_row_testBit t r hrt]
      · have d2 : decide ((t + twopow (k + 1)) - r ≥ twopow k + twopow k) = false :=
          decide_eq_false (by omega)
        rw [d2, Bool.false_and, rhCenter_gt_eq_false t r (by omega)]
    rw [h0, h1, h2]
    cases rhCenter t r <;>
      cases lhCenter t (twopow k - r) <;>
      cases lhCenter t (twopow (k + 1) - r) <;> rfl
  rw [hsc, hphi]
  simp only [bxor_eq_xor]

theorem lhCenter_scale_cross_step_prop (t k r : Nat) (hr : r ≤ twopow k) :
    lhCenter (t + twopow k) (twopow k - r) =
      bxor
        (bxor (bxor (rhCenter t r) (lhCenter t (twopow k - r)))
          (lhCenter t (twopow (k + 1) - r)))
        (wittBitBool (winWitt t (twopow k)) ((t + twopow (k + 1)) - r)) :=
  lhCenter_scale_cross_step t k r hr

/-- **Unconditional Cross-Center `2^k`-Scale Formula for `rhCenter` in Terms of `lhCenter` and `winWitt` (`rhCenter_eq_lhCenter_scale_cross`)**:
    for ALL `t, k, r : Nat` with `r ≤ 2^k`, solving `lhCenter_scale_cross_step` for `rhCenter t r` expresses every right-half column `r ∈ [0, 2^k]` directly in terms of `lhCenter (t + 2^k) (2^k - r)`, `lhCenter t (2^k - r)`, `lhCenter t (2^(k+1) - r)`, and `(winWitt t (2^k)).testBit ((t + 2^(k+1)) - r)`! -/
theorem rhCenter_eq_lhCenter_scale_cross (t k r : Nat) (hr : r ≤ twopow k) :
    rhCenter t r =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (twopow k - r)) (lhCenter t (twopow k - r)))
          (lhCenter t (twopow (k + 1) - r)))
        ((winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r)) := by
  rw [lhCenter_scale_cross_step t k r hr]
  simp only [bxor_eq_xor]
  cases rhCenter t r <;>
    cases lhCenter t (twopow k - r) <;>
    cases lhCenter t (twopow (k + 1) - r) <;>
    cases (winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r) <;> rfl

theorem rhCenter_eq_lhCenter_scale_cross_prop (t k r : Nat) (hr : r ≤ twopow k) :
    rhCenter t r =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (twopow k - r)) (lhCenter t (twopow k - r)))
          (lhCenter t (twopow (k + 1) - r)))
        (wittBitBool (winWitt t (twopow k)) ((t + twopow (k + 1)) - r)) :=
  rhCenter_eq_lhCenter_scale_cross t k r hr

/-- **Cross-Center `2^k`-Scale Transport from `LhBandAgree` and `WinWittAgree` to `RhBandAgree` (`rhBandAgree_of_lhBandAgree_scale_cross`)**:
    for `L ≤ 2^k`, if `LhBandAgree (t + 2^k) Q (2^k - L) L`, `LhBandAgree t Q (2^k - L) L`, `LhBandAgree t Q (2^(k+1) - L) L`, and `WinWittAgree t k Q ((t + 2^(k+1)) - L) L` hold, then `RhBandAgree t Q 0 L` holds across the right half `[0, L]`! -/
theorem rhBandAgree_of_lhBandAgree_scale_cross (t k Q L : Nat)
    (hL : L ≤ twopow k)
    (hlate : LhBandAgree (t + twopow k) Q (twopow k - L) L)
    (h1 : LhBandAgree t Q (twopow k - L) L)
    (h2 : LhBandAgree t Q (twopow (k + 1) - L) L)
    (hw : WinWittAgree t k Q ((t + twopow (k + 1)) - L) L) :
    RhBandAgree t Q 0 L := by
  intro r hr
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  rw [Nat.zero_add,
    rhCenter_eq_lhCenter_scale_cross (t + Q) k r (by omega),
    rhCenter_eq_lhCenter_scale_cross t k r (by omega)]
  have hbl := hlate (L - r) (by omega)
  have hb1 := h1 (L - r) (by omega)
  have hb2 := h2 (L - r) (by omega)
  have hwi := hw (L - r) (by omega)
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (twopow k - L) + (L - r) = twopow k - r by omega] at hbl
  rw [show (twopow k - L) + (L - r) = twopow k - r by omega] at hb1
  rw [show (twopow (k + 1) - L) + (L - r) = twopow (k + 1) - r by omega] at hb2
  rw [show ((t + twopow (k + 1)) - L) + (L - r) + Q =
      ((t + Q) + twopow (k + 1)) - r by omega,
    show ((t + twopow (k + 1)) - L) + (L - r) =
      (t + twopow (k + 1)) - r by omega] at hwi
  rw [hbl, hb1, hb2, hwi]

/-- **Converse Cross-Center `2^k`-Scale Transport to `WinWittAgree` (`winWittAgree_of_rhBandAgree_lhBandAgree_scale_cross`)**:
    for `L ≤ 2^k`, if `RhBandAgree t Q 0 L`, `LhBandAgree (t + 2^k) Q (2^k - L) L`, `LhBandAgree t Q (2^k - L) L`, and `LhBandAgree t Q (2^(k+1) - L) L` hold, then `WinWittAgree t k Q ((t + 2^(k+1)) - L) L` holds! -/
theorem winWittAgree_of_rhBandAgree_lhBandAgree_scale_cross (t k Q L : Nat)
    (hL : L ≤ twopow k)
    (hrh : RhBandAgree t Q 0 L)
    (hlate : LhBandAgree (t + twopow k) Q (twopow k - L) L)
    (h1 : LhBandAgree t Q (twopow k - L) L)
    (h2 : LhBandAgree t Q (twopow (k + 1) - L) L) :
    WinWittAgree t k Q ((t + twopow (k + 1)) - L) L := by
  intro j hj
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hsQ := rhCenter_eq_lhCenter_scale_cross (t + Q) k (L - j) (by omega)
  have hs0 := rhCenter_eq_lhCenter_scale_cross t k (L - j) (by omega)
  have hbr := hrh (L - j) (by omega)
  have hbl := hlate j hj
  have hb1 := h1 j hj
  have hb2 := h2 j hj
  rw [Nat.zero_add] at hbr
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (twopow k - L) + j = twopow k - (L - j) by omega] at hbl
  rw [show (twopow k - L) + j = twopow k - (L - j) by omega] at hb1
  rw [show (twopow (k + 1) - L) + j = twopow (k + 1) - (L - j) by omega] at hb2
  rw [show ((t + twopow (k + 1)) - L) + j + Q = ((t + Q) + twopow (k + 1)) - (L - j) by omega,
    show ((t + twopow (k + 1)) - L) + j = (t + twopow (k + 1)) - (L - j) by omega]
  rw [hbr, hbl, hb1, hb2] at hsQ
  revert hsQ hs0
  simp only [bxor_eq_xor]
  cases rhCenter t (L - j) <;>
    cases lhCenter (t + twopow k) (twopow k - (L - j)) <;>
    cases lhCenter t (twopow k - (L - j)) <;>
    cases lhCenter t (twopow (k + 1) - (L - j)) <;>
    cases (winWitt (t + Q) (twopow k)).testBit (((t + Q) + twopow (k + 1)) - (L - j)) <;>
    cases (winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - (L - j)) <;> decide

/-- **Deriving `RhBandAgree` on `[0, 2^k]` from `LhColAgree · 1` and `WinWittAgree` (`periodic_rhBandAgree_of_lhColAgree_one_and_winWittAgree`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t`, if `LhColAgree t (m * P) 1 (2^(k+1))` and `WinWittAgree t k (m * P) (t + 2^k) (2^k)` hold, then outward left-half determination supplies all three `LhBandAgree` terms in `rhBandAgree_of_lhBandAgree_scale_cross`, establishing `RhBandAgree t (m * P) 0 (2^k)`! -/
theorem periodic_rhBandAgree_of_lhColAgree_one_and_winWittAgree
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t)
    (hcol1 : LhColAgree t (m * P) 1 (twopow (k + 1)))
    (hw : WinWittAgree t k (m * P) (t + twopow k) (twopow k)) :
    RhBandAgree t (m * P) 0 (twopow k) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hcol0 := periodic_lhColAgree_zero T P hP hper m t (twopow (k + 1)) ht
  have hl_full := lhBandAgree_of_outward_determine t (m * P) 0 (twopow (k + 1)) hcol0 hcol1
  have h1 : LhBandAgree t (m * P) (twopow k - twopow k) (twopow k) := by
    rw [Nat.sub_self]
    intro i hi
    exact hl_full i (by omega)
  have h2 : LhBandAgree t (m * P) (twopow (k + 1) - twopow k) (twopow k) := by
    intro i hi
    have heq := hl_full (twopow k + i) (by omega)
    rwa [show 0 + (twopow k + i) = (twopow (k + 1) - twopow k) + i by omega] at heq
  have hcol0_late := periodic_lhColAgree_zero T P hP hper m (t + twopow k) (twopow k) (by omega)
  have hcol1_late : LhColAgree (t + twopow k) (m * P) 1 (twopow k) := by
    intro s hs
    have heq := hcol1 (twopow k + s) (by omega)
    rwa [show t + (twopow k + s) = (t + twopow k) + s by omega] at heq
  have hl_late := lhBandAgree_of_outward_determine (t + twopow k) (m * P) 0 (twopow k)
    hcol0_late hcol1_late
  have hlate : LhBandAgree (t + twopow k) (m * P) (twopow k - twopow k) (twopow k) := by
    rw [Nat.sub_self]
    intro i hi
    exact hl_late i (by omega)
  have hw' : WinWittAgree t k (m * P) ((t + twopow (k + 1)) - twopow k) (twopow k) := by
    rwa [show (t + twopow (k + 1)) - twopow k = t + twopow k by omega]
  exact rhBandAgree_of_lhBandAgree_scale_cross t k (m * P) (twopow k)
    (by omega) hlate h1 h2 hw'

/-- **Converse Derivation of `WinWittAgree` from `LhColAgree · 1` and `RhBandAgree` (`periodic_winWittAgree_of_lhColAgree_one_and_rhBandAgree`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t`, if `LhColAgree t (m * P) 1 (2^(k+1))` and `RhBandAgree t (m * P) 0 (2^k)` hold, then `WinWittAgree t k (m * P) (t + 2^k) (2^k)` holds! -/
theorem periodic_winWittAgree_of_lhColAgree_one_and_rhBandAgree
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t)
    (hcol1 : LhColAgree t (m * P) 1 (twopow (k + 1)))
    (hrh : RhBandAgree t (m * P) 0 (twopow k)) :
    WinWittAgree t k (m * P) (t + twopow k) (twopow k) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hcol0 := periodic_lhColAgree_zero T P hP hper m t (twopow (k + 1)) ht
  have hl_full := lhBandAgree_of_outward_determine t (m * P) 0 (twopow (k + 1)) hcol0 hcol1
  have h1 : LhBandAgree t (m * P) (twopow k - twopow k) (twopow k) := by
    rw [Nat.sub_self]
    intro i hi
    exact hl_full i (by omega)
  have h2 : LhBandAgree t (m * P) (twopow (k + 1) - twopow k) (twopow k) := by
    intro i hi
    have heq := hl_full (twopow k + i) (by omega)
    rwa [show 0 + (twopow k + i) = (twopow (k + 1) - twopow k) + i by omega] at heq
  have hcol0_late := periodic_lhColAgree_zero T P hP hper m (t + twopow k) (twopow k) (by omega)
  have hcol1_late : LhColAgree (t + twopow k) (m * P) 1 (twopow k) := by
    intro s hs
    have heq := hcol1 (twopow k + s) (by omega)
    rwa [show t + (twopow k + s) = (t + twopow k) + s by omega] at heq
  have hl_late := lhBandAgree_of_outward_determine (t + twopow k) (m * P) 0 (twopow k)
    hcol0_late hcol1_late
  have hlate : LhBandAgree (t + twopow k) (m * P) (twopow k - twopow k) (twopow k) := by
    rw [Nat.sub_self]
    intro i hi
    exact hl_late i (by omega)
  have hw := winWittAgree_of_rhBandAgree_lhBandAgree_scale_cross t k (m * P) (twopow k)
    (by omega) hrh hlate h1 h2
  rwa [show (t + twopow (k + 1)) - twopow k = t + twopow k by omega] at hw

/-- **Unconditional `2^k`-Scale Forward Band Transport of `LhBandAgree` (`lhBandAgree_scale_step_uncond`)**:
    for ALL `t, k, Q, p0, L : Nat`, if `LhBandAgree` holds on `p0`, `p0 + 2^k`, and `p0 + 2^(k+1)` at time `t`, and `WinWittAgree t k Q (t + p0 + 2^(k+1)) L` holds at time `t`, then `LhBandAgree (t + 2^k) Q (p0 + 2^k) L` holds! -/
theorem lhBandAgree_scale_step_uncond (t k Q p0 L : Nat)
    (h0 : LhBandAgree t Q p0 L)
    (h1 : LhBandAgree t Q (p0 + twopow k) L)
    (h2 : LhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) L) :
    LhBandAgree (t + twopow k) Q (p0 + twopow k) L := by
  intro i hi
  have hsQ := lhCenter_scale_step_uncond (t + Q) k (p0 + i)
  have hs0 := lhCenter_scale_step_uncond t k (p0 + i)
  have hb0 := h0 i hi
  have hb1 := h1 i hi
  have hb2 := h2 i hi
  have hwi := hw i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega,
    hsQ, hs0,
    show (p0 + i) + twopow k = (p0 + twopow k) + i by omega,
    show (p0 + i) + twopow (k + 1) = (p0 + twopow (k + 1)) + i by omega,
    show (t + Q) + (p0 + i) + twopow (k + 1) = (t + p0 + twopow (k + 1)) + i + Q by omega,
    show t + (p0 + i) + twopow (k + 1) = (t + p0 + twopow (k + 1)) + i by omega,
    hb0, hb1, hb2, hwi]

/-- **Unconditional `2^k`-Scale Outward Band Transport of `LhBandAgree` (`lhBandAgree_scale_outward_step_uncond`)**:
    for ALL `t, k, Q, p0, L : Nat`, if `LhBandAgree (t + 2^k) Q (p0 + 2^k) L`, `LhBandAgree t Q p0 L`, `LhBandAgree t Q (p0 + 2^k) L`, and `WinWittAgree t k Q (t + p0 + 2^(k+1)) L` hold, then `LhBandAgree t Q (p0 + 2^(k+1)) L` holds! -/
theorem lhBandAgree_scale_outward_step_uncond (t k Q p0 L : Nat)
    (hlate : LhBandAgree (t + twopow k) Q (p0 + twopow k) L)
    (h0 : LhBandAgree t Q p0 L)
    (h1 : LhBandAgree t Q (p0 + twopow k) L)
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) L) :
    LhBandAgree t Q (p0 + twopow (k + 1)) L := by
  intro i hi
  have hsQ := lhCenter_scale_outward_step_uncond (t + Q) k (p0 + i)
  have hs0 := lhCenter_scale_outward_step_uncond t k (p0 + i)
  have hbl := hlate i hi
  have hb0 := h0 i hi
  have hb1 := h1 i hi
  have hwi := hw i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hbl
  rw [show (p0 + twopow (k + 1)) + i = (p0 + i) + twopow (k + 1) by omega,
    hsQ, hs0, hbl,
    show (p0 + i) + twopow k = (p0 + twopow k) + i by omega,
    show (t + Q) + (p0 + i) + twopow (k + 1) = (t + p0 + twopow (k + 1)) + i + Q by omega,
    show t + (p0 + i) + twopow (k + 1) = (t + p0 + twopow (k + 1)) + i by omega,
    hb0, hb1, hwi]

/-- **Exact Diagonal Difference Law of the Driven Left Half `lhCenter` (`lhCenter_diag_diff_eq_or`)**:
    for all `t, p : Nat`, `bxor (lhCenter (t + 1) (p + 1)) (lhCenter t (p + 2)) = (lhCenter t (p + 1) || lhCenter t p)`! -/
theorem lhCenter_diag_diff_eq_or (t p : Nat) :
    bxor (lhCenter (t + 1) (p + 1)) (lhCenter t (p + 2)) =
      (lhCenter t (p + 1) || lhCenter t p) := by
  rw [lhCenter_step_succ t p]
  cases lhCenter t (p + 2) <;>
    cases (lhCenter t (p + 1) || lhCenter t p) <;> rfl

/-- **Exact Outward Step Law for the Left-Half `Q`-Defect (`lhCenter_defect_outward_step`)**:
    for all `t, Q, p : Nat`, the outward `Q`-defect `bxor (lhCenter (t + Q) (p + 2)) (lhCenter t (p + 2))` equals `bxor (bxor (lhCenter ((t + 1) + Q) (p + 1)) (lhCenter (t + 1) (p + 1))) (bxor (lhCenter (t + Q) (p + 1) || lhCenter (t + Q) p) (lhCenter t (p + 1) || lhCenter t p))`! -/
theorem lhCenter_defect_outward_step (t Q p : Nat) :
    bxor (lhCenter (t + Q) (p + 2)) (lhCenter t (p + 2)) =
      bxor
        (bxor (lhCenter ((t + 1) + Q) (p + 1)) (lhCenter (t + 1) (p + 1)))
        (bxor (lhCenter (t + Q) (p + 1) || lhCenter (t + Q) p)
          (lhCenter t (p + 1) || lhCenter t p)) := by
  rw [lhCenter_outward_step (t + Q) p,
    lhCenter_outward_step t p,
    show (t + Q) + 1 = (t + 1) + Q by omega]
  cases lhCenter ((t + 1) + Q) (p + 1) <;>
    cases lhCenter (t + 1) (p + 1) <;>
    cases (lhCenter (t + Q) (p + 1) || lhCenter (t + Q) p) <;>
    cases (lhCenter t (p + 1) || lhCenter t p) <;> rfl

/-- **Linearized Outward Defect Step in `lhCenter` When Column `p` Agrees (`lhCenter_defect_outward_of_col_eq`)**:
    whenever `lhCenter (t + Q) p = lhCenter t p` (which is already known when marching outward from the center!), the outward `Q`-defect at `p + 2` is linear in the column-`p + 1` defects:
    `bxor (lhCenter (t + Q) (p + 2)) (lhCenter t (p + 2)) = bxor (bxor (lhCenter ((t + 1) + Q) (p + 1)) (lhCenter (t + 1) (p + 1))) (!lhCenter t p && bxor (lhCenter (t + Q) (p + 1)) (lhCenter t (p + 1)))`! -/
theorem lhCenter_defect_outward_of_col_eq (t Q p : Nat)
    (heq : lhCenter (t + Q) p = lhCenter t p) :
    bxor (lhCenter (t + Q) (p + 2)) (lhCenter t (p + 2)) =
      bxor
        (bxor (lhCenter ((t + 1) + Q) (p + 1)) (lhCenter (t + 1) (p + 1)))
        (!lhCenter t p && bxor (lhCenter (t + Q) (p + 1)) (lhCenter t (p + 1))) := by
  rw [lhCenter_defect_outward_step t Q p, heq]
  cases lhCenter ((t + 1) + Q) (p + 1) <;>
    cases lhCenter (t + 1) (p + 1) <;>
    cases lhCenter (t + Q) (p + 1) <;>
    cases lhCenter t (p + 1) <;>
    cases lhCenter t p <;> rfl

/-- **Black-Cell Shielding in Outward Left-Half Defect Propagation (`lhCenter_defect_outward_of_black`)**:
    whenever `lhCenter (t + Q) p = true` and `lhCenter t p = true`, the column-`p + 1` defect at time `t` is completely shielded out, so `bxor (lhCenter (t + Q) (p + 2)) (lhCenter t (p + 2)) = bxor (lhCenter ((t + 1) + Q) (p + 1)) (lhCenter (t + 1) (p + 1))`! -/
theorem lhCenter_defect_outward_of_black (t Q p : Nat)
    (hbQ : lhCenter (t + Q) p = true)
    (hb0 : lhCenter t p = true) :
    bxor (lhCenter (t + Q) (p + 2)) (lhCenter t (p + 2)) =
      bxor (lhCenter ((t + 1) + Q) (p + 1)) (lhCenter (t + 1) (p + 1)) := by
  have heq : lhCenter (t + Q) p = lhCenter t p := by rw [hbQ, hb0]
  rw [lhCenter_defect_outward_of_col_eq t Q p heq, hb0]
  cases lhCenter ((t + 1) + Q) (p + 1) <;>
    cases lhCenter (t + 1) (p + 1) <;>
    cases lhCenter (t + Q) (p + 1) <;>
    cases lhCenter t (p + 1) <;> rfl

/-- **Exact Left-Edge Vanishing of `winWitt` (`winWitt_testBit_left_edge`)**:
    for all `t, k : Nat`, at the left edge `p = t`, `lhCenter (t + 2^k) (t + 2^k) = true` and `lhCenter t t = true` cancel in `lhCenter_scale_step_uncond`, proving `(winWitt t (2^k)).testBit (t + t + 2^(k+1)) = false`! -/
theorem winWitt_testBit_left_edge (t k : Nat) :
    (winWitt t (twopow k)).testBit (t + t + twopow (k + 1)) = false := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hpos : 0 < twopow k := by
    have := twopow_gt_self k
    omega
  have hs := lhCenter_scale_step_uncond t k t
  rw [lhCenter_self_eq_true (t + twopow k),
    lhCenter_self_eq_true t,
    lhCenter_gt_eq_false t (t + twopow k) (by omega),
    lhCenter_gt_eq_false t (t + twopow (k + 1)) (by omega)] at hs
  revert hs
  cases (winWitt t (twopow k)).testBit (t + t + twopow (k + 1)) <;> decide

theorem winWitt_testBit_left_edge_prop (t k : Nat) :
    wittBitBool (winWitt t (twopow k)) (t + t + twopow (k + 1)) = false :=
  winWitt_testBit_left_edge t k

/-- **Vanishing of `winWitt` Strictly Outside the Left Light Cone (`winWitt_testBit_gt_left_edge`)**:
    for all `t, k, p : Nat` with `t < p`, all four `lhCenter` terms in `lhCenter_scale_step_uncond` vanish, proving `(winWitt t (2^k)).testBit (t + p + 2^(k+1)) = false`! -/
theorem winWitt_testBit_gt_left_edge (t k p : Nat) (hp : t < p) :
    (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) = false := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hs := lhCenter_scale_step_uncond t k p
  rw [lhCenter_gt_eq_false (t + twopow k) (p + twopow k) (by omega),
    lhCenter_gt_eq_false t p (by omega),
    lhCenter_gt_eq_false t (p + twopow k) (by omega),
    lhCenter_gt_eq_false t (p + twopow (k + 1)) (by omega)] at hs
  revert hs
  cases (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) <;> decide

theorem winWitt_testBit_gt_left_edge_prop (t k p : Nat) (hp : t < p) :
    wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1)) = false :=
  winWitt_testBit_gt_left_edge t k p hp

/-- **Vanishing of `winWitt` At and Outside the Left Light Cone (`winWitt_testBit_ge_left_edge`)**:
    for all `t, k, p : Nat` with `t ≤ p`, `(winWitt t (2^k)).testBit (t + p + 2^(k+1)) = false`! -/
theorem winWitt_testBit_ge_left_edge (t k p : Nat) (hp : t ≤ p) :
    (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) = false := by
  rcases Nat.eq_or_lt_of_le hp with rfl | hlt
  · exact winWitt_testBit_left_edge t k
  · exact winWitt_testBit_gt_left_edge t k p hlt

theorem winWitt_testBit_ge_left_edge_prop (t k p : Nat) (hp : t ≤ p) :
    wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1)) = false :=
  winWitt_testBit_ge_left_edge t k p hp

/-- **Settled Left-Edge Vanishing of `winWitt` Inside the Light Cone (`winWitt_testBit_settled_left`)**:
    for all `t, k, j : Nat` with `j ≤ k`, `j ≤ t`, and `settle j ≤ t`, left-wing settled `2^k`-periodicity (`ldiag_settled_restart`) cancels `lhCenter (t + 2^k) ((t - j) + 2^k)` against `lhCenter t (t - j)` in `lhCenter_scale_step_uncond`, proving `(winWitt t (2^k)).testBit (t + (t - j) + 2^(k+1)) = false` (the exact left-wing counterpart of `winWitt_testBit_low`)! -/
theorem winWitt_testBit_settled_left (t k j : Nat)
    (hj : j ≤ k) (hjt : j ≤ t) (hset : settle j ≤ t) :
    (winWitt t (twopow k)).testBit (t + (t - j) + twopow (k + 1)) = false := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hk_lt : k < twopow k := twopow_gt_self k
  have hs := lhCenter_scale_step_uncond t k (t - j)
  have hl_late : lhCenter (t + twopow k) ((t - j) + twopow k) = ldiag j t := by
    rw [lhCenter_eq_ldiag (t + twopow k) ((t - j) + twopow k) (by omega),
      show (t + twopow k) - ((t - j) + twopow k) = j by omega]
    have hres := ldiag_settled_restart k j 1 t hj hset
    rwa [Nat.one_mul] at hres
  have hl_early : lhCenter t (t - j) = ldiag j t := by
    rw [lhCenter_eq_ldiag t (t - j) (by omega),
      show t - (t - j) = j by omega]
  rw [hl_late, hl_early,
    lhCenter_gt_eq_false t ((t - j) + twopow k) (by omega),
    lhCenter_gt_eq_false t ((t - j) + twopow (k + 1)) (by omega)] at hs
  revert hs
  cases ldiag j t <;>
    cases (winWitt t (twopow k)).testBit (t + (t - j) + twopow (k + 1)) <;> decide

theorem winWitt_testBit_settled_left_prop (t k j : Nat)
    (hj : j ≤ k) (hjt : j ≤ t) (hset : SettledBy j t) :
    wittBitBool (winWitt t (twopow k)) (t + (t - j) + twopow (k + 1)) = false :=
  winWitt_testBit_settled_left t k j hj hjt hset

/-- **Unconditional Left-Edge `LhBandAgree` Outside the Light Cone (`lhBandAgree_outside_cone`)**:
    for `t + Q < p0`, `LhBandAgree t Q p0 L` holds unconditionally. -/
theorem lhBandAgree_outside_cone (t Q p0 L : Nat) (h : t + Q < p0) :
    LhBandAgree t Q p0 L := by
  intro i _
  rw [lhCenter_gt_eq_false (t + Q) (p0 + i) (by omega),
    lhCenter_gt_eq_false t (p0 + i) (by omega)]

/-- **Sub-interval Monotonicity of `LhBandAgree` (`lhBandAgree_mono`)**:
    if `LhBandAgree t Q p0 L` holds on `[p0, p0 + L]` and `[p0', p0' + L'] ⊆ [p0, p0 + L]`, then `LhBandAgree t Q p0' L'` holds. -/
theorem lhBandAgree_mono (t Q p0 L p0' L' : Nat)
    (hp : p0 ≤ p0') (hL : p0' + L' ≤ p0 + L)
    (h : LhBandAgree t Q p0 L) :
    LhBandAgree t Q p0' L' := by
  intro i hi
  have hj : (p0' - p0) + i ≤ L := by omega
  have heq := h ((p0' - p0) + i) hj
  rwa [show p0 + ((p0' - p0) + i) = p0' + i by omega] at heq

/-- **Sub-interval Monotonicity of `LhColAgree` (`lhColAgree_mono`)**:
    if `LhColAgree t Q p0 S` holds on `[t, t + S]` and `[t + s0, t + s0 + S'] ⊆ [t, t + S]`, then `LhColAgree (t + s0) Q p0 S'` holds. -/
theorem lhColAgree_mono (t Q p0 S s0 S' : Nat)
    (hs : s0 + S' ≤ S)
    (h : LhColAgree t Q p0 S) :
    LhColAgree (t + s0) Q p0 S' := by
  intro s hs'
  have heq := h (s0 + s) (by omega)
  rwa [show t + (s0 + s) = (t + s0) + s by omega] at heq

/-- **One-Step Forward Propagation of `LhBandAgree` (`lhBandAgree_step`)**:
    each step `t ↦ t + 1` in the driven left half carries `LhBandAgree t Q p0 (L + 2)` on `[p0, p0 + L + 2]` to `LhBandAgree (t + 1) Q (p0 + 1) L` on `[p0 + 1, p0 + 1 + L]`. -/
theorem lhBandAgree_step (t Q p0 L : Nat)
    (h : LhBandAgree t Q p0 (L + 2)) :
    LhBandAgree (t + 1) Q (p0 + 1) L := by
  intro i hi
  have h0 := h i (by omega)
  have h1 := h (i + 1) (by omega)
  have h2 := h (i + 2) (by omega)
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    show (p0 + 1) + i = (p0 + i) + 1 by omega,
    lhCenter_step_succ (t + Q) (p0 + i),
    lhCenter_step_succ t (p0 + i),
    show (p0 + i) + 1 = p0 + (i + 1) by omega,
    show (p0 + i) + 2 = p0 + (i + 2) by omega,
    h0, h1, h2]

/-- **Multi-Step Forward Propagation of `LhBandAgree` (`lhBandAgree_steps`)**:
    by induction on `s : Nat`, `LhBandAgree t Q p0 (L + 2 * s)` implies `LhBandAgree (t + s) Q (p0 + s) L`. -/
theorem lhBandAgree_steps (t Q p0 L s : Nat)
    (h : LhBandAgree t Q p0 (L + 2 * s)) :
    LhBandAgree (t + s) Q (p0 + s) L := by
  induction s generalizing t p0 L with
  | zero =>
    simpa using h
  | succ s ih =>
    have h' : LhBandAgree t Q p0 ((L + 2 * s) + 2) := by
      intro i hi
      exact h i (by omega)
    have h1 := lhBandAgree_step t Q p0 (L + 2 * s) h'
    have h2 := ih (t + 1) (p0 + 1) L h1
    rw [show (t + 1) + s = t + (s + 1) by omega,
      show (p0 + 1) + s = p0 + (s + 1) by omega] at h2
    exact h2

/-- **Free Inward Extension of `LhBandAgree` from Column `-1` to Column `0` under `CenterPeriodic` (`periodic_lhBandAgree_zero_of_one`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t`, `LhBandAgree t (m * P) 1 L` automatically extends to `LhBandAgree t (m * P) 0 (L + 1)` because `lhCenter · 0 = center ·` is `m * P`-periodic! -/
theorem periodic_lhBandAgree_zero_of_one
    (T P : Nat) (_hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t L : Nat) (ht : T ≤ t)
    (h : LhBandAgree t (m * P) 1 L) :
    LhBandAgree t (m * P) 0 (L + 1) := by
  intro i hi
  rcases i with _ | i
  · simp only [Nat.zero_add, lhCenter_zero_eq_center]
    exact Rule30UOR.Scale.center_mul hper m t ht
  · have hi' : i ≤ L := by omega
    have h1 := h i hi'
    rwa [show 0 + (i + 1) = 1 + i by omega]

/-- **Deriving `RhBandAgree` on `[0, 2^k]` from `RhColAgree · 1` and `WinWittAgree` (`periodic_rhBandAgree_of_rhColAgree_one_and_winWittAgree`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t`, if `RhColAgree t (m * P) 1 (2^(k+1))` and `WinWittAgree t k (m * P) (t + 2^k) (2^k)` hold, then `periodic_lhColAgree_one_of_rhColAgree_one` and `periodic_rhBandAgree_of_lhColAgree_one_and_winWittAgree` establish `RhBandAgree t (m * P) 0 (2^k)`! -/
theorem periodic_rhBandAgree_of_rhColAgree_one_and_winWittAgree
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t)
    (hcol1 : RhColAgree t (m * P) 1 (twopow (k + 1)))
    (hw : WinWittAgree t k (m * P) (t + twopow k) (twopow k)) :
    RhBandAgree t (m * P) 0 (twopow k) := by
  have hlcol1 := periodic_lhColAgree_one_of_rhColAgree_one T P hP hper m t (twopow (k + 1)) ht hcol1
  exact periodic_rhBandAgree_of_lhColAgree_one_and_winWittAgree T P hP hper m t k ht hlcol1 hw

/-- **Converse Derivation of `WinWittAgree` from `RhColAgree · 1` and `RhBandAgree` (`periodic_winWittAgree_of_rhColAgree_one_and_rhBandAgree`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t`, if `RhColAgree t (m * P) 1 (2^(k+1))` and `RhBandAgree t (m * P) 0 (2^k)` hold, then `WinWittAgree t k (m * P) (t + 2^k) (2^k)` holds! -/
theorem periodic_winWittAgree_of_rhColAgree_one_and_rhBandAgree
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t)
    (hcol1 : RhColAgree t (m * P) 1 (twopow (k + 1)))
    (hrh : RhBandAgree t (m * P) 0 (twopow k)) :
    WinWittAgree t k (m * P) (t + twopow k) (twopow k) := by
  have hlcol1 := periodic_lhColAgree_one_of_rhColAgree_one T P hP hper m t (twopow (k + 1)) ht hcol1
  exact periodic_winWittAgree_of_lhColAgree_one_and_rhBandAgree T P hP hper m t k ht hlcol1 hrh

/-- **Fully Unconditional `2^k`-Scale Inward Step of `lhCenter` (`lhCenter_scale_inward_step_uncond`)**:
    for ALL `t, k, p : Nat`, solving `lhCenter_scale_step_uncond` for the inner column `lhCenter t p` expresses it in terms of `lhCenter (t + 2^k) (p + 2^k)`, `lhCenter t (p + 2^k)`, `lhCenter t (p + 2^(k+1))`, and `(winWitt t (2^k)).testBit (t + p + 2^(k+1))`! -/
theorem lhCenter_scale_inward_step_uncond (t k p : Nat) :
    lhCenter t p =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t (p + twopow k)))
          (lhCenter t (p + twopow (k + 1))))
        ((winWitt t (twopow k)).testBit (t + p + twopow (k + 1))) := by
  rw [lhCenter_scale_step_uncond t k p]
  simp only [bxor_eq_xor]
  cases lhCenter t p <;>
    cases lhCenter t (p + twopow k) <;>
    cases lhCenter t (p + twopow (k + 1)) <;>
    cases (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) <;> rfl

theorem lhCenter_scale_inward_step_uncond_prop (t k p : Nat) :
    lhCenter t p =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t (p + twopow k)))
          (lhCenter t (p + twopow (k + 1))))
        (wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1))) :=
  lhCenter_scale_inward_step_uncond t k p

/-- **Unconditional `2^k`-Scale Inward Band Transport of `LhBandAgree` (`lhBandAgree_scale_inward_step_uncond`)**:
    for ALL `t, k, Q, p0, L : Nat`, if `LhBandAgree (t + 2^k) Q (p0 + 2^k) L`, `LhBandAgree t Q (p0 + 2^k) L`, `LhBandAgree t Q (p0 + 2^(k+1)) L`, and `WinWittAgree t k Q (t + p0 + 2^(k+1)) L` hold, then `LhBandAgree t Q p0 L` holds! -/
theorem lhBandAgree_scale_inward_step_uncond (t k Q p0 L : Nat)
    (hlate : LhBandAgree (t + twopow k) Q (p0 + twopow k) L)
    (h1 : LhBandAgree t Q (p0 + twopow k) L)
    (h2 : LhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) L) :
    LhBandAgree t Q p0 L := by
  intro i hi
  have hsQ := lhCenter_scale_inward_step_uncond (t + Q) k (p0 + i)
  have hs0 := lhCenter_scale_inward_step_uncond t k (p0 + i)
  have hbl := hlate i hi
  have hb1 := h1 i hi
  have hb2 := h2 i hi
  have hwi := hw i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hbl
  rw [hsQ, hs0, hbl,
    show (p0 + i) + twopow k = (p0 + twopow k) + i by omega,
    show (p0 + i) + twopow (k + 1) = (p0 + twopow (k + 1)) + i by omega,
    show (t + Q) + (p0 + i) + twopow (k + 1) = (t + p0 + twopow (k + 1)) + i + Q by omega,
    show t + (p0 + i) + twopow (k + 1) = (t + p0 + twopow (k + 1)) + i by omega,
    hb1, hb2, hwi]

/-- **Unconditional `WinWittAgree` At and Outside the Left Light Cone (`winWittAgree_outside_left_cone`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q ≤ p0`, `WinWittAgree t k Q (t + p0 + 2^(k+1)) L` holds unconditionally by `winWitt_testBit_ge_left_edge`! -/
theorem winWittAgree_outside_left_cone (t k Q p0 L : Nat) (hp : t + Q ≤ p0) :
    WinWittAgree t k Q (t + p0 + twopow (k + 1)) L := by
  intro i _
  rw [show (t + p0 + twopow (k + 1)) + i + Q = (t + Q) + (p0 + i) + twopow (k + 1) by omega,
    show (t + p0 + twopow (k + 1)) + i = t + (p0 + i) + twopow (k + 1) by omega,
    winWitt_testBit_ge_left_edge (t + Q) k (p0 + i) (by omega),
    winWitt_testBit_ge_left_edge t k (p0 + i) (by omega)]

/-! ### Batch 9: Complete `2^k`-Scale 5-Term Left-Half Calculus, Outer `$2^k$`-Strip 3-Term Collapse, and Left-Half Frobenius Defect Vanishing -/

/-- **Unconditional Identity Between `rdiag (t + p) t` and `lhCenter t p` (`rdiag_add_eq_lhCenter_uncond`)**:
    for ALL `t, p : Nat` (no light-cone bound `p ≤ t` required), `rdiag (t + p) t = lhCenter t p`! -/
theorem rdiag_add_eq_lhCenter_uncond (t p : Nat) :
    rdiag (t + p) t = lhCenter t p := by
  rw [lhCenter_eq_row_testBit_uncond t p, row_testBit t (t + p)]

theorem rdiag_add_eq_lhCenter_uncond_prop (t p : Nat) :
    rdiag (t + p) t = lhCenter t p :=
  rdiag_add_eq_lhCenter_uncond t p

/-- **Unconditional `2^k`-Scale Readout of `winWitt` in `lhCenter` Coordinates (`winWitt_testBit_eq_lhCenter_scale_uncond`)**:
    for ALL `t, k, p : Nat`, solving `lhCenter_scale_step_uncond` for `(winWitt t (2^k)).testBit (t + p + 2^(k+1))` expresses it as the 4-term XOR of `lhCenter (t + 2^k) (p + 2^k)`, `lhCenter t p`, `lhCenter t (p + 2^k)`, and `lhCenter t (p + 2^(k+1))`! -/
theorem winWitt_testBit_eq_lhCenter_scale_uncond (t k p : Nat) :
    (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t p))
          (lhCenter t (p + twopow k)))
        (lhCenter t (p + twopow (k + 1))) := by
  rw [lhCenter_scale_step_uncond t k p]
  simp only [bxor_eq_xor]
  cases lhCenter t p <;>
    cases lhCenter t (p + twopow k) <;>
    cases lhCenter t (p + twopow (k + 1)) <;>
    cases (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) <;> rfl

theorem winWitt_testBit_eq_lhCenter_scale_uncond_prop (t k p : Nat) :
    wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1)) =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t p))
          (lhCenter t (p + twopow k)))
        (lhCenter t (p + twopow (k + 1))) :=
  winWitt_testBit_eq_lhCenter_scale_uncond t k p

/-- **Unconditional `2^k`-Scale Band Derivation of `WinWittAgree` from Four `LhBandAgree` Bands (`winWittAgree_of_lhBandAgree_scale_uncond`)**:
    for ALL `t, k, Q, p0, L : Nat`, if `LhBandAgree (t + 2^k) Q (p0 + 2^k) L`, `LhBandAgree t Q p0 L`, `LhBandAgree t Q (p0 + 2^k) L`, and `LhBandAgree t Q (p0 + 2^(k+1)) L` hold, then `WinWittAgree t k Q (t + p0 + 2^(k+1)) L` holds! -/
theorem winWittAgree_of_lhBandAgree_scale_uncond (t k Q p0 L : Nat)
    (hlate : LhBandAgree (t + twopow k) Q (p0 + twopow k) L)
    (h0 : LhBandAgree t Q p0 L)
    (h1 : LhBandAgree t Q (p0 + twopow k) L)
    (h2 : LhBandAgree t Q (p0 + twopow (k + 1)) L) :
    WinWittAgree t k Q (t + p0 + twopow (k + 1)) L := by
  intro i hi
  have hsQ := winWitt_testBit_eq_lhCenter_scale_uncond (t + Q) k (p0 + i)
  have hs0 := winWitt_testBit_eq_lhCenter_scale_uncond t k (p0 + i)
  have hbl := hlate i hi
  have hb0 := h0 i hi
  have hb1 := h1 i hi
  have hb2 := h2 i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hbl
  rw [show (t + p0 + twopow (k + 1)) + i + Q = (t + Q) + (p0 + i) + twopow (k + 1) by omega,
    show (t + p0 + twopow (k + 1)) + i = t + (p0 + i) + twopow (k + 1) by omega,
    hsQ, hs0, hbl, hb0,
    show (p0 + i) + twopow k = (p0 + twopow k) + i by omega,
    show (p0 + i) + twopow (k + 1) = (p0 + twopow (k + 1)) + i by omega,
    hb1, hb2]

/-- **Fully Unconditional `2^k`-Scale Middle-Column Step of `lhCenter` (`lhCenter_scale_mid_step_uncond`)**:
    for ALL `t, k, p : Nat`, solving `lhCenter_scale_step_uncond` for the middle column `lhCenter t (p + 2^k)` expresses it in terms of `lhCenter (t + 2^k) (p + 2^k)`, `lhCenter t p`, `lhCenter t (p + 2^(k+1))`, and `(winWitt t (2^k)).testBit (t + p + 2^(k+1))`! -/
theorem lhCenter_scale_mid_step_uncond (t k p : Nat) :
    lhCenter t (p + twopow k) =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t p))
          (lhCenter t (p + twopow (k + 1))))
        ((winWitt t (twopow k)).testBit (t + p + twopow (k + 1))) := by
  rw [lhCenter_scale_step_uncond t k p]
  simp only [bxor_eq_xor]
  cases lhCenter t p <;>
    cases lhCenter t (p + twopow k) <;>
    cases lhCenter t (p + twopow (k + 1)) <;>
    cases (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) <;> rfl

theorem lhCenter_scale_mid_step_uncond_prop (t k p : Nat) :
    lhCenter t (p + twopow k) =
      bxor
        (bxor (bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t p))
          (lhCenter t (p + twopow (k + 1))))
        (wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1))) :=
  lhCenter_scale_mid_step_uncond t k p

/-- **Unconditional `2^k`-Scale Middle-Band Transport of `LhBandAgree` (`lhBandAgree_scale_mid_step_uncond`)**:
    for ALL `t, k, Q, p0, L : Nat`, if `LhBandAgree (t + 2^k) Q (p0 + 2^k) L`, `LhBandAgree t Q p0 L`, `LhBandAgree t Q (p0 + 2^(k+1)) L`, and `WinWittAgree t k Q (t + p0 + 2^(k+1)) L` hold, then `LhBandAgree t Q (p0 + 2^k) L` holds! -/
theorem lhBandAgree_scale_mid_step_uncond (t k Q p0 L : Nat)
    (hlate : LhBandAgree (t + twopow k) Q (p0 + twopow k) L)
    (h0 : LhBandAgree t Q p0 L)
    (h2 : LhBandAgree t Q (p0 + twopow (k + 1)) L)
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) L) :
    LhBandAgree t Q (p0 + twopow k) L := by
  intro i hi
  have hsQ := lhCenter_scale_mid_step_uncond (t + Q) k (p0 + i)
  have hs0 := lhCenter_scale_mid_step_uncond t k (p0 + i)
  have hbl := hlate i hi
  have hb0 := h0 i hi
  have hb2 := h2 i hi
  have hwi := hw i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hbl
  rw [show (p0 + twopow k) + i = (p0 + i) + twopow k by omega,
    hsQ, hs0, hbl, hb0,
    show (p0 + i) + twopow (k + 1) = (p0 + twopow (k + 1)) + i by omega,
    show (t + Q) + (p0 + i) + twopow (k + 1) = (t + p0 + twopow (k + 1)) + i + Q by omega,
    show t + (p0 + i) + twopow (k + 1) = (t + p0 + twopow (k + 1)) + i by omega,
    hb2, hwi]

/-- **Outer `$2^k$`-Strip 3-Term Forward Scale Step of `lhCenter` (`lhCenter_scale_step_outer_strip`)**:
    for all `t, k, p : Nat` with `t < p + 2^k` (the outer `2^k`-strip of the left cone and beyond, valid at ANY time `t`), both `lhCenter t (p + 2^k)` and `lhCenter t (p + 2^(k+1))` lie outside the light cone and vanish, collapsing `lhCenter_scale_step_uncond` to the 3-term law `lhCenter (t + 2^k) (p + 2^k) = lhCenter t p ⊕ (winWitt t (2^k)).testBit (t + p + 2^(k+1))`! -/
theorem lhCenter_scale_step_outer_strip (t k p : Nat) (hp : t < p + twopow k) :
    lhCenter (t + twopow k) (p + twopow k) =
      bxor (lhCenter t p) ((winWitt t (twopow k)).testBit (t + p + twopow (k + 1))) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  rw [lhCenter_scale_step_uncond t k p,
    lhCenter_gt_eq_false t (p + twopow k) hp,
    lhCenter_gt_eq_false t (p + twopow (k + 1)) (by omega)]
  cases lhCenter t p <;>
    cases (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) <;> rfl

theorem lhCenter_scale_step_outer_strip_prop (t k p : Nat) (hp : t < p + twopow k) :
    lhCenter (t + twopow k) (p + twopow k) =
      bxor (lhCenter t p) (wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1))) :=
  lhCenter_scale_step_outer_strip t k p hp

/-- **Outer `$2^k$`-Strip 3-Term Inward Scale Step of `lhCenter` (`lhCenter_scale_inward_outer_strip`)**:
    for all `t, k, p : Nat` with `t < p + 2^k`, `lhCenter t p = lhCenter (t + 2^k) (p + 2^k) ⊕ (winWitt t (2^k)).testBit (t + p + 2^(k+1))`! -/
theorem lhCenter_scale_inward_outer_strip (t k p : Nat) (hp : t < p + twopow k) :
    lhCenter t p =
      bxor (lhCenter (t + twopow k) (p + twopow k))
        ((winWitt t (twopow k)).testBit (t + p + twopow (k + 1))) := by
  rw [lhCenter_scale_step_outer_strip t k p hp]
  cases lhCenter t p <;>
    cases (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) <;> rfl

theorem lhCenter_scale_inward_outer_strip_prop (t k p : Nat) (hp : t < p + twopow k) :
    lhCenter t p =
      bxor (lhCenter (t + twopow k) (p + twopow k))
        (wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1))) :=
  lhCenter_scale_inward_outer_strip t k p hp

/-- **Outer `$2^k$`-Strip 3-Term Readout of `winWitt` (`winWitt_testBit_outer_left_strip`)**:
    for all `t, k, p : Nat` with `t < p + 2^k`, `(winWitt t (2^k)).testBit (t + p + 2^(k+1)) = lhCenter (t + 2^k) (p + 2^k) ⊕ lhCenter t p`! -/
theorem winWitt_testBit_outer_left_strip (t k p : Nat) (hp : t < p + twopow k) :
    (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) =
      bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t p) := by
  rw [lhCenter_scale_step_outer_strip t k p hp]
  cases lhCenter t p <;>
    cases (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) <;> rfl

theorem winWitt_testBit_outer_left_strip_prop (t k p : Nat) (hp : t < p + twopow k) :
    wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1)) =
      bxor (lhCenter (t + twopow k) (p + twopow k)) (lhCenter t p) :=
  winWitt_testBit_outer_left_strip t k p hp

/-- **Outer `$2^k$`-Strip Left-Diagonal Difference Law for `winWitt` (`winWitt_testBit_outer_left_strip_eq_ldiag_xor`)**:
    for all `t, k, p : Nat` with `p ≤ t` and `t < p + 2^k` (the first `2^k` left diagonals `j = t - p < 2^k` at ANY time `t`), `(winWitt t (2^k)).testBit (t + p + 2^(k+1))` equals the `2^k`-step difference `ldiag (t - p) (t + 2^k) ⊕ ldiag (t - p) t` along left diagonal `t - p`! -/
theorem winWitt_testBit_outer_left_strip_eq_ldiag_xor (t k p : Nat)
    (hpt : p ≤ t) (hp : t < p + twopow k) :
    (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) =
      bxor (ldiag (t - p) (t + twopow k)) (ldiag (t - p) t) := by
  rw [winWitt_testBit_outer_left_strip t k p hp,
    lhCenter_eq_ldiag (t + twopow k) (p + twopow k) (by omega),
    lhCenter_eq_ldiag t p hpt,
    show (t + twopow k) - (p + twopow k) = t - p by omega]

theorem winWitt_testBit_outer_left_strip_eq_ldiag_xor_prop (t k p : Nat)
    (hpt : p ≤ t) (hp : t < p + twopow k) :
    wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1)) =
      bxor (ldiag (t - p) (t + twopow k)) (ldiag (t - p) t) :=
  winWitt_testBit_outer_left_strip_eq_ldiag_xor t k p hpt hp

/-- **Outer `$2^k$`-Strip Inward Band Transport of `LhBandAgree` (`lhBandAgree_scale_inward_outer_strip`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0 + 2^k`, both outer bands at `p0 + 2^k` and `p0 + 2^(k+1)` hold unconditionally outside the light cone, so `LhBandAgree (t + 2^k) Q (p0 + 2^k) L` and `WinWittAgree t k Q (t + p0 + 2^(k+1)) L` alone imply `LhBandAgree t Q p0 L`! -/
theorem lhBandAgree_scale_inward_outer_strip (t k Q p0 L : Nat)
    (hp : t + Q < p0 + twopow k)
    (hlate : LhBandAgree (t + twopow k) Q (p0 + twopow k) L)
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) L) :
    LhBandAgree t Q p0 L := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  exact lhBandAgree_scale_inward_step_uncond t k Q p0 L hlate
    (lhBandAgree_outside_cone t Q (p0 + twopow k) L hp)
    (lhBandAgree_outside_cone t Q (p0 + twopow (k + 1)) L (by omega))
    hw

/-- **Outer `$2^k$`-Strip Forward Band Transport of `LhBandAgree` (`lhBandAgree_scale_step_outer_strip`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0 + 2^k`, `LhBandAgree t Q p0 L` and `WinWittAgree t k Q (t + p0 + 2^(k+1)) L` alone imply `LhBandAgree (t + 2^k) Q (p0 + 2^k) L`! -/
theorem lhBandAgree_scale_step_outer_strip (t k Q p0 L : Nat)
    (hp : t + Q < p0 + twopow k)
    (h0 : LhBandAgree t Q p0 L)
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) L) :
    LhBandAgree (t + twopow k) Q (p0 + twopow k) L := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  exact lhBandAgree_scale_step_uncond t k Q p0 L h0
    (lhBandAgree_outside_cone t Q (p0 + twopow k) L hp)
    (lhBandAgree_outside_cone t Q (p0 + twopow (k + 1)) L (by omega))
    hw

/-- **Outer `$2^k$`-Strip Band Derivation of `WinWittAgree` (`winWittAgree_outer_left_strip`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0 + 2^k`, `LhBandAgree (t + 2^k) Q (p0 + 2^k) L` and `LhBandAgree t Q p0 L` alone imply `WinWittAgree t k Q (t + p0 + 2^(k+1)) L`! -/
theorem winWittAgree_outer_left_strip (t k Q p0 L : Nat)
    (hp : t + Q < p0 + twopow k)
    (hlate : LhBandAgree (t + twopow k) Q (p0 + twopow k) L)
    (h0 : LhBandAgree t Q p0 L) :
    WinWittAgree t k Q (t + p0 + twopow (k + 1)) L := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  exact winWittAgree_of_lhBandAgree_scale_uncond t k Q p0 L hlate h0
    (lhBandAgree_outside_cone t Q (p0 + twopow k) L hp)
    (lhBandAgree_outside_cone t Q (p0 + twopow (k + 1)) L (by omega))

/-- **Mutual Incompatibility of `LhBandAgree (t + 2^k) Q (2^k) L` and `WinWittAgree t k Q (t + 2^(k+1)) L` Inside Scale `2^k` (`not_lhBandAgree_and_winWittAgree_of_lt_twopow`)**:
    for any `t, k, Q, L : Nat` with `0 < Q`, `t + Q ≤ L`, and `t + Q < 2^k`, `LhBandAgree (t + 2^k) Q (2^k) L` and `WinWittAgree t k Q (t + 2^(k+1)) L` cannot both hold, since their conjunction forces `LhBandAgree t Q 0 L` via `lhBandAgree_scale_inward_outer_strip`, contradicting `not_lhBandAgree_of_lt_add`! -/
theorem not_lhBandAgree_and_winWittAgree_of_lt_twopow (t k Q L : Nat)
    (hQ : 0 < Q) (hL : t + Q ≤ L) (hk : t + Q < twopow k)
    (hlate : LhBandAgree (t + twopow k) Q (twopow k) L) :
    ¬ WinWittAgree t k Q (t + twopow (k + 1)) L := by
  intro hw
  have hlate' : LhBandAgree (t + twopow k) Q (0 + twopow k) L := by
    simpa [Nat.zero_add] using hlate
  have hw' : WinWittAgree t k Q (t + 0 + twopow (k + 1)) L := by
    simpa [Nat.add_zero] using hw
  have h0 := lhBandAgree_scale_inward_outer_strip t k Q 0 L (by omega) hlate' hw'
  exact not_lhBandAgree_of_lt_add t Q L hQ hL h0

/-- **Unconditional Bit Readout of `frobDefect k (row t)` in `lhCenter` Coordinates (`frobDefect_row_testBit_lhCenter_uncond`)**:
    for ALL `t, k, p : Nat` (no light-cone bound required!), bit `(t + p + 1) + 2^(k+1)` of `frobDefect k (row t)` is the 3-term sum of pairwise products of `lhCenter t` cells at distances `2^k` and `2^(k+1)` apart! -/
theorem frobDefect_row_testBit_lhCenter_uncond (t k p : Nat) :
    (frobDefect k (row t)).testBit ((t + p + 1) + twopow (k + 1)) =
      bxor (bxor
        (lhCenter t ((p + 1) + twopow (k + 1)) &&
          bxor (lhCenter t (p + twopow k)) (lhCenter t p))
        (lhCenter t ((p + 1) + twopow k) &&
          bxor (lhCenter t (p + twopow (k + 1))) (lhCenter t p)))
        (lhCenter t (p + 1) &&
          bxor (lhCenter t (p + twopow (k + 1))) (lhCenter t (p + twopow k))) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hf := frobDefect_row_testBit_outside_cone t k (t + p + twopow k) (by omega)
  rw [show ((t + p + twopow k) + 1) + twopow k = (t + p + 1) + twopow (k + 1) by omega] at hf
  rw [hf,
    show (t + p + 1) + twopow (k + 1) = t + ((p + 1) + twopow (k + 1)) by omega,
    show ((t + p + twopow k) + 1) - twopow k = t + (p + 1) by omega,
    show (t + p + twopow k) + twopow k = t + (p + twopow (k + 1)) by omega,
    show (t + p + twopow k) + 1 = t + ((p + 1) + twopow k) by omega,
    show (t + p + twopow k) - twopow k = t + p by omega,
    show t + p + twopow k = t + (p + twopow k) by omega,
    rdiag_add_eq_lhCenter_uncond t ((p + 1) + twopow (k + 1)),
    rdiag_add_eq_lhCenter_uncond t (p + twopow k),
    rdiag_add_eq_lhCenter_uncond t p,
    rdiag_add_eq_lhCenter_uncond t ((p + 1) + twopow k),
    rdiag_add_eq_lhCenter_uncond t (p + twopow (k + 1)),
    rdiag_add_eq_lhCenter_uncond t (p + 1)]

theorem frobDefect_row_testBit_lhCenter_uncond_prop (t k p : Nat) :
    wittBitBool (frobDefect k (row t)) ((t + p + 1) + twopow (k + 1)) =
      bxor (bxor
        (lhCenter t ((p + 1) + twopow (k + 1)) &&
          bxor (lhCenter t (p + twopow k)) (lhCenter t p))
        (lhCenter t ((p + 1) + twopow k) &&
          bxor (lhCenter t (p + twopow (k + 1))) (lhCenter t p)))
        (lhCenter t (p + 1) &&
          bxor (lhCenter t (p + twopow (k + 1))) (lhCenter t (p + twopow k))) :=
  frobDefect_row_testBit_lhCenter_uncond t k p

/-- **Vanishing of `frobDefect k (row t)` Across the Outer `$2^k$`-Strip of the Left Cone (`frobDefect_row_testBit_lhCenter_outer_strip_eq_false`)**:
    for all `t, k, p : Nat` with `t < p + 2^k` (valid at ANY time `t`, even `t ≫ 2^k`!), all four shifted `lhCenter t` cells at `+ 2^k` and `+ 2^(k+1)` lie outside the left light cone and vanish, so `(frobDefect k (row t)).testBit ((t + p + 1) + 2^(k+1)) = false`! -/
theorem frobDefect_row_testBit_lhCenter_outer_strip_eq_false (t k p : Nat)
    (hp : t < p + twopow k) :
    (frobDefect k (row t)).testBit ((t + p + 1) + twopow (k + 1)) = false := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  rw [frobDefect_row_testBit_lhCenter_uncond t k p,
    lhCenter_gt_eq_false t ((p + 1) + twopow (k + 1)) (by omega),
    lhCenter_gt_eq_false t ((p + 1) + twopow k) (by omega),
    lhCenter_gt_eq_false t (p + twopow (k + 1)) (by omega),
    lhCenter_gt_eq_false t (p + twopow k) hp]
  cases lhCenter t (p + 1) <;> cases lhCenter t p <;> rfl

theorem frobDefect_row_testBit_lhCenter_outer_strip_eq_false_prop (t k p : Nat)
    (hp : t < p + twopow k) :
    wittBitBool (frobDefect k (row t)) ((t + p + 1) + twopow (k + 1)) = false :=
  frobDefect_row_testBit_lhCenter_outer_strip_eq_false t k p hp

/-! ### Batch 10: Single-Sector Window Evolution in the Outer `$2^k$`-Strip and Outer Cross-Center `$2^k$`-Scale Duality -/

/-- **Unconditional Bit Readout of `phiScale k (row t)` in `lhCenter` Coordinates (`phiScale_row_testBit_lhCenter_uncond`)**:
    for ALL `t, k, p : Nat` (no light-cone bound required!), bit `t + p + 2^(k+1)` of `phiScale k (row t)` is the 3-term XOR of `lhCenter t (p + 2^(k+1))`, `lhCenter t (p + 2^k)`, and `lhCenter t p`! -/
theorem phiScale_row_testBit_lhCenter_uncond (t k p : Nat) :
    (phiScale k (row t)).testBit (t + p + twopow (k + 1)) =
      bxor (bxor (lhCenter t (p + twopow (k + 1))) (lhCenter t (p + twopow k))) (lhCenter t p) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hp := phiScale_row_testBit_outside_cone t k (t + p + twopow k) (by omega)
  rw [show (t + p + twopow k) + twopow k = t + p + twopow (k + 1) by omega] at hp
  rw [hp,
    show t + p + twopow (k + 1) = t + (p + twopow (k + 1)) by omega,
    show (t + p + twopow k) - twopow k = t + p by omega,
    show t + p + twopow k = t + (p + twopow k) by omega,
    rdiag_add_eq_lhCenter_uncond t (p + twopow (k + 1)),
    rdiag_add_eq_lhCenter_uncond t (p + twopow k),
    rdiag_add_eq_lhCenter_uncond t p]

theorem phiScale_row_testBit_lhCenter_uncond_prop (t k p : Nat) :
    wittBitBool (phiScale k (row t)) (t + p + twopow (k + 1)) =
      bxor (bxor (lhCenter t (p + twopow (k + 1))) (lhCenter t (p + twopow k))) (lhCenter t p) :=
  phiScale_row_testBit_lhCenter_uncond t k p

/-- **Single-Cell Collapse of `phiScale k (row t)` Across the Outer `$2^k$`-Strip of the Left Cone (`phiScale_row_testBit_lhCenter_outer_strip`)**:
    for all `t, k, p : Nat` with `t < p + 2^k` (valid at ANY time `t`), both `lhCenter t (p + 2^(k+1))` and `lhCenter t (p + 2^k)` vanish, so `(phiScale k (row t)).testBit (t + p + 2^(k+1)) = lhCenter t p`! -/
theorem phiScale_row_testBit_lhCenter_outer_strip (t k p : Nat)
    (hp : t < p + twopow k) :
    (phiScale k (row t)).testBit (t + p + twopow (k + 1)) = lhCenter t p := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  rw [phiScale_row_testBit_lhCenter_uncond t k p,
    lhCenter_gt_eq_false t (p + twopow (k + 1)) (by omega),
    lhCenter_gt_eq_false t (p + twopow k) hp]
  cases lhCenter t p <;> rfl

theorem phiScale_row_testBit_lhCenter_outer_strip_prop (t k p : Nat)
    (hp : t < p + twopow k) :
    wittBitBool (phiScale k (row t)) (t + p + twopow (k + 1)) = lhCenter t p :=
  phiScale_row_testBit_lhCenter_outer_strip t k p hp

/-- **Single-Sector Collapse of `crossCarry (phiScale k (row t)) (winWitt t (2^k))` Across the Outer `$2^k$`-Strip (`crossCarry_row_scale_lhCenter_outer_strip`)**:
    for all `t, k, p : Nat` with `t < p + 2^k`, at bit `(t + p + 1) + 2^(k+1)`, `phiScale k (row t)` reads only `lhCenter t (p + 1)` and `lhCenter t p`, collapsing the cross-carry to a pure single-sector bilinear pairing! -/
theorem crossCarry_row_scale_lhCenter_outer_strip (t k p : Nat)
    (hp : t < p + twopow k) :
    (crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit ((t + p + 1) + twopow (k + 1)) =
      bxor
        (lhCenter t (p + 1) && (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)))
        ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow (k + 1)) && lhCenter t p) := by
  have hc := crossCarry_testBit_succ (phiScale k (row t)) (winWitt t (twopow k)) (t + p + twopow (k + 1))
  rw [show (t + p + twopow (k + 1)) + 1 = (t + p + 1) + twopow (k + 1) by omega] at hc
  rw [hc,
    show (t + p + 1) + twopow (k + 1) = t + (p + 1) + twopow (k + 1) by omega,
    phiScale_row_testBit_lhCenter_outer_strip t k (p + 1) (by omega),
    phiScale_row_testBit_lhCenter_outer_strip t k p hp]

theorem crossCarry_row_scale_lhCenter_outer_strip_prop (t k p : Nat)
    (hp : t < p + twopow k) :
    wittBitBool (crossCarry (phiScale k (row t)) (winWitt t (twopow k))) ((t + p + 1) + twopow (k + 1)) =
      bxor
        (lhCenter t (p + 1) && wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1)))
        (wittBitBool (winWitt t (twopow k)) (t + (p + 1) + twopow (k + 1)) && lhCenter t p) :=
  crossCarry_row_scale_lhCenter_outer_strip t k p hp

/-- **Single-Sector Window Step Law Across the Outer `$2^k$`-Strip of the Left Cone (`winWitt_step_outer_left_strip`)**:
    for all `t, k, p : Nat` with `t < p + 2^k` (valid at ANY time `t`), because `frobDefect k (row t)` vanishes (`frobDefect_row_testBit_lhCenter_outer_strip_eq_false`) and `phiScale k (row t)` collapses to `lhCenter t`, the universal window step `winWitt_step_frobDefect_testBit_succ` depends ONLY on `lhCenter t p`, `lhCenter t (p + 1)` and `winWitt t (2^k)`! -/
theorem winWitt_step_outer_left_strip (t k p : Nat)
    (hp : t < p + twopow k) :
    (winWitt (t + 1) (twopow k)).testBit ((t + 1) + (p + 1) + twopow (k + 1)) =
      bxor
        ((phi (winWitt t (twopow k))).testBit ((t + 1) + (p + 1) + twopow (k + 1)))
        (bxor
          (lhCenter t (p + 1) && (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)))
          ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow (k + 1)) && lhCenter t p)) := by
  have hs := winWitt_step_frobDefect_testBit_succ t k ((t + p + 1) + twopow (k + 1))
  rw [show ((t + p + 1) + twopow (k + 1)) + 1 = (t + 1) + (p + 1) + twopow (k + 1) by omega,
    crossCarry_row_scale_lhCenter_outer_strip t k p hp,
    frobDefect_row_testBit_lhCenter_outer_strip_eq_false t k p hp] at hs
  rw [hs]
  cases (phi (winWitt t (twopow k))).testBit ((t + 1) + (p + 1) + twopow (k + 1)) <;>
    cases (bxor
      (lhCenter t (p + 1) && (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)))
      ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow (k + 1)) && lhCenter t p)) <;> rfl

theorem winWitt_step_outer_left_strip_prop (t k p : Nat)
    (hp : t < p + twopow k) :
    wittBitBool (winWitt (t + 1) (twopow k)) ((t + 1) + (p + 1) + twopow (k + 1)) =
      bxor
        (wittBitBool (phi (winWitt t (twopow k))) ((t + 1) + (p + 1) + twopow (k + 1)))
        (bxor
          (lhCenter t (p + 1) && wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1)))
          (wittBitBool (winWitt t (twopow k)) (t + (p + 1) + twopow (k + 1)) && lhCenter t p)) :=
  winWitt_step_outer_left_strip t k p hp

/-- **Single-Sector 1-Step Forward Propagation of `WinWittAgree` in the Outer `$2^k$`-Strip (`winWittAgree_step_outer_left_strip`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0 + 2^k`, if `LhBandAgree t Q p0 (L + 1)` and `WinWittAgree t k Q (t + p0 + 2^(k+1)) (L + 2)` hold at time `t` alone (requiring ONLY the single inner `LhBandAgree` band at `p0`, and NO `LhBandAgree` hypotheses at `p0 + 2^k`, `p0 + 2^(k+1)`, or `t + 2^k`!), then `WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + 2^(k+1)) L` holds at time `t + 1`! -/
theorem winWittAgree_step_outer_left_strip (t k Q p0 L : Nat)
    (hp : t + Q < p0 + twopow k)
    (h0 : LhBandAgree t Q p0 (L + 1))
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) (L + 2)) :
    WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + twopow (k + 1)) L := by
  intro i hi
  have hsQ := winWitt_step_outer_left_strip (t + Q) k (p0 + i) (by omega)
  have hs0 := winWitt_step_outer_left_strip t k (p0 + i) (by omega)
  have hb0 := h0 i (by omega)
  have hb1 := h0 (i + 1) (by omega)
  have hw0 := hw i (by omega)
  have hw1 := hw (i + 1) (by omega)
  have hw2 := hw (i + 2) (by omega)
  rw [show p0 + (i + 1) = (p0 + i) + 1 by omega] at hb1
  rw [show (t + p0 + twopow (k + 1)) + i + Q = (t + Q) + (p0 + i) + twopow (k + 1) by omega,
    show (t + p0 + twopow (k + 1)) + i = t + (p0 + i) + twopow (k + 1) by omega] at hw0
  rw [show (t + p0 + twopow (k + 1)) + (i + 1) + Q = (t + Q) + ((p0 + i) + 1) + twopow (k + 1) by omega,
    show (t + p0 + twopow (k + 1)) + (i + 1) = t + ((p0 + i) + 1) + twopow (k + 1) by omega] at hw1
  rw [show (t + p0 + twopow (k + 1)) + (i + 2) + Q = ((t + Q) + (p0 + i) + twopow (k + 1)) + 2 by omega,
    show (t + p0 + twopow (k + 1)) + (i + 2) = (t + (p0 + i) + twopow (k + 1)) + 2 by omega] at hw2
  have hphiQ : (phi (winWitt (t + Q) (twopow k))).testBit (((t + Q) + 1) + ((p0 + i) + 1) + twopow (k + 1)) =
      bxor ((winWitt (t + Q) (twopow k)).testBit (((t + Q) + (p0 + i) + twopow (k + 1)) + 2))
        ((winWitt (t + Q) (twopow k)).testBit ((t + Q) + ((p0 + i) + 1) + twopow (k + 1)) ||
          (winWitt (t + Q) (twopow k)).testBit ((t + Q) + (p0 + i) + twopow (k + 1))) := by
    have hp0 := phi_testBit_add_two (winWitt (t + Q) (twopow k)) ((t + Q) + (p0 + i) + twopow (k + 1))
    rw [show (((t + Q) + 1) + ((p0 + i) + 1) + twopow (k + 1)) =
        ((t + Q) + (p0 + i) + twopow (k + 1)) + 2 by omega,
      hp0,
      show ((t + Q) + (p0 + i) + twopow (k + 1)) + 1 = (t + Q) + ((p0 + i) + 1) + twopow (k + 1) by omega,
      bxor_eq_xor]
  have hphi0 : (phi (winWitt t (twopow k))).testBit ((t + 1) + ((p0 + i) + 1) + twopow (k + 1)) =
      bxor ((winWitt t (twopow k)).testBit ((t + (p0 + i) + twopow (k + 1)) + 2))
        ((winWitt t (twopow k)).testBit (t + ((p0 + i) + 1) + twopow (k + 1)) ||
          (winWitt t (twopow k)).testBit (t + (p0 + i) + twopow (k + 1))) := by
    have hp0 := phi_testBit_add_two (winWitt t (twopow k)) (t + (p0 + i) + twopow (k + 1))
    rw [show ((t + 1) + ((p0 + i) + 1) + twopow (k + 1)) =
        (t + (p0 + i) + twopow (k + 1)) + 2 by omega,
      hp0,
      show (t + (p0 + i) + twopow (k + 1)) + 1 = t + ((p0 + i) + 1) + twopow (k + 1) by omega,
      bxor_eq_xor]
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    show ((t + 1) + (p0 + 1) + twopow (k + 1)) + i + Q =
      ((t + Q) + 1) + ((p0 + i) + 1) + twopow (k + 1) by omega,
    show ((t + 1) + (p0 + 1) + twopow (k + 1)) + i =
      (t + 1) + ((p0 + i) + 1) + twopow (k + 1) by omega,
    hsQ, hs0, hphiQ, hphi0, hb0, hb1, hw0, hw1, hw2]

/-- **Multi-Step Single-Sector Forward Propagation of `WinWittAgree` in the Outer `$2^k$`-Strip (`winWittAgree_steps_outer_left_strip`)**:
    by induction on `s : Nat`, for all `t, k, Q, p0, L, s : Nat` with `t + Q < p0 + 2^k`, if `LhBandAgree t Q p0 (L + 2 * s)` and `WinWittAgree t k Q (t + p0 + 2^(k+1)) (L + 2 * s)` hold at time `t` alone, then `WinWittAgree (t + s) k Q ((t + s) + (p0 + s) + 2^(k+1)) L` holds at time `t + s`! -/
theorem winWittAgree_steps_outer_left_strip (t k Q p0 L s : Nat)
    (hp : t + Q < p0 + twopow k)
    (h0 : LhBandAgree t Q p0 (L + 2 * s))
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) (L + 2 * s)) :
    WinWittAgree (t + s) k Q ((t + s) + (p0 + s) + twopow (k + 1)) L := by
  induction s generalizing t p0 L with
  | zero =>
    simpa using hw
  | succ s ih =>
    have h0_step : LhBandAgree t Q p0 ((L + 2 * s) + 2) := by
      intro i hi; exact h0 i (by omega)
    have h0_sub : LhBandAgree t Q p0 ((L + 2 * s) + 1) := by
      intro i hi; exact h0 i (by omega)
    have hw_step : WinWittAgree t k Q (t + p0 + twopow (k + 1)) ((L + 2 * s) + 2) := by
      intro i hi; exact hw i (by omega)
    have h0_next := lhBandAgree_step t Q p0 (L + 2 * s) h0_step
    have hw_next := winWittAgree_step_outer_left_strip t k Q p0 (L + 2 * s) hp h0_sub hw_step
    have h_ih := ih (t + 1) (p0 + 1) L (by omega) h0_next hw_next
    rw [show (t + 1) + s = t + (s + 1) by omega,
      show (p0 + 1) + s = p0 + (s + 1) by omega] at h_ih
    exact h_ih

/-- **Outward Spatial Step of `winWitt` Across the Outer `$2^k$`-Strip of the Left Cone (`winWitt_outward_step_outer_left_strip`)**:
    for all `t, k, p : Nat` with `t < p + 2^k`, solving `winWitt_step_outer_left_strip` for the outer window bit `(winWitt t (2^k)).testBit (t + (p + 2) + 2^(k+1))` expresses it in terms of `(winWitt (t + 1) (2^k)).testBit ((t + 1) + (p + 1) + 2^(k+1))`, the two inner window bits at `p + 1` and `p`, and `lhCenter t (p + 1)`, `lhCenter t p`! -/
theorem winWitt_outward_step_outer_left_strip (t k p : Nat)
    (hp : t < p + twopow k) :
    (winWitt t (twopow k)).testBit (t + (p + 2) + twopow (k + 1)) =
      bxor
        (bxor
          ((winWitt (t + 1) (twopow k)).testBit ((t + 1) + (p + 1) + twopow (k + 1)))
          ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow (k + 1)) ||
            (winWitt t (twopow k)).testBit (t + p + twopow (k + 1))))
        (bxor
          (lhCenter t (p + 1) && (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)))
          ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow (k + 1)) && lhCenter t p)) := by
  have hs := winWitt_step_outer_left_strip t k p hp
  have hphi := phi_testBit_add_two (winWitt t (twopow k)) (t + p + twopow (k + 1))
  rw [show (t + 1) + (p + 1) + twopow (k + 1) = (t + p + twopow (k + 1)) + 2 by omega,
    hphi,
    show (t + p + twopow (k + 1)) + 2 = t + (p + 2) + twopow (k + 1) by omega,
    show (t + p + twopow (k + 1)) + 1 = t + (p + 1) + twopow (k + 1) by omega] at hs
  rw [show (t + 1) + (p + 1) + twopow (k + 1) = t + (p + 2) + twopow (k + 1) by omega, hs]
  simp only [bxor_eq_xor]
  cases (winWitt t (twopow k)).testBit (t + (p + 2) + twopow (k + 1)) <;>
    cases ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow (k + 1)) ||
      (winWitt t (twopow k)).testBit (t + p + twopow (k + 1))) <;>
    cases ((lhCenter t (p + 1) && (winWitt t (twopow k)).testBit (t + p + twopow (k + 1))) ^^
      ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow (k + 1)) && lhCenter t p)) <;> rfl

theorem winWitt_outward_step_outer_left_strip_prop (t k p : Nat)
    (hp : t < p + twopow k) :
    wittBitBool (winWitt t (twopow k)) (t + (p + 2) + twopow (k + 1)) =
      bxor
        (bxor
          (wittBitBool (winWitt (t + 1) (twopow k)) ((t + 1) + (p + 1) + twopow (k + 1)))
          (wittBitBool (winWitt t (twopow k)) (t + (p + 1) + twopow (k + 1)) ||
            wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1))))
        (bxor
          (lhCenter t (p + 1) && wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1)))
          (wittBitBool (winWitt t (twopow k)) (t + (p + 1) + twopow (k + 1)) && lhCenter t p)) :=
  winWitt_outward_step_outer_left_strip t k p hp

/-- **Single-Sector 1-Cell Outward Spatial Extension of `WinWittAgree` in the Outer `$2^k$`-Strip (`winWittAgree_extend_outer_left_strip`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0 + 2^k`, if `LhBandAgree t Q p0 (L + 1)` and `WinWittAgree t k Q (t + p0 + 2^(k+1)) (L + 1)` hold at time `t`, and bit `(t + 1) + (p0 + L + 1) + 2^(k+1)` of `winWitt (t + 1) (2^k)` agrees between `t + 1` and `(t + 1) + Q`, then `WinWittAgree t k Q (t + p0 + 2^(k+1)) (L + 2)` holds at time `t`! -/
theorem winWittAgree_extend_outer_left_strip (t k Q p0 L : Nat)
    (hp : t + Q < p0 + twopow k)
    (h0 : LhBandAgree t Q p0 (L + 1))
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) (L + 1))
    (hstep : (winWitt ((t + 1) + Q) (twopow k)).testBit ((t + 1) + (p0 + L + 1) + twopow (k + 1) + Q) =
      (winWitt (t + 1) (twopow k)).testBit ((t + 1) + (p0 + L + 1) + twopow (k + 1))) :
    WinWittAgree t k Q (t + p0 + twopow (k + 1)) (L + 2) := by
  intro i hi
  rcases Nat.lt_or_eq_of_le hi with hlt | rfl
  · exact hw i (by omega)
  · have hsQ := winWitt_outward_step_outer_left_strip (t + Q) k (p0 + L) (by omega)
    have hs0 := winWitt_outward_step_outer_left_strip t k (p0 + L) (by omega)
    have hb0 := h0 L (by omega)
    have hb1 := h0 (L + 1) (by omega)
    have hw0 := hw L (by omega)
    have hw1 := hw (L + 1) (by omega)
    rw [show p0 + (L + 1) = (p0 + L) + 1 by omega] at hb1
    rw [show (t + p0 + twopow (k + 1)) + L + Q = (t + Q) + (p0 + L) + twopow (k + 1) by omega,
      show (t + p0 + twopow (k + 1)) + L = t + (p0 + L) + twopow (k + 1) by omega] at hw0
    rw [show (t + p0 + twopow (k + 1)) + (L + 1) + Q = (t + Q) + ((p0 + L) + 1) + twopow (k + 1) by omega,
      show (t + p0 + twopow (k + 1)) + (L + 1) = t + ((p0 + L) + 1) + twopow (k + 1) by omega] at hw1
    rw [show (t + 1) + Q = (t + Q) + 1 by omega,
      show (t + 1) + (p0 + L + 1) + twopow (k + 1) + Q =
        ((t + Q) + 1) + ((p0 + L) + 1) + twopow (k + 1) by omega,
      show (t + 1) + (p0 + L + 1) + twopow (k + 1) =
        (t + 1) + ((p0 + L) + 1) + twopow (k + 1) by omega] at hstep
    rw [show (t + p0 + twopow (k + 1)) + (L + 2) + Q =
        (t + Q) + ((p0 + L) + 2) + twopow (k + 1) by omega,
      show (t + p0 + twopow (k + 1)) + (L + 2) =
        t + ((p0 + L) + 2) + twopow (k + 1) by omega,
      hsQ, hs0, hstep, hw0, hw1, hb0, hb1]

/-- **Single-Sector Outward Band Step of `WinWittAgree` in the Outer `$2^k$`-Strip (`winWittAgree_outward_step_outer_left_strip`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0 + 2^k`, if `LhBandAgree t Q p0 (L + 1)`, `WinWittAgree t k Q (t + p0 + 2^(k+1)) (L + 1)`, and `WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + 2^(k+1)) L` hold, then `WinWittAgree t k Q (t + (p0 + 2) + 2^(k+1)) L` holds! -/
theorem winWittAgree_outward_step_outer_left_strip (t k Q p0 L : Nat)
    (hp : t + Q < p0 + twopow k)
    (h0 : LhBandAgree t Q p0 (L + 1))
    (hw : WinWittAgree t k Q (t + p0 + twopow (k + 1)) (L + 1))
    (hnext : WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + twopow (k + 1)) L) :
    WinWittAgree t k Q (t + (p0 + 2) + twopow (k + 1)) L := by
  intro i hi
  have hsQ := winWitt_outward_step_outer_left_strip (t + Q) k (p0 + i) (by omega)
  have hs0 := winWitt_outward_step_outer_left_strip t k (p0 + i) (by omega)
  have hb0 := h0 i (by omega)
  have hb1 := h0 (i + 1) (by omega)
  have hw0 := hw i (by omega)
  have hw1 := hw (i + 1) (by omega)
  have hwn := hnext i hi
  rw [show p0 + (i + 1) = (p0 + i) + 1 by omega] at hb1
  rw [show (t + p0 + twopow (k + 1)) + i + Q = (t + Q) + (p0 + i) + twopow (k + 1) by omega,
    show (t + p0 + twopow (k + 1)) + i = t + (p0 + i) + twopow (k + 1) by omega] at hw0
  rw [show (t + p0 + twopow (k + 1)) + (i + 1) + Q = (t + Q) + ((p0 + i) + 1) + twopow (k + 1) by omega,
    show (t + p0 + twopow (k + 1)) + (i + 1) = t + ((p0 + i) + 1) + twopow (k + 1) by omega] at hw1
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    show ((t + 1) + (p0 + 1) + twopow (k + 1)) + i + Q =
      ((t + Q) + 1) + ((p0 + i) + 1) + twopow (k + 1) by omega,
    show ((t + 1) + (p0 + 1) + twopow (k + 1)) + i =
      (t + 1) + ((p0 + i) + 1) + twopow (k + 1) by omega] at hwn
  rw [show (t + (p0 + 2) + twopow (k + 1)) + i + Q =
      (t + Q) + ((p0 + i) + 2) + twopow (k + 1) by omega,
    show (t + (p0 + 2) + twopow (k + 1)) + i =
      t + ((p0 + i) + 2) + twopow (k + 1) by omega,
    hsQ, hs0, hwn, hw0, hw1, hb0, hb1]

/-- **3-Term Cross-Center `$2^k$`-Scale Duality in the Outer `$2^{k+1}$`-Regime (`rhCenter_eq_lhCenter_scale_cross_outer`)**:
    for all `t, k, r : Nat` with `r ≤ 2^k` and `t + r < 2^(k+1)` (which holds for all `r ≤ 2^k` whenever `t < 2^k`), `lhCenter t (2^(k+1) - r) = false`, so `rhCenter_eq_lhCenter_scale_cross` collapses to the 3-term cross-center law `rhCenter t r = lhCenter (t + 2^k) (2^k - r) ⊕ lhCenter t (2^k - r) ⊕ (winWitt t (2^k)).testBit ((t + 2^(k+1)) - r)`! -/
theorem rhCenter_eq_lhCenter_scale_cross_outer (t k r : Nat)
    (hr : r ≤ twopow k) (htr : t + r < twopow (k + 1)) :
    rhCenter t r =
      bxor
        (bxor (lhCenter (t + twopow k) (twopow k - r)) (lhCenter t (twopow k - r)))
        ((winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r)) := by
  rw [rhCenter_eq_lhCenter_scale_cross t k r hr,
    lhCenter_gt_eq_false t (twopow (k + 1) - r) (by omega)]
  cases lhCenter (t + twopow k) (twopow k - r) <;>
    cases lhCenter t (twopow k - r) <;>
    cases (winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r) <;> rfl

theorem rhCenter_eq_lhCenter_scale_cross_outer_prop (t k r : Nat)
    (hr : r ≤ twopow k) (htr : t + r < twopow (k + 1)) :
    rhCenter t r =
      bxor
        (bxor (lhCenter (t + twopow k) (twopow k - r)) (lhCenter t (twopow k - r)))
        (wittBitBool (winWitt t (twopow k)) ((t + twopow (k + 1)) - r)) :=
  rhCenter_eq_lhCenter_scale_cross_outer t k r hr htr

/-- **Outer Cross-Center `$2^k$`-Scale Band Transport to `RhBandAgree` (`rhBandAgree_of_lhBandAgree_scale_cross_outer`)**:
    for all `t, k, Q, L : Nat` with `L ≤ 2^k` and `t + Q + L < 2^(k+1)`, the outer band `LhBandAgree t Q (2^(k+1) - L) L` holds unconditionally outside the light cone, so `LhBandAgree (t + 2^k) Q (2^k - L) L`, `LhBandAgree t Q (2^k - L) L`, and `WinWittAgree t k Q ((t + 2^(k+1)) - L) L` alone imply `RhBandAgree t Q 0 L`! -/
theorem rhBandAgree_of_lhBandAgree_scale_cross_outer (t k Q L : Nat)
    (hL : L ≤ twopow k) (ht : t + Q + L < twopow (k + 1))
    (hlate : LhBandAgree (t + twopow k) Q (twopow k - L) L)
    (h1 : LhBandAgree t Q (twopow k - L) L)
    (hw : WinWittAgree t k Q ((t + twopow (k + 1)) - L) L) :
    RhBandAgree t Q 0 L := by
  exact rhBandAgree_of_lhBandAgree_scale_cross t k Q L hL hlate h1
    (lhBandAgree_outside_cone t Q (twopow (k + 1) - L) L (by omega))
    hw

/-- **Outer Cross-Center `$2^k$`-Scale Band Transport to `WinWittAgree` (`winWittAgree_of_rhBandAgree_lhBandAgree_scale_cross_outer`)**:
    for all `t, k, Q, L : Nat` with `L ≤ 2^k` and `t + Q + L < 2^(k+1)`, `RhBandAgree t Q 0 L`, `LhBandAgree (t + 2^k) Q (2^k - L) L`, and `LhBandAgree t Q (2^k - L) L` alone imply `WinWittAgree t k Q ((t + 2^(k+1)) - L) L`! -/
theorem winWittAgree_of_rhBandAgree_lhBandAgree_scale_cross_outer (t k Q L : Nat)
    (hL : L ≤ twopow k) (ht : t + Q + L < twopow (k + 1))
    (hrh : RhBandAgree t Q 0 L)
    (hlate : LhBandAgree (t + twopow k) Q (twopow k - L) L)
    (h1 : LhBandAgree t Q (twopow k - L) L) :
    WinWittAgree t k Q ((t + twopow (k + 1)) - L) L := by
  exact winWittAgree_of_rhBandAgree_lhBandAgree_scale_cross t k Q L hL hrh hlate h1
    (lhBandAgree_outside_cone t Q (twopow (k + 1) - L) L (by omega))

/-- **Half-Horizon Derivation of `RhBandAgree` on `[0, 2^k]` when `t + m * P < 2^k` (`periodic_rhBandAgree_of_lhColAgree_one_and_winWittAgree_outer`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t` and `t + m * P < 2^k`, we only need `LhColAgree t (m * P) 1 (2^k)` and `LhColAgree (t + 2^k) (m * P) 1 (2^k)` (each of horizon `2^k` instead of `2^(k+1)`!) together with `WinWittAgree t k (m * P) (t + 2^k) (2^k)` to establish `RhBandAgree t (m * P) 0 (2^k)`! -/
theorem periodic_rhBandAgree_of_lhColAgree_one_and_winWittAgree_outer
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P < twopow k)
    (hcol_early : LhColAgree t (m * P) 1 (twopow k))
    (hcol_late : LhColAgree (t + twopow k) (m * P) 1 (twopow k))
    (hw : WinWittAgree t k (m * P) (t + twopow k) (twopow k)) :
    RhBandAgree t (m * P) 0 (twopow k) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have h0_early := periodic_lhColAgree_zero T P hP hper m t (twopow k) ht
  have h0_late := periodic_lhColAgree_zero T P hP hper m (t + twopow k) (twopow k) (by omega)
  have hb_early := lhBandAgree_of_outward_determine t (m * P) 0 (twopow k) h0_early hcol_early
  have hb_late := lhBandAgree_of_outward_determine (t + twopow k) (m * P) 0 (twopow k) h0_late hcol_late
  have h1 : LhBandAgree t (m * P) (twopow k - twopow k) (twopow k) := by
    rw [Nat.sub_self]
    intro i hi
    exact hb_early i (by omega)
  have hlate : LhBandAgree (t + twopow k) (m * P) (twopow k - twopow k) (twopow k) := by
    rw [Nat.sub_self]
    intro i hi
    exact hb_late i (by omega)
  have hw' : WinWittAgree t k (m * P) ((t + twopow (k + 1)) - twopow k) (twopow k) := by
    rw [show (t + twopow (k + 1)) - twopow k = t + twopow k by omega]
    exact hw
  exact rhBandAgree_of_lhBandAgree_scale_cross_outer t k (m * P) (twopow k)
    (Nat.le_refl _) (by omega) hlate h1 hw'

/-- **Half-Horizon Converse Derivation of `WinWittAgree` when `t + m * P < 2^k` (`periodic_winWittAgree_of_lhColAgree_one_and_rhBandAgree_outer`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t` and `t + m * P < 2^k`, `LhColAgree t (m * P) 1 (2^k)`, `LhColAgree (t + 2^k) (m * P) 1 (2^k)`, and `RhBandAgree t (m * P) 0 (2^k)` imply `WinWittAgree t k (m * P) (t + 2^k) (2^k)`! -/
theorem periodic_winWittAgree_of_lhColAgree_one_and_rhBandAgree_outer
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P < twopow k)
    (hcol_early : LhColAgree t (m * P) 1 (twopow k))
    (hcol_late : LhColAgree (t + twopow k) (m * P) 1 (twopow k))
    (hrh : RhBandAgree t (m * P) 0 (twopow k)) :
    WinWittAgree t k (m * P) (t + twopow k) (twopow k) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have h0_early := periodic_lhColAgree_zero T P hP hper m t (twopow k) ht
  have h0_late := periodic_lhColAgree_zero T P hP hper m (t + twopow k) (twopow k) (by omega)
  have hb_early := lhBandAgree_of_outward_determine t (m * P) 0 (twopow k) h0_early hcol_early
  have hb_late := lhBandAgree_of_outward_determine (t + twopow k) (m * P) 0 (twopow k) h0_late hcol_late
  have h1 : LhBandAgree t (m * P) (twopow k - twopow k) (twopow k) := by
    rw [Nat.sub_self]
    intro i hi
    exact hb_early i (by omega)
  have hlate : LhBandAgree (t + twopow k) (m * P) (twopow k - twopow k) (twopow k) := by
    rw [Nat.sub_self]
    intro i hi
    exact hb_late i (by omega)
  have hw := winWittAgree_of_rhBandAgree_lhBandAgree_scale_cross_outer t k (m * P) (twopow k)
    (Nat.le_refl _) (by omega) hrh hlate h1
  rwa [show (t + twopow (k + 1)) - twopow k = t + twopow k by omega] at hw

/-- **2-Term In-Cone Cross-Center `$2^k$`-Scale Duality (`rhCenter_eq_lhCenter_scale_cross_cone`)**:
    for all `t, k, r : Nat` with `t + r < 2^k` (where both `lhCenter t (2^k - r)` and `lhCenter t (2^(k+1) - r)` lie outside the light cone at time `t` and vanish!), `rhCenter_eq_lhCenter_scale_cross` collapses to the 2-term law `rhCenter t r = lhCenter (t + 2^k) (2^k - r) ⊕ (winWitt t (2^k)).testBit ((t + 2^(k+1)) - r)`! -/
theorem rhCenter_eq_lhCenter_scale_cross_cone (t k r : Nat)
    (htr : t + r < twopow k) :
    rhCenter t r =
      bxor (lhCenter (t + twopow k) (twopow k - r))
        ((winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r)) := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  rw [rhCenter_eq_lhCenter_scale_cross_outer t k r (by omega) (by omega),
    lhCenter_gt_eq_false t (twopow k - r) (by omega)]
  cases lhCenter (t + twopow k) (twopow k - r) <;>
    cases (winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r) <;> rfl

theorem rhCenter_eq_lhCenter_scale_cross_cone_prop (t k r : Nat)
    (htr : t + r < twopow k) :
    rhCenter t r =
      bxor (lhCenter (t + twopow k) (twopow k - r))
        (wittBitBool (winWitt t (twopow k)) ((t + twopow (k + 1)) - r)) :=
  rhCenter_eq_lhCenter_scale_cross_cone t k r htr

/-! ### Batch 11: In-Cone Cross-Center Triality, Inter-Cone Zero-Gap Direct Readout of Late `lhCenter`, and Unconditional Left-Half Window Defect Step -/

/-- **2-Term In-Cone Cross-Center Readout of Late `lhCenter` (`lhCenter_scale_cross_cone`)**:
    for all `t, k, r : Nat` with `t + r < 2^k`, solving `rhCenter_eq_lhCenter_scale_cross_cone` for `lhCenter (t + 2^k) (2^k - r)` gives `lhCenter (t + 2^k) (2^k - r) = rhCenter t r ⊕ (winWitt t (2^k)).testBit ((t + 2^(k+1)) - r)`! -/
theorem lhCenter_scale_cross_cone (t k r : Nat)
    (htr : t + r < twopow k) :
    lhCenter (t + twopow k) (twopow k - r) =
      bxor (rhCenter t r)
        ((winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r)) := by
  rw [rhCenter_eq_lhCenter_scale_cross_cone t k r htr]
  cases lhCenter (t + twopow k) (twopow k - r) <;>
    cases (winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r) <;> rfl

theorem lhCenter_scale_cross_cone_prop (t k r : Nat)
    (htr : t + r < twopow k) :
    lhCenter (t + twopow k) (twopow k - r) =
      bxor (rhCenter t r)
        (wittBitBool (winWitt t (twopow k)) ((t + twopow (k + 1)) - r)) :=
  lhCenter_scale_cross_cone t k r htr

/-- **2-Term In-Cone Cross-Center Readout of `winWitt` (`winWitt_testBit_scale_cross_cone`)**:
    for all `t, k, r : Nat` with `t + r < 2^k`, `(winWitt t (2^k)).testBit ((t + 2^(k+1)) - r) = lhCenter (t + 2^k) (2^k - r) ⊕ rhCenter t r`! -/
theorem winWitt_testBit_scale_cross_cone (t k r : Nat)
    (htr : t + r < twopow k) :
    (winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r) =
      bxor (lhCenter (t + twopow k) (twopow k - r)) (rhCenter t r) := by
  rw [rhCenter_eq_lhCenter_scale_cross_cone t k r htr]
  cases lhCenter (t + twopow k) (twopow k - r) <;>
    cases (winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r) <;> rfl

theorem winWitt_testBit_scale_cross_cone_prop (t k r : Nat)
    (htr : t + r < twopow k) :
    wittBitBool (winWitt t (twopow k)) ((t + twopow (k + 1)) - r) =
      bxor (lhCenter (t + twopow k) (twopow k - r)) (rhCenter t r) :=
  winWitt_testBit_scale_cross_cone t k r htr

/-- **Direct Window Readout in the Inter-Cone Zero Gap (`winWitt_testBit_scale_cross_zero_gap`)**:
    for all `t, k, r : Nat` with `t < r` and `t + r < 2^k` (the inter-cone zero gap between the lower cone `r ≤ t` and the middle cone `t + r ≥ 2^k`), `rhCenter t r = false`, so `(winWitt t (2^k)).testBit ((t + 2^(k+1)) - r) = lhCenter (t + 2^k) (2^k - r)`! -/
theorem winWitt_testBit_scale_cross_zero_gap (t k r : Nat)
    (ht : t < r) (htr : t + r < twopow k) :
    (winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - r) =
      lhCenter (t + twopow k) (twopow k - r) := by
  rw [winWitt_testBit_scale_cross_cone t k r htr,
    rhCenter_gt_eq_false t r ht]
  cases lhCenter (t + twopow k) (twopow k - r) <;> rfl

theorem winWitt_testBit_scale_cross_zero_gap_prop (t k r : Nat)
    (ht : t < r) (htr : t + r < twopow k) :
    wittBitBool (winWitt t (twopow k)) ((t + twopow (k + 1)) - r) =
      lhCenter (t + twopow k) (twopow k - r) :=
  winWitt_testBit_scale_cross_zero_gap t k r ht htr

/-- **Direct Readout of Late `lhCenter (t + 2^k) p` from `winWitt t (2^k)` in the Inter-Cone Zero Gap (`winWitt_testBit_zero_gap_eq_lhCenter_late`)**:
    for all `t, k, p : Nat` with `t < p` and `t + p < 2^k`, all three shifted copies of `row t` in `phiScale k (row t)` vanish at bit `t + p + 2^k`, so `(winWitt t (2^k)).testBit (t + p + 2^k) = lhCenter (t + 2^k) p`! -/
theorem winWitt_testBit_zero_gap_eq_lhCenter_late (t k p : Nat)
    (htp : t < p) (hp : t + p < twopow k) :
    (winWitt t (twopow k)).testBit (t + p + twopow k) =
      lhCenter (t + twopow k) p := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hz := winWitt_testBit_scale_cross_zero_gap t k (twopow k - p) (by omega) (by omega)
  rwa [show (t + twopow (k + 1)) - (twopow k - p) = t + p + twopow k by omega,
    show twopow k - (twopow k - p) = p by omega] at hz

theorem winWitt_testBit_zero_gap_eq_lhCenter_late_prop (t k p : Nat)
    (htp : t < p) (hp : t + p < twopow k) :
    wittBitBool (winWitt t (twopow k)) (t + p + twopow k) =
      lhCenter (t + twopow k) p :=
  winWitt_testBit_zero_gap_eq_lhCenter_late t k p htp hp

/-- **Deriving Late `LhBandAgree (t + 2^k)` Directly from `WinWittAgree t` in the Inter-Cone Zero Gap (`lhBandAgree_of_winWittAgree_zero_gap`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0` and `t + Q + p0 + L < 2^k`, `WinWittAgree t k Q (t + p0 + 2^k) L` at time `t` directly implies `LhBandAgree (t + 2^k) Q p0 L` at time `t + 2^k` with zero `lhCenter` hypotheses at time `t`! -/
theorem lhBandAgree_of_winWittAgree_zero_gap (t k Q p0 L : Nat)
    (hp0 : t + Q < p0) (hL : t + Q + p0 + L < twopow k)
    (hw : WinWittAgree t k Q (t + p0 + twopow k) L) :
    LhBandAgree (t + twopow k) Q p0 L := by
  intro i hi
  have hwi := hw i hi
  have hzQ := winWitt_testBit_zero_gap_eq_lhCenter_late (t + Q) k (p0 + i) (by omega) (by omega)
  have hz0 := winWitt_testBit_zero_gap_eq_lhCenter_late t k (p0 + i) (by omega) (by omega)
  rw [show (t + p0 + twopow k) + i + Q = (t + Q) + (p0 + i) + twopow k by omega,
    show (t + p0 + twopow k) + i = t + (p0 + i) + twopow k by omega,
    hzQ, hz0] at hwi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega]
  exact hwi

/-- **Deriving `WinWittAgree t` Directly from Late `LhBandAgree (t + 2^k)` in the Inter-Cone Zero Gap (`winWittAgree_of_lhBandAgree_zero_gap`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0` and `t + Q + p0 + L < 2^k`, `LhBandAgree (t + 2^k) Q p0 L` at time `t + 2^k` directly implies `WinWittAgree t k Q (t + p0 + 2^k) L` at time `t`! -/
theorem winWittAgree_of_lhBandAgree_zero_gap (t k Q p0 L : Nat)
    (hp0 : t + Q < p0) (hL : t + Q + p0 + L < twopow k)
    (hlate : LhBandAgree (t + twopow k) Q p0 L) :
    WinWittAgree t k Q (t + p0 + twopow k) L := by
  intro i hi
  have hbl := hlate i hi
  have hzQ := winWitt_testBit_zero_gap_eq_lhCenter_late (t + Q) k (p0 + i) (by omega) (by omega)
  have hz0 := winWitt_testBit_zero_gap_eq_lhCenter_late t k (p0 + i) (by omega) (by omega)
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega] at hbl
  rw [show (t + p0 + twopow k) + i + Q = (t + Q) + (p0 + i) + twopow k by omega,
    show (t + p0 + twopow k) + i = t + (p0 + i) + twopow k by omega,
    hzQ, hz0, hbl]

/-- **In-Cone Cross-Center Derivation of `RhBandAgree` without Early `LhBandAgree` (`rhBandAgree_of_lhBandAgree_and_winWittAgree_cross_cone`)**:
    for all `t, k, Q, L : Nat` with `t + Q + L < 2^k`, both early `LhBandAgree` bands at `2^k - L` and `2^(k+1) - L` lie outside the light cone at time `t + Q` and hold unconditionally, so `LhBandAgree (t + 2^k) Q (2^k - L) L` and `WinWittAgree t k Q ((t + 2^(k+1)) - L) L` alone imply `RhBandAgree t Q 0 L`! -/
theorem rhBandAgree_of_lhBandAgree_and_winWittAgree_cross_cone (t k Q L : Nat)
    (ht : t + Q + L < twopow k)
    (hlate : LhBandAgree (t + twopow k) Q (twopow k - L) L)
    (hw : WinWittAgree t k Q ((t + twopow (k + 1)) - L) L) :
    RhBandAgree t Q 0 L := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  exact rhBandAgree_of_lhBandAgree_scale_cross_outer t k Q L (by omega) (by omega) hlate
    (lhBandAgree_outside_cone t Q (twopow k - L) L (by omega))
    hw

/-- **In-Cone Cross-Center Derivation of `WinWittAgree` without Early `LhBandAgree` (`winWittAgree_of_rhBandAgree_and_lhBandAgree_cross_cone`)**:
    for all `t, k, Q, L : Nat` with `t + Q + L < 2^k`, `RhBandAgree t Q 0 L` and `LhBandAgree (t + 2^k) Q (2^k - L) L` alone imply `WinWittAgree t k Q ((t + 2^(k+1)) - L) L`! -/
theorem winWittAgree_of_rhBandAgree_and_lhBandAgree_cross_cone (t k Q L : Nat)
    (ht : t + Q + L < twopow k)
    (hrh : RhBandAgree t Q 0 L)
    (hlate : LhBandAgree (t + twopow k) Q (twopow k - L) L) :
    WinWittAgree t k Q ((t + twopow (k + 1)) - L) L := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  exact winWittAgree_of_rhBandAgree_lhBandAgree_scale_cross_outer t k Q L (by omega) (by omega) hrh hlate
    (lhBandAgree_outside_cone t Q (twopow k - L) L (by omega))

/-- **In-Cone Cross-Center Derivation of Late `LhBandAgree` from `RhBandAgree` and `WinWittAgree` (`lhBandAgree_of_rhBandAgree_and_winWittAgree_cross_cone`)**:
    for all `t, k, Q, L : Nat` with `t + Q + L < 2^k`, `RhBandAgree t Q 0 L` and `WinWittAgree t k Q ((t + 2^(k+1)) - L) L` alone imply `LhBandAgree (t + 2^k) Q (2^k - L) L`! -/
theorem lhBandAgree_of_rhBandAgree_and_winWittAgree_cross_cone (t k Q L : Nat)
    (ht : t + Q + L < twopow k)
    (hrh : RhBandAgree t Q 0 L)
    (hw : WinWittAgree t k Q ((t + twopow (k + 1)) - L) L) :
    LhBandAgree (t + twopow k) Q (twopow k - L) L := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  intro i hi
  have hsQ := lhCenter_scale_cross_cone (t + Q) k (L - i) (by omega)
  have hs0 := lhCenter_scale_cross_cone t k (L - i) (by omega)
  have hr := hrh (L - i) (by omega)
  have hwi := hw i hi
  rw [Nat.zero_add] at hr
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (twopow k - L) + i = twopow k - (L - i) by omega,
    hsQ, hs0, hr,
    show ((t + Q) + twopow (k + 1)) - (L - i) = ((t + twopow (k + 1)) - L) + i + Q by omega,
    show (t + twopow (k + 1)) - (L - i) = ((t + twopow (k + 1)) - L) + i by omega,
    hwi]

/-- **Deriving `RhBandAgree` from Late `LhColAgree (t + 2^k)` Alone when `t + m * P + L < 2^k` (`periodic_rhBandAgree_of_lhColAgree_late_and_winWittAgree_cone`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t` and `t + m * P + L < 2^k`, we ONLY need `LhColAgree (t + 2^k) (m * P) 1 (2^k)` at late time `t + 2^k` (and NO `LhColAgree` at early time `t`!) together with `WinWittAgree t k (m * P) ((t + 2^(k+1)) - L) L` to establish `RhBandAgree t (m * P) 0 L`! -/
theorem periodic_rhBandAgree_of_lhColAgree_late_and_winWittAgree_cone
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k L : Nat) (ht : T ≤ t) (htk : t + m * P + L < twopow k)
    (hcol_late : LhColAgree (t + twopow k) (m * P) 1 (twopow k))
    (hw : WinWittAgree t k (m * P) ((t + twopow (k + 1)) - L) L) :
    RhBandAgree t (m * P) 0 L := by
  have h0_late := periodic_lhColAgree_zero T P hP hper m (t + twopow k) (twopow k) (by omega)
  have hb_late := lhBandAgree_of_outward_determine (t + twopow k) (m * P) 0 (twopow k) h0_late hcol_late
  have hlate : LhBandAgree (t + twopow k) (m * P) (twopow k - L) L :=
    lhBandAgree_mono (t + twopow k) (m * P) 0 (twopow k + 1) (twopow k - L) L (by omega) (by omega) hb_late
  exact rhBandAgree_of_lhBandAgree_and_winWittAgree_cross_cone t k (m * P) L htk hlate hw

/-- **Converse Derivation of `WinWittAgree` from Late `LhColAgree (t + 2^k)` and `RhBandAgree` when `t + m * P + L < 2^k` (`periodic_winWittAgree_of_lhColAgree_late_and_rhBandAgree_cone`)**:
    under `CenterPeriodic T P` (`0 < P`), for `T ≤ t` and `t + m * P + L < 2^k`, `LhColAgree (t + 2^k) (m * P) 1 (2^k)` and `RhBandAgree t (m * P) 0 L` alone imply `WinWittAgree t k (m * P) ((t + 2^(k+1)) - L) L`! -/
theorem periodic_winWittAgree_of_lhColAgree_late_and_rhBandAgree_cone
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k L : Nat) (ht : T ≤ t) (htk : t + m * P + L < twopow k)
    (hcol_late : LhColAgree (t + twopow k) (m * P) 1 (twopow k))
    (hrh : RhBandAgree t (m * P) 0 L) :
    WinWittAgree t k (m * P) ((t + twopow (k + 1)) - L) L := by
  have h0_late := periodic_lhColAgree_zero T P hP hper m (t + twopow k) (twopow k) (by omega)
  have hb_late := lhBandAgree_of_outward_determine (t + twopow k) (m * P) 0 (twopow k) h0_late hcol_late
  have hlate : LhBandAgree (t + twopow k) (m * P) (twopow k - L) L :=
    lhBandAgree_mono (t + twopow k) (m * P) 0 (twopow k + 1) (twopow k - L) L (by omega) (by omega) hb_late
  exact winWittAgree_of_rhBandAgree_and_lhBandAgree_cross_cone t k (m * P) L htk hrh hlate

/-- **1-Step Evolution of Late `lhCenter` in the Outer `$2^k$`-Strip via `winWitt` (`lhCenter_step_outer_strip_from_winWitt`)**:
    for all `t, k, p : Nat` with `t < p + 2^k`, combining `lhCenter_step_succ` at `(t + 2^k, p + 2^k)` with `lhCenter_scale_step_outer_strip` at `p`, `p + 1`, and `p + 2` expresses `lhCenter ((t + 1) + 2^k) ((p + 1) + 2^k)` purely in terms of `lhCenter t` and `winWitt t (2^k)`! -/
theorem lhCenter_step_outer_strip_from_winWitt (t k p : Nat)
    (hp : t < p + twopow k) :
    lhCenter ((t + 1) + twopow k) ((p + 1) + twopow k) =
      bxor
        (bxor (lhCenter t (p + 2)) ((winWitt t (twopow k)).testBit (t + (p + 2) + twopow (k + 1))))
        ((bxor (lhCenter t (p + 1)) ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow (k + 1)))) ||
          (bxor (lhCenter t p) ((winWitt t (twopow k)).testBit (t + p + twopow (k + 1))))) := by
  rw [show (t + 1) + twopow k = (t + twopow k) + 1 by omega,
    show (p + 1) + twopow k = (p + twopow k) + 1 by omega,
    lhCenter_step_succ (t + twopow k) (p + twopow k),
    show (p + twopow k) + 2 = (p + 2) + twopow k by omega,
    show (p + twopow k) + 1 = (p + 1) + twopow k by omega,
    lhCenter_scale_step_outer_strip t k (p + 2) (by omega),
    lhCenter_scale_step_outer_strip t k (p + 1) (by omega),
    lhCenter_scale_step_outer_strip t k p hp]

theorem lhCenter_step_outer_strip_from_winWitt_prop (t k p : Nat)
    (hp : t < p + twopow k) :
    lhCenter ((t + 1) + twopow k) ((p + 1) + twopow k) =
      bxor
        (bxor (lhCenter t (p + 2)) (wittBitBool (winWitt t (twopow k)) (t + (p + 2) + twopow (k + 1))))
        ((bxor (lhCenter t (p + 1)) (wittBitBool (winWitt t (twopow k)) (t + (p + 1) + twopow (k + 1)))) ||
          (bxor (lhCenter t p) (wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1))))) :=
  lhCenter_step_outer_strip_from_winWitt t k p hp

/-- **Unconditional 1-Step Spatiotemporal Difference Law of `winWitt` in `lhCenter` Coordinates (`winWitt_step_lhCenter_defect_uncond`)**:
    for ALL `t, k, p : Nat` (unconditional!), substituting `lhCenter_step_succ` into `winWitt_testBit_eq_lhCenter_scale_uncond (t + 1) k (p + 1)` relates the window bit at `(t + 1, p + 1)` directly to the window bit at `(t, p + 2)` XORed with the four adjacent-column OR-pairs in `lhCenter`! -/
theorem winWitt_step_lhCenter_defect_uncond (t k p : Nat) :
    (winWitt (t + 1) (twopow k)).testBit ((t + 1) + (p + 1) + twopow (k + 1)) =
      bxor
        ((winWitt t (twopow k)).testBit (t + (p + 2) + twopow (k + 1)))
        (bxor
          (bxor
            (bxor
              (lhCenter (t + twopow k) ((p + 1) + twopow k) || lhCenter (t + twopow k) (p + twopow k))
              (lhCenter t (p + 1) || lhCenter t p))
            (lhCenter t ((p + 1) + twopow k) || lhCenter t (p + twopow k)))
          (lhCenter t ((p + 1) + twopow (k + 1)) || lhCenter t (p + twopow (k + 1)))) := by
  rw [winWitt_testBit_eq_lhCenter_scale_uncond (t + 1) k (p + 1),
    winWitt_testBit_eq_lhCenter_scale_uncond t k (p + 2),
    show (t + 1) + twopow k = (t + twopow k) + 1 by omega,
    show (p + 1) + twopow k = (p + twopow k) + 1 by omega,
    show (p + 1) + twopow (k + 1) = (p + twopow (k + 1)) + 1 by omega,
    show (p + 2) + twopow k = (p + twopow k) + 2 by omega,
    show (p + 2) + twopow (k + 1) = (p + twopow (k + 1)) + 2 by omega,
    lhCenter_step_succ (t + twopow k) (p + twopow k),
    lhCenter_step_succ t p,
    lhCenter_step_succ t (p + twopow k),
    lhCenter_step_succ t (p + twopow (k + 1))]
  simp only [bxor_eq_xor]
  cases lhCenter (t + twopow k) ((p + twopow k) + 2) <;>
    cases (lhCenter (t + twopow k) ((p + twopow k) + 1) || lhCenter (t + twopow k) (p + twopow k)) <;>
    cases lhCenter t (p + 2) <;>
    cases (lhCenter t (p + 1) || lhCenter t p) <;>
    cases lhCenter t ((p + twopow k) + 2) <;>
    cases (lhCenter t ((p + twopow k) + 1) || lhCenter t (p + twopow k)) <;>
    cases lhCenter t ((p + twopow (k + 1)) + 2) <;>
    cases (lhCenter t ((p + twopow (k + 1)) + 1) || lhCenter t (p + twopow (k + 1))) <;> rfl

theorem winWitt_step_lhCenter_defect_uncond_prop (t k p : Nat) :
    wittBitBool (winWitt (t + 1) (twopow k)) ((t + 1) + (p + 1) + twopow (k + 1)) =
      bxor
        (wittBitBool (winWitt t (twopow k)) (t + (p + 2) + twopow (k + 1)))
        (bxor
          (bxor
            (bxor
              (lhCenter (t + twopow k) ((p + 1) + twopow k) || lhCenter (t + twopow k) (p + twopow k))
              (lhCenter t (p + 1) || lhCenter t p))
            (lhCenter t ((p + 1) + twopow k) || lhCenter t (p + twopow k)))
          (lhCenter t ((p + 1) + twopow (k + 1)) || lhCenter t (p + twopow (k + 1)))) :=
  winWitt_step_lhCenter_defect_uncond t k p

/-- **Unconditional 1-Step Forward Transport of `WinWittAgree` via Four `LhBandAgree` Bands (`winWittAgree_step_of_lhBandAgree_scale_uncond`)**:
    for ALL `t, k, Q, p0, L : Nat`, if the four `LhBandAgree` bands of width `L + 1` hold at `(t + 2^k, p0 + 2^k)`, `(t, p0)`, `(t, p0 + 2^k)`, and `(t, p0 + 2^(k+1))`, and `WinWittAgree t k Q (t + (p0 + 2) + 2^(k+1)) L` holds at time `t`, then `WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + 2^(k+1)) L` holds at time `t + 1`! -/
theorem winWittAgree_step_of_lhBandAgree_scale_uncond (t k Q p0 L : Nat)
    (hlate : LhBandAgree (t + twopow k) Q (p0 + twopow k) (L + 1))
    (h0 : LhBandAgree t Q p0 (L + 1))
    (h1 : LhBandAgree t Q (p0 + twopow k) (L + 1))
    (h2 : LhBandAgree t Q (p0 + twopow (k + 1)) (L + 1))
    (hw : WinWittAgree t k Q (t + (p0 + 2) + twopow (k + 1)) L) :
    WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + twopow (k + 1)) L := by
  intro i hi
  have hsQ := winWitt_step_lhCenter_defect_uncond (t + Q) k (p0 + i)
  have hs0 := winWitt_step_lhCenter_defect_uncond t k (p0 + i)
  have hbl0 := hlate i (by omega)
  have hbl1 := hlate (i + 1) (by omega)
  have hb00 := h0 i (by omega)
  have hb01 := h0 (i + 1) (by omega)
  have hb10 := h1 i (by omega)
  have hb11 := h1 (i + 1) (by omega)
  have hb20 := h2 i (by omega)
  have hb21 := h2 (i + 1) (by omega)
  have hwi := hw i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hbl0
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + (i + 1) = ((p0 + i) + 1) + twopow k by omega] at hbl1
  rw [show p0 + (i + 1) = (p0 + i) + 1 by omega] at hb01
  rw [show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hb10
  rw [show (p0 + twopow k) + (i + 1) = ((p0 + i) + 1) + twopow k by omega] at hb11
  rw [show (p0 + twopow (k + 1)) + i = (p0 + i) + twopow (k + 1) by omega] at hb20
  rw [show (p0 + twopow (k + 1)) + (i + 1) = ((p0 + i) + 1) + twopow (k + 1) by omega] at hb21
  rw [show (t + (p0 + 2) + twopow (k + 1)) + i + Q =
      (t + Q) + ((p0 + i) + 2) + twopow (k + 1) by omega,
    show (t + (p0 + 2) + twopow (k + 1)) + i =
      t + ((p0 + i) + 2) + twopow (k + 1) by omega] at hwi
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    show ((t + 1) + (p0 + 1) + twopow (k + 1)) + i + Q =
      ((t + Q) + 1) + ((p0 + i) + 1) + twopow (k + 1) by omega,
    show ((t + 1) + (p0 + 1) + twopow (k + 1)) + i =
      (t + 1) + ((p0 + i) + 1) + twopow (k + 1) by omega,
    hsQ, hs0, hwi, hbl0, hbl1, hb00, hb01, hb10, hb11, hb20, hb21]

/-- **Unconditional 1-Step Outward Transport of `WinWittAgree` via Four `LhBandAgree` Bands (`winWittAgree_outward_of_lhBandAgree_scale_uncond`)**:
    for ALL `t, k, Q, p0, L : Nat`, if the four `LhBandAgree` bands of width `L + 1` hold at `(t + 2^k, p0 + 2^k)`, `(t, p0)`, `(t, p0 + 2^k)`, and `(t, p0 + 2^(k+1))`, and `WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + 2^(k+1)) L` holds at time `t + 1`, then `WinWittAgree t k Q (t + (p0 + 2) + 2^(k+1)) L` holds at time `t`! -/
theorem winWittAgree_outward_of_lhBandAgree_scale_uncond (t k Q p0 L : Nat)
    (hlate : LhBandAgree (t + twopow k) Q (p0 + twopow k) (L + 1))
    (h0 : LhBandAgree t Q p0 (L + 1))
    (h1 : LhBandAgree t Q (p0 + twopow k) (L + 1))
    (h2 : LhBandAgree t Q (p0 + twopow (k + 1)) (L + 1))
    (hnext : WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + twopow (k + 1)) L) :
    WinWittAgree t k Q (t + (p0 + 2) + twopow (k + 1)) L := by
  intro i hi
  have hsQ := winWitt_step_lhCenter_defect_uncond (t + Q) k (p0 + i)
  have hs0 := winWitt_step_lhCenter_defect_uncond t k (p0 + i)
  have hbl0 := hlate i (by omega)
  have hbl1 := hlate (i + 1) (by omega)
  have hb00 := h0 i (by omega)
  have hb01 := h0 (i + 1) (by omega)
  have hb10 := h1 i (by omega)
  have hb11 := h1 (i + 1) (by omega)
  have hb20 := h2 i (by omega)
  have hb21 := h2 (i + 1) (by omega)
  have hwn := hnext i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hbl0
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    show (p0 + twopow k) + (i + 1) = ((p0 + i) + 1) + twopow k by omega] at hbl1
  rw [show p0 + (i + 1) = (p0 + i) + 1 by omega] at hb01
  rw [show (p0 + twopow k) + i = (p0 + i) + twopow k by omega] at hb10
  rw [show (p0 + twopow k) + (i + 1) = ((p0 + i) + 1) + twopow k by omega] at hb11
  rw [show (p0 + twopow (k + 1)) + i = (p0 + i) + twopow (k + 1) by omega] at hb20
  rw [show (p0 + twopow (k + 1)) + (i + 1) = ((p0 + i) + 1) + twopow (k + 1) by omega] at hb21
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    show ((t + 1) + (p0 + 1) + twopow (k + 1)) + i + Q =
      ((t + Q) + 1) + ((p0 + i) + 1) + twopow (k + 1) by omega,
    show ((t + 1) + (p0 + 1) + twopow (k + 1)) + i =
      (t + 1) + ((p0 + i) + 1) + twopow (k + 1) by omega] at hwn
  rw [hsQ, hs0, hbl0, hbl1, hb00, hb01, hb10, hb11, hb20, hb21] at hwn
  rw [show (t + (p0 + 2) + twopow (k + 1)) + i + Q =
      (t + Q) + ((p0 + i) + 2) + twopow (k + 1) by omega,
    show (t + (p0 + 2) + twopow (k + 1)) + i =
      t + ((p0 + i) + 2) + twopow (k + 1) by omega]
  revert hwn
  simp only [bxor_eq_xor]
  cases (winWitt (t + Q) (twopow k)).testBit ((t + Q) + ((p0 + i) + 2) + twopow (k + 1)) <;>
    cases (winWitt t (twopow k)).testBit (t + ((p0 + i) + 2) + twopow (k + 1)) <;>
    cases ((((lhCenter (t + twopow k) (((p0 + i) + 1) + twopow k) ||
      lhCenter (t + twopow k) ((p0 + i) + twopow k)) ^^
      (lhCenter t ((p0 + i) + 1) || lhCenter t (p0 + i))) ^^
      (lhCenter t (((p0 + i) + 1) + twopow k) || lhCenter t ((p0 + i) + twopow k))) ^^
      (lhCenter t (((p0 + i) + 1) + twopow (k + 1)) || lhCenter t ((p0 + i) + twopow (k + 1)))) <;> decide

/-! ### Batch 12: Sector-1 Same-Column `$2^k$`-Scale Left-Half Calculus, Vanishing Frobenius Defect, and Linearized Periodic Window Defect Law -/

/-- **Single-Term Collapse of `phiScale k (row t)` in Sector 1 (`phiScale_row_testBit_lhCenter_sector_one`)**:
    for all `t, k, p : Nat` with `t + p < 2^k` (including `p = 0`, the center column!), bit `t + p + 2^k` lies strictly below `2^(k+1)` while `(row t).testBit (t + p + 2^k) = lhCenter t (p + 2^k) = false`, so `(phiScale k (row t)).testBit (t + p + 2^k) = lhCenter t p`! -/
theorem phiScale_row_testBit_lhCenter_sector_one (t k p : Nat)
    (hp : t + p < twopow k) :
    (phiScale k (row t)).testBit (t + p + twopow k) = lhCenter t p := by
  change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
    ((row t) <<< (twopow k + twopow k))).testBit (t + p + twopow k) = _
  simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
  have d1 : decide (t + p + twopow k ≥ twopow k) = true := decide_eq_true (by omega)
  have d2 : decide (t + p + twopow k ≥ twopow k + twopow k) = false := decide_eq_false (by omega)
  rw [d1, d2, Bool.true_and, Bool.false_and, Bool.xor_false,
    show t + p + twopow k - twopow k = t + p by omega,
    show t + p + twopow k = t + (p + twopow k) by omega,
    ← lhCenter_eq_row_testBit_uncond t (p + twopow k),
    ← lhCenter_eq_row_testBit_uncond t p,
    lhCenter_gt_eq_false t (p + twopow k) (by omega),
    Bool.false_xor]

theorem phiScale_row_testBit_lhCenter_sector_one_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    wittBitBool (phiScale k (row t)) (t + p + twopow k) = lhCenter t p :=
  phiScale_row_testBit_lhCenter_sector_one t k p hp

/-- **Same-Column `$2^k$`-Scale Step of `lhCenter` Inside the `$2^k$`-Horizon (`lhCenter_scale_same_col_cone`)**:
    for all `t, k, p : Nat` with `t + p < 2^k`, at the SAME spatial column `p` in the left half, `lhCenter (t + 2^k) p = lhCenter t p ⊕ (winWitt t (2^k)).testBit (t + p + 2^k)`! -/
theorem lhCenter_scale_same_col_cone (t k p : Nat)
    (hp : t + p < twopow k) :
    lhCenter (t + twopow k) p =
      bxor (lhCenter t p)
        ((winWitt t (twopow k)).testBit (t + p + twopow k)) := by
  rw [lhCenter_eq_row_testBit_uncond (t + twopow k) p,
    show (t + twopow k) + p = t + p + twopow k by omega]
  have hsc := congrArg (fun n => n.testBit (t + p + twopow k)) (row_scale t k)
  rw [Nat.testBit_xor, phiScale_row_testBit_lhCenter_sector_one t k p hp] at hsc
  rw [hsc, bxor_eq_xor]

theorem lhCenter_scale_same_col_cone_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    lhCenter (t + twopow k) p =
      bxor (lhCenter t p)
        (wittBitBool (winWitt t (twopow k)) (t + p + twopow k)) :=
  lhCenter_scale_same_col_cone t k p hp

/-- **Same-Column `$2^k$`-Scale Pullback of `lhCenter` Inside the `$2^k$`-Horizon (`lhCenter_scale_inward_same_col_cone`)**:
    for all `t, k, p : Nat` with `t + p < 2^k`, `lhCenter t p = lhCenter (t + 2^k) p ⊕ (winWitt t (2^k)).testBit (t + p + 2^k)`! -/
theorem lhCenter_scale_inward_same_col_cone (t k p : Nat)
    (hp : t + p < twopow k) :
    lhCenter t p =
      bxor (lhCenter (t + twopow k) p)
        ((winWitt t (twopow k)).testBit (t + p + twopow k)) := by
  rw [lhCenter_scale_same_col_cone t k p hp]
  cases lhCenter t p <;>
    cases (winWitt t (twopow k)).testBit (t + p + twopow k) <;> rfl

theorem lhCenter_scale_inward_same_col_cone_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    lhCenter t p =
      bxor (lhCenter (t + twopow k) p)
        (wittBitBool (winWitt t (twopow k)) (t + p + twopow k)) :=
  lhCenter_scale_inward_same_col_cone t k p hp

/-- **Exact Readout of Sector-1 `winWitt` as the Same-Column `$2^k$`-Time Jump of `lhCenter` (`winWitt_testBit_sector_one_lhCenter`)**:
    for all `t, k, p : Nat` with `t + p < 2^k`, `(winWitt t (2^k)).testBit (t + p + 2^k) = lhCenter (t + 2^k) p ⊕ lhCenter t p`! -/
theorem winWitt_testBit_sector_one_lhCenter (t k p : Nat)
    (hp : t + p < twopow k) :
    (winWitt t (twopow k)).testBit (t + p + twopow k) =
      bxor (lhCenter (t + twopow k) p) (lhCenter t p) := by
  rw [lhCenter_scale_same_col_cone t k p hp]
  cases lhCenter t p <;>
    cases (winWitt t (twopow k)).testBit (t + p + twopow k) <;> rfl

theorem winWitt_testBit_sector_one_lhCenter_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    wittBitBool (winWitt t (twopow k)) (t + p + twopow k) =
      bxor (lhCenter (t + twopow k) p) (lhCenter t p) :=
  winWitt_testBit_sector_one_lhCenter t k p hp

/-- **Same-Column `$2^k$`-Scale Forward Step of `LhBandAgree` (`lhBandAgree_scale_same_col_cone`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L < 2^k`, `LhBandAgree t Q p0 L` and `WinWittAgree t k Q (t + p0 + 2^k) L` imply `LhBandAgree (t + 2^k) Q p0 L` at the SAME column `p0`! -/
theorem lhBandAgree_scale_same_col_cone (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L < twopow k)
    (h0 : LhBandAgree t Q p0 L)
    (hw : WinWittAgree t k Q (t + p0 + twopow k) L) :
    LhBandAgree (t + twopow k) Q p0 L := by
  intro i hi
  have hsQ := lhCenter_scale_same_col_cone (t + Q) k (p0 + i) (by omega)
  have hs0 := lhCenter_scale_same_col_cone t k (p0 + i) (by omega)
  have hb0 := h0 i hi
  have hwi := hw i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    hsQ, hs0, hb0,
    show (t + Q) + (p0 + i) + twopow k = (t + p0 + twopow k) + i + Q by omega,
    show t + (p0 + i) + twopow k = (t + p0 + twopow k) + i by omega,
    hwi]

/-- **Same-Column `$2^k$`-Scale Pullback of `LhBandAgree` (`lhBandAgree_scale_inward_same_col_cone`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L < 2^k`, `LhBandAgree (t + 2^k) Q p0 L` and `WinWittAgree t k Q (t + p0 + 2^k) L` imply `LhBandAgree t Q p0 L` at the SAME column `p0`! -/
theorem lhBandAgree_scale_inward_same_col_cone (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L < twopow k)
    (hlate : LhBandAgree (t + twopow k) Q p0 L)
    (hw : WinWittAgree t k Q (t + p0 + twopow k) L) :
    LhBandAgree t Q p0 L := by
  intro i hi
  have hsQ := lhCenter_scale_inward_same_col_cone (t + Q) k (p0 + i) (by omega)
  have hs0 := lhCenter_scale_inward_same_col_cone t k (p0 + i) (by omega)
  have hbl := hlate i hi
  have hwi := hw i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega] at hbl
  rw [hsQ, hs0, hbl,
    show (t + Q) + (p0 + i) + twopow k = (t + p0 + twopow k) + i + Q by omega,
    show t + (p0 + i) + twopow k = (t + p0 + twopow k) + i by omega,
    hwi]

/-- **Deriving Sector-1 `WinWittAgree` from Same-Column `LhBandAgree` at `t + 2^k` and `t` (`winWittAgree_sector_one_lhCenter`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L < 2^k`, `LhBandAgree (t + 2^k) Q p0 L` and `LhBandAgree t Q p0 L` imply `WinWittAgree t k Q (t + p0 + 2^k) L`! -/
theorem winWittAgree_sector_one_lhCenter (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L < twopow k)
    (hlate : LhBandAgree (t + twopow k) Q p0 L)
    (h0 : LhBandAgree t Q p0 L) :
    WinWittAgree t k Q (t + p0 + twopow k) L := by
  intro i hi
  have hsQ := winWitt_testBit_sector_one_lhCenter (t + Q) k (p0 + i) (by omega)
  have hs0 := winWitt_testBit_sector_one_lhCenter t k (p0 + i) (by omega)
  have hbl := hlate i hi
  have hb0 := h0 i hi
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega] at hbl
  rw [show (t + p0 + twopow k) + i + Q = (t + Q) + (p0 + i) + twopow k by omega,
    show (t + p0 + twopow k) + i = t + (p0 + i) + twopow k by omega,
    hsQ, hs0, hbl, hb0]

/-- **Refutation of Simultaneous Late Same-Column `LhBandAgree` and Sector-1 `WinWittAgree` (`not_lhBandAgree_late_and_winWittAgree_sector_one`)**:
    for all `t, k, Q, L : Nat` with `0 < Q`, `t + Q ≤ L`, and `t + Q + L < 2^k`, `LhBandAgree (t + 2^k) Q 0 L` (even though `L < 2^k` lies strictly inside the late light cone at `t + 2^k`!) and `WinWittAgree t k Q (t + 2^k) L` cannot both hold, because pulling back to time `t` reaches the left edge of the early light cone at `t + Q`! -/
theorem not_lhBandAgree_late_and_winWittAgree_sector_one (t k Q L : Nat)
    (hQ : 0 < Q) (hL : t + Q ≤ L) (htk : t + Q + L < twopow k)
    (hlate : LhBandAgree (t + twopow k) Q 0 L)
    (hw : WinWittAgree t k Q (t + twopow k) L) : False := by
  have hw0 : WinWittAgree t k Q (t + 0 + twopow k) L := by
    rwa [Nat.add_zero]
  have h0 := lhBandAgree_scale_inward_same_col_cone t k Q 0 L (by omega) hlate hw0
  exact not_lhBandAgree_of_lt_add t Q L hQ hL h0

/-- **Identical Vanishing of Sector-1 `frobDefect k (row t)` Across the Left Half (`frobDefect_row_testBit_lhCenter_sector_one_eq_false`)**:
    for all `t, k, p : Nat` with `t + p + 1 < 2^k` (including `p = 0`, the center column, for all `t + 1 < 2^k`!), both `rdiag ((t + p + 1) + 2^k) t` and `rdiag (t + p + 2^k) t` lie outside the light cone `2 * t` and vanish, so `(frobDefect k (row t)).testBit ((t + p + 1) + 2^k) = false`! -/
theorem frobDefect_row_testBit_lhCenter_sector_one_eq_false (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    (frobDefect k (row t)).testBit ((t + p + 1) + twopow k) = false := by
  rw [frobDefect_row_testBit_sector_one t k (t + p) hp,
    show (t + p + 1) + twopow k = t + (p + 1 + twopow k) by omega,
    show (t + p) + twopow k = t + (p + twopow k) by omega,
    rdiag_add_eq_lhCenter_uncond t (p + 1 + twopow k),
    rdiag_add_eq_lhCenter_uncond t (p + twopow k),
    lhCenter_gt_eq_false t (p + 1 + twopow k) (by omega),
    lhCenter_gt_eq_false t (p + twopow k) (by omega),
    Bool.false_and, Bool.and_false]
  rfl

theorem frobDefect_row_testBit_lhCenter_sector_one_eq_false_prop (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    wittBitBool (frobDefect k (row t)) ((t + p + 1) + twopow k) = false :=
  frobDefect_row_testBit_lhCenter_sector_one_eq_false t k p hp

/-- **Single-Sector Collapse of Sector-1 `crossCarry` Across the Left Half (`crossCarry_row_scale_lhCenter_sector_one`)**:
    for all `t, k, p : Nat` with `t + p + 1 < 2^k`, `(crossCarry (phiScale k (row t)) (winWitt t (2^k))).testBit ((t + p + 1) + 2^k)` depends ONLY on `lhCenter t p`, `lhCenter t (p + 1)`, and Sector 1 of `winWitt t (2^k)`! -/
theorem crossCarry_row_scale_lhCenter_sector_one (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    (crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit
        ((t + p + 1) + twopow k) =
      bxor
        (lhCenter t (p + 1) &&
          (winWitt t (twopow k)).testBit (t + p + twopow k))
        ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow k) &&
          lhCenter t p) := by
  have hc := crossCarry_testBit_succ (phiScale k (row t)) (winWitt t (twopow k)) (t + p + twopow k)
  rw [show (t + p + twopow k) + 1 = (t + p + 1) + twopow k by omega] at hc
  rw [hc,
    show (t + p + 1) + twopow k = t + (p + 1) + twopow k by omega,
    phiScale_row_testBit_lhCenter_sector_one t k (p + 1) (by omega),
    phiScale_row_testBit_lhCenter_sector_one t k p (by omega)]

theorem crossCarry_row_scale_lhCenter_sector_one_prop (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    wittBitBool (crossCarry (phiScale k (row t)) (winWitt t (twopow k)))
        ((t + p + 1) + twopow k) =
      bxor
        (lhCenter t (p + 1) &&
          wittBitBool (winWitt t (twopow k)) (t + p + twopow k))
        (wittBitBool (winWitt t (twopow k)) (t + (p + 1) + twopow k) &&
          lhCenter t p) :=
  crossCarry_row_scale_lhCenter_sector_one t k p hp

/-- **Single-Sector Window Step of Sector-1 `winWitt` Across the Left Half (`winWitt_step_sector_one_lhCenter`)**:
    for all `t, k, p : Nat` with `t + p + 1 < 2^k`, because `frobDefect = false` (`9.480`) and `phiScale k (row t) = lhCenter t p` (`9.472`), the universal window step `winWitt_step_frobDefect_testBit_succ` in Sector 1 collapses to a single-sector recurrence driven ONLY by `lhCenter t p`, `lhCenter t (p + 1)`, and `winWitt t (2^k)`! -/
theorem winWitt_step_sector_one_lhCenter (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    (winWitt (t + 1) (twopow k)).testBit ((t + 1) + (p + 1) + twopow k) =
      bxor
        ((phi (winWitt t (twopow k))).testBit ((t + 1) + (p + 1) + twopow k))
        (bxor
          (lhCenter t (p + 1) &&
            (winWitt t (twopow k)).testBit (t + p + twopow k))
          ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow k) &&
            lhCenter t p)) := by
  have hs := winWitt_step_frobDefect_testBit_succ t k ((t + p + 1) + twopow k)
  rw [show ((t + p + 1) + twopow k) + 1 = (t + 1) + (p + 1) + twopow k by omega,
    crossCarry_row_scale_lhCenter_sector_one t k p hp,
    frobDefect_row_testBit_lhCenter_sector_one_eq_false t k p hp] at hs
  rw [hs]
  cases (phi (winWitt t (twopow k))).testBit ((t + 1) + (p + 1) + twopow k) <;>
    cases (bxor
      (lhCenter t (p + 1) && (winWitt t (twopow k)).testBit (t + p + twopow k))
      ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow k) && lhCenter t p)) <;> rfl

theorem winWitt_step_sector_one_lhCenter_prop (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    wittBitBool (winWitt (t + 1) (twopow k)) ((t + 1) + (p + 1) + twopow k) =
      bxor
        (wittBitBool (phi (winWitt t (twopow k))) ((t + 1) + (p + 1) + twopow k))
        (bxor
          (lhCenter t (p + 1) &&
            wittBitBool (winWitt t (twopow k)) (t + p + twopow k))
          (wittBitBool (winWitt t (twopow k)) (t + (p + 1) + twopow k) &&
            lhCenter t p)) :=
  winWitt_step_sector_one_lhCenter t k p hp

/-- **Single-Sector Forward Step of Sector-1 `WinWittAgree` (`winWittAgree_step_sector_one_lhCenter`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L + 1 < 2^k`, `WinWittAgree` in Sector 1 steps forward from time `t` to `t + 1` using ONLY the single inner band `LhBandAgree t Q p0 (L + 1)`! -/
theorem winWittAgree_step_sector_one_lhCenter (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L + 1 < twopow k)
    (hb : LhBandAgree t Q p0 (L + 1))
    (hw : WinWittAgree t k Q (t + p0 + twopow k) (L + 2)) :
    WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + twopow k) L := by
  intro i hi
  have hsQ := winWitt_step_sector_one_lhCenter (t + Q) k (p0 + i) (by omega)
  have hs0 := winWitt_step_sector_one_lhCenter t k (p0 + i) (by omega)
  have hb0 := hb i (by omega)
  have hb1 := hb (i + 1) (by omega)
  have hw0 := hw i (by omega)
  have hw1 := hw (i + 1) (by omega)
  have hw2 := hw (i + 2) (by omega)
  rw [show p0 + (i + 1) = (p0 + i) + 1 by omega] at hb1
  rw [show (t + p0 + twopow k) + i + Q = (t + Q) + (p0 + i) + twopow k by omega,
    show (t + p0 + twopow k) + i = t + (p0 + i) + twopow k by omega] at hw0
  rw [show (t + p0 + twopow k) + (i + 1) + Q = (t + Q) + ((p0 + i) + 1) + twopow k by omega,
    show (t + p0 + twopow k) + (i + 1) = t + ((p0 + i) + 1) + twopow k by omega] at hw1
  rw [show (t + p0 + twopow k) + (i + 2) + Q = ((t + Q) + (p0 + i) + twopow k) + 2 by omega,
    show (t + p0 + twopow k) + (i + 2) = (t + (p0 + i) + twopow k) + 2 by omega] at hw2
  have hphiQ : (phi (winWitt (t + Q) (twopow k))).testBit (((t + Q) + 1) + ((p0 + i) + 1) + twopow k) =
      bxor ((winWitt (t + Q) (twopow k)).testBit (((t + Q) + (p0 + i) + twopow k) + 2))
        ((winWitt (t + Q) (twopow k)).testBit ((t + Q) + ((p0 + i) + 1) + twopow k) ||
          (winWitt (t + Q) (twopow k)).testBit ((t + Q) + (p0 + i) + twopow k)) := by
    have hp0 := phi_testBit_add_two (winWitt (t + Q) (twopow k)) ((t + Q) + (p0 + i) + twopow k)
    rw [show (((t + Q) + 1) + ((p0 + i) + 1) + twopow k) =
        ((t + Q) + (p0 + i) + twopow k) + 2 by omega,
      hp0,
      show ((t + Q) + (p0 + i) + twopow k) + 1 = (t + Q) + ((p0 + i) + 1) + twopow k by omega,
      bxor_eq_xor]
  have hphi0 : (phi (winWitt t (twopow k))).testBit ((t + 1) + ((p0 + i) + 1) + twopow k) =
      bxor ((winWitt t (twopow k)).testBit ((t + (p0 + i) + twopow k) + 2))
        ((winWitt t (twopow k)).testBit (t + ((p0 + i) + 1) + twopow k) ||
          (winWitt t (twopow k)).testBit (t + (p0 + i) + twopow k)) := by
    have hp0 := phi_testBit_add_two (winWitt t (twopow k)) (t + (p0 + i) + twopow k)
    rw [show ((t + 1) + ((p0 + i) + 1) + twopow k) =
        (t + (p0 + i) + twopow k) + 2 by omega,
      hp0,
      show (t + (p0 + i) + twopow k) + 1 = t + ((p0 + i) + 1) + twopow k by omega,
      bxor_eq_xor]
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    show ((t + 1) + (p0 + 1) + twopow k) + i + Q =
      ((t + Q) + 1) + ((p0 + i) + 1) + twopow k by omega,
    show ((t + 1) + (p0 + 1) + twopow k) + i =
      (t + 1) + ((p0 + i) + 1) + twopow k by omega,
    hsQ, hs0, hphiQ, hphi0, hb0, hb1, hw0, hw1, hw2]

/-- **Single-Sector Outward Step of Sector-1 `WinWittAgree` (`winWittAgree_outward_step_sector_one_lhCenter`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L + 1 < 2^k`, `LhBandAgree t Q p0 (L + 1)`, `WinWittAgree t k Q (t + p0 + 2^k) (L + 1)`, and `WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + 2^k) L` extend `WinWittAgree` at time `t` to width `L + 2`! -/
theorem winWittAgree_outward_step_sector_one_lhCenter (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L + 1 < twopow k)
    (hb : LhBandAgree t Q p0 (L + 1))
    (hw : WinWittAgree t k Q (t + p0 + twopow k) (L + 1))
    (hnext : WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + twopow k) L) :
    WinWittAgree t k Q (t + p0 + twopow k) (L + 2) := by
  intro i hi
  by_cases hi1 : i ≤ L + 1
  · exact hw i hi1
  · have hi_eq : i = L + 2 := by omega
    subst hi_eq
    have hsQ := winWitt_step_sector_one_lhCenter (t + Q) k (p0 + L) (by omega)
    have hs0 := winWitt_step_sector_one_lhCenter t k (p0 + L) (by omega)
    have hb0 := hb L (by omega)
    have hb1 := hb (L + 1) (by omega)
    have hw0 := hw L (by omega)
    have hw1 := hw (L + 1) (by omega)
    have hwn := hnext L (Nat.le_refl L)
    rw [show p0 + (L + 1) = (p0 + L) + 1 by omega] at hb1
    rw [show (t + p0 + twopow k) + L + Q = (t + Q) + (p0 + L) + twopow k by omega,
      show (t + p0 + twopow k) + L = t + (p0 + L) + twopow k by omega] at hw0
    rw [show (t + p0 + twopow k) + (L + 1) + Q = (t + Q) + ((p0 + L) + 1) + twopow k by omega,
      show (t + p0 + twopow k) + (L + 1) = t + ((p0 + L) + 1) + twopow k by omega] at hw1
    rw [show (t + 1) + Q = (t + Q) + 1 by omega,
      show ((t + 1) + (p0 + 1) + twopow k) + L + Q =
        ((t + Q) + 1) + ((p0 + L) + 1) + twopow k by omega,
      show ((t + 1) + (p0 + 1) + twopow k) + L =
        (t + 1) + ((p0 + L) + 1) + twopow k by omega] at hwn
    have hphiQ : (phi (winWitt (t + Q) (twopow k))).testBit (((t + Q) + 1) + ((p0 + L) + 1) + twopow k) =
        bxor ((winWitt (t + Q) (twopow k)).testBit ((t + Q) + ((p0 + L) + 2) + twopow k))
          ((winWitt (t + Q) (twopow k)).testBit ((t + Q) + ((p0 + L) + 1) + twopow k) ||
            (winWitt (t + Q) (twopow k)).testBit ((t + Q) + (p0 + L) + twopow k)) := by
      have hp0 := phi_testBit_add_two (winWitt (t + Q) (twopow k)) ((t + Q) + (p0 + L) + twopow k)
      rw [show (((t + Q) + 1) + ((p0 + L) + 1) + twopow k) =
          ((t + Q) + (p0 + L) + twopow k) + 2 by omega,
        hp0,
        show ((t + Q) + (p0 + L) + twopow k) + 2 = (t + Q) + ((p0 + L) + 2) + twopow k by omega,
        show ((t + Q) + (p0 + L) + twopow k) + 1 = (t + Q) + ((p0 + L) + 1) + twopow k by omega,
        bxor_eq_xor]
    have hphi0 : (phi (winWitt t (twopow k))).testBit ((t + 1) + ((p0 + L) + 1) + twopow k) =
        bxor ((winWitt t (twopow k)).testBit (t + ((p0 + L) + 2) + twopow k))
          ((winWitt t (twopow k)).testBit (t + ((p0 + L) + 1) + twopow k) ||
            (winWitt t (twopow k)).testBit (t + (p0 + L) + twopow k)) := by
      have hp0 := phi_testBit_add_two (winWitt t (twopow k)) (t + (p0 + L) + twopow k)
      rw [show ((t + 1) + ((p0 + L) + 1) + twopow k) =
          (t + (p0 + L) + twopow k) + 2 by omega,
        hp0,
        show (t + (p0 + L) + twopow k) + 2 = t + ((p0 + L) + 2) + twopow k by omega,
        show (t + (p0 + L) + twopow k) + 1 = t + ((p0 + L) + 1) + twopow k by omega,
        bxor_eq_xor]
    rw [hsQ, hs0, hphiQ, hphi0, hb0, hb1, hw0, hw1] at hwn
    rw [show (t + p0 + twopow k) + (L + 2) + Q = (t + Q) + ((p0 + L) + 2) + twopow k by omega,
      show (t + p0 + twopow k) + (L + 2) = t + ((p0 + L) + 2) + twopow k by omega]
    revert hwn
    simp only [bxor_eq_xor]
    cases (winWitt (t + Q) (twopow k)).testBit ((t + Q) + ((p0 + L) + 2) + twopow k) <;>
      cases (winWitt t (twopow k)).testBit (t + ((p0 + L) + 2) + twopow k) <;>
      cases ((winWitt t (twopow k)).testBit (t + ((p0 + L) + 1) + twopow k) ||
        (winWitt t (twopow k)).testBit (t + (p0 + L) + twopow k)) <;>
      cases ((lhCenter t ((p0 + L) + 1) && (winWitt t (twopow k)).testBit (t + (p0 + L) + twopow k)) ^^
        ((winWitt t (twopow k)).testBit (t + ((p0 + L) + 1) + twopow k) && lhCenter t (p0 + L))) <;> decide

/-- **Automatic `$m * P$`-Invariance of the Sector-1 Center-Slot Window Bit Inside the `$2^k$`-Horizon (`periodic_winWitt_sector_one_zero_eq`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k : Nat` with `T ≤ t` and `t + m * P < 2^k`, `(winWitt · (2^k)).testBit (· + 2^k)` equals `center (· + 2^k) ⊕ center ·` by `winWitt_testBit_sector_one_lhCenter` at `p = 0`, and therefore is automatically `m * P`-invariant! -/
theorem periodic_winWitt_sector_one_zero_eq
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P < twopow k) :
    (winWitt (t + m * P) (twopow k)).testBit ((t + m * P) + twopow k) =
      (winWitt t (twopow k)).testBit (t + twopow k) := by
  have hQ := winWitt_testBit_sector_one_lhCenter (t + m * P) k 0 (by omega)
  have h0 := winWitt_testBit_sector_one_lhCenter t k 0 (by omega)
  rw [Nat.add_zero] at hQ h0
  have hc0 : lhCenter (t + m * P) 0 = lhCenter t 0 := by
    have hcol := periodic_lhColAgree_zero T P hP hper m t 0 ht 0 (Nat.le_refl 0)
    simpa using hcol
  have hcl : lhCenter ((t + m * P) + twopow k) 0 = lhCenter (t + twopow k) 0 := by
    have hcol := periodic_lhColAgree_zero T P hP hper m (t + twopow k) 0 (by omega) 0 (Nat.le_refl 0)
    rw [show (t + m * P) + twopow k = (t + twopow k) + m * P by omega]
    simpa using hcol
  rw [hQ, h0, hcl, hc0]

theorem periodic_winWitt_sector_one_zero_eq_prop
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P < twopow k) :
    wittBitBool (winWitt (t + m * P) (twopow k)) ((t + m * P) + twopow k) =
      wittBitBool (winWitt t (twopow k)) (t + twopow k) :=
  periodic_winWitt_sector_one_zero_eq T P hP hper m t k ht htk

/-- **Exact Linear Discrete Time-Derivative Law for the Sector-1 Column-`-2` Window Defect (`periodic_winWitt_sector_one_two_defect_eq`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k : Nat` with `T ≤ t` and `t + m * P + 2 < 2^k`, combining `winWitt_testBit_sector_one_lhCenter` at `p = 1, 2` with `periodic_lhCenter_two_defect_eq` at `t` and `t + 2^k` proves that the `m * P`-defect of `(winWitt · (2^k)).testBit (· + 2 + 2^k)` is the exact linear discrete time-derivative of the `m * P`-defect of `(winWitt · (2^k)).testBit (· + 1 + 2^k)`! -/
theorem periodic_winWitt_sector_one_two_defect_eq
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 2 < twopow k) :
    bxor
      ((winWitt (t + m * P) (twopow k)).testBit ((t + m * P) + 2 + twopow k))
      ((winWitt t (twopow k)).testBit (t + 2 + twopow k)) =
      bxor
        (bxor
          ((winWitt ((t + 1) + m * P) (twopow k)).testBit (((t + 1) + m * P) + 1 + twopow k))
          ((winWitt (t + 1) (twopow k)).testBit ((t + 1) + 1 + twopow k)))
        (bxor
          ((winWitt (t + m * P) (twopow k)).testBit ((t + m * P) + 1 + twopow k))
          ((winWitt t (twopow k)).testBit (t + 1 + twopow k))) := by
  have hw2Q := winWitt_testBit_sector_one_lhCenter (t + m * P) k 2 (by omega)
  have hw20 := winWitt_testBit_sector_one_lhCenter t k 2 (by omega)
  have hw1nQ := winWitt_testBit_sector_one_lhCenter ((t + 1) + m * P) k 1 (by omega)
  have hw1n0 := winWitt_testBit_sector_one_lhCenter (t + 1) k 1 (by omega)
  have hw1Q := winWitt_testBit_sector_one_lhCenter (t + m * P) k 1 (by omega)
  have hw10 := winWitt_testBit_sector_one_lhCenter t k 1 (by omega)
  have hd0 := periodic_lhCenter_two_defect_eq T P hP hper m t ht
  have hdl := periodic_lhCenter_two_defect_eq T P hP hper m (t + twopow k) (by omega)
  rw [show (t + m * P) + twopow k = (t + twopow k) + m * P by omega] at hw2Q hw1Q
  rw [show ((t + 1) + m * P) + twopow k = ((t + twopow k) + 1) + m * P by omega] at hw1nQ
  rw [show (t + 1) + twopow k = (t + twopow k) + 1 by omega] at hw1n0
  rw [hw2Q, hw20, hw1nQ, hw1n0, hw1Q, hw10]
  have hrearrange :
      bxor
        (bxor (lhCenter ((t + twopow k) + m * P) 2) (lhCenter (t + m * P) 2))
        (bxor (lhCenter (t + twopow k) 2) (lhCenter t 2)) =
      bxor
        (bxor (lhCenter ((t + twopow k) + m * P) 2) (lhCenter (t + twopow k) 2))
        (bxor (lhCenter (t + m * P) 2) (lhCenter t 2)) := by
    cases lhCenter ((t + twopow k) + m * P) 2 <;>
      cases lhCenter (t + m * P) 2 <;>
      cases lhCenter (t + twopow k) 2 <;>
      cases lhCenter t 2 <;> rfl
  rw [hrearrange, hdl, hd0]
  cases lhCenter (((t + twopow k) + 1) + m * P) 1 <;>
    cases lhCenter ((t + twopow k) + 1) 1 <;>
    cases lhCenter ((t + twopow k) + m * P) 1 <;>
    cases lhCenter (t + twopow k) 1 <;>
    cases lhCenter ((t + 1) + m * P) 1 <;>
    cases lhCenter (t + 1) 1 <;>
    cases lhCenter (t + m * P) 1 <;>
    cases lhCenter t 1 <;> rfl

theorem periodic_winWitt_sector_one_two_defect_eq_prop
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 2 < twopow k) :
    bxor
      (wittBitBool (winWitt (t + m * P) (twopow k)) ((t + m * P) + 2 + twopow k))
      (wittBitBool (winWitt t (twopow k)) (t + 2 + twopow k)) =
      bxor
        (bxor
          (wittBitBool (winWitt ((t + 1) + m * P) (twopow k)) (((t + 1) + m * P) + 1 + twopow k))
          (wittBitBool (winWitt (t + 1) (twopow k)) ((t + 1) + 1 + twopow k)))
        (bxor
          (wittBitBool (winWitt (t + m * P) (twopow k)) ((t + m * P) + 1 + twopow k))
          (wittBitBool (winWitt t (twopow k)) (t + 1 + twopow k))) :=
  periodic_winWitt_sector_one_two_defect_eq T P hP hper m t k ht htk

/-! ### Batch 13: Same-Column `$2^k$`-Scale Right-Half Calculus, Inter-Cone Right Readout, and Symmetric Doubling of `RhBandAgree` & `WinWittAgree` -/

/-- **Finite-Horizon Right-Light-Cone Refutation of `RhBandAgree` (`not_rhBandAgree_of_lt_add`)**:
    for all `t, Q, L : Nat` with `0 < Q` and `t + Q ≤ L`, `RhBandAgree t Q 0 L` is impossible because `rhCenter (t + Q) (t + Q) = true` at the right light-cone edge of `t + Q` while `rhCenter t (t + Q) = false` outside the light cone of `t`! -/
theorem not_rhBandAgree_of_lt_add (t Q L : Nat)
    (hQ : 0 < Q) (hL : t + Q ≤ L) :
    ¬ RhBandAgree t Q 0 L := by
  intro hb
  have hbi := hb (t + Q) hL
  rw [Nat.zero_add,
    rhCenter_self_eq_true (t + Q),
    rhCenter_gt_eq_false t (t + Q) (by omega)] at hbi
  exact Bool.noConfusion hbi

/-- **Single-Term Collapse of `phiScale k (row t)` at `(t + 2^k) - p` Inside the `$2^k$`-Horizon (`phiScale_row_testBit_rhCenter_cone`)**:
    for all `t, k, p : Nat` with `t + p < 2^k` (with NO bound `p ≤ t` required, since for `p > t` bit `(t + 2^k) - p` crosses into the inter-cone zero gap where both sides equal `false`!), `(phiScale k (row t)).testBit ((t + 2^k) - p) = rhCenter t p`! -/
theorem phiScale_row_testBit_rhCenter_cone (t k p : Nat)
    (hp : t + p < twopow k) :
    (phiScale k (row t)).testBit ((t + twopow k) - p) = rhCenter t p := by
  change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
    ((row t) <<< (twopow k + twopow k))).testBit ((t + twopow k) - p) = _
  simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
  have d2 : decide ((t + twopow k) - p ≥ twopow k + twopow k) = false := decide_eq_false (by omega)
  have hout : (row t).testBit ((t + twopow k) - p) = false := by
    rw [row_testBit]
    exact rdiag_gt_two_mul t ((t + twopow k) - p) (by omega)
  by_cases hpt : p ≤ t
  · have d1 : decide ((t + twopow k) - p ≥ twopow k) = true := decide_eq_true (by omega)
    rw [d1, d2, Bool.true_and, Bool.false_and, Bool.xor_false, hout, Bool.false_xor,
      show (t + twopow k) - p - twopow k = t - p by omega,
      ← rhCenter_eq_row_testBit t p hpt]
  · have d1 : decide ((t + twopow k) - p ≥ twopow k) = false := decide_eq_false (by omega)
    rw [d1, d2, Bool.false_and, Bool.false_and, Bool.xor_false, Bool.xor_false, hout,
      rhCenter_gt_eq_false t p (by omega)]

theorem phiScale_row_testBit_rhCenter_cone_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    wittBitBool (phiScale k (row t)) ((t + twopow k) - p) = rhCenter t p :=
  phiScale_row_testBit_rhCenter_cone t k p hp

/-- **Same-Column `$2^k$`-Scale Step of `rhCenter` Inside the `$2^k$`-Horizon (`rhCenter_scale_same_col_cone`)**:
    for all `t, k, p : Nat` with `t + p < 2^k` (no bound `p ≤ t` required!), at the SAME spatial column `p` in the right half, `rhCenter (t + 2^k) p = rhCenter t p ⊕ (winWitt t (2^k)).testBit ((t + 2^k) - p)`! -/
theorem rhCenter_scale_same_col_cone (t k p : Nat)
    (hp : t + p < twopow k) :
    rhCenter (t + twopow k) p =
      bxor (rhCenter t p)
        ((winWitt t (twopow k)).testBit ((t + twopow k) - p)) := by
  rw [rhCenter_eq_row_testBit (t + twopow k) p (by omega)]
  have hsc := congrArg (fun n => n.testBit ((t + twopow k) - p)) (row_scale t k)
  rw [Nat.testBit_xor, phiScale_row_testBit_rhCenter_cone t k p hp] at hsc
  rw [hsc, bxor_eq_xor]

theorem rhCenter_scale_same_col_cone_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    rhCenter (t + twopow k) p =
      bxor (rhCenter t p)
        (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - p)) :=
  rhCenter_scale_same_col_cone t k p hp

/-- **Same-Column `$2^k$`-Scale Pullback of `rhCenter` Inside the `$2^k$`-Horizon (`rhCenter_scale_inward_same_col_cone`)**:
    for all `t, k, p : Nat` with `t + p < 2^k` (no bound `p ≤ t` required!), `rhCenter t p = rhCenter (t + 2^k) p ⊕ (winWitt t (2^k)).testBit ((t + 2^k) - p)`! -/
theorem rhCenter_scale_inward_same_col_cone (t k p : Nat)
    (hp : t + p < twopow k) :
    rhCenter t p =
      bxor (rhCenter (t + twopow k) p)
        ((winWitt t (twopow k)).testBit ((t + twopow k) - p)) := by
  rw [rhCenter_scale_same_col_cone t k p hp]
  cases rhCenter t p <;>
    cases (winWitt t (twopow k)).testBit ((t + twopow k) - p) <;> rfl

theorem rhCenter_scale_inward_same_col_cone_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    rhCenter t p =
      bxor (rhCenter (t + twopow k) p)
        (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - p)) :=
  rhCenter_scale_inward_same_col_cone t k p hp

/-- **Exact Readout of `winWitt` at `(t + 2^k) - p` as the Same-Column `$2^k$`-Time Jump of `rhCenter` (`winWitt_testBit_rhCenter_same_col_cone`)**:
    for all `t, k, p : Nat` with `t + p < 2^k` (no bound `p ≤ t` required!), `(winWitt t (2^k)).testBit ((t + 2^k) - p) = rhCenter (t + 2^k) p ⊕ rhCenter t p`! -/
theorem winWitt_testBit_rhCenter_same_col_cone (t k p : Nat)
    (hp : t + p < twopow k) :
    (winWitt t (twopow k)).testBit ((t + twopow k) - p) =
      bxor (rhCenter (t + twopow k) p) (rhCenter t p) := by
  rw [rhCenter_scale_same_col_cone t k p hp]
  cases rhCenter t p <;>
    cases (winWitt t (twopow k)).testBit ((t + twopow k) - p) <;> rfl

theorem winWitt_testBit_rhCenter_same_col_cone_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    wittBitBool (winWitt t (twopow k)) ((t + twopow k) - p) =
      bxor (rhCenter (t + twopow k) p) (rhCenter t p) :=
  winWitt_testBit_rhCenter_same_col_cone t k p hp

/-- **Direct Readout of Late `rhCenter (t + 2^k) p` in the Inter-Cone Zero Gap (`winWitt_testBit_zero_gap_eq_rhCenter_late`)**:
    for all `t, k, p : Nat` with `t < p` and `t + p < 2^k`, `rhCenter t p = false`, so `(winWitt t (2^k)).testBit ((t + 2^k) - p) = rhCenter (t + 2^k) p` directly! -/
theorem winWitt_testBit_zero_gap_eq_rhCenter_late (t k p : Nat)
    (htp : t < p) (hp : t + p < twopow k) :
    (winWitt t (twopow k)).testBit ((t + twopow k) - p) =
      rhCenter (t + twopow k) p := by
  rw [winWitt_testBit_rhCenter_same_col_cone t k p hp,
    rhCenter_gt_eq_false t p htp]
  cases rhCenter (t + twopow k) p <;> rfl

theorem winWitt_testBit_zero_gap_eq_rhCenter_late_prop (t k p : Nat)
    (htp : t < p) (hp : t + p < twopow k) :
    wittBitBool (winWitt t (twopow k)) ((t + twopow k) - p) =
      rhCenter (t + twopow k) p :=
  winWitt_testBit_zero_gap_eq_rhCenter_late t k p htp hp

/-- **Same-Column `$2^k$`-Scale Forward Step of `RhBandAgree` (`rhBandAgree_scale_same_col_cone`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L < 2^k` (no bound `p0 + L ≤ t` required!), `RhBandAgree t Q p0 L` and `WinWittAgree t k Q ((t + 2^k) - (p0 + L)) L` imply `RhBandAgree (t + 2^k) Q p0 L` at the SAME column `p0`! -/
theorem rhBandAgree_scale_same_col_cone (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L < twopow k)
    (h0 : RhBandAgree t Q p0 L)
    (hw : WinWittAgree t k Q ((t + twopow k) - (p0 + L)) L) :
    RhBandAgree (t + twopow k) Q p0 L := by
  intro i hi
  have hsQ := rhCenter_scale_same_col_cone (t + Q) k (p0 + i) (by omega)
  have hs0 := rhCenter_scale_same_col_cone t k (p0 + i) (by omega)
  have hb0 := h0 i hi
  have hwi := hw (L - i) (by omega)
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega,
    hsQ, hs0, hb0,
    show ((t + Q) + twopow k) - (p0 + i) = ((t + twopow k) - (p0 + L)) + (L - i) + Q by omega,
    show (t + twopow k) - (p0 + i) = ((t + twopow k) - (p0 + L)) + (L - i) by omega,
    hwi]

/-- **Same-Column `$2^k$`-Scale Pullback of `RhBandAgree` (`rhBandAgree_scale_inward_same_col_cone`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L < 2^k` (no bound `p0 + L ≤ t` required!), `RhBandAgree (t + 2^k) Q p0 L` and `WinWittAgree t k Q ((t + 2^k) - (p0 + L)) L` imply `RhBandAgree t Q p0 L` at the SAME column `p0`! -/
theorem rhBandAgree_scale_inward_same_col_cone (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L < twopow k)
    (hlate : RhBandAgree (t + twopow k) Q p0 L)
    (hw : WinWittAgree t k Q ((t + twopow k) - (p0 + L)) L) :
    RhBandAgree t Q p0 L := by
  intro i hi
  have hsQ := rhCenter_scale_inward_same_col_cone (t + Q) k (p0 + i) (by omega)
  have hs0 := rhCenter_scale_inward_same_col_cone t k (p0 + i) (by omega)
  have hbl := hlate i hi
  have hwi := hw (L - i) (by omega)
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega] at hbl
  rw [hsQ, hs0, hbl,
    show ((t + Q) + twopow k) - (p0 + i) = ((t + twopow k) - (p0 + L)) + (L - i) + Q by omega,
    show (t + twopow k) - (p0 + i) = ((t + twopow k) - (p0 + L)) + (L - i) by omega,
    hwi]

/-- **Deriving `WinWittAgree` at `(t + 2^k) - (p0 + L)` from Same-Column `RhBandAgree` at `t + 2^k` and `t` (`winWittAgree_rhCenter_same_col_cone`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L < 2^k` (no bound `p0 + L ≤ t` required!), `RhBandAgree (t + 2^k) Q p0 L` and `RhBandAgree t Q p0 L` imply `WinWittAgree t k Q ((t + 2^k) - (p0 + L)) L`! -/
theorem winWittAgree_rhCenter_same_col_cone (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L < twopow k)
    (hlate : RhBandAgree (t + twopow k) Q p0 L)
    (h0 : RhBandAgree t Q p0 L) :
    WinWittAgree t k Q ((t + twopow k) - (p0 + L)) L := by
  intro i hi
  have hsQ := winWitt_testBit_rhCenter_same_col_cone (t + Q) k (p0 + (L - i)) (by omega)
  have hs0 := winWitt_testBit_rhCenter_same_col_cone t k (p0 + (L - i)) (by omega)
  have hbl := hlate (L - i) (by omega)
  have hb0 := h0 (L - i) (by omega)
  rw [show (t + twopow k) + Q = (t + Q) + twopow k by omega] at hbl
  rw [show ((t + twopow k) - (p0 + L)) + i + Q = ((t + Q) + twopow k) - (p0 + (L - i)) by omega,
    show ((t + twopow k) - (p0 + L)) + i = (t + twopow k) - (p0 + (L - i)) by omega,
    hsQ, hs0, hbl, hb0]

/-- **Refutation of Simultaneous Late Same-Column `RhBandAgree` and Right-Wing `WinWittAgree` (`not_rhBandAgree_late_and_winWittAgree_cone`)**:
    for all `t, k, Q, L : Nat` with `0 < Q`, `t + Q ≤ L`, and `t + Q + L < 2^k`, `RhBandAgree (t + 2^k) Q 0 L` and `WinWittAgree t k Q ((t + 2^k) - L) L` cannot both hold, since pulling back to time `t` violates `not_rhBandAgree_of_lt_add`! -/
theorem not_rhBandAgree_late_and_winWittAgree_cone (t k Q L : Nat)
    (hQ : 0 < Q) (hL : t + Q ≤ L) (htk : t + Q + L < twopow k)
    (hlate : RhBandAgree (t + twopow k) Q 0 L) :
    ¬ WinWittAgree t k Q ((t + twopow k) - L) L := by
  intro hw
  have hw0 : WinWittAgree t k Q ((t + twopow k) - (0 + L)) L := by
    rwa [Nat.zero_add]
  have h0 := rhBandAgree_scale_inward_same_col_cone t k Q 0 L (by omega) hlate hw0
  exact not_rhBandAgree_of_lt_add t Q L hQ hL h0

/-- **Extracting `LhBandAgree t Q 0 R` from Two-Sided Symmetric `RowAgree t Q (t - R) (2 * R)` (`lhBandAgree_of_rowAgree_symm`)**:
    for all `t, Q, R : Nat` with `R ≤ t`, symmetric row agreement `RowAgree t Q (t - R) (2 * R)` implies left-half band agreement `LhBandAgree t Q 0 R`! -/
theorem lhBandAgree_of_rowAgree_symm (t Q R : Nat)
    (hR : R ≤ t)
    (hrow : RowAgree t Q (t - R) (2 * R)) :
    LhBandAgree t Q 0 R := by
  intro i hi
  have hr := hrow (R + i) (by omega)
  rw [Nat.zero_add,
    lhCenter_eq_row_testBit_uncond (t + Q) i,
    lhCenter_eq_row_testBit_uncond t i,
    show (t + Q) + i = (t - R) + (R + i) + Q by omega,
    show t + i = (t - R) + (R + i) by omega]
  exact hr

/-- **Symmetric Doubling from `RhBandAgree` to `LhBandAgree` Across the Periodic Center (`periodic_lhBandAgree_zero_of_rhBandAgree_zero`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, R : Nat` with `T ≤ t` and `R ≤ t`, right-half band agreement `RhBandAgree t (m * P) 0 R` automatically doubles across the periodic center to left-half band agreement `LhBandAgree t (m * P) 0 R`! -/
theorem periodic_lhBandAgree_zero_of_rhBandAgree_zero
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t R : Nat) (ht : T ≤ t) (hR : R ≤ t)
    (hrh : RhBandAgree t (m * P) 0 R) :
    LhBandAgree t (m * P) 0 R := by
  have hrow_r := rowAgree_right_of_rhBandAgree t (m * P) 0 R (by omega) hrh
  rw [Nat.zero_add] at hrow_r
  have hrow_symm := periodic_rowAgree_symm_of_right T P hP hper m R t ht hR hrow_r
  exact lhBandAgree_of_rowAgree_symm t (m * P) R hR hrow_symm

/-- **Late-Time Symmetric Doubling from `RhBandAgree (t + 2^k)` to `LhBandAgree (t + 2^k)` Without `R ≤ t` (`periodic_lhBandAgree_late_of_rhBandAgree_late`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k, R : Nat` with `T ≤ t` and `R ≤ 2^k` (no bound `R ≤ t` required, because `R ≤ 2^k ≤ t + 2^k`!), `RhBandAgree (t + 2^k) (m * P) 0 R` automatically implies `LhBandAgree (t + 2^k) (m * P) 0 R`! -/
theorem periodic_lhBandAgree_late_of_rhBandAgree_late
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k R : Nat) (ht : T ≤ t) (hR : R ≤ twopow k)
    (hrh : RhBandAgree (t + twopow k) (m * P) 0 R) :
    LhBandAgree (t + twopow k) (m * P) 0 R :=
  periodic_lhBandAgree_zero_of_rhBandAgree_zero T P hP hper m (t + twopow k) R (by omega) (by omega) hrh

/-- **Cross-Wing Refutation of Late `RhBandAgree (t + 2^k)` and Left Sector-1 `WinWittAgree` (`not_periodic_rhBandAgree_late_and_winWittAgree_sector_one`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k, L : Nat` with `0 < m`, `T ≤ t`, `t + m * P ≤ L`, and `t + m * P + L < 2^k`, `RhBandAgree (t + 2^k) (m * P) 0 L` transfers across the periodic center at time `t + 2^k` to `LhBandAgree (t + 2^k) (m * P) 0 L` (`L ≤ 2^k`), which is incompatible with left Sector-1 `WinWittAgree t k (m * P) (t + 2^k) L`! -/
theorem not_periodic_rhBandAgree_late_and_winWittAgree_sector_one
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k L : Nat) (hm : 0 < m) (ht : T ≤ t) (hL : t + m * P ≤ L)
    (htk : t + m * P + L < twopow k)
    (hrh_late : RhBandAgree (t + twopow k) (m * P) 0 L) :
    ¬ WinWittAgree t k (m * P) (t + twopow k) L := by
  have hQ : 0 < m * P := Nat.mul_pos hm hP
  have hlh_late := periodic_lhBandAgree_late_of_rhBandAgree_late T P hP hper m t k L ht (by omega) hrh_late
  exact not_lhBandAgree_late_and_winWittAgree_sector_one t k (m * P) L hQ hL htk hlh_late

/-- **Symmetric Doubling of Sector-1 `WinWittAgree` Across the Periodic Center (`periodic_winWittAgree_sector_one_left_of_right`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k, R : Nat` with `T ≤ t`, `R ≤ t`, and `t + m * P + R < 2^k`, early right-half agreement `RhBandAgree t (m * P) 0 R` and right-wing window agreement `WinWittAgree t k (m * P) ((t + 2^k) - R) R` automatically imply left-wing Sector-1 window agreement `WinWittAgree t k (m * P) (t + 2^k) R`! -/
theorem periodic_winWittAgree_sector_one_left_of_right
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k R : Nat) (ht : T ≤ t) (hR : R ≤ t) (htk : t + m * P + R < twopow k)
    (hrh0 : RhBandAgree t (m * P) 0 R)
    (hw_right : WinWittAgree t k (m * P) ((t + twopow k) - R) R) :
    WinWittAgree t k (m * P) (t + twopow k) R := by
  have hw_r0 : WinWittAgree t k (m * P) ((t + twopow k) - (0 + R)) R := by
    rwa [Nat.zero_add]
  have hrh_late := rhBandAgree_scale_same_col_cone t k (m * P) 0 R (by omega) hrh0 hw_r0
  have hlh_late := periodic_lhBandAgree_late_of_rhBandAgree_late T P hP hper m t k R ht (by omega) hrh_late
  have hlh0 := periodic_lhBandAgree_zero_of_rhBandAgree_zero T P hP hper m t R ht hR hrh0
  have hw_left := winWittAgree_sector_one_lhCenter t k (m * P) 0 R (by omega) hlh_late hlh0
  rwa [Nat.add_zero] at hw_left

/-! ### Batch 14: Universal Inter-Cone & Sector-1 `frobDefect` Vanishing, Right-Half Window Step, and `Φ`-Coupled Sector-1 Window Defect Laws -/

/-- **Universal Vanishing of `frobDefect k (row t)` Above the Sector-0 Light Cone and Below Sector 2 (`frobDefect_row_testBit_gt_two_mul_eq_false`)**:
    for all `t, k, b : Nat` with `2 * t + 1 < b` and `b < 2^k + 2^k` (covering the inter-cone zero gap, the boundary `b = 2^k`, and the entire right, center, and left parts of Sector 1 without requiring `2 * t + 1 < 2^k`!), `(frobDefect k (row t)).testBit b = false`! -/
theorem frobDefect_row_testBit_gt_two_mul_eq_false (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k + twopow k) :
    (frobDefect k (row t)).testBit b = false := by
  have hu_b : (row t).testBit b = false := by
    rw [row_testBit]
    exact rdiag_gt_two_mul t b (by omega)
  have hu_bm1 : (row t).testBit (b - 1) = false := by
    rw [row_testBit]
    exact rdiag_gt_two_mul t (b - 1) (by omega)
  change (carry (phiScale k (row t)) ^^^ phiScale k (carry (row t))).testBit b = false
  simp only [Nat.testBit_xor]
  have hphi_b : (phiScale k (row t)).testBit b =
      (decide (b ≥ twopow k) && (row t).testBit (b - twopow k)) := by
    change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
      ((row t) <<< (twopow k + twopow k))).testBit b = _
    simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
    have d2 : decide (b ≥ twopow k + twopow k) = false := decide_eq_false (by omega)
    rw [d2, Bool.false_and, Bool.xor_false, hu_b, Bool.false_xor]
  have hphi_bm1 : (phiScale k (row t)).testBit (b - 1) =
      (decide (b - 1 ≥ twopow k) && (row t).testBit (b - 1 - twopow k)) := by
    change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
      ((row t) <<< (twopow k + twopow k))).testBit (b - 1) = _
    simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
    have d2 : decide (b - 1 ≥ twopow k + twopow k) = false := decide_eq_false (by omega)
    rw [d2, Bool.false_and, Bool.xor_false, hu_bm1, Bool.false_xor]
  have hcarry_b : (carry (row t)).testBit b = false := by
    change ((row t) &&& ((row t) <<< 1)).testBit b = false
    simp only [Nat.testBit_and, Nat.testBit_shiftLeft]
    rw [hu_b, Bool.false_and]
  have hlhs : (carry (phiScale k (row t))).testBit b =
      ((phiScale k (row t)).testBit b && (phiScale k (row t)).testBit (b - 1)) := by
    change ((phiScale k (row t)) &&& ((phiScale k (row t)) <<< 1)).testBit b = _
    simp only [Nat.testBit_and, Nat.testBit_shiftLeft]
    have d0 : decide (b ≥ 1) = true := decide_eq_true (by omega)
    rw [d0, Bool.true_and]
  have hrhs : (phiScale k (carry (row t))).testBit b =
      (decide (b ≥ twopow k) && (carry (row t)).testBit (b - twopow k)) := by
    change (((carry (row t)) ^^^ ((carry (row t)) <<< twopow k)) ^^^
      ((carry (row t)) <<< (twopow k + twopow k))).testBit b = _
    simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
    have d2 : decide (b ≥ twopow k + twopow k) = false := decide_eq_false (by omega)
    rw [d2, Bool.false_and, Bool.xor_false, hcarry_b, Bool.false_xor]
  rw [hlhs, hrhs, hphi_b, hphi_bm1]
  by_cases hbk : twopow k + 1 ≤ b
  · have d1 : decide (b ≥ twopow k) = true := decide_eq_true (by omega)
    have d1m : decide (b - 1 ≥ twopow k) = true := decide_eq_true (by omega)
    have hck : (carry (row t)).testBit (b - twopow k) =
        ((row t).testBit (b - twopow k) && (row t).testBit (b - 1 - twopow k)) := by
      change ((row t) &&& ((row t) <<< 1)).testBit (b - twopow k) = _
      simp only [Nat.testBit_and, Nat.testBit_shiftLeft]
      have d0 : decide (b - twopow k ≥ 1) = true := decide_eq_true (by omega)
      rw [d0, Bool.true_and, show b - twopow k - 1 = b - 1 - twopow k by omega]
    rw [d1, d1m, Bool.true_and, Bool.true_and, Bool.true_and, hck, Bool.xor_self]
  · have d1m : decide (b - 1 ≥ twopow k) = false := decide_eq_false (by omega)
    have hck0 : (decide (b ≥ twopow k) && (carry (row t)).testBit (b - twopow k)) = false := by
      by_cases hbe : b ≥ twopow k
      · have hbeq : b - twopow k = 0 := by omega
        have hc0 : (carry (row t)).testBit 0 = false := by
          change ((row t) &&& ((row t) <<< 1)).testBit 0 = false
          simp
        rw [hbeq, hc0, Bool.and_false]
      · have df : decide (b ≥ twopow k) = false := decide_eq_false hbe
        rw [df, Bool.false_and]
    rw [d1m, Bool.false_and, Bool.and_false, hck0, Bool.xor_self]

theorem frobDefect_row_testBit_gt_two_mul_eq_false_prop (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k + twopow k) :
    wittBitBool (frobDefect k (row t)) b = false :=
  frobDefect_row_testBit_gt_two_mul_eq_false t k b hb0 hb1

/-- **Vanishing of `frobDefect k (row t)` Across the Right Half and Center of Sector 1 (`frobDefect_row_testBit_rhCenter_cone_eq_false`)**:
    for all `t, k, p : Nat` with `t + p + 1 < 2^k` (no bound `p ≤ t` required, and including `p = 0`, the center slot `t + 2^k`!), `(frobDefect k (row t)).testBit ((t + 2^k) - p) = false`! -/
theorem frobDefect_row_testBit_rhCenter_cone_eq_false (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    (frobDefect k (row t)).testBit ((t + twopow k) - p) = false :=
  frobDefect_row_testBit_gt_two_mul_eq_false t k ((t + twopow k) - p) (by omega) (by omega)

theorem frobDefect_row_testBit_rhCenter_cone_eq_false_prop (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    wittBitBool (frobDefect k (row t)) ((t + twopow k) - p) = false :=
  frobDefect_row_testBit_rhCenter_cone_eq_false t k p hp

/-- **Single-Sector Collapse of Sector-1 `crossCarry` Across the Right Half and Center (`crossCarry_row_scale_rhCenter_cone`)**:
    for all `t, k, p : Nat` with `t + p + 1 < 2^k` (no bound `p ≤ t` required, and including `p = 0`!), `(crossCarry (phiScale k (row t)) (winWitt t (2^k))).testBit ((t + 2^k) - p)` depends ONLY on `rhCenter t p`, `rhCenter t (p + 1)`, and `winWitt t (2^k)`! -/
theorem crossCarry_row_scale_rhCenter_cone (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    (crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit
        ((t + twopow k) - p) =
      bxor
        (rhCenter t p &&
          (winWitt t (twopow k)).testBit ((t + twopow k) - (p + 1)))
        ((winWitt t (twopow k)).testBit ((t + twopow k) - p) &&
          rhCenter t (p + 1)) := by
  have hc := crossCarry_testBit_succ (phiScale k (row t)) (winWitt t (twopow k))
    ((t + twopow k) - (p + 1))
  rw [show ((t + twopow k) - (p + 1)) + 1 = (t + twopow k) - p by omega] at hc
  rw [hc,
    phiScale_row_testBit_rhCenter_cone t k p (by omega),
    phiScale_row_testBit_rhCenter_cone t k (p + 1) (by omega)]

theorem crossCarry_row_scale_rhCenter_cone_prop (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    wittBitBool (crossCarry (phiScale k (row t)) (winWitt t (twopow k)))
        ((t + twopow k) - p) =
      bxor
        (rhCenter t p &&
          wittBitBool (winWitt t (twopow k)) ((t + twopow k) - (p + 1)))
        (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - p) &&
          rhCenter t (p + 1)) :=
  crossCarry_row_scale_rhCenter_cone t k p hp

/-- **Single-Sector Window Step of `winWitt` Across the Right Half and Center (`winWitt_step_rhCenter_cone`)**:
    for all `t, k, p : Nat` with `t + p + 1 < 2^k` (no bound `p ≤ t` required, and including `p = 0`!), because `frobDefect = false` (`9.503`) and `phiScale k (row t) = rhCenter t p` (`9.488`), the universal window step at `((t + 1) + 2^k) - p` collapses to a single-sector recurrence driven ONLY by `rhCenter t p`, `rhCenter t (p + 1)`, and `winWitt t (2^k)`! -/
theorem winWitt_step_rhCenter_cone (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    (winWitt (t + 1) (twopow k)).testBit (((t + 1) + twopow k) - p) =
      bxor
        ((phi (winWitt t (twopow k))).testBit (((t + 1) + twopow k) - p))
        (bxor
          (rhCenter t p &&
            (winWitt t (twopow k)).testBit ((t + twopow k) - (p + 1)))
          ((winWitt t (twopow k)).testBit ((t + twopow k) - p) &&
            rhCenter t (p + 1))) := by
  have hs := winWitt_step_frobDefect_testBit_succ t k ((t + twopow k) - p)
  rw [show ((t + twopow k) - p) + 1 = ((t + 1) + twopow k) - p by omega,
    crossCarry_row_scale_rhCenter_cone t k p hp,
    frobDefect_row_testBit_rhCenter_cone_eq_false t k p hp] at hs
  rw [hs]
  cases (phi (winWitt t (twopow k))).testBit (((t + 1) + twopow k) - p) <;>
    cases (bxor
      (rhCenter t p && (winWitt t (twopow k)).testBit ((t + twopow k) - (p + 1)))
      ((winWitt t (twopow k)).testBit ((t + twopow k) - p) && rhCenter t (p + 1))) <;> rfl

theorem winWitt_step_rhCenter_cone_prop (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    wittBitBool (winWitt (t + 1) (twopow k)) (((t + 1) + twopow k) - p) =
      bxor
        (wittBitBool (phi (winWitt t (twopow k))) (((t + 1) + twopow k) - p))
        (bxor
          (rhCenter t p &&
            wittBitBool (winWitt t (twopow k)) ((t + twopow k) - (p + 1)))
          (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - p) &&
            rhCenter t (p + 1))) :=
  winWitt_step_rhCenter_cone t k p hp

/-- **Pure `Φ`-Evolution of `winWitt` in the Right Inter-Cone Zero Gap (`winWitt_step_zero_gap_eq_phi`)**:
    for all `t, k, p : Nat` with `t < p` and `t + p + 1 < 2^k`, both `rhCenter t p = false` and `rhCenter t (p + 1) = false`, so both `frobDefect` and `crossCarry` vanish and `winWitt` evolves by the pure Witt-row map `phi`! -/
theorem winWitt_step_zero_gap_eq_phi (t k p : Nat)
    (htp : t < p) (hp : t + p + 1 < twopow k) :
    (winWitt (t + 1) (twopow k)).testBit (((t + 1) + twopow k) - p) =
      (phi (winWitt t (twopow k))).testBit (((t + 1) + twopow k) - p) := by
  rw [winWitt_step_rhCenter_cone t k p hp,
    rhCenter_gt_eq_false t p htp,
    rhCenter_gt_eq_false t (p + 1) (by omega),
    Bool.false_and, Bool.and_false]
  cases (phi (winWitt t (twopow k))).testBit (((t + 1) + twopow k) - p) <;> rfl

theorem winWitt_step_zero_gap_eq_phi_prop (t k p : Nat)
    (htp : t < p) (hp : t + p + 1 < twopow k) :
    wittBitBool (winWitt (t + 1) (twopow k)) (((t + 1) + twopow k) - p) =
      wittBitBool (phi (winWitt t (twopow k))) (((t + 1) + twopow k) - p) :=
  winWitt_step_zero_gap_eq_phi t k p htp hp

/-- **Pure `Φ`-Evolution of `winWitt` in the Left Outer Cone Gap (`winWitt_step_lhCenter_zero_gap_eq_phi`)**:
    for all `t, k, p : Nat` with `t < p` and `t + p + 1 < 2^k`, both `lhCenter t p = false` and `lhCenter t (p + 1) = false`, so both `frobDefect` and `crossCarry` vanish and `winWitt` at `(t + 1) + (p + 1) + 2^k` evolves by the pure Witt-row map `phi`! -/
theorem winWitt_step_lhCenter_zero_gap_eq_phi (t k p : Nat)
    (htp : t < p) (hp : t + p + 1 < twopow k) :
    (winWitt (t + 1) (twopow k)).testBit ((t + 1) + (p + 1) + twopow k) =
      (phi (winWitt t (twopow k))).testBit ((t + 1) + (p + 1) + twopow k) := by
  rw [winWitt_step_sector_one_lhCenter t k p hp,
    lhCenter_gt_eq_false t p htp,
    lhCenter_gt_eq_false t (p + 1) (by omega),
    Bool.false_and, Bool.and_false]
  cases (phi (winWitt t (twopow k))).testBit ((t + 1) + (p + 1) + twopow k) <;> rfl

theorem winWitt_step_lhCenter_zero_gap_eq_phi_prop (t k p : Nat)
    (htp : t < p) (hp : t + p + 1 < twopow k) :
    wittBitBool (winWitt (t + 1) (twopow k)) ((t + 1) + (p + 1) + twopow k) =
      wittBitBool (phi (winWitt t (twopow k))) ((t + 1) + (p + 1) + twopow k) :=
  winWitt_step_lhCenter_zero_gap_eq_phi t k p htp hp

/-- **Single-Sector Forward Step of Right-Wing `WinWittAgree` (`winWittAgree_step_rhCenter_cone`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L + 1 < 2^k` (no bound `p0 + L ≤ t` required, and including `p0 = 0`!), `WinWittAgree` on the right half of Sector 1 steps forward from time `t` to `t + 1` using ONLY `RhBandAgree t Q p0 (L + 1)`! -/
theorem winWittAgree_step_rhCenter_cone (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L + 1 < twopow k)
    (hb : RhBandAgree t Q p0 (L + 1))
    (hw : WinWittAgree t k Q ((t + twopow k) - (p0 + L + 1)) (L + 2)) :
    WinWittAgree (t + 1) k Q (((t + 1) + twopow k) - (p0 + L)) L := by
  intro i hi
  have hsQ := winWitt_step_rhCenter_cone (t + Q) k (p0 + (L - i)) (by omega)
  have hs0 := winWitt_step_rhCenter_cone t k (p0 + (L - i)) (by omega)
  have hb0 := hb (L - i) (by omega)
  have hb1 := hb ((L - i) + 1) (by omega)
  have hw0 := hw i (by omega)
  have hw1 := hw (i + 1) (by omega)
  have hw2 := hw (i + 2) (by omega)
  rw [show p0 + ((L - i) + 1) = (p0 + (L - i)) + 1 by omega] at hb1
  rw [show ((t + twopow k) - (p0 + L + 1)) + i + Q =
      ((t + Q) + twopow k) - ((p0 + (L - i)) + 1) by omega,
    show ((t + twopow k) - (p0 + L + 1)) + i =
      (t + twopow k) - ((p0 + (L - i)) + 1) by omega] at hw0
  rw [show ((t + twopow k) - (p0 + L + 1)) + (i + 1) + Q =
      ((t + Q) + twopow k) - (p0 + (L - i)) by omega,
    show ((t + twopow k) - (p0 + L + 1)) + (i + 1) =
      (t + twopow k) - (p0 + (L - i)) by omega] at hw1
  rw [show ((t + twopow k) - (p0 + L + 1)) + (i + 2) + Q =
      (((t + Q) + twopow k) - ((p0 + (L - i)) + 1)) + 2 by omega,
    show ((t + twopow k) - (p0 + L + 1)) + (i + 2) =
      ((t + twopow k) - ((p0 + (L - i)) + 1)) + 2 by omega] at hw2
  have hphiQ : (phi (winWitt (t + Q) (twopow k))).testBit ((((t + Q) + 1) + twopow k) - (p0 + (L - i))) =
      bxor ((winWitt (t + Q) (twopow k)).testBit ((((t + Q) + twopow k) - ((p0 + (L - i)) + 1)) + 2))
        ((winWitt (t + Q) (twopow k)).testBit (((t + Q) + twopow k) - (p0 + (L - i))) ||
          (winWitt (t + Q) (twopow k)).testBit (((t + Q) + twopow k) - ((p0 + (L - i)) + 1))) := by
    have hp0 := phi_testBit_add_two (winWitt (t + Q) (twopow k)) (((t + Q) + twopow k) - ((p0 + (L - i)) + 1))
    rw [show ((((t + Q) + 1) + twopow k) - (p0 + (L - i))) =
        (((t + Q) + twopow k) - ((p0 + (L - i)) + 1)) + 2 by omega,
      hp0,
      show (((t + Q) + twopow k) - ((p0 + (L - i)) + 1)) + 1 =
        ((t + Q) + twopow k) - (p0 + (L - i)) by omega,
      bxor_eq_xor]
  have hphi0 : (phi (winWitt t (twopow k))).testBit (((t + 1) + twopow k) - (p0 + (L - i))) =
      bxor ((winWitt t (twopow k)).testBit (((t + twopow k) - ((p0 + (L - i)) + 1)) + 2))
        ((winWitt t (twopow k)).testBit ((t + twopow k) - (p0 + (L - i))) ||
          (winWitt t (twopow k)).testBit ((t + twopow k) - ((p0 + (L - i)) + 1))) := by
    have hp0 := phi_testBit_add_two (winWitt t (twopow k)) ((t + twopow k) - ((p0 + (L - i)) + 1))
    rw [show (((t + 1) + twopow k) - (p0 + (L - i))) =
        ((t + twopow k) - ((p0 + (L - i)) + 1)) + 2 by omega,
      hp0,
      show ((t + twopow k) - ((p0 + (L - i)) + 1)) + 1 =
        (t + twopow k) - (p0 + (L - i)) by omega,
      bxor_eq_xor]
  rw [show (t + 1) + Q = (t + Q) + 1 by omega,
    show (((t + 1) + twopow k) - (p0 + L)) + i + Q =
      (((t + Q) + 1) + twopow k) - (p0 + (L - i)) by omega,
    show (((t + 1) + twopow k) - (p0 + L)) + i =
      ((t + 1) + twopow k) - (p0 + (L - i)) by omega,
    hsQ, hs0, hphiQ, hphi0, hb0, hb1, hw0, hw1, hw2]

/-- **Single-Sector Inward Extension of Right-Wing `WinWittAgree` Toward the Center (`winWittAgree_inward_step_rhCenter_cone`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L + 1 < 2^k`, `RhBandAgree t Q p0 (L + 1)`, `WinWittAgree t k Q ((t + 2^k) - (p0 + L + 1)) (L + 1)`, and `WinWittAgree (t + 1) k Q (((t + 1) + 2^k) - (p0 + L)) L` extend `WinWittAgree` at time `t` inward toward the center to width `L + 2`! -/
theorem winWittAgree_inward_step_rhCenter_cone (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L + 1 < twopow k)
    (hb : RhBandAgree t Q p0 (L + 1))
    (hw : WinWittAgree t k Q ((t + twopow k) - (p0 + L + 1)) (L + 1))
    (hnext : WinWittAgree (t + 1) k Q (((t + 1) + twopow k) - (p0 + L)) L) :
    WinWittAgree t k Q ((t + twopow k) - (p0 + L + 1)) (L + 2) := by
  intro i hi
  by_cases hi1 : i ≤ L + 1
  · exact hw i hi1
  · have hi_eq : i = L + 2 := by omega
    subst hi_eq
    have hsQ := winWitt_step_rhCenter_cone (t + Q) k p0 (by omega)
    have hs0 := winWitt_step_rhCenter_cone t k p0 (by omega)
    have hb0 := hb 0 (by omega)
    have hb1 := hb 1 (by omega)
    have hw0 := hw L (by omega)
    have hw1 := hw (L + 1) (by omega)
    have hwn := hnext L (Nat.le_refl L)
    rw [Nat.add_zero] at hb0
    rw [show ((t + twopow k) - (p0 + L + 1)) + L + Q = ((t + Q) + twopow k) - (p0 + 1) by omega,
      show ((t + twopow k) - (p0 + L + 1)) + L = (t + twopow k) - (p0 + 1) by omega] at hw0
    rw [show ((t + twopow k) - (p0 + L + 1)) + (L + 1) + Q = ((t + Q) + twopow k) - p0 by omega,
      show ((t + twopow k) - (p0 + L + 1)) + (L + 1) = (t + twopow k) - p0 by omega] at hw1
    rw [show (t + 1) + Q = (t + Q) + 1 by omega,
      show (((t + 1) + twopow k) - (p0 + L)) + L + Q = (((t + Q) + 1) + twopow k) - p0 by omega,
      show (((t + 1) + twopow k) - (p0 + L)) + L = ((t + 1) + twopow k) - p0 by omega] at hwn
    have hphiQ : (phi (winWitt (t + Q) (twopow k))).testBit ((((t + Q) + 1) + twopow k) - p0) =
        bxor ((winWitt (t + Q) (twopow k)).testBit ((((t + Q) + twopow k) - (p0 + 1)) + 2))
          ((winWitt (t + Q) (twopow k)).testBit (((t + Q) + twopow k) - p0) ||
            (winWitt (t + Q) (twopow k)).testBit (((t + Q) + twopow k) - (p0 + 1))) := by
      have hp0 := phi_testBit_add_two (winWitt (t + Q) (twopow k)) (((t + Q) + twopow k) - (p0 + 1))
      rw [show ((((t + Q) + 1) + twopow k) - p0) =
          (((t + Q) + twopow k) - (p0 + 1)) + 2 by omega,
        hp0,
        show (((t + Q) + twopow k) - (p0 + 1)) + 1 = ((t + Q) + twopow k) - p0 by omega,
        bxor_eq_xor]
    have hphi0 : (phi (winWitt t (twopow k))).testBit (((t + 1) + twopow k) - p0) =
        bxor ((winWitt t (twopow k)).testBit (((t + twopow k) - (p0 + 1)) + 2))
          ((winWitt t (twopow k)).testBit ((t + twopow k) - p0) ||
            (winWitt t (twopow k)).testBit ((t + twopow k) - (p0 + 1))) := by
      have hp0 := phi_testBit_add_two (winWitt t (twopow k)) ((t + twopow k) - (p0 + 1))
      rw [show (((t + 1) + twopow k) - p0) =
          ((t + twopow k) - (p0 + 1)) + 2 by omega,
        hp0,
        show ((t + twopow k) - (p0 + 1)) + 1 = (t + twopow k) - p0 by omega,
        bxor_eq_xor]
    rw [hsQ, hs0, hphiQ, hphi0, hb0, hb1, hw0, hw1] at hwn
    rw [show ((t + twopow k) - (p0 + L + 1)) + (L + 2) + Q =
        (((t + Q) + twopow k) - (p0 + 1)) + 2 by omega,
      show ((t + twopow k) - (p0 + L + 1)) + (L + 2) =
        ((t + twopow k) - (p0 + 1)) + 2 by omega]
    revert hwn
    simp only [bxor_eq_xor]
    cases (winWitt (t + Q) (twopow k)).testBit ((((t + Q) + twopow k) - (p0 + 1)) + 2) <;>
      cases (winWitt t (twopow k)).testBit (((t + twopow k) - (p0 + 1)) + 2) <;>
      cases ((winWitt t (twopow k)).testBit ((t + twopow k) - p0) ||
        (winWitt t (twopow k)).testBit ((t + twopow k) - (p0 + 1))) <;>
      cases ((rhCenter t p0 && (winWitt t (twopow k)).testBit ((t + twopow k) - (p0 + 1))) ^^
        ((winWitt t (twopow k)).testBit ((t + twopow k) - p0) && rhCenter t (p0 + 1))) <;> decide

/-- **Exact Center-Slot Step Law of Sector-1 `winWitt` (`winWitt_step_sector_one_center_slot`)**:
    for all `t, k : Nat` with `t + 1 < 2^k`, evaluating `winWitt_step_rhCenter_cone` at `p = 0` expresses the next center-slot window bit `(winWitt (t + 1) (2^k)).testBit ((t + 1) + 2^k)` directly from the left slot `t + 1 + 2^k`, center slot `t + 2^k`, and right slot `(t + 2^k) - 1` of `winWitt t (2^k)` together with `center t` and `rhCenter t 1`! -/
theorem winWitt_step_sector_one_center_slot (t k : Nat)
    (htk : t + 1 < twopow k) :
    (winWitt (t + 1) (twopow k)).testBit ((t + 1) + twopow k) =
      bxor
        ((winWitt t (twopow k)).testBit (t + 1 + twopow k))
        (bxor
          ((winWitt t (twopow k)).testBit (t + twopow k) ||
            (winWitt t (twopow k)).testBit ((t + twopow k) - 1))
          (bxor
            (Rule30UOR.Core.center t &&
              (winWitt t (twopow k)).testBit ((t + twopow k) - 1))
            ((winWitt t (twopow k)).testBit (t + twopow k) &&
              rhCenter t 1))) := by
  have hs := winWitt_step_rhCenter_cone t k 0 (by omega)
  rw [Nat.sub_zero, Nat.sub_zero, Nat.zero_add, rhCenter_zero_eq_center t] at hs
  have hphi := phi_testBit_add_two (winWitt t (twopow k)) ((t + twopow k) - 1)
  rw [show ((t + twopow k) - 1) + 2 = (t + 1) + twopow k by omega,
    show ((t + twopow k) - 1) + 1 = t + twopow k by omega] at hphi
  rw [hs, hphi]
  rw [show (t + 1) + twopow k = t + 1 + twopow k by omega]
  simp only [bxor_eq_xor]
  cases (winWitt t (twopow k)).testBit (t + 1 + twopow k) <;>
    cases ((winWitt t (twopow k)).testBit (t + twopow k) ||
      (winWitt t (twopow k)).testBit ((t + twopow k) - 1)) <;>
    cases ((Rule30UOR.Core.center t && (winWitt t (twopow k)).testBit ((t + twopow k) - 1)) ^^
      ((winWitt t (twopow k)).testBit (t + twopow k) && rhCenter t 1)) <;> rfl

theorem winWitt_step_sector_one_center_slot_prop (t k : Nat)
    (htk : t + 1 < twopow k) :
    wittBitBool (winWitt (t + 1) (twopow k)) ((t + 1) + twopow k) =
      bxor
        (wittBitBool (winWitt t (twopow k)) (t + 1 + twopow k))
        (bxor
          (wittBitBool (winWitt t (twopow k)) (t + twopow k) ||
            wittBitBool (winWitt t (twopow k)) ((t + twopow k) - 1))
          (bxor
            (Rule30UOR.Core.center t &&
              wittBitBool (winWitt t (twopow k)) ((t + twopow k) - 1))
            (wittBitBool (winWitt t (twopow k)) (t + twopow k) &&
              rhCenter t 1))) :=
  winWitt_step_sector_one_center_slot t k htk

/-- **`Φ`-Coupled Sector-1 Column-`-1` Window Defect Law — Late-Center Form (`periodic_winWitt_sector_one_one_defect_eq_late`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k : Nat` with `T ≤ t` and `t + m * P + 1 < 2^k`, combining `winWitt_testBit_sector_one_lhCenter` (`p = 0, 1`), `winWitt_testBit_rhCenter_same_col_cone` (`p = 1`), and `periodic_lhCenter_one_defect_eq_not_center_and_rhCenter_one_defect` at `t` and `t + 2^k` proves that the `m * P`-defect of `(winWitt · (2^k)).testBit (· + 1 + 2^k)` equals `((winWitt t (2^k)).testBit (t + 2^k) && (rhCenter (t + m * P) 1 ⊕ rhCenter t 1)) ⊕ (!center (t + 2^k) && ((winWitt (t + m * P) (2^k)).testBit (((t + m * P) + 2^k) - 1) ⊕ (winWitt t (2^k)).testBit ((t + 2^k) - 1)))`! -/
theorem periodic_winWitt_sector_one_one_defect_eq_late
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 1 < twopow k) :
    bxor
      ((winWitt (t + m * P) (twopow k)).testBit ((t + m * P) + 1 + twopow k))
      ((winWitt t (twopow k)).testBit (t + 1 + twopow k)) =
      bxor
        ((winWitt t (twopow k)).testBit (t + twopow k) &&
          bxor (rhCenter (t + m * P) 1) (rhCenter t 1))
        (!Rule30UOR.Core.center (t + twopow k) &&
          bxor
            ((winWitt (t + m * P) (twopow k)).testBit (((t + m * P) + twopow k) - 1))
            ((winWitt t (twopow k)).testBit ((t + twopow k) - 1))) := by
  have hwlQ := winWitt_testBit_sector_one_lhCenter (t + m * P) k 1 (by omega)
  have hwl0 := winWitt_testBit_sector_one_lhCenter t k 1 (by omega)
  have hwrQ := winWitt_testBit_rhCenter_same_col_cone (t + m * P) k 1 (by omega)
  have hwr0 := winWitt_testBit_rhCenter_same_col_cone t k 1 (by omega)
  have hw0 := winWitt_testBit_sector_one_lhCenter t k 0 (by omega)
  rw [Nat.add_zero, lhCenter_zero_eq_center (t + twopow k), lhCenter_zero_eq_center t] at hw0
  have hd0 := periodic_lhCenter_one_defect_eq_not_center_and_rhCenter_one_defect T P hP hper m t ht
  have hdl := periodic_lhCenter_one_defect_eq_not_center_and_rhCenter_one_defect T P hP hper m (t + twopow k) (by omega)
  rw [hwlQ, hwl0, hwrQ, hwr0, hw0,
    show (t + m * P) + twopow k = (t + twopow k) + m * P by omega]
  have hrearrange :
      bxor
        (bxor (lhCenter ((t + twopow k) + m * P) 1) (lhCenter (t + m * P) 1))
        (bxor (lhCenter (t + twopow k) 1) (lhCenter t 1)) =
      bxor
        (bxor (lhCenter ((t + twopow k) + m * P) 1) (lhCenter (t + twopow k) 1))
        (bxor (lhCenter (t + m * P) 1) (lhCenter t 1)) := by
    cases lhCenter ((t + twopow k) + m * P) 1 <;>
      cases lhCenter (t + m * P) 1 <;>
      cases lhCenter (t + twopow k) 1 <;>
      cases lhCenter t 1 <;> rfl
  rw [hrearrange, hdl, hd0]
  cases Rule30UOR.Core.center (t + twopow k) <;>
    cases Rule30UOR.Core.center t <;>
    cases rhCenter ((t + twopow k) + m * P) 1 <;>
    cases rhCenter (t + twopow k) 1 <;>
    cases rhCenter (t + m * P) 1 <;>
    cases rhCenter t 1 <;> rfl

theorem periodic_winWitt_sector_one_one_defect_eq_late_prop
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 1 < twopow k) :
    bxor
      (wittBitBool (winWitt (t + m * P) (twopow k)) ((t + m * P) + 1 + twopow k))
      (wittBitBool (winWitt t (twopow k)) (t + 1 + twopow k)) =
      bxor
        (wittBitBool (winWitt t (twopow k)) (t + twopow k) &&
          bxor (rhCenter (t + m * P) 1) (rhCenter t 1))
        (!Rule30UOR.Core.center (t + twopow k) &&
          bxor
            (wittBitBool (winWitt (t + m * P) (twopow k)) (((t + m * P) + twopow k) - 1))
            (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - 1))) :=
  periodic_winWitt_sector_one_one_defect_eq_late T P hP hper m t k ht htk

/-- **`Φ`-Coupled Sector-1 Column-`-1` Window Defect Law — Early-Center Form (`periodic_winWitt_sector_one_one_defect_eq_early`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k : Nat` with `T ≤ t` and `t + m * P + 1 < 2^k`, the `m * P`-defect of `(winWitt · (2^k)).testBit (· + 1 + 2^k)` also equals `((winWitt t (2^k)).testBit (t + 2^k) && (rhCenter ((t + 2^k) + m * P) 1 ⊕ rhCenter (t + 2^k) 1)) ⊕ (!center t && ((winWitt (t + m * P) (2^k)).testBit (((t + m * P) + 2^k) - 1) ⊕ (winWitt t (2^k)).testBit ((t + 2^k) - 1)))`! -/
theorem periodic_winWitt_sector_one_one_defect_eq_early
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 1 < twopow k) :
    bxor
      ((winWitt (t + m * P) (twopow k)).testBit ((t + m * P) + 1 + twopow k))
      ((winWitt t (twopow k)).testBit (t + 1 + twopow k)) =
      bxor
        ((winWitt t (twopow k)).testBit (t + twopow k) &&
          bxor (rhCenter ((t + twopow k) + m * P) 1) (rhCenter (t + twopow k) 1))
        (!Rule30UOR.Core.center t &&
          bxor
            ((winWitt (t + m * P) (twopow k)).testBit (((t + m * P) + twopow k) - 1))
            ((winWitt t (twopow k)).testBit ((t + twopow k) - 1))) := by
  rw [periodic_winWitt_sector_one_one_defect_eq_late T P hP hper m t k ht htk]
  have hwrQ := winWitt_testBit_rhCenter_same_col_cone (t + m * P) k 1 (by omega)
  have hwr0 := winWitt_testBit_rhCenter_same_col_cone t k 1 (by omega)
  have hw0 := winWitt_testBit_sector_one_lhCenter t k 0 (by omega)
  rw [Nat.add_zero, lhCenter_zero_eq_center (t + twopow k), lhCenter_zero_eq_center t] at hw0
  rw [hwrQ, hwr0, hw0,
    show (t + m * P) + twopow k = (t + twopow k) + m * P by omega]
  cases Rule30UOR.Core.center (t + twopow k) <;>
    cases Rule30UOR.Core.center t <;>
    cases rhCenter ((t + twopow k) + m * P) 1 <;>
    cases rhCenter (t + twopow k) 1 <;>
    cases rhCenter (t + m * P) 1 <;>
    cases rhCenter t 1 <;> rfl

theorem periodic_winWitt_sector_one_one_defect_eq_early_prop
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 1 < twopow k) :
    bxor
      (wittBitBool (winWitt (t + m * P) (twopow k)) ((t + m * P) + 1 + twopow k))
      (wittBitBool (winWitt t (twopow k)) (t + 1 + twopow k)) =
      bxor
        (wittBitBool (winWitt t (twopow k)) (t + twopow k) &&
          bxor (rhCenter ((t + twopow k) + m * P) 1) (rhCenter (t + twopow k) 1))
        (!Rule30UOR.Core.center t &&
          bxor
            (wittBitBool (winWitt (t + m * P) (twopow k)) (((t + m * P) + twopow k) - 1))
            (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - 1))) :=
  periodic_winWitt_sector_one_one_defect_eq_early T P hP hper m t k ht htk

/-- **Direct Gated Transfer Between Right and Left Column-`1` Window Slots When the Center Window Slot Vanishes (`periodic_winWitt_sector_one_one_defect_of_witt_zero_false`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k : Nat` with `T ≤ t`, `t + m * P + 1 < 2^k`, and `(winWitt t (2^k)).testBit (t + 2^k) = false`, the `rhCenter · 1` term drops out completely and the `m * P`-defect of `(winWitt · (2^k)).testBit (· + 1 + 2^k)` equals `!center t && ((winWitt (t + m * P) (2^k)).testBit (((t + m * P) + 2^k) - 1) ⊕ (winWitt t (2^k)).testBit ((t + 2^k) - 1))`! -/
theorem periodic_winWitt_sector_one_one_defect_of_witt_zero_false
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 1 < twopow k)
    (hw0 : (winWitt t (twopow k)).testBit (t + twopow k) = false) :
    bxor
      ((winWitt (t + m * P) (twopow k)).testBit ((t + m * P) + 1 + twopow k))
      ((winWitt t (twopow k)).testBit (t + 1 + twopow k)) =
      (!Rule30UOR.Core.center t &&
        bxor
          ((winWitt (t + m * P) (twopow k)).testBit (((t + m * P) + twopow k) - 1))
          ((winWitt t (twopow k)).testBit ((t + twopow k) - 1))) := by
  rw [periodic_winWitt_sector_one_one_defect_eq_early T P hP hper m t k ht htk,
    hw0, Bool.false_and]
  cases (!Rule30UOR.Core.center t &&
    bxor
      ((winWitt (t + m * P) (twopow k)).testBit (((t + m * P) + twopow k) - 1))
      ((winWitt t (twopow k)).testBit ((t + twopow k) - 1))) <;> rfl

theorem periodic_winWitt_sector_one_one_defect_of_witt_zero_false_prop
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 1 < twopow k)
    (hw0 : wittBitBool (winWitt t (twopow k)) (t + twopow k) = false) :
    bxor
      (wittBitBool (winWitt (t + m * P) (twopow k)) ((t + m * P) + 1 + twopow k))
      (wittBitBool (winWitt t (twopow k)) (t + 1 + twopow k)) =
      (!Rule30UOR.Core.center t &&
        bxor
          (wittBitBool (winWitt (t + m * P) (twopow k)) (((t + m * P) + twopow k) - 1))
          (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - 1))) :=
  periodic_winWitt_sector_one_one_defect_of_witt_zero_false T P hP hper m t k ht htk hw0

/-- **Exact Identification of Left Column-`-1` Window Defect with Gated `rhCenter · 1` Defect Under Right-Slot Agreement (`periodic_winWitt_sector_one_one_defect_of_witt_right_eq`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k : Nat` with `T ≤ t` and `t + m * P + 1 < 2^k`, if `(winWitt (t + m * P) (2^k)).testBit (((t + m * P) + 2^k) - 1) = (winWitt t (2^k)).testBit ((t + 2^k) - 1)`, then the `m * P`-defect of `(winWitt · (2^k)).testBit (· + 1 + 2^k)` equals `(winWitt t (2^k)).testBit (t + 2^k) && (rhCenter (t + m * P) 1 ⊕ rhCenter t 1)`! -/
theorem periodic_winWitt_sector_one_one_defect_of_witt_right_eq
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 1 < twopow k)
    (hwr : (winWitt (t + m * P) (twopow k)).testBit (((t + m * P) + twopow k) - 1) =
      (winWitt t (twopow k)).testBit ((t + twopow k) - 1)) :
    bxor
      ((winWitt (t + m * P) (twopow k)).testBit ((t + m * P) + 1 + twopow k))
      ((winWitt t (twopow k)).testBit (t + 1 + twopow k)) =
      ((winWitt t (twopow k)).testBit (t + twopow k) &&
        bxor (rhCenter (t + m * P) 1) (rhCenter t 1)) := by
  rw [periodic_winWitt_sector_one_one_defect_eq_late T P hP hper m t k ht htk, hwr]
  cases (winWitt t (twopow k)).testBit ((t + twopow k) - 1) <;>
    cases ((winWitt t (twopow k)).testBit (t + twopow k) &&
      bxor (rhCenter (t + m * P) 1) (rhCenter t 1)) <;>
    cases Rule30UOR.Core.center (t + twopow k) <;> rfl

theorem periodic_winWitt_sector_one_one_defect_of_witt_right_eq_prop
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 1 < twopow k)
    (hwr : wittBitBool (winWitt (t + m * P) (twopow k)) (((t + m * P) + twopow k) - 1) =
      wittBitBool (winWitt t (twopow k)) ((t + twopow k) - 1)) :
    bxor
      (wittBitBool (winWitt (t + m * P) (twopow k)) ((t + m * P) + 1 + twopow k))
      (wittBitBool (winWitt t (twopow k)) (t + 1 + twopow k)) =
      (wittBitBool (winWitt t (twopow k)) (t + twopow k) &&
        bxor (rhCenter (t + m * P) 1) (rhCenter t 1)) :=
  periodic_winWitt_sector_one_one_defect_of_witt_right_eq T P hP hper m t k ht htk hwr

/-- **Symmetric Doubling of Sector-1 `WinWittAgree` at Width `1` Without `1 ≤ t` (`periodic_winWittAgree_sector_one_two_of_right_one`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k : Nat` with `T ≤ t` and `t + m * P + 1 < 2^k` (no bound `1 ≤ t` required!), `rhCenter (t + m * P) 1 = rhCenter t 1` and `(winWitt (t + m * P) (2^k)).testBit (((t + m * P) + 2^k) - 1) = (winWitt t (2^k)).testBit ((t + 2^k) - 1)` imply `WinWittAgree t k (m * P) (t + 2^k) 1` across `[t + 2^k, t + 1 + 2^k]`! -/
theorem periodic_winWittAgree_sector_one_two_of_right_one
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 1 < twopow k)
    (hr1 : rhCenter (t + m * P) 1 = rhCenter t 1)
    (hwr : (winWitt (t + m * P) (twopow k)).testBit (((t + m * P) + twopow k) - 1) =
      (winWitt t (twopow k)).testBit ((t + twopow k) - 1)) :
    WinWittAgree t k (m * P) (t + twopow k) 1 := by
  intro i hi
  rcases Nat.eq_zero_or_pos i with rfl | hpos
  · rw [Nat.add_zero, show t + twopow k + m * P = (t + m * P) + twopow k by omega]
    exact periodic_winWitt_sector_one_zero_eq T P hP hper m t k ht (by omega)
  · have hi1 : i = 1 := by omega
    subst hi1
    have hd := periodic_winWitt_sector_one_one_defect_of_witt_right_eq T P hP hper m t k ht htk hwr
    rw [hr1] at hd
    rw [show (t + twopow k) + 1 + m * P = (t + m * P) + 1 + twopow k by omega,
      show (t + twopow k) + 1 = t + 1 + twopow k by omega]
    revert hd
    cases (winWitt (t + m * P) (twopow k)).testBit ((t + m * P) + 1 + twopow k) <;>
      cases (winWitt t (twopow k)).testBit (t + 1 + twopow k) <;>
      cases (winWitt t (twopow k)).testBit (t + twopow k) <;>
      cases rhCenter t 1 <;> decide

/-- **Extending Sector-1 `WinWittAgree` to Width `2` (`[t + 2^k, t + 2 + 2^k]`) from Two Steps of Right Column-`+1` Agreement (`periodic_winWittAgree_sector_one_three_of_right_one_step`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k : Nat` with `T ≤ t` and `t + m * P + 2 < 2^k` (no bound `2 ≤ t` required!), if `rhCenter · 1` and `(winWitt · (2^k)).testBit ((· + 2^k) - 1)` are `m * P`-invariant at `t` and `t + 1`, then `WinWittAgree t k (m * P) (t + 2^k) 2` holds across `[t + 2^k, t + 2 + 2^k]`! -/
theorem periodic_winWittAgree_sector_one_three_of_right_one_step
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k : Nat) (ht : T ≤ t) (htk : t + m * P + 2 < twopow k)
    (hr1 : rhCenter (t + m * P) 1 = rhCenter t 1)
    (hr1_next : rhCenter ((t + 1) + m * P) 1 = rhCenter (t + 1) 1)
    (hwr : (winWitt (t + m * P) (twopow k)).testBit (((t + m * P) + twopow k) - 1) =
      (winWitt t (twopow k)).testBit ((t + twopow k) - 1))
    (hwr_next : (winWitt ((t + 1) + m * P) (twopow k)).testBit ((((t + 1) + m * P) + twopow k) - 1) =
      (winWitt (t + 1) (twopow k)).testBit (((t + 1) + twopow k) - 1)) :
    WinWittAgree t k (m * P) (t + twopow k) 2 := by
  have hw1 := periodic_winWittAgree_sector_one_two_of_right_one T P hP hper m t k ht (by omega) hr1 hwr
  have hw1_next := periodic_winWittAgree_sector_one_two_of_right_one T P hP hper m (t + 1) k
    (by omega) (by omega) hr1_next hwr_next
  intro i hi
  by_cases hi1 : i ≤ 1
  · exact hw1 i hi1
  · have hi2 : i = 2 := by omega
    subst hi2
    have hbit1 := hw1 1 (Nat.le_refl 1)
    have hbit1_next := hw1_next 1 (Nat.le_refl 1)
    rw [show (t + twopow k) + 1 + m * P = (t + m * P) + 1 + twopow k by omega,
      show (t + twopow k) + 1 = t + 1 + twopow k by omega] at hbit1
    rw [show ((t + 1) + twopow k) + 1 + m * P = ((t + 1) + m * P) + 1 + twopow k by omega,
      show ((t + 1) + twopow k) + 1 = (t + 1) + 1 + twopow k by omega] at hbit1_next
    have hd2 := periodic_winWitt_sector_one_two_defect_eq T P hP hper m t k ht htk
    rw [hbit1, hbit1_next] at hd2
    rw [show (t + twopow k) + 2 + m * P = (t + m * P) + 2 + twopow k by omega,
      show (t + twopow k) + 2 = t + 2 + twopow k by omega]
    revert hd2
    cases (winWitt (t + m * P) (twopow k)).testBit ((t + m * P) + 2 + twopow k) <;>
      cases (winWitt t (twopow k)).testBit (t + 2 + twopow k) <;>
      cases (winWitt (t + 1) (twopow k)).testBit ((t + 1) + 1 + twopow k) <;>
      cases (winWitt t (twopow k)).testBit (t + 1 + twopow k) <;> decide

/-! ### Batch 15: Universal Sideways (Left-Permutive) Inversion of `winWitt`, Unconditional Zero-Gap Window Propagation, and Multi-Step Sector-1 Window Calculus -/

/-- **Universal Sideways (Left-Permutive) Inversion of `winWitt` (`winWitt_inward_step_frobDefect_testBit_succ`)**:
    for all `t, k, b : Nat` with `1 ≤ b`, because `(phi w).testBit (b + 1)` is linear in `w.testBit (b + 1)` while `(crossCarry (phiScale k (row t)) w).testBit b` and `(frobDefect k (row t)).testBit b` depend only on bits `≤ b`, the universal window step `winWitt_step_frobDefect_testBit_succ` inverts sideways to express `(winWitt t (2^k)).testBit (b + 1)` from `(winWitt (t + 1) (2^k)).testBit (b + 1)` and bits `b, b - 1` at time `t`! -/
theorem winWitt_inward_step_frobDefect_testBit_succ (t k b : Nat)
    (hb : 1 ≤ b) :
    (winWitt t (twopow k)).testBit (b + 1) =
      bxor
        ((winWitt (t + 1) (twopow k)).testBit (b + 1))
        (bxor
          ((winWitt t (twopow k)).testBit b ||
            (winWitt t (twopow k)).testBit (b - 1))
          (bxor
            ((crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit b)
            ((frobDefect k (row t)).testBit b))) := by
  have hs := winWitt_step_frobDefect_testBit_succ t k b
  have hphi := phi_testBit_add_two (winWitt t (twopow k)) (b - 1)
  rw [show (b - 1) + 2 = b + 1 by omega,
    show (b - 1) + 1 = b by omega] at hphi
  rw [hs, hphi]
  simp only [bxor_eq_xor]
  cases (winWitt t (twopow k)).testBit (b + 1) <;>
    cases ((winWitt t (twopow k)).testBit b ||
      (winWitt t (twopow k)).testBit (b - 1)) <;>
    cases ((crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit b) <;>
    cases ((frobDefect k (row t)).testBit b) <;> rfl

theorem winWitt_inward_step_frobDefect_testBit_succ_prop (t k b : Nat)
    (hb : 1 ≤ b) :
    wittBitBool (winWitt t (twopow k)) (b + 1) =
      bxor
        (wittBitBool (winWitt (t + 1) (twopow k)) (b + 1))
        (bxor
          (wittBitBool (winWitt t (twopow k)) b ||
            wittBitBool (winWitt t (twopow k)) (b - 1))
          (bxor
            (wittBitBool (crossCarry (phiScale k (row t)) (winWitt t (twopow k))) b)
            (wittBitBool (frobDefect k (row t)) b))) :=
  winWitt_inward_step_frobDefect_testBit_succ t k b hb

/-- **Sideways Inversion of `winWitt` Above the Sector-0 Light Cone (`winWitt_inward_step_gt_two_mul`)**:
    for all `t, k, b : Nat` with `2 * t + 1 < b` and `b < 2^k + 2^k`, `(frobDefect k (row t)).testBit b = false` (`9.502`), so `(winWitt t (2^k)).testBit (b + 1)` is determined purely by `(winWitt (t + 1) (2^k)).testBit (b + 1)`, `(winWitt t (2^k)).testBit b`, `(winWitt t (2^k)).testBit (b - 1)`, and `crossCarry` at bit `b`! -/
theorem winWitt_inward_step_gt_two_mul (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k + twopow k) :
    (winWitt t (twopow k)).testBit (b + 1) =
      bxor
        ((winWitt (t + 1) (twopow k)).testBit (b + 1))
        (bxor
          ((winWitt t (twopow k)).testBit b ||
            (winWitt t (twopow k)).testBit (b - 1))
          ((crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit b)) := by
  rw [winWitt_inward_step_frobDefect_testBit_succ t k b (by omega),
    frobDefect_row_testBit_gt_two_mul_eq_false t k b hb0 hb1]
  cases (winWitt (t + 1) (twopow k)).testBit (b + 1) <;>
    cases ((winWitt t (twopow k)).testBit b ||
      (winWitt t (twopow k)).testBit (b - 1)) <;>
    cases ((crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit b) <;> rfl

theorem winWitt_inward_step_gt_two_mul_prop (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k + twopow k) :
    wittBitBool (winWitt t (twopow k)) (b + 1) =
      bxor
        (wittBitBool (winWitt (t + 1) (twopow k)) (b + 1))
        (bxor
          (wittBitBool (winWitt t (twopow k)) b ||
            wittBitBool (winWitt t (twopow k)) (b - 1))
          (wittBitBool (crossCarry (phiScale k (row t)) (winWitt t (twopow k))) b)) :=
  winWitt_inward_step_gt_two_mul t k b hb0 hb1

/-- **Sideways Readout of the Left Column-`-1` Window Bit from Center and Right-Half Data (`winWitt_sector_one_one_from_center_and_right`)**:
    for all `t, k : Nat` with `t + 1 < 2^k`, inverting `winWitt_step_sector_one_center_slot` (`9.510`) expresses the left column-`-1` window bit `(winWitt t (2^k)).testBit (t + 1 + 2^k)` purely in terms of `(winWitt (t + 1) (2^k)).testBit ((t + 1) + 2^k)`, `(winWitt t (2^k)).testBit (t + 2^k)`, `(winWitt t (2^k)).testBit ((t + 2^k) - 1)`, `center t`, and `rhCenter t 1`! -/
theorem winWitt_sector_one_one_from_center_and_right (t k : Nat)
    (htk : t + 1 < twopow k) :
    (winWitt t (twopow k)).testBit (t + 1 + twopow k) =
      bxor
        ((winWitt (t + 1) (twopow k)).testBit ((t + 1) + twopow k))
        (bxor
          ((winWitt t (twopow k)).testBit (t + twopow k) ||
            (winWitt t (twopow k)).testBit ((t + twopow k) - 1))
          (bxor
            (Rule30UOR.Core.center t &&
              (winWitt t (twopow k)).testBit ((t + twopow k) - 1))
            ((winWitt t (twopow k)).testBit (t + twopow k) &&
              rhCenter t 1))) := by
  rw [winWitt_step_sector_one_center_slot t k htk]
  simp only [bxor_eq_xor]
  cases (winWitt t (twopow k)).testBit (t + 1 + twopow k) <;>
    cases ((winWitt t (twopow k)).testBit (t + twopow k) ||
      (winWitt t (twopow k)).testBit ((t + twopow k) - 1)) <;>
    cases ((Rule30UOR.Core.center t && (winWitt t (twopow k)).testBit ((t + twopow k) - 1)) ^^
      ((winWitt t (twopow k)).testBit (t + twopow k) && rhCenter t 1)) <;> rfl

theorem winWitt_sector_one_one_from_center_and_right_prop (t k : Nat)
    (htk : t + 1 < twopow k) :
    wittBitBool (winWitt t (twopow k)) (t + 1 + twopow k) =
      bxor
        (wittBitBool (winWitt (t + 1) (twopow k)) ((t + 1) + twopow k))
        (bxor
          (wittBitBool (winWitt t (twopow k)) (t + twopow k) ||
            wittBitBool (winWitt t (twopow k)) ((t + twopow k) - 1))
          (bxor
            (Rule30UOR.Core.center t &&
              wittBitBool (winWitt t (twopow k)) ((t + twopow k) - 1))
            (wittBitBool (winWitt t (twopow k)) (t + twopow k) &&
              rhCenter t 1))) :=
  winWitt_sector_one_one_from_center_and_right t k htk

/-- **Sideways Outward Inversion of `winWitt` Across the Left Half of Sector 1 (`winWitt_inward_step_sector_one_lhCenter`)**:
    for all `t, k, p : Nat` with `t + p + 1 < 2^k`, solving `winWitt_step_sector_one_lhCenter` (`9.482`) for the outward bit `(winWitt t (2^k)).testBit (t + (p + 2) + 2^k)` expresses it in terms of `(winWitt (t + 1) (2^k)).testBit ((t + 1) + (p + 1) + 2^k)`, `winWitt t (2^k)` at `p, p + 1`, and `lhCenter t` at `p, p + 1`! -/
theorem winWitt_inward_step_sector_one_lhCenter (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    (winWitt t (twopow k)).testBit (t + (p + 2) + twopow k) =
      bxor
        ((winWitt (t + 1) (twopow k)).testBit ((t + 1) + (p + 1) + twopow k))
        (bxor
          ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow k) ||
            (winWitt t (twopow k)).testBit (t + p + twopow k))
          (bxor
            (lhCenter t (p + 1) &&
              (winWitt t (twopow k)).testBit (t + p + twopow k))
            ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow k) &&
              lhCenter t p))) := by
  have hs := winWitt_step_sector_one_lhCenter t k p hp
  have hphi := phi_testBit_add_two (winWitt t (twopow k)) (t + p + twopow k)
  rw [show (t + p + twopow k) + 2 = (t + 1) + (p + 1) + twopow k by omega,
    show (t + p + twopow k) + 1 = t + (p + 1) + twopow k by omega] at hphi
  rw [hs, hphi, show (t + 1) + (p + 1) + twopow k = t + (p + 2) + twopow k by omega]
  simp only [bxor_eq_xor]
  cases (winWitt t (twopow k)).testBit (t + (p + 2) + twopow k) <;>
    cases ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow k) ||
      (winWitt t (twopow k)).testBit (t + p + twopow k)) <;>
    cases ((lhCenter t (p + 1) && (winWitt t (twopow k)).testBit (t + p + twopow k)) ^^
      ((winWitt t (twopow k)).testBit (t + (p + 1) + twopow k) && lhCenter t p)) <;> rfl

theorem winWitt_inward_step_sector_one_lhCenter_prop (t k p : Nat)
    (hp : t + p + 1 < twopow k) :
    wittBitBool (winWitt t (twopow k)) (t + (p + 2) + twopow k) =
      bxor
        (wittBitBool (winWitt (t + 1) (twopow k)) ((t + 1) + (p + 1) + twopow k))
        (bxor
          (wittBitBool (winWitt t (twopow k)) (t + (p + 1) + twopow k) ||
            wittBitBool (winWitt t (twopow k)) (t + p + twopow k))
          (bxor
            (lhCenter t (p + 1) &&
              wittBitBool (winWitt t (twopow k)) (t + p + twopow k))
            (wittBitBool (winWitt t (twopow k)) (t + (p + 1) + twopow k) &&
              lhCenter t p))) :=
  winWitt_inward_step_sector_one_lhCenter t k p hp

/-- **Sideways Inward Inversion of `winWitt` Across the Right Half of Sector 1 (`winWitt_inward_step_rhCenter_cone`)**:
    for all `t, k, p : Nat` with `t + p + 2 < 2^k` (no bound `p ≤ t` required!), solving `winWitt_step_rhCenter_cone` (`9.505`) at `p + 1` for the inward bit `(winWitt t (2^k)).testBit ((t + 2^k) - p)` expresses column `p` of the right-wing window from `(winWitt (t + 1) (2^k)).testBit (((t + 1) + 2^k) - (p + 1))` and columns `p + 1, p + 2` at time `t`! -/
theorem winWitt_inward_step_rhCenter_cone (t k p : Nat)
    (hp : t + p + 2 < twopow k) :
    (winWitt t (twopow k)).testBit ((t + twopow k) - p) =
      bxor
        ((winWitt (t + 1) (twopow k)).testBit (((t + 1) + twopow k) - (p + 1)))
        (bxor
          ((winWitt t (twopow k)).testBit ((t + twopow k) - (p + 1)) ||
            (winWitt t (twopow k)).testBit ((t + twopow k) - (p + 2)))
          (bxor
            (rhCenter t (p + 1) &&
              (winWitt t (twopow k)).testBit ((t + twopow k) - (p + 2)))
            ((winWitt t (twopow k)).testBit ((t + twopow k) - (p + 1)) &&
              rhCenter t (p + 2)))) := by
  have hs := winWitt_step_rhCenter_cone t k (p + 1) (by omega)
  have hphi := phi_testBit_add_two (winWitt t (twopow k)) ((t + twopow k) - (p + 2))
  rw [show ((t + twopow k) - (p + 2)) + 2 = ((t + 1) + twopow k) - (p + 1) by omega,
    show ((t + twopow k) - (p + 2)) + 1 = (t + twopow k) - (p + 1) by omega] at hphi
  rw [hs, hphi,
    show (p + 1) + 1 = p + 2 by omega,
    show ((t + 1) + twopow k) - (p + 1) = (t + twopow k) - p by omega]
  simp only [bxor_eq_xor]
  cases (winWitt t (twopow k)).testBit ((t + twopow k) - p) <;>
    cases ((winWitt t (twopow k)).testBit ((t + twopow k) - (p + 1)) ||
      (winWitt t (twopow k)).testBit ((t + twopow k) - (p + 2))) <;>
    cases ((rhCenter t (p + 1) && (winWitt t (twopow k)).testBit ((t + twopow k) - (p + 2))) ^^
      ((winWitt t (twopow k)).testBit ((t + twopow k) - (p + 1)) && rhCenter t (p + 2))) <;> rfl

theorem winWitt_inward_step_rhCenter_cone_prop (t k p : Nat)
    (hp : t + p + 2 < twopow k) :
    wittBitBool (winWitt t (twopow k)) ((t + twopow k) - p) =
      bxor
        (wittBitBool (winWitt (t + 1) (twopow k)) (((t + 1) + twopow k) - (p + 1)))
        (bxor
          (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - (p + 1)) ||
            wittBitBool (winWitt t (twopow k)) ((t + twopow k) - (p + 2)))
          (bxor
            (rhCenter t (p + 1) &&
              wittBitBool (winWitt t (twopow k)) ((t + twopow k) - (p + 2)))
            (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - (p + 1)) &&
              rhCenter t (p + 2)))) :=
  winWitt_inward_step_rhCenter_cone t k p hp

/-- **Pure-`Φ` Sideways Inward Inversion of `winWitt` in the Right Inter-Cone Zero Gap (`winWitt_inward_step_zero_gap`)**:
    for all `t, k, p : Nat` with `t ≤ p` and `t + p + 2 < 2^k` (including `p = t`, right at the Sector-1 light-cone boundary `b = 2^k`!), both `rhCenter t (p + 1) = false` and `rhCenter t (p + 2) = false`, so `(winWitt t (2^k)).testBit ((t + 2^k) - p)` equals `(winWitt (t + 1) (2^k)).testBit (((t + 1) + 2^k) - (p + 1)) ⊕ ((winWitt t (2^k)).testBit ((t + 2^k) - (p + 1)) || (winWitt t (2^k)).testBit ((t + 2^k) - (p + 2)))`! -/
theorem winWitt_inward_step_zero_gap (t k p : Nat)
    (htp : t ≤ p) (hp : t + p + 2 < twopow k) :
    (winWitt t (twopow k)).testBit ((t + twopow k) - p) =
      bxor
        ((winWitt (t + 1) (twopow k)).testBit (((t + 1) + twopow k) - (p + 1)))
        ((winWitt t (twopow k)).testBit ((t + twopow k) - (p + 1)) ||
          (winWitt t (twopow k)).testBit ((t + twopow k) - (p + 2))) := by
  rw [winWitt_inward_step_rhCenter_cone t k p hp,
    rhCenter_gt_eq_false t (p + 1) (by omega),
    rhCenter_gt_eq_false t (p + 2) (by omega),
    Bool.false_and, Bool.and_false]
  cases (winWitt (t + 1) (twopow k)).testBit (((t + 1) + twopow k) - (p + 1)) <;>
    cases ((winWitt t (twopow k)).testBit ((t + twopow k) - (p + 1)) ||
      (winWitt t (twopow k)).testBit ((t + twopow k) - (p + 2))) <;> rfl

theorem winWitt_inward_step_zero_gap_prop (t k p : Nat)
    (htp : t ≤ p) (hp : t + p + 2 < twopow k) :
    wittBitBool (winWitt t (twopow k)) ((t + twopow k) - p) =
      bxor
        (wittBitBool (winWitt (t + 1) (twopow k)) (((t + 1) + twopow k) - (p + 1)))
        (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - (p + 1)) ||
          wittBitBool (winWitt t (twopow k)) ((t + twopow k) - (p + 2))) :=
  winWitt_inward_step_zero_gap t k p htp hp

/-- **Unconditional Forward Step of `WinWittAgree` in the Right Inter-Cone Zero Gap (`winWittAgree_step_zero_gap`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0` and `t + Q + p0 + L + 1 < 2^k`, `WinWittAgree t k Q ((t + 2^k) - (p0 + L + 1)) (L + 2)` steps forward to `WinWittAgree (t + 1) k Q (((t + 1) + 2^k) - (p0 + L)) L` with ZERO row or band hypotheses at time `t`! -/
theorem winWittAgree_step_zero_gap (t k Q p0 L : Nat)
    (hp0 : t + Q < p0)
    (hp : t + Q + p0 + L + 1 < twopow k)
    (hw : WinWittAgree t k Q ((t + twopow k) - (p0 + L + 1)) (L + 2)) :
    WinWittAgree (t + 1) k Q (((t + 1) + twopow k) - (p0 + L)) L :=
  winWittAgree_step_rhCenter_cone t k Q p0 L hp
    (rhBandAgree_outside_cone t Q p0 (L + 1) hp0) hw

/-- **Unconditional Inward Extension of `WinWittAgree` in the Right Inter-Cone Zero Gap (`winWittAgree_inward_step_zero_gap`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0` and `t + Q + p0 + L + 1 < 2^k`, `WinWittAgree t k Q ((t + 2^k) - (p0 + L + 1)) (L + 1)` and `WinWittAgree (t + 1) k Q (((t + 1) + 2^k) - (p0 + L)) L` extend `WinWittAgree` at time `t` inward to width `L + 2` with ZERO row or band hypotheses at time `t`! -/
theorem winWittAgree_inward_step_zero_gap (t k Q p0 L : Nat)
    (hp0 : t + Q < p0)
    (hp : t + Q + p0 + L + 1 < twopow k)
    (hw : WinWittAgree t k Q ((t + twopow k) - (p0 + L + 1)) (L + 1))
    (hnext : WinWittAgree (t + 1) k Q (((t + 1) + twopow k) - (p0 + L)) L) :
    WinWittAgree t k Q ((t + twopow k) - (p0 + L + 1)) (L + 2) :=
  winWittAgree_inward_step_rhCenter_cone t k Q p0 L hp
    (rhBandAgree_outside_cone t Q p0 (L + 1) hp0) hw hnext

/-- **Unconditional Forward Step of `WinWittAgree` in the Left Outer Cone Gap (`winWittAgree_step_lhCenter_zero_gap`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0` and `t + Q + p0 + L + 1 < 2^k`, `WinWittAgree t k Q (t + p0 + 2^k) (L + 2)` steps forward to `WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + 2^k) L` with ZERO row or band hypotheses at time `t`! -/
theorem winWittAgree_step_lhCenter_zero_gap (t k Q p0 L : Nat)
    (hp0 : t + Q < p0)
    (hp : t + Q + p0 + L + 1 < twopow k)
    (hw : WinWittAgree t k Q (t + p0 + twopow k) (L + 2)) :
    WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + twopow k) L :=
  winWittAgree_step_sector_one_lhCenter t k Q p0 L hp
    (lhBandAgree_outside_cone t Q p0 (L + 1) hp0) hw

/-- **Unconditional Outward Extension of `WinWittAgree` in the Left Outer Cone Gap (`winWittAgree_outward_step_lhCenter_zero_gap`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q < p0` and `t + Q + p0 + L + 1 < 2^k`, `WinWittAgree t k Q (t + p0 + 2^k) (L + 1)` and `WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + 2^k) L` extend `WinWittAgree` at time `t` outward to width `L + 2` with ZERO row or band hypotheses at time `t`! -/
theorem winWittAgree_outward_step_lhCenter_zero_gap (t k Q p0 L : Nat)
    (hp0 : t + Q < p0)
    (hp : t + Q + p0 + L + 1 < twopow k)
    (hw : WinWittAgree t k Q (t + p0 + twopow k) (L + 1))
    (hnext : WinWittAgree (t + 1) k Q ((t + 1) + (p0 + 1) + twopow k) L) :
    WinWittAgree t k Q (t + p0 + twopow k) (L + 2) :=
  winWittAgree_outward_step_sector_one_lhCenter t k Q p0 L hp
    (lhBandAgree_outside_cone t Q p0 (L + 1) hp0) hw hnext

/-- **Multi-Step Forward Propagation of Right-Wing `WinWittAgree` Across the Right Half (`winWittAgree_steps_rhCenter_cone`)**:
    for all `t, k, Q, p0, L, s : Nat` with `t + Q + p0 + L + 2 * s < 2^k`, `RhBandAgree t Q p0 (L + 2 * s)` and `WinWittAgree t k Q ((t + 2^k) - (p0 + L + 2 * s)) (L + 2 * s)` propagate forward across `s` steps to `WinWittAgree (t + s) k Q (((t + s) + 2^k) - ((p0 + s) + L)) L`! -/
theorem winWittAgree_steps_rhCenter_cone (t k Q p0 L s : Nat)
    (hp : t + Q + p0 + L + 2 * s < twopow k)
    (hb : RhBandAgree t Q p0 (L + 2 * s))
    (hw : WinWittAgree t k Q ((t + twopow k) - (p0 + L + 2 * s)) (L + 2 * s)) :
    WinWittAgree (t + s) k Q (((t + s) + twopow k) - ((p0 + s) + L)) L := by
  induction s generalizing t p0 L with
  | zero =>
    rw [Nat.add_zero, Nat.add_zero]
    rw [Nat.mul_zero, Nat.add_zero] at hw
    exact hw
  | succ s ih =>
    have hb1 : RhBandAgree (t + 1) Q (p0 + 1) (L + 2 * s) := by
      apply rhBandAgree_step t Q p0 (L + 2 * s)
      rwa [show (L + 2 * s) + 2 = L + 2 * (s + 1) by omega]
    have hb_sub : RhBandAgree t Q (p0 + 1) ((L + 2 * s) + 1) :=
      rhBandAgree_mono t Q p0 (L + 2 * (s + 1)) (p0 + 1) ((L + 2 * s) + 1) (by omega) (by omega) hb
    have hw_sub : WinWittAgree t k Q ((t + twopow k) - ((p0 + 1) + (L + 2 * s) + 1)) ((L + 2 * s) + 2) := by
      rwa [show (p0 + 1) + (L + 2 * s) + 1 = p0 + L + 2 * (s + 1) by omega,
        show (L + 2 * s) + 2 = L + 2 * (s + 1) by omega]
    have hw1 := winWittAgree_step_rhCenter_cone t k Q (p0 + 1) (L + 2 * s) (by omega) hb_sub hw_sub
    rw [show (p0 + 1) + (L + 2 * s) = (p0 + 1) + L + 2 * s by omega] at hw1
    have hih := ih (t + 1) (p0 + 1) L (by omega) hb1 hw1
    rwa [show (t + 1) + s = t + (s + 1) by omega,
      show (p0 + 1) + s = p0 + (s + 1) by omega] at hih

/-- **Multi-Step Propagation of Late `RhBandAgree ((t + s) + 2^k)` from Early `RhBandAgree` and `WinWittAgree` (`rhBandAgree_late_steps_cone`)**:
    for all `t, k, Q, p0, L, s : Nat` with `t + Q + p0 + L + 2 * s < 2^k`, `RhBandAgree t Q p0 (L + 2 * s)` and `WinWittAgree t k Q ((t + 2^k) - (p0 + L + 2 * s)) (L + 2 * s)` at time `t` imply late band agreement `RhBandAgree ((t + s) + 2^k) Q (p0 + s) L` at every shifted time `(t + s) + 2^k`! -/
theorem rhBandAgree_late_steps_cone (t k Q p0 L s : Nat)
    (hp : t + Q + p0 + L + 2 * s < twopow k)
    (hb : RhBandAgree t Q p0 (L + 2 * s))
    (hw : WinWittAgree t k Q ((t + twopow k) - (p0 + L + 2 * s)) (L + 2 * s)) :
    RhBandAgree ((t + s) + twopow k) Q (p0 + s) L := by
  have hbs := rhBandAgree_steps t Q p0 L s hb
  have hws := winWittAgree_steps_rhCenter_cone t k Q p0 L s hp hb hw
  exact rhBandAgree_scale_same_col_cone (t + s) k Q (p0 + s) L (by omega) hbs hws

/-- **Multi-Step Unconditional Forward Propagation of `WinWittAgree` in the Right Inter-Cone Zero Gap (`winWittAgree_steps_zero_gap`)**:
    for all `t, k, Q, p0, L, s : Nat` with `t + Q < p0` and `t + Q + p0 + L + 2 * s < 2^k`, `WinWittAgree t k Q ((t + 2^k) - (p0 + L + 2 * s)) (L + 2 * s)` propagates forward across `s` steps to `WinWittAgree (t + s) k Q (((t + s) + 2^k) - ((p0 + s) + L)) L` with ZERO row or band hypotheses! -/
theorem winWittAgree_steps_zero_gap (t k Q p0 L s : Nat)
    (hp0 : t + Q < p0)
    (hp : t + Q + p0 + L + 2 * s < twopow k)
    (hw : WinWittAgree t k Q ((t + twopow k) - (p0 + L + 2 * s)) (L + 2 * s)) :
    WinWittAgree (t + s) k Q (((t + s) + twopow k) - ((p0 + s) + L)) L :=
  winWittAgree_steps_rhCenter_cone t k Q p0 L s hp
    (rhBandAgree_outside_cone t Q p0 (L + 2 * s) hp0) hw

/-- **Multi-Step Forward Propagation of Sector-1 `WinWittAgree` Across the Left Half (`winWittAgree_steps_sector_one_lhCenter`)**:
    for all `t, k, Q, p0, L, s : Nat` with `t + Q + p0 + L + 2 * s < 2^k`, `LhBandAgree t Q p0 (L + 2 * s)` and `WinWittAgree t k Q (t + p0 + 2^k) (L + 2 * s)` propagate forward across `s` steps to `WinWittAgree (t + s) k Q ((t + s) + (p0 + s) + 2^k) L`! -/
theorem winWittAgree_steps_sector_one_lhCenter (t k Q p0 L s : Nat)
    (hp : t + Q + p0 + L + 2 * s < twopow k)
    (hb : LhBandAgree t Q p0 (L + 2 * s))
    (hw : WinWittAgree t k Q (t + p0 + twopow k) (L + 2 * s)) :
    WinWittAgree (t + s) k Q ((t + s) + (p0 + s) + twopow k) L := by
  induction s generalizing t p0 L with
  | zero =>
    rw [Nat.add_zero, Nat.add_zero]
    rw [Nat.mul_zero, Nat.add_zero] at hw
    exact hw
  | succ s ih =>
    have hb1 : LhBandAgree (t + 1) Q (p0 + 1) (L + 2 * s) := by
      apply lhBandAgree_step t Q p0 (L + 2 * s)
      rwa [show (L + 2 * s) + 2 = L + 2 * (s + 1) by omega]
    have hb_sub : LhBandAgree t Q p0 ((L + 2 * s) + 1) :=
      lhBandAgree_mono t Q p0 (L + 2 * (s + 1)) p0 ((L + 2 * s) + 1) (by omega) (by omega) hb
    have hw_sub : WinWittAgree t k Q (t + p0 + twopow k) ((L + 2 * s) + 2) := by
      rwa [show (L + 2 * s) + 2 = L + 2 * (s + 1) by omega]
    have hw1 := winWittAgree_step_sector_one_lhCenter t k Q p0 (L + 2 * s) (by omega) hb_sub hw_sub
    have hih := ih (t + 1) (p0 + 1) L (by omega) hb1 hw1
    rwa [show (t + 1) + s = t + (s + 1) by omega,
      show (p0 + 1) + s = p0 + (s + 1) by omega] at hih

/-- **Multi-Step Propagation of Late `LhBandAgree ((t + s) + 2^k)` from Early `LhBandAgree` and `WinWittAgree` (`lhBandAgree_late_steps_sector_one`)**:
    for all `t, k, Q, p0, L, s : Nat` with `t + Q + p0 + L + 2 * s < 2^k`, `LhBandAgree t Q p0 (L + 2 * s)` and `WinWittAgree t k Q (t + p0 + 2^k) (L + 2 * s)` at time `t` imply late band agreement `LhBandAgree ((t + s) + 2^k) Q (p0 + s) L` at every shifted time `(t + s) + 2^k`! -/
theorem lhBandAgree_late_steps_sector_one (t k Q p0 L s : Nat)
    (hp : t + Q + p0 + L + 2 * s < twopow k)
    (hb : LhBandAgree t Q p0 (L + 2 * s))
    (hw : WinWittAgree t k Q (t + p0 + twopow k) (L + 2 * s)) :
    LhBandAgree ((t + s) + twopow k) Q (p0 + s) L := by
  have hbs := lhBandAgree_steps t Q p0 L s hb
  have hws := winWittAgree_steps_sector_one_lhCenter t k Q p0 L s hp hb hw
  exact lhBandAgree_scale_same_col_cone (t + s) k Q (p0 + s) L (by omega) hbs hws

/-! ### Batch 16: Raw Inter-Cone Pure-`Φ` Window Evolution, Non-Overlapping 3-Sector Copy Laws of `phiScale`, and Early-Free Cross-Sector Window Duality -/

/-- **Vanishing of `phiScale k (row t)` Across the Raw Inter-Cone Gap (`phiScale_row_testBit_inter_cone_gap_eq_false`)**:
    for all `t, k, b : Nat` with `2 * t < b` and `b < 2^k`, bit `b` lies strictly above the Sector-0 light cone `2 * t` and strictly below the Sector-1 shift `2^k`, so `(phiScale k (row t)).testBit b = false`! -/
theorem phiScale_row_testBit_inter_cone_gap_eq_false (t k b : Nat)
    (hb0 : 2 * t < b) (hb1 : b < twopow k) :
    (phiScale k (row t)).testBit b = false := by
  have hu : (row t).testBit b = false := by
    rw [row_testBit]
    exact rdiag_gt_two_mul t b hb0
  change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
    ((row t) <<< (twopow k + twopow k))).testBit b = false
  simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
  have d1 : decide (b ≥ twopow k) = false := decide_eq_false (by omega)
  have d2 : decide (b ≥ twopow k + twopow k) = false := decide_eq_false (by omega)
  rw [d1, d2, Bool.false_and, Bool.false_and, hu]
  rfl

theorem phiScale_row_testBit_inter_cone_gap_eq_false_prop (t k b : Nat)
    (hb0 : 2 * t < b) (hb1 : b < twopow k) :
    wittBitBool (phiScale k (row t)) b = false :=
  phiScale_row_testBit_inter_cone_gap_eq_false t k b hb0 hb1

/-- **Direct Readout of Late `row (t + 2^k)` Across the Raw Inter-Cone Gap (`winWitt_testBit_inter_cone_gap_eq_row_late`)**:
    for all `t, k, b : Nat` with `2 * t < b` and `b < 2^k`, because `(phiScale k (row t)).testBit b = false`, `(winWitt t (2^k)).testBit b` equals `(row (t + 2^k)).testBit b` directly! -/
theorem winWitt_testBit_inter_cone_gap_eq_row_late (t k b : Nat)
    (hb0 : 2 * t < b) (hb1 : b < twopow k) :
    (winWitt t (twopow k)).testBit b = (row (t + twopow k)).testBit b := by
  have hsc := congrArg (fun n => n.testBit b) (row_scale t k)
  rw [Nat.testBit_xor,
    phiScale_row_testBit_inter_cone_gap_eq_false t k b hb0 hb1,
    Bool.false_xor] at hsc
  exact hsc.symm

theorem winWitt_testBit_inter_cone_gap_eq_row_late_prop (t k b : Nat)
    (hb0 : 2 * t < b) (hb1 : b < twopow k) :
    wittBitBool (winWitt t (twopow k)) b =
      wittBitBool (row (t + twopow k)) b :=
  winWitt_testBit_inter_cone_gap_eq_row_late t k b hb0 hb1

/-- **Vanishing of `crossCarry` Across the Raw Inter-Cone Gap (`crossCarry_row_scale_inter_cone_gap_eq_false`)**:
    for all `t, k, b : Nat` with `2 * t + 1 < b` and `b < 2^k`, both `b` and `b - 1` lie in the inter-cone gap `(2 * t, 2^k)` where `phiScale k (row t)` vanishes, so `(crossCarry (phiScale k (row t)) (winWitt t (2^k))).testBit b = false`! -/
theorem crossCarry_row_scale_inter_cone_gap_eq_false (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k) :
    (crossCarry (phiScale k (row t)) (winWitt t (twopow k))).testBit b = false := by
  have hc := crossCarry_testBit_succ (phiScale k (row t)) (winWitt t (twopow k)) (b - 1)
  rw [show (b - 1) + 1 = b by omega] at hc
  rw [hc,
    phiScale_row_testBit_inter_cone_gap_eq_false t k b (by omega) hb1,
    phiScale_row_testBit_inter_cone_gap_eq_false t k (b - 1) (by omega) (by omega),
    Bool.false_and, Bool.and_false]
  rfl

theorem crossCarry_row_scale_inter_cone_gap_eq_false_prop (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k) :
    wittBitBool (crossCarry (phiScale k (row t)) (winWitt t (twopow k))) b = false :=
  crossCarry_row_scale_inter_cone_gap_eq_false t k b hb0 hb1

/-- **Pure-`Φ` Forward Step of `winWitt` Across the Raw Inter-Cone Gap (`winWitt_step_inter_cone_gap_eq_phi`)**:
    for all `t, k, b : Nat` with `2 * t + 1 < b` and `b < 2^k` (including `b = 2^k - 1`, where `b + 1 = 2^k` is the exact Sector-1 boundary bit!), both `crossCarry` and `frobDefect` vanish at bit `b`, so `(winWitt (t + 1) (2^k)).testBit (b + 1) = (phi (winWitt t (2^k))).testBit (b + 1)`! -/
theorem winWitt_step_inter_cone_gap_eq_phi (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k) :
    (winWitt (t + 1) (twopow k)).testBit (b + 1) =
      (phi (winWitt t (twopow k))).testBit (b + 1) := by
  rw [winWitt_step_frobDefect_testBit_succ t k b,
    crossCarry_row_scale_inter_cone_gap_eq_false t k b hb0 hb1,
    frobDefect_row_testBit_gt_two_mul_eq_false t k b hb0 (by omega)]
  cases (phi (winWitt t (twopow k))).testBit (b + 1) <;> rfl

theorem winWitt_step_inter_cone_gap_eq_phi_prop (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k) :
    wittBitBool (winWitt (t + 1) (twopow k)) (b + 1) =
      wittBitBool (phi (winWitt t (twopow k))) (b + 1) :=
  winWitt_step_inter_cone_gap_eq_phi t k b hb0 hb1

/-- **Pure-`Φ` Sideways Inversion of `winWitt` Across the Raw Inter-Cone Gap (`winWitt_inward_step_inter_cone_gap`)**:
    for all `t, k, b : Nat` with `2 * t + 1 < b` and `b < 2^k`, `(winWitt t (2^k)).testBit (b + 1)` equals `(winWitt (t + 1) (2^k)).testBit (b + 1) ⊕ ((winWitt t (2^k)).testBit b || (winWitt t (2^k)).testBit (b - 1))`! -/
theorem winWitt_inward_step_inter_cone_gap (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k) :
    (winWitt t (twopow k)).testBit (b + 1) =
      bxor
        ((winWitt (t + 1) (twopow k)).testBit (b + 1))
        ((winWitt t (twopow k)).testBit b ||
          (winWitt t (twopow k)).testBit (b - 1)) := by
  rw [winWitt_inward_step_gt_two_mul t k b hb0 (by omega),
    crossCarry_row_scale_inter_cone_gap_eq_false t k b hb0 hb1]
  cases (winWitt (t + 1) (twopow k)).testBit (b + 1) <;>
    cases ((winWitt t (twopow k)).testBit b ||
      (winWitt t (twopow k)).testBit (b - 1)) <;> rfl

theorem winWitt_inward_step_inter_cone_gap_prop (t k b : Nat)
    (hb0 : 2 * t + 1 < b) (hb1 : b < twopow k) :
    wittBitBool (winWitt t (twopow k)) (b + 1) =
      bxor
        (wittBitBool (winWitt (t + 1) (twopow k)) (b + 1))
        (wittBitBool (winWitt t (twopow k)) b ||
          wittBitBool (winWitt t (twopow k)) (b - 1)) :=
  winWitt_inward_step_inter_cone_gap t k b hb0 hb1

/-- **Non-Overlapping Sector-1 Copy Law of `phiScale k (row t)` (`phiScale_row_testBit_sector_one_eq_row`)**:
    for all `t, k, d : Nat` with `2 * t < 2^k` and `d < 2^k`, Sector 1 of `phiScale k (row t)` is an exact bit-for-bit shifted copy of `row t`: `(phiScale k (row t)).testBit (d + 2^k) = (row t).testBit d`! -/
theorem phiScale_row_testBit_sector_one_eq_row (t k d : Nat)
    (htk : 2 * t < twopow k) (hd : d < twopow k) :
    (phiScale k (row t)).testBit (d + twopow k) = (row t).testBit d := by
  have hu : (row t).testBit (d + twopow k) = false := by
    rw [row_testBit]
    exact rdiag_gt_two_mul t (d + twopow k) (by omega)
  change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
    ((row t) <<< (twopow k + twopow k))).testBit (d + twopow k) = (row t).testBit d
  simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
  have d1 : decide (d + twopow k ≥ twopow k) = true := decide_eq_true (by omega)
  have d2 : decide (d + twopow k ≥ twopow k + twopow k) = false := decide_eq_false (by omega)
  rw [d1, d2, Bool.true_and, Bool.false_and,
    hu,
    show (d + twopow k) - twopow k = d by omega]
  cases (row t).testBit d <;> rfl

theorem phiScale_row_testBit_sector_one_eq_row_prop (t k d : Nat)
    (htk : 2 * t < twopow k) (hd : d < twopow k) :
    wittBitBool (phiScale k (row t)) (d + twopow k) =
      wittBitBool (row t) d :=
  phiScale_row_testBit_sector_one_eq_row t k d htk hd

/-- **Non-Overlapping Sector-2 Copy Law of `phiScale k (row t)` (`phiScale_row_testBit_sector_two_eq_row`)**:
    for all `t, k, d : Nat` with `2 * t < 2^k` (for ALL `d : Nat`, with no bound `d < 2^k` required!), Sector 2 of `phiScale k (row t)` is an exact bit-for-bit shifted copy of `row t`: `(phiScale k (row t)).testBit (d + 2^(k+1)) = (row t).testBit d`! -/
theorem phiScale_row_testBit_sector_two_eq_row (t k d : Nat)
    (htk : 2 * t < twopow k) :
    (phiScale k (row t)).testBit (d + twopow (k + 1)) = (row t).testBit d := by
  have hstep_k : twopow (k + 1) = twopow k + twopow k := Rule30UOR.Core.twopow_succ k
  have hu2 : (row t).testBit (d + twopow (k + 1)) = false := by
    rw [row_testBit]
    exact rdiag_gt_two_mul t (d + twopow (k + 1)) (by omega)
  have hu1 : (row t).testBit (d + twopow k) = false := by
    rw [row_testBit]
    exact rdiag_gt_two_mul t (d + twopow k) (by omega)
  change (((row t) ^^^ ((row t) <<< twopow k)) ^^^
    ((row t) <<< (twopow k + twopow k))).testBit (d + twopow (k + 1)) = (row t).testBit d
  simp only [Nat.testBit_xor, Nat.testBit_shiftLeft]
  have d1 : decide (d + twopow (k + 1) ≥ twopow k) = true := decide_eq_true (by omega)
  have d2 : decide (d + twopow (k + 1) ≥ twopow k + twopow k) = true := decide_eq_true (by omega)
  rw [d1, d2, Bool.true_and, Bool.true_and,
    hu2,
    show (d + twopow (k + 1)) - twopow k = d + twopow k by omega,
    hu1,
    show (d + twopow (k + 1)) - (twopow k + twopow k) = d by omega]
  cases (row t).testBit d <;> rfl

theorem phiScale_row_testBit_sector_two_eq_row_prop (t k d : Nat)
    (htk : 2 * t < twopow k) :
    wittBitBool (phiScale k (row t)) (d + twopow (k + 1)) =
      wittBitBool (row t) d :=
  phiScale_row_testBit_sector_two_eq_row t k d htk

/-- **Non-Overlapping Sector-1 Bit Readout of `winWitt t (2^k)` (`winWitt_testBit_sector_one_eq_row_xor`)**:
    for all `t, k, d : Nat` with `2 * t < 2^k` and `d < 2^k`, `(winWitt t (2^k)).testBit (d + 2^k) = (row (t + 2^k)).testBit (d + 2^k) ⊕ (row t).testBit d`! -/
theorem winWitt_testBit_sector_one_eq_row_xor (t k d : Nat)
    (htk : 2 * t < twopow k) (hd : d < twopow k) :
    (winWitt t (twopow k)).testBit (d + twopow k) =
      bxor ((row (t + twopow k)).testBit (d + twopow k)) ((row t).testBit d) := by
  have hsc := congrArg (fun n => n.testBit (d + twopow k)) (row_scale t k)
  rw [Nat.testBit_xor,
    phiScale_row_testBit_sector_one_eq_row t k d htk hd] at hsc
  rw [hsc]
  simp only [bxor_eq_xor]
  cases (row t).testBit d <;>
    cases (winWitt t (twopow k)).testBit (d + twopow k) <;> rfl

theorem winWitt_testBit_sector_one_eq_row_xor_prop (t k d : Nat)
    (htk : 2 * t < twopow k) (hd : d < twopow k) :
    wittBitBool (winWitt t (twopow k)) (d + twopow k) =
      bxor (wittBitBool (row (t + twopow k)) (d + twopow k))
        (wittBitBool (row t) d) :=
  winWitt_testBit_sector_one_eq_row_xor t k d htk hd

/-- **Non-Overlapping Sector-2 Bit Readout of `winWitt t (2^k)` (`winWitt_testBit_sector_two_eq_row_xor`)**:
    for all `t, k, d : Nat` with `2 * t < 2^k` (for ALL `d : Nat`), `(winWitt t (2^k)).testBit (d + 2^(k+1)) = (row (t + 2^k)).testBit (d + 2^(k+1)) ⊕ (row t).testBit d`! -/
theorem winWitt_testBit_sector_two_eq_row_xor (t k d : Nat)
    (htk : 2 * t < twopow k) :
    (winWitt t (twopow k)).testBit (d + twopow (k + 1)) =
      bxor ((row (t + twopow k)).testBit (d + twopow (k + 1))) ((row t).testBit d) := by
  have hsc := congrArg (fun n => n.testBit (d + twopow (k + 1))) (row_scale t k)
  rw [Nat.testBit_xor,
    phiScale_row_testBit_sector_two_eq_row t k d htk] at hsc
  rw [hsc]
  simp only [bxor_eq_xor]
  cases (row t).testBit d <;>
    cases (winWitt t (twopow k)).testBit (d + twopow (k + 1)) <;> rfl

theorem winWitt_testBit_sector_two_eq_row_xor_prop (t k d : Nat)
    (htk : 2 * t < twopow k) :
    wittBitBool (winWitt t (twopow k)) (d + twopow (k + 1)) =
      bxor (wittBitBool (row (t + twopow k)) (d + twopow (k + 1)))
        (wittBitBool (row t) d) :=
  winWitt_testBit_sector_two_eq_row_xor t k d htk

/-- **Early-Free Right-to-Left Cross-Sector Window Duality (`winWitt_sector_one_xor_sector_two_rhCenter_cone`)**:
    for all `t, k, p : Nat` with `t + p < 2^k`, the common early term `rhCenter t p` in `winWitt_testBit_rhCenter_same_col_cone` (`9.491`) and `winWitt_testBit_scale_cross_cone` (`9.458`) cancels identically under XOR, equating `(winWitt t (2^k)).testBit ((t + 2^k) - p) ⊕ (winWitt t (2^k)).testBit ((t + 2^(k+1)) - p)` directly to the late-only pair `rhCenter (t + 2^k) p ⊕ lhCenter (t + 2^k) (2^k - p)`! -/
theorem winWitt_sector_one_xor_sector_two_rhCenter_cone (t k p : Nat)
    (hp : t + p < twopow k) :
    bxor
      ((winWitt t (twopow k)).testBit ((t + twopow k) - p))
      ((winWitt t (twopow k)).testBit ((t + twopow (k + 1)) - p)) =
      bxor
        (rhCenter (t + twopow k) p)
        (lhCenter (t + twopow k) (twopow k - p)) := by
  rw [winWitt_testBit_rhCenter_same_col_cone t k p hp,
    winWitt_testBit_scale_cross_cone t k p hp]
  cases rhCenter (t + twopow k) p <;>
    cases lhCenter (t + twopow k) (twopow k - p) <;>
    cases rhCenter t p <;> rfl

theorem winWitt_sector_one_xor_sector_two_rhCenter_cone_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    bxor
      (wittBitBool (winWitt t (twopow k)) ((t + twopow k) - p))
      (wittBitBool (winWitt t (twopow k)) ((t + twopow (k + 1)) - p)) =
      bxor
        (rhCenter (t + twopow k) p)
        (lhCenter (t + twopow k) (twopow k - p)) :=
  winWitt_sector_one_xor_sector_two_rhCenter_cone t k p hp

/-- **Early-Free Left-to-Left Cross-Sector Window Duality (`winWitt_sector_one_xor_sector_two_lhCenter_cone`)**:
    for all `t, k, p : Nat` with `t + p < 2^k`, the common early term `lhCenter t p` in `winWitt_testBit_sector_one_lhCenter` (`9.475`) and `winWitt_testBit_outer_left_strip` (`9.434`) cancels identically under XOR, equating `(winWitt t (2^k)).testBit (t + p + 2^k) ⊕ (winWitt t (2^k)).testBit (t + p + 2^(k+1))` directly to the late-only pair `lhCenter (t + 2^k) p ⊕ lhCenter (t + 2^k) (p + 2^k)`! -/
theorem winWitt_sector_one_xor_sector_two_lhCenter_cone (t k p : Nat)
    (hp : t + p < twopow k) :
    bxor
      ((winWitt t (twopow k)).testBit (t + p + twopow k))
      ((winWitt t (twopow k)).testBit (t + p + twopow (k + 1))) =
      bxor
        (lhCenter (t + twopow k) p)
        (lhCenter (t + twopow k) (p + twopow k)) := by
  rw [winWitt_testBit_sector_one_lhCenter t k p hp,
    winWitt_testBit_outer_left_strip t k p (by omega)]
  cases lhCenter (t + twopow k) p <;>
    cases lhCenter (t + twopow k) (p + twopow k) <;>
    cases lhCenter t p <;> rfl

theorem winWitt_sector_one_xor_sector_two_lhCenter_cone_prop (t k p : Nat)
    (hp : t + p < twopow k) :
    bxor
      (wittBitBool (winWitt t (twopow k)) (t + p + twopow k))
      (wittBitBool (winWitt t (twopow k)) (t + p + twopow (k + 1))) =
      bxor
        (lhCenter (t + twopow k) p)
        (lhCenter (t + twopow k) (p + twopow k)) :=
  winWitt_sector_one_xor_sector_two_lhCenter_cone t k p hp

/-- **Early-Free `$2^k$`-Spatial Shift of Late `LhBandAgree (t + 2^k)` via Cross-Sector `WinWittAgree` (`lhBandAgree_late_shift_of_winWittAgree_sectors`)**:
    for all `t, k, Q, p0, L : Nat` with `t + Q + p0 + L < 2^k`, `LhBandAgree (t + 2^k) Q p0 L`, `WinWittAgree t k Q (t + p0 + 2^k) L`, and `WinWittAgree t k Q (t + p0 + 2^(k+1)) L` imply `LhBandAgree (t + 2^k) Q (p0 + 2^k) L` with ZERO band hypotheses at time `t`! -/
theorem lhBandAgree_late_shift_of_winWittAgree_sectors (t k Q p0 L : Nat)
    (hp : t + Q + p0 + L < twopow k)
    (hlate : LhBandAgree (t + twopow k) Q p0 L)
    (hw1 : WinWittAgree t k Q (t + p0 + twopow k) L)
    (hw2 : WinWittAgree t k Q (t + p0 + twopow (k + 1)) L) :
    LhBandAgree (t + twopow k) Q (p0 + twopow k) L := by
  have h0 := lhBandAgree_scale_inward_same_col_cone t k Q p0 L hp hlate hw1
  exact lhBandAgree_scale_step_outer_strip t k Q p0 L (by omega) h0 hw2

/-- **Early-Free Cross-Center Transfer from Late `LhBandAgree (t + 2^k)` to Late `RhBandAgree (t + 2^k)` via Cross-Sector `WinWittAgree` (`rhBandAgree_late_of_lhBandAgree_late_and_winWittAgree_sectors`)**:
    for all `t, k, Q, L : Nat` with `t + Q + L < 2^k`, `LhBandAgree (t + 2^k) Q (2^k - L) L`, `WinWittAgree t k Q ((t + 2^k) - L) L`, and `WinWittAgree t k Q ((t + 2^(k+1)) - L) L` imply `RhBandAgree (t + 2^k) Q 0 L` with ZERO band hypotheses at time `t`! -/
theorem rhBandAgree_late_of_lhBandAgree_late_and_winWittAgree_sectors (t k Q L : Nat)
    (hp : t + Q + L < twopow k)
    (hlate : LhBandAgree (t + twopow k) Q (twopow k - L) L)
    (hw1 : WinWittAgree t k Q ((t + twopow k) - L) L)
    (hw2 : WinWittAgree t k Q ((t + twopow (k + 1)) - L) L) :
    RhBandAgree (t + twopow k) Q 0 L := by
  have h0 := rhBandAgree_of_lhBandAgree_and_winWittAgree_cross_cone t k Q L hp hlate hw2
  have hw1_0 : WinWittAgree t k Q ((t + twopow k) - (0 + L)) L := by
    rwa [Nat.zero_add]
  exact rhBandAgree_scale_same_col_cone t k Q 0 L (by omega) h0 hw1_0

/-- **Exact Sector-1 Boundary Bit Readout `(winWitt t (2^k)).testBit (2^k) = !rhCenter (t + 2^k) t` (`winWitt_testBit_twopow_eq_not_rhCenter_late`)**:
    for all `t, k : Nat` with `2 * t < 2^k`, evaluating `winWitt_testBit_rhCenter_same_col_cone` at the right light-cone boundary `p = t` (`(t + 2^k) - t = 2^k`, `rhCenter t t = true`) proves that bit `2^k` of `winWitt t (2^k)` is the exact negation of `rhCenter (t + 2^k) t`! -/
theorem winWitt_testBit_twopow_eq_not_rhCenter_late (t k : Nat)
    (htk : 2 * t < twopow k) :
    (winWitt t (twopow k)).testBit (twopow k) =
      !rhCenter (t + twopow k) t := by
  have hw := winWitt_testBit_rhCenter_same_col_cone t k t (by omega)
  rw [show (t + twopow k) - t = twopow k by omega,
    rhCenter_self_eq_true t] at hw
  rw [hw]
  cases rhCenter (t + twopow k) t <;> rfl

theorem winWitt_testBit_twopow_eq_not_rhCenter_late_prop (t k : Nat)
    (htk : 2 * t < twopow k) :
    wittBitBool (winWitt t (twopow k)) (twopow k) =
      !rhCenter (t + twopow k) t :=
  winWitt_testBit_twopow_eq_not_rhCenter_late t k htk

/-- **Pure-`Φ` Recurrence of Late `rhCenter (t + 2^k) t` Along the Sector-1 Boundary (`rhCenter_late_self_from_zero_gap_step`)**:
    for all `t, k : Nat` with `2 * t + 2 < 2^k`, combining `winWitt_inward_step_zero_gap` at `p = t` (`9.522`), `winWitt_testBit_twopow_eq_not_rhCenter_late` (`9.545`), and `winWitt_testBit_zero_gap_eq_rhCenter_late` (`9.492`) at `p = t + 1, t + 2` expresses `rhCenter (t + 2^k) t` directly from `rhCenter ((t + 1) + 2^k) (t + 1)` and `rhCenter (t + 2^k) (t + 1) || rhCenter (t + 2^k) (t + 2)`! -/
theorem rhCenter_late_self_from_zero_gap_step (t k : Nat)
    (htk : 2 * t + 2 < twopow k) :
    rhCenter (t + twopow k) t =
      bxor
        (rhCenter ((t + 1) + twopow k) (t + 1))
        (rhCenter (t + twopow k) (t + 1) ||
          rhCenter (t + twopow k) (t + 2)) := by
  have hs := winWitt_inward_step_zero_gap t k t (Nat.le_refl t) (by omega)
  have hw0 := winWitt_testBit_twopow_eq_not_rhCenter_late t k (by omega)
  have hw1 := winWitt_testBit_twopow_eq_not_rhCenter_late (t + 1) k (by omega)
  have hg1 := winWitt_testBit_zero_gap_eq_rhCenter_late t k (t + 1) (by omega) (by omega)
  have hg2 := winWitt_testBit_zero_gap_eq_rhCenter_late t k (t + 2) (by omega) (by omega)
  rw [show (t + twopow k) - t = twopow k by omega,
    show ((t + 1) + twopow k) - (t + 1) = twopow k by omega] at hs
  rw [hw0, hw1, hg1, hg2] at hs
  revert hs
  simp only [bxor_eq_xor]
  cases rhCenter (t + twopow k) t <;>
    cases rhCenter ((t + 1) + twopow k) (t + 1) <;>
    cases (rhCenter (t + twopow k) (t + 1) || rhCenter (t + twopow k) (t + 2)) <;> decide

/-! ### Batch 17: Scale-Independent Left-Diagonal Coordinates at `t + 2^k`, Zero-State Center Cross-Sector Readout, and Zero-Diagonal Window Mirrors -/

/-- **Scale-Independent Left-Diagonal Coordinate of `lhCenter (t + 2^k) (p + 2^k)` (`lhCenter_late_shift_eq_ldiag`)**:
    for all `t, k, p : Nat` with `p ≤ t`, the late shifted left-half cell `lhCenter (t + 2^k) (p + 2^k)` lies on left diagonal `t - p` (independent of `k`!): `lhCenter (t + 2^k) (p + 2^k) = ldiag (t - p) (t + 2^k)`! -/
theorem lhCenter_late_shift_eq_ldiag (t k p : Nat) (hp : p ≤ t) :
    lhCenter (t + twopow k) (p + twopow k) =
      ldiag (t - p) (t + twopow k) := by
  rw [lhCenter_eq_ldiag (t + twopow k) (p + twopow k) (by omega),
    show (t + twopow k) - (p + twopow k) = t - p by omega]

/-- **Scale-Independent Left-Diagonal Coordinate of `lhCenter (t + 2^k) (2^k - r)` (`lhCenter_late_cross_eq_ldiag`)**:
    for all `t, k, r : Nat` with `r ≤ 2^k`, the late cross-center cell `lhCenter (t + 2^k) (2^k - r)` lies on left diagonal `t + r` (independent of `k`!): `lhCenter (t + 2^k) (2^k - r) = ldiag (t + r) (t + 2^k)`! -/
theorem lhCenter_late_cross_eq_ldiag (t k r : Nat) (hr : r ≤ twopow k) :
    lhCenter (t + twopow k) (twopow k - r) =
      ldiag (t + r) (t + twopow k) := by
  rw [lhCenter_eq_ldiag (t + twopow k) (twopow k - r) (by omega),
    show (t + twopow k) - (twopow k - r) = t + r by omega]

/-- **Direct Settled Readout of `zcenter t` at `lhCenter (t + 2^k) (2^k)` (`lhCenter_late_twopow_eq_zcenter`)**:
    for all `t, k : Nat` with `t ≤ k` and `settle t ≤ t + 2^k` (`SettledAt t k`), the late cell `lhCenter (t + 2^k) (2^k)` equals the zero-state center `zcenter t`! -/
theorem lhCenter_late_twopow_eq_zcenter (t k : Nat)
    (hk : t ≤ k) (hset : settle t ≤ t + twopow k) :
    lhCenter (t + twopow k) (twopow k) = zcenter t := by
  have h0 := lhCenter_late_shift_eq_ldiag t k 0 (Nat.zero_le t)
  rw [Nat.zero_add, Nat.sub_zero] at h0
  rw [h0, ldiag_settled_eq_zcenter t k hk hset]

theorem lhCenter_late_twopow_eq_zcenter_prop (t k : Nat)
    (hk : t ≤ k) (hset : SettledAt t k) :
    ZCenterEq t (lhCenter (t + twopow k) (twopow k)) :=
  (lhCenter_late_twopow_eq_zcenter t k hk hset).symm

/-- **Settled Sector-2 Center-Slot Window Readout of `zcenter t` (`winWitt_testBit_sector_two_center_slot_zcenter`)**:
    for all `t, k : Nat` with `t ≤ k` and `settle t ≤ t + 2^k` (`SettledAt t k`), `zcenter t = (winWitt t (2^k)).testBit (t + 2^(k+1)) ⊕ center t`! -/
theorem winWitt_testBit_sector_two_center_slot_zcenter (t k : Nat)
    (hk : t ≤ k) (hset : settle t ≤ t + twopow k) :
    zcenter t =
      bxor
        ((winWitt t (twopow k)).testBit (t + twopow (k + 1)))
        (Rule30UOR.Core.center t) := by
  have htk : t < twopow k := Nat.lt_of_le_of_lt hk (twopow_gt_self k)
  have hw := winWitt_testBit_outer_left_strip t k 0 (by omega)
  rw [Nat.add_zero, Nat.zero_add,
    lhCenter_late_twopow_eq_zcenter t k hk hset,
    lhCenter_zero_eq_center t] at hw
  rw [hw]
  cases zcenter t <;> cases Rule30UOR.Core.center t <;> rfl

theorem winWitt_testBit_sector_two_center_slot_zcenter_prop (t k : Nat)
    (hk : t ≤ k) (hset : SettledAt t k) :
    ZCenterEq t
      (bxor
        (wittBitBool (winWitt t (twopow k)) (t + twopow (k + 1)))
        (Rule30UOR.Core.center t)) :=
  winWitt_testBit_sector_two_center_slot_zcenter t k hk hset

/-- **Early-Free Cross-Sector Window Readout of `zcenter t` (`winWitt_sector_one_xor_sector_two_center_slot_zcenter`)**:
    for all `t, k : Nat` with `t ≤ k` and `settle t ≤ t + 2^k` (`SettledAt t k`), evaluating `winWitt_sector_one_xor_sector_two_lhCenter_cone` at `p = 0` expresses `zcenter t` purely in terms of the late center `center (t + 2^k)` and the Sector-1 and Sector-2 center-slot bits of `winWitt t (2^k)`! -/
theorem winWitt_sector_one_xor_sector_two_center_slot_zcenter (t k : Nat)
    (hk : t ≤ k) (hset : settle t ≤ t + twopow k) :
    zcenter t =
      bxor
        (Rule30UOR.Core.center (t + twopow k))
        (bxor
          ((winWitt t (twopow k)).testBit (t + twopow k))
          ((winWitt t (twopow k)).testBit (t + twopow (k + 1)))) := by
  have htk : t < twopow k := Nat.lt_of_le_of_lt hk (twopow_gt_self k)
  have hd := winWitt_sector_one_xor_sector_two_lhCenter_cone t k 0 (by omega)
  rw [Nat.add_zero, Nat.zero_add,
    lhCenter_zero_eq_center (t + twopow k),
    lhCenter_late_twopow_eq_zcenter t k hk hset] at hd
  revert hd
  simp only [bxor_eq_xor]
  cases zcenter t <;>
    cases Rule30UOR.Core.center (t + twopow k) <;>
    cases ((winWitt t (twopow k)).testBit (t + twopow k) ^^
      (winWitt t (twopow k)).testBit (t + twopow (k + 1))) <;> decide

theorem winWitt_sector_one_xor_sector_two_center_slot_zcenter_prop (t k : Nat)
    (hk : t ≤ k) (hset : SettledAt t k) :
    ZCenterEq t
      (bxor
        (Rule30UOR.Core.center (t + twopow k))
        (bxor
          (wittBitBool (winWitt t (twopow k)) (t + twopow k))
          (wittBitBool (winWitt t (twopow k)) (t + twopow (k + 1))))) :=
  winWitt_sector_one_xor_sector_two_center_slot_zcenter t k hk hset

/-- **Exact Late Left-Half Vanishing Along Any Zero Diagonal (`lhCenter_late_shift_of_zero_diag`)**:
    for all `t, k, p : Nat` with `p ≤ t`, `t - p ≤ k`, `IsZeroDiag (t - p)`, and `settle (t - p) ≤ t + 2^k` (`SettledBy (t - p) (t + 2^k)`), the late shifted cell `lhCenter (t + 2^k) (p + 2^k)` vanishes identically! -/
theorem lhCenter_late_shift_of_zero_diag (t k p : Nat)
    (hp : p ≤ t) (hk : t - p ≤ k)
    (hz : IsZeroDiag (t - p))
    (hset : settle (t - p) ≤ t + twopow k) :
    lhCenter (t + twopow k) (p + twopow k) = false := by
  rw [lhCenter_late_shift_eq_ldiag t k p hp,
    ldiag_settled_eq_E (t - p) t k hk hset,
    hz t]

theorem lhCenter_late_shift_of_zero_diag_prop (t k p : Nat)
    (hp : p ≤ t) (hk : t - p ≤ k)
    (hz : IsZeroDiag (t - p))
    (hset : SettledBy (t - p) (t + twopow k)) :
    lhCenter (t + twopow k) (p + twopow k) = false :=
  lhCenter_late_shift_of_zero_diag t k p hp hk hz hset

/-- **Exact Late Cross-Center Vanishing Along Any Zero Diagonal (`lhCenter_late_cross_of_zero_diag`)**:
    for all `t, k, r : Nat` with `t + r ≤ k`, `IsZeroDiag (t + r)`, and `settle (t + r) ≤ t + 2^k` (`SettledBy (t + r) (t + 2^k)`), the late cross-center cell `lhCenter (t + 2^k) (2^k - r)` vanishes identically! -/
theorem lhCenter_late_cross_of_zero_diag (t k r : Nat)
    (hk : t + r ≤ k)
    (hz : IsZeroDiag (t + r))
    (hset : settle (t + r) ≤ t + twopow k) :
    lhCenter (t + twopow k) (twopow k - r) = false := by
  have hrk : r ≤ twopow k := by
    have := twopow_gt_self k
    omega
  rw [lhCenter_late_cross_eq_ldiag t k r hrk,
    ldiag_settled_eq_E (t + r) t k hk hset,
    hz t]

theorem lhCenter_late_cross_of_zero_diag_prop (t k r : Nat)
    (hk : t + r ≤ k)
    (hz : IsZeroDiag (t + r))
    (hset : SettledBy (t + r) (t + twopow k)) :
    lhCenter (t + twopow k) (twopow k - r) = false :=
  lhCenter_late_cross_of_zero_diag t k r hk hz hset

/-- **Direct Readout of Early `lhCenter t p` from Sector-2 `winWitt` Along a Zero Diagonal (`winWitt_testBit_outer_left_strip_of_zero_diag`)**:
    for all `t, k, p : Nat` with `p ≤ t`, `t - p ≤ k`, `IsZeroDiag (t - p)`, and `settle (t - p) ≤ t + 2^k`, because `lhCenter (t + 2^k) (p + 2^k) = false`, the Sector-2 window bit `(winWitt t (2^k)).testBit (t + p + 2^(k+1))` equals `lhCenter t p` directly (even before diagonal `t - p` has settled at time `t`!)! -/
theorem winWitt_testBit_outer_left_strip_of_zero_diag (t k p : Nat)
    (hp : p ≤ t) (hk : t - p ≤ k)
    (hz : IsZeroDiag (t - p))
    (hset : settle (t - p) ≤ t + twopow k) :
    (winWitt t (twopow k)).testBit (t + p + twopow (k + 1)) =
      lhCenter t p := by
  have hlt : t < p + twopow k := by
    have := twopow_gt_self k
    omega
  rw [winWitt_testBit_outer_left_strip t k p hlt,
