private theorem not_isZeroDiag_zero (hz : IsZeroDiag 0) : False := by
  have h0 := hz 0
  rw [Rule30UOR.ZeroDiagonals.E_zero'] at h0
  exact absurd h0 (by decide)

private theorem add_five_le_twopow : ∀ k : Nat, 3 ≤ k → k + 5 ≤ twopow k
  | 0, h => by omega
  | 1, h => by omega
  | 2, h => by omega
  | 3, _ => by decide
  | k + 4, _ => by
    have ih := add_five_le_twopow (k + 3) (by omega)
    have hstep : twopow (k + 4) = twopow (k + 3) + twopow (k + 3) :=
      Rule30UOR.Core.twopow_succ (k + 3)
    omega

private theorem gt_twopow_of_zero_diag_le (z k : Nat)
    (hk : z + 2 ≤ k) (hz : IsZeroDiag z) :
