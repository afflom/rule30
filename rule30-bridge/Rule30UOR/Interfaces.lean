      rhCenter (t + r) (r + c) = false →
      rhCenter ((t + Q) + r) (r + (c + 1)) = rhCenter (t + r) (r + (c + 1)))
    (hw : rhCenter (t + u) (u + c) = false) :
    rhCenter ((t + Q) + u) (u + (c + 1)) = rhCenter (t + u) (u + (c + 1)) := by
  have hpos : 0 < twopow k := by
