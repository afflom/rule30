    (hw : ∀ j : Nat, j < d → Rule30UOR.Core.center (td + j) = false) :
    rdrv td 0 (u + d) u = Rule30UOR.Core.center (td + d) := by
  have h1 : u + d = d + u := by omega
  rw [h1, rdrv_white_seed_shift_of_white_drive_prefix td d u u hw,
