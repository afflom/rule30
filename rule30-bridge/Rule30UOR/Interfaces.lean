theorem lhCenter_step_three_pin_plus_one_true_of_doubles_three_and_lhBandAgree_prop (t p p0 L : Nat)
    (hz : IsZeroDiag (t - (p + 1))) (hd : DoublesAt 3 (t - (p + 1)))
    (hset0 : SettledBy (t - (p + 1)) t)
    (hset1 : SettledBy ((t - (p + 1)) + 1) t)
