      (rdrv (twopow k - m * P) (twopow k) u (1 + K) ||
        rdrv (twopow k - m * P) (twopow k) u ((1 + K) + 1)) =
      (rdrv (twopow k - m * P) (twopow k - m * P) u (1 + K) ||
