/-- **Column-`1` Agreement at Step `1 + c` from Agreement at Dyadic Column `1 + v * 2^((k + 1) + c)` (`rdrv_col_one_agree_of_subdiag_twopow_agree`, 9.1307, `kit [33]`)**:
    for all `td, tx2, tx, k, c, v ∈ ℕ` with `tx2 - 1 ≤ k` and `tx - 1 ≤ k`, if `rdrv td tx2` and `rdrv td tx` agree at `((1 + v * 2^((k + 1) + c)) + c, 1 + v * 2^((k + 1) + c))`, then `rdrv td tx2 (1 + c) 1 = rdrv td tx (1 + c) 1`! -/
theorem rdrv_col_one_agree_of_subdiag_twopow_agree (td tx2 tx k c v : Nat)
    (htc2 : tx2 - 1 ≤ k) (htc1 : tx - 1 ≤ k)
    (h : rdrv td tx2 ((1 + v * twopow ((k + 1) + c)) + c) (1 + v * twopow ((k + 1) + c)) =
         rdrv td tx ((1 + v * twopow ((k + 1) + c)) + c) (1 + v * twopow ((k + 1) + c))) :
    rdrv td tx2 (1 + c) 1 = rdrv td tx (1 + c) 1 := by
  rw [rdrv_col_one_eq_subdiag_at_twopow_all td tx2 k c v htc2,
      rdrv_col_one_eq_subdiag_at_twopow_all td tx k c v htc1, h]

/-- **All-Column Agreement on Sub-Diagonal `c` from a Single `2^((k + 1) + c)` Fundamental Period (`rdrv_subdiag_agree_all_of_lt_twopow_all`, 9.1308, `kit [33]`)**:
    for all `td, tx, Q, k, c, u ∈ ℕ` with `(tx + Q) - 1 ≤ k`, if `rdrv td (tx + Q) (r + c) r = rdrv td tx (r + c) r` for all `r < 2^((k + 1) + c)`, then `rdrv td (tx + Q) (u + c) u = rdrv td tx (u + c) u` for ALL `u ∈ ℕ`! -/
theorem rdrv_subdiag_agree_all_of_lt_twopow_all (td tx Q k c u : Nat)
    (htc : (tx + Q) - 1 ≤ k)
    (h : ∀ r : Nat, r < twopow ((k + 1) + c) →
      rdrv td (tx + Q) (r + c) r = rdrv td tx (r + c) r) :
    rdrv td (tx + Q) (u + c) u = rdrv td tx (u + c) u := by
  have hpos : 0 < twopow ((k + 1) + c) := by
    rw [twopow_eq_pow ((k + 1) + c)]
    exact Nat.two_pow_pos ((k + 1) + c)
  have hr : u % twopow ((k + 1) + c) < twopow ((k + 1) + c) := Nat.mod_lt u hpos
  have heq : u % twopow ((k + 1) + c) + (u / twopow ((k + 1) + c)) * twopow ((k + 1) + c) = u := by
    have hdiv := Nat.div_add_mod u (twopow ((k + 1) + c))
    rw [Nat.mul_comm] at hdiv
    omega
  rw [← heq,
      rdrv_subdiag_period_twopow_all_mul td (tx + Q) k c
        (u % twopow ((k + 1) + c)) (u / twopow ((k + 1) + c)) htc,
      rdrv_subdiag_period_twopow_all_mul td tx k c
        (u % twopow ((k + 1) + c)) (u / twopow ((k + 1) + c)) (by omega)]
  exact h (u % twopow ((k + 1) + c)) hr

/-- **Right-Threshold Multi-Period `v * 2^((k + 1) + c)`-Invariance in `u` of Sub-Diagonal `c` (`rdrv_subdiag_period_twopow_all_mul_of_threshold`, 9.1309, `kit [33]`)**:
    for all `td, tx, k, J, c, u, v ∈ ℕ` with `IsRightThreshold k J` and `tx - 1 ≤ J`, `rdrv td tx ((u + v * 2^((k + 1) + c)) + c) (u + v * 2^((k + 1) + c)) = rdrv td tx (u + c) u`! -/
theorem rdrv_subdiag_period_twopow_all_mul_of_threshold (td tx k J c u v : Nat)
    (hJ : IsRightThreshold k J) (htc : tx - 1 ≤ J) :
    rdrv td tx ((u + v * twopow ((k + 1) + c)) + c) (u + v * twopow ((k + 1) + c)) =
      rdrv td tx (u + c) u := by
  induction v with
  | zero =>
    simp only [Nat.zero_mul, Nat.add_zero]
  | succ v ih =>
    have hmul : u + (v + 1) * twopow ((k + 1) + c) =
        (u + v * twopow ((k + 1) + c)) + twopow ((k + 1) + c) := by
      rw [Nat.add_mul, Nat.one_mul]
      omega
    rw [hmul,
        rdrv_subdiag_period_twopow_all_of_threshold td tx k J c
          (u + v * twopow ((k + 1) + c)) hJ htc,
        ih]

/-- **Right-Threshold All-Column Agreement on Sub-Diagonal `c` from a Single `2^((k + 1) + c)` Fundamental Period (`rdrv_subdiag_agree_all_of_threshold`, 9.1310, `kit [33]`)**:
    for all `td, tx, Q, k, J, c, u ∈ ℕ` with `IsRightThreshold k J` and `(tx + Q) - 1 ≤ J`, if `rdrv td (tx + Q) (r + c) r = rdrv td tx (r + c) r` for all `r < 2^((k + 1) + c)`, then `rdrv td (tx + Q) (u + c) u = rdrv td tx (u + c) u` for ALL `u ∈ ℕ`! -/
theorem rdrv_subdiag_agree_all_of_threshold (td tx Q k J c u : Nat)
    (hJ : IsRightThreshold k J) (htc : (tx + Q) - 1 ≤ J)
    (h : ∀ r : Nat, r < twopow ((k + 1) + c) →
      rdrv td (tx + Q) (r + c) r = rdrv td tx (r + c) r) :
    rdrv td (tx + Q) (u + c) u = rdrv td tx (u + c) u := by
  have hpos : 0 < twopow ((k + 1) + c) := by
    rw [twopow_eq_pow ((k + 1) + c)]
    exact Nat.two_pow_pos ((k + 1) + c)
  have hr : u % twopow ((k + 1) + c) < twopow ((k + 1) + c) := Nat.mod_lt u hpos
  have heq : u % twopow ((k + 1) + c) + (u / twopow ((k + 1) + c)) * twopow ((k + 1) + c) = u := by
    have hdiv := Nat.div_add_mod u (twopow ((k + 1) + c))
    rw [Nat.mul_comm] at hdiv
    omega
  rw [← heq,
      rdrv_subdiag_period_twopow_all_mul_of_threshold td (tx + Q) k J c
        (u % twopow ((k + 1) + c)) (u / twopow ((k + 1) + c)) hJ htc,
      rdrv_subdiag_period_twopow_all_mul_of_threshold td tx k J c
        (u % twopow ((k + 1) + c)) (u / twopow ((k + 1) + c)) hJ (by omega)]
  exact h (u % twopow ((k + 1) + c)) hr

/-- **Derivation of `maskparity · 0` Agreement at `t + (1 + c)` from Dyadic Sub-Diagonal Column `1 + v * 2^((k + 1) + c)` Agreement (`periodic_maskparity_zero_agree_of_subdiag_twopow_agree`, 9.1311, `kit [33]`)**:
    under `CenterPeriodic T P` (`0 < P`), for all `m, t, k, c, v ∈ ℕ` with `T ≤ t` and `(t + m * P) - 1 ≤ k`, if `rdrv t (t + m * P)` and `rdrv t t` agree at `((1 + v * 2^((k + 1) + c)) + c, 1 + v * 2^((k + 1) + c))`, then `maskparity ((t + (1 + c)) + m * P) 0 = maskparity (t + (1 + c)) 0`! -/
theorem periodic_maskparity_zero_agree_of_subdiag_twopow_agree
    (T P : Nat) (hP : 0 < P) (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t k c v : Nat) (ht : T ≤ t) (htc : (t + m * P) - 1 ≤ k)
    (h : rdrv t (t + m * P) ((1 + v * twopow ((k + 1) + c)) + c) (1 + v * twopow ((k + 1) + c)) =
         rdrv t t ((1 + v * twopow ((k + 1) + c)) + c) (1 + v * twopow ((k + 1) + c))) :
    Rule30UOR.Scale.maskparity ((t + (1 + c)) + m * P) 0 =
      Rule30UOR.Scale.maskparity (t + (1 + c)) 0 := by
  refine periodic_maskparity_zero_agree_of_rdrv_one_agree T P hP hper m t (1 + c) ht (fun _ => ?_)
  exact rdrv_col_one_agree_of_subdiag_twopow_agree t (t + m * P) t k c v htc (by omega) h

/-! ### Batch 68: Dyadic Quadrant Replication (`rdrv td tx (v * 2^((k + 1) + C) + j) (v * 2^((k + 1) + C) + q) = rdrv td tx j q`), Spatio-Temporal Self-Similarity of `rhCenter`, and Shifted-Slice `RhBandAgree` Lifting (`kit [33]`, 9.1312–9.1326) -/

/-- **Additive-to-Multiplicative Law for `twopow` (`twopow_add_eq_mul`, 9.1312)**:
    for all `a, b ∈ ℕ`, `twopow (a + b) = twopow b * twopow a`. -/
theorem twopow_add_eq_mul (a b : Nat) :
    twopow (a + b) = twopow b * twopow a := by
  induction b with
  | zero =>
    rw [Nat.add_zero]
    change twopow a = 1 * twopow a
    omega
  | succ b ih =>
    rw [show a + (b + 1) = (a + b) + 1 by omega,
        twopow_succ (a + b),
        twopow_succ b,
        ih,
        ← Nat.add_mul]

/-- **Sub-Diagonal Scale Factorization for `v * 2^((k + 1) + C)` (`twopow_subdiag_scale_split`, 9.1313, `kit [33]`)**:
    for all `k, c, C, v ∈ ℕ` with `c ≤ C`, `v * 2^((k + 1) + C) = (v * 2^(C - c)) * 2^((k + 1) + c)`. -/
theorem twopow_subdiag_scale_split (k c C v : Nat) (hc : c ≤ C) :
    v * twopow ((k + 1) + C) =
      (v * twopow (C - c)) * twopow ((k + 1) + c) := by
  rw [show (k + 1) + C = ((k + 1) + c) + (C - c) by omega,
      twopow_add_eq_mul ((k + 1) + c) (C - c),
      Nat.mul_assoc]

/-- **Dyadic Quadrant Replication Theorem for `rdrv` (`rdrv_dyadic_quadrant_eq`, 9.1314, `kit [33]`)**:
    for all `td, tx, k, C, v, j, q ∈ ℕ` with `tx - 1 ≤ k` and `j ≤ q + C` (and NO hypothesis on the center drive `td`!), `rdrv td tx (v * 2^((k + 1) + C) + j) (v * 2^((k + 1) + C) + q) = rdrv td tx j q`! -/
theorem rdrv_dyadic_quadrant_eq (td tx k C v j q : Nat)
    (htc : tx - 1 ≤ k) (hjq : j ≤ q + C) :
    rdrv td tx (v * twopow ((k + 1) + C) + j) (v * twopow ((k + 1) + C) + q) =
      rdrv td tx j q := by
  by_cases hqj : q ≤ j
  · have hc : j - q ≤ C := by omega
    have hj : j = q + (j - q) := by omega
    have hU := twopow_subdiag_scale_split k (j - q) C v hc
    have h1 : v * twopow ((k + 1) + C) + j =
        (q + (v * twopow (C - (j - q))) * twopow ((k + 1) + (j - q))) + (j - q) := by
      rw [hU]
      omega
    have h2 : v * twopow ((k + 1) + C) + q =
        q + (v * twopow (C - (j - q))) * twopow ((k + 1) + (j - q)) := by
      rw [hU]
      omega
    rw [h1, h2,
        rdrv_subdiag_period_twopow_all_mul td tx k (j - q) q (v * twopow (C - (j - q))) htc,
        ← hj]
  · have hlt : j < q := by omega
    rw [rdrv_outside_cone_eq_rhCenter td tx (v * twopow ((k + 1) + C) + j)
          (v * twopow ((k + 1) + C) + q) (by omega),
        rdrv_outside_cone_eq_rhCenter td tx j q hlt]
    have hUk : v * twopow ((k + 1) + C) = (v * twopow (C + 1)) * twopow k := by
      rw [show (k + 1) + C = k + (C + 1) by omega,
          twopow_add_eq_mul k (C + 1),
          Nat.mul_assoc]
    have ht1 : tx + (v * twopow ((k + 1) + C) + j) =
        tx + (j + (v * twopow (C + 1)) * twopow k) := by
      rw [hUk]
      omega
    have ht2 : v * twopow ((k + 1) + C) + q =
        (j + (v * twopow (C + 1)) * twopow k) + (q - j) := by
      rw [hUk]
      omega
    have ht3 : q = j + (q - j) := by omega
    rw [ht1, ht2,
        rhCenter_superdiag_period_twopow tx (q - j) k j (v * twopow (C + 1)) (by omega),
        ← ht3]

/-- **Right-Threshold Dyadic Quadrant Replication Theorem for `rdrv` (`rdrv_dyadic_quadrant_eq_of_threshold`, 9.1315, `kit [33]`)**:
    for all `td, tx, k, J, C, v, j, q ∈ ℕ` with `IsRightThreshold k J`, `tx - 1 ≤ J`, and `j ≤ q + C`, `rdrv td tx (v * 2^((k + 1) + C) + j) (v * 2^((k + 1) + C) + q) = rdrv td tx j q`! -/
theorem rdrv_dyadic_quadrant_eq_of_threshold (td tx k J C v j q : Nat)
    (hJ : IsRightThreshold k J) (htc : tx - 1 ≤ J) (hjq : j ≤ q + C) :
    rdrv td tx (v * twopow ((k + 1) + C) + j) (v * twopow ((k + 1) + C) + q) =
      rdrv td tx j q := by
  by_cases hqj : q ≤ j
  · have hc : j - q ≤ C := by omega
    have hj : j = q + (j - q) := by omega
    have hU := twopow_subdiag_scale_split k (j - q) C v hc
    have h1 : v * twopow ((k + 1) + C) + j =
        (q + (v * twopow (C - (j - q))) * twopow ((k + 1) + (j - q))) + (j - q) := by
      rw [hU]
      omega
    have h2 : v * twopow ((k + 1) + C) + q =
        q + (v * twopow (C - (j - q))) * twopow ((k + 1) + (j - q)) := by
      rw [hU]
      omega
    rw [h1, h2,
        rdrv_subdiag_period_twopow_all_mul_of_threshold td tx k J (j - q) q
          (v * twopow (C - (j - q))) hJ htc,
        ← hj]
  · have hlt : j < q := by omega
    rw [rdrv_outside_cone_eq_rhCenter td tx (v * twopow ((k + 1) + C) + j)
          (v * twopow ((k + 1) + C) + q) (by omega),
        rdrv_outside_cone_eq_rhCenter td tx j q hlt]
    have hUk : v * twopow ((k + 1) + C) = (v * twopow (C + 1)) * twopow k := by
      rw [show (k + 1) + C = k + (C + 1) by omega,
          twopow_add_eq_mul k (C + 1),
          Nat.mul_assoc]
    have ht1 : tx + (v * twopow ((k + 1) + C) + j) =
        tx + (j + (v * twopow (C + 1)) * twopow k) := by
      rw [hUk]
      omega
    have ht2 : v * twopow ((k + 1) + C) + q =
        (j + (v * twopow (C + 1)) * twopow k) + (q - j) := by
      rw [hUk]
      omega
    have ht3 : q = j + (q - j) := by omega
    rw [ht1, ht2,
        rhCenter_superdiag_period_twopow_of_threshold tx (q - j) k J j (v * twopow (C + 1)) hJ (by omega),
        ← ht3]

/-- **Dyadic `C`-Step Slab Replication for `rdrv` (`rdrv_dyadic_slab_eq`, 9.1316, `kit [33]`)**:
    for all `td, tx, k, C, v, j, q ∈ ℕ` with `tx - 1 ≤ k` and `j ≤ C`, `rdrv td tx (v * 2^((k + 1) + C) + j) (v * 2^((k + 1) + C) + q) = rdrv td tx j q` for ALL columns `q ∈ ℕ`! -/
theorem rdrv_dyadic_slab_eq (td tx k C v j q : Nat)
    (htc : tx - 1 ≤ k) (hj : j ≤ C) :
    rdrv td tx (v * twopow ((k + 1) + C) + j) (v * twopow ((k + 1) + C) + q) =
      rdrv td tx j q :=
  rdrv_dyadic_quadrant_eq td tx k C v j q htc (by omega)

/-- **Dyadic Horizontal Row Replication at Step `v * 2^(k + 1)` in `rdrv` (`rdrv_dyadic_row_eq_init`, 9.1317, `kit [33]`)**:
    for all `td, tx, k, v, q ∈ ℕ` with `tx - 1 ≤ k`, `rdrv td tx (v * 2^(k + 1)) (v * 2^(k + 1) + q) = rdrv td tx 0 q` for ALL `q ∈ ℕ`! -/
theorem rdrv_dyadic_row_eq_init (td tx k v q : Nat) (htc : tx - 1 ≤ k) :
    rdrv td tx (v * twopow (k + 1)) (v * twopow (k + 1) + q) =
      rdrv td tx 0 q := by
  have h := rdrv_dyadic_slab_eq td tx k 0 v 0 q htc (by omega)
  rwa [Nat.add_zero, Nat.add_zero] at h

/-- **Spatio-Temporal Dyadic Quadrant Self-Similarity of `rhCenter` (`rhCenter_dyadic_quadrant_eq`, 9.1318, `kit [33]`)**:
    for all `t, k, C, v, j, q ∈ ℕ` with `t - 1 ≤ k` and `j ≤ q + C`, `rhCenter (t + (v * 2^((k + 1) + C) + j)) (v * 2^((k + 1) + C) + q) = rhCenter (t + j) q`! -/
theorem rhCenter_dyadic_quadrant_eq (t k C v j q : Nat)
    (htc : t - 1 ≤ k) (hjq : j ≤ q + C) :
    rhCenter (t + (v * twopow ((k + 1) + C) + j)) (v * twopow ((k + 1) + C) + q) =
      rhCenter (t + j) q := by
