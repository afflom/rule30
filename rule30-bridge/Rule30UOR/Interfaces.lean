  have hsetQ : settle d ≤ t + Q := by omega
  rw [Rule30UOR.Kit.ldiag_eq_D, Rule30UOR.Kit.ldiag_eq_D,
    ← Rule30UOR.Intent.E_eq_D d (t + Q) hsetQ,
    ← Rule30UOR.Intent.E_eq_D d t hset]
