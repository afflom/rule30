theorem not_centerPeriodic_of_rdrv_one_agree_sub_twopow_ge
    (T P m k S : Nat) (hP : 0 < P) (hm : 0 < m)
    (hmP : m * P ≤ twopow k) (ht : T + m * P ≤ twopow k)
    (hS : twopow k ≤ S + 1)
    (hw : ∀ s : Nat, s ≤ S →
      Rule30UOR.Core.center ((twopow k - m * P) + s) = false →
        rdrv (twopow k - m * P) (twopow k) s 1 =
