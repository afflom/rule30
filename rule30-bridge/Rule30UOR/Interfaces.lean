      !(bxor (rhCenter t (r + 1)) (rhCenter (t + 1) (r + 2))) := by
  have h7 := gt_twopow_of_zero_diag_le (t + r) k hk hz
  have h1 := winWitt_testBit_scale_cross_cone t k (r + 1) (by omega)
