        show a + (k + 1) = (a + k) + 1 by omega,
        hs1, hs0,
        show ((a + H) + k) + 1 = (a + H) + (k + 1) by omega,
        show ((a + H) + k) + 2 = (a + H) + (k + 2) by omega,
        show (a + k) + 1 = a + (k + 1) by omega,
        show (a + k) + 2 = a + (k + 2) by omega,
