theorem periodic_lhCenter_step_one_and_two_eq_of_maskparity_zero_true (T P : Nat) (hP : 0 < P)
    (hper : Rule30UOR.Scale.CenterPeriodic T P)
    (m t : Nat) (ht : T ≤ t)
    (hmQ : Rule30UOR.Scale.maskparity (t + m * P) 0 = true)
