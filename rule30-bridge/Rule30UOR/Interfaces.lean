    cases rhCenter (t + twopow k) (r + 1) <;>
    cases lhCenter (t + twopow k) (twopow k - (r + 1)) <;> decide

theorem winWitt_sector_one_xor_sector_two_twin_before_zero_diag_prop (t k r : Nat)
    (hk : (t + r) + 2 ≤ k)
