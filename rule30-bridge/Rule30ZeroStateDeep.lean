module

public import Rule30ZeroState

/-!
# The single seed to depth 87,868: a kernel certificate

The left diagonals of depth `≤ N = 87868` form a closed system: depth `j` at `t + 1` reads depths
`j - 2, j - 1, j` at `t`. Packed into one natural number (bit `j` = depth `j`), one step is
`dstep` (`D_eq_dIter`). The kernel runs it from time `0` to `T0 = 117325` through checkpoints, then
32 more steps, and finds the state again.

* `periodic_32`: from `T0` on, every diagonal of depth `≤ 87868` is periodic with period `32`.
* `periodic_16_below`: every diagonal of depth `< 87867` has period dividing `16`.
* `antiperiod_87867`: depth `87867` has antiperiod `16`, so its eventual period is exactly `32`
  (the record at depth `87867`, OEIS A364239 index `87868`).
* `zero_diagonals_87866`: depths 2, 7, 28, 399, 53207, 58286, 87866 are eventually white.
-/

@[expose] public section

namespace Rule30ZeroState
namespace Deep

open Ruliology.CellularAutomata Rule30Diagonals

def N : Nat := 87868
def T0 : Nat := 117325

def mask (n : Nat) : Nat := 2 ^ (n + 1) - 1

/-- One step of the closed system of depths `≤ n`. -/
def dstep (n y : Nat) : Nat := ((y <<< 2) ^^^ ((y <<< 1) ||| y)) &&& mask n

def dIterFrom (n : Nat) (y : Nat) : Nat → Nat
  | 0 => y
  | k + 1 => dIterFrom n (dstep n y) k

def dIter (n t : Nat) : Nat := dIterFrom n 1 t

theorem dIterFrom_add (n y a b : Nat) : dIterFrom n y (a + b) = dIterFrom n (dIterFrom n y a) b := by
  induction a generalizing y with
  | zero => rw [Nat.zero_add]; rfl
  | succ a ih => rw [show a + 1 + b = (a + b) + 1 by omega]; exact ih (dstep n y)

theorem dIterFrom_succ' (n y k : Nat) : dIterFrom n y (k + 1) = dstep n (dIterFrom n y k) := by
  induction k generalizing y with
  | zero => rfl
  | succ k ih => exact ih (dstep n y)

theorem testBit_mask (n j : Nat) (hj : j ≤ n) : (mask n).testBit j = true := by
  unfold mask
  rw [Nat.testBit_two_pow_sub_one]
  exact decide_eq_true (by omega)

theorem testBit_dstep_zero (n y : Nat) : (dstep n y).testBit 0 = y.testBit 0 := by
  unfold dstep
  rw [Nat.testBit_and, testBit_mask n 0 (by omega), Bool.and_true, Nat.testBit_xor,
    Nat.testBit_or, Nat.testBit_shiftLeft, Nat.testBit_shiftLeft]
  simp

theorem testBit_dstep_one (n y : Nat) (hn : 1 ≤ n) :
    (dstep n y).testBit 1 = (y.testBit 0 || y.testBit 1) := by
  unfold dstep
  rw [Nat.testBit_and, testBit_mask n 1 hn, Bool.and_true, Nat.testBit_xor,
    Nat.testBit_or, Nat.testBit_shiftLeft, Nat.testBit_shiftLeft]
  simp

theorem testBit_dstep_add_two (n y j : Nat) (hj : j + 2 ≤ n) :
    (dstep n y).testBit (j + 2) = xor (y.testBit j) (y.testBit (j + 1) || y.testBit (j + 2)) := by
  unfold dstep
  rw [Nat.testBit_and, testBit_mask n (j + 2) hj, Bool.and_true, Nat.testBit_xor,
    Nat.testBit_or, Nat.testBit_shiftLeft, Nat.testBit_shiftLeft]
  simp [show j + 2 - 2 = j by omega, show j + 2 - 1 = j + 1 by omega]

theorem D_eq_dIterFrom (n : Nat) : ∀ t j, j ≤ n → D j t = (dIterFrom n 1 t).testBit j := by
  intro t
  induction t with
  | zero =>
    intro j _
    show Rule30Jen.cell 0 ((j : Int) - (0 : Nat)) = (1 : Nat).testBit j
    rcases j with _ | j
    · rfl
    · show decide (((j + 1 : Nat) : Int) - ((0 : Nat) : Int) = 0) = (1 : Nat).testBit (j + 1)
      have h1 : (1 : Nat).testBit (j + 1) = false := by
        rw [Nat.testBit_succ]; simp
      rw [h1]; exact decide_eq_false (by omega)
  | succ t ih =>
    intro j hj
    rw [dIterFrom_succ']
    rcases j with _ | _ | j
    · rw [testBit_dstep_zero, ← ih 0 hj, D_zero, D_zero]
    · rw [testBit_dstep_one n _ hj, ← ih 0 (by omega), D_one, D_zero]; rfl
    · rw [testBit_dstep_add_two n _ j hj, D_step, ih j (by omega), ih (j + 1) (by omega), ih (j + 2) hj]

/-- **The packed system is the left half.** -/
theorem D_eq_dIter (n : Nat) (t j : Nat) (hj : j ≤ n) : D j t = (dIter n t).testBit j :=
  D_eq_dIterFrom n t j hj

def cp0 : Nat := 0x1
def cp1 : Nat := 
def cp2 : Nat := 
def cp3 : Nat := 
def cp4 : Nat := 
def cp5 : Nat := 
def cp6 : Nat := 
def cp7 : Nat := 
def cp8 : Nat := 
theorem cp0_eq : dIter N 0 = cp0 := rfl
theorem chunk1 : dIterFrom N cp0 15000 = cp1 := by decide +kernel
theorem cp1_eq : dIter N 15000 = cp1 := by
  unfold dIter
  rw [show (15000 : Nat) = 0 + 15000 by rfl, dIterFrom_add]
  exact (congrArg (fun y => dIterFrom N y 15000) cp0_eq).trans chunk1
theorem chunk2 : dIterFrom N cp1 15000 = cp2 := by decide +kernel
theorem cp2_eq : dIter N 30000 = cp2 := by
  unfold dIter
  rw [show (30000 : Nat) = 15000 + 15000 by rfl, dIterFrom_add]
  exact (congrArg (fun y => dIterFrom N y 15000) cp1_eq).trans chunk2
theorem chunk3 : dIterFrom N cp2 15000 = cp3 := by decide +kernel
theorem cp3_eq : dIter N 45000 = cp3 := by
  unfold dIter
  rw [show (45000 : Nat) = 30000 + 15000 by rfl, dIterFrom_add]
  exact (congrArg (fun y => dIterFrom N y 15000) cp2_eq).trans chunk3
theorem chunk4 : dIterFrom N cp3 15000 = cp4 := by decide +kernel
theorem cp4_eq : dIter N 60000 = cp4 := by
  unfold dIter
  rw [show (60000 : Nat) = 45000 + 15000 by rfl, dIterFrom_add]
  exact (congrArg (fun y => dIterFrom N y 15000) cp3_eq).trans chunk4
theorem chunk5 : dIterFrom N cp4 15000 = cp5 := by decide +kernel
theorem cp5_eq : dIter N 75000 = cp5 := by
  unfold dIter
  rw [show (75000 : Nat) = 60000 + 15000 by rfl, dIterFrom_add]
  exact (congrArg (fun y => dIterFrom N y 15000) cp4_eq).trans chunk5
theorem chunk6 : dIterFrom N cp5 15000 = cp6 := by decide +kernel
theorem cp6_eq : dIter N 90000 = cp6 := by
  unfold dIter
  rw [show (90000 : Nat) = 75000 + 15000 by rfl, dIterFrom_add]
  exact (congrArg (fun y => dIterFrom N y 15000) cp5_eq).trans chunk6
theorem chunk7 : dIterFrom N cp6 15000 = cp7 := by decide +kernel
theorem cp7_eq : dIter N 105000 = cp7 := by
  unfold dIter
  rw [show (105000 : Nat) = 90000 + 15000 by rfl, dIterFrom_add]
  exact (congrArg (fun y => dIterFrom N y 15000) cp6_eq).trans chunk7
theorem chunk8 : dIterFrom N cp7 12325 = cp8 := by decide +kernel
theorem cp8_eq : dIter N 117325 = cp8 := by
  unfold dIter
  rw [show (117325 : Nat) = 105000 + 12325 by rfl, dIterFrom_add]
  exact (congrArg (fun y => dIterFrom N y 12325) cp7_eq).trans chunk8

theorem state_T0 : dIter N T0 = cp8 := cp8_eq

theorem return_32 : dIterFrom N cp8 32 = cp8 := by decide +kernel

theorem dIter_T0_add (k : Nat) : dIter N (T0 + k) = dIterFrom N cp8 k := by
  unfold dIter; rw [dIterFrom_add]; exact congrArg (fun y => dIterFrom N y k) state_T0

theorem dIterFrom_period (k : Nat) : dIterFrom N cp8 (k + 32) = dIterFrom N cp8 k := by
  rw [Nat.add_comm, dIterFrom_add, return_32]

/-- **Period 32 to depth 87,868.** -/
theorem periodic_32 : ∀ t, T0 ≤ t → ∀ j, j ≤ N → D j (t + 32) = D j t := by
  intro t ht j hj
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le ht
  rw [D_eq_dIter N _ j hj, D_eq_dIter N _ j hj, show T0 + k + 32 = T0 + (k + 32) by omega,
    dIter_T0_add, dIter_T0_add, dIterFrom_period]

theorem half_check : (dIterFrom N cp8 16 ^^^ cp8) &&& (2 ^ 87867 - 1) = 0 := by decide +kernel

theorem anti_check : (List.range 16).all (fun k =>
    (dIterFrom N cp8 (k + 16)).testBit 87867 == !(dIterFrom N cp8 k).testBit 87867) = true := by
  decide +kernel

theorem zero_check : (List.range 32).all (fun k =>
    [2, 7, 28, 399, 53207, 58286, 87866].all (fun z => !(dIterFrom N cp8 k).testBit z)) = true := by
  decide +kernel

/-- A closed block of depths that repeats once repeats forever. -/
theorem per_of_base {M P T : Nat} (h : ∀ j, j ≤ M → D j (T + P) = D j T) :
    ∀ t, T ≤ t → ∀ j, j ≤ M → D j (t + P) = D j t := by
  intro t ht
  induction t, ht using le_induction with
  | base => exact h
  | succ t ht ih =>
    intro j hj
    match j, hj with
    | 0, _ => rw [D_zero, D_zero]
    | 1, _ => rw [show t + 1 + P = (t + P) + 1 by omega, D_one, D_one]
    | k + 2, hk =>
      rw [show t + 1 + P = (t + P) + 1 by omega, D_step, D_step, ih k (by omega),
        ih (k + 1) (by omega), ih (k + 2) hk]

theorem dIterFrom_mod (k : Nat) : dIterFrom N cp8 k = dIterFrom N cp8 (k % 32) := by
  induction k using Nat.strongRecOn with
  | _ k ih =>
    rcases Nat.lt_or_ge k 32 with h | h
    · rw [Nat.mod_eq_of_lt h]
    · have e := dIterFrom_period (k - 32)
      rw [show k - 32 + 32 = k by omega] at e
      rw [e, ih (k - 32) (by omega), show (k - 32) % 32 = k % 32 by omega]

theorem D_T0_add (k j : Nat) (hj : j ≤ N) : D j (T0 + k) = (dIterFrom N cp8 (k % 32)).testBit j := by
  rw [D_eq_dIter N _ j hj, dIter_T0_add, dIterFrom_mod]

/-- **Period 16 below depth 87,867.** -/
theorem periodic_16_below : ∀ t, T0 ≤ t → ∀ j, j ≤ 87866 → D j (t + 16) = D j t := by
  refine per_of_base (fun j hj => ?_)
  have hjN : j ≤ N := by unfold N; omega
  have e1 := D_T0_add 16 j hjN
  have e0 := D_T0_add 0 j hjN
  simp only [Nat.add_zero, show (16 : Nat) % 32 = 16 by rfl, Nat.zero_mod] at e1 e0
  rw [e1, e0]
  have := congrArg (fun y => y.testBit j) half_check
  simp only [Nat.testBit_and, Nat.testBit_xor, Nat.zero_testBit, Nat.testBit_two_pow_sub_one,
    decide_eq_true (show j < 87867 by omega), Bool.and_true] at this
  show (dIterFrom N cp8 16).testBit j = cp8.testBit j
  revert this; cases (dIterFrom N cp8 16).testBit j <;> cases cp8.testBit j <;> simp

/-- **The record at depth 87,867.** Antiperiod 16, so the eventual period is exactly 32. -/
theorem antiperiod_87867 : ∀ t, T0 ≤ t → D 87867 (t + 16) = !D 87867 t := by
  intro t ht
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le ht
  have hN : (87867 : Nat) ≤ N := by unfold N; omega
  rw [show T0 + k + 16 = T0 + (k + 16) by omega, D_T0_add _ _ hN, D_T0_add _ _ hN]
  have ha := anti_check
  simp only [List.all_eq_true, List.mem_range, beq_iff_eq] at ha
  have hm := Nat.mod_lt k (show 32 > 0 by omega)
  rcases Nat.lt_or_ge (k % 32) 16 with h | h
  · rw [show (k + 16) % 32 = k % 32 + 16 by omega]; exact ha _ h
  · rw [show (k + 16) % 32 = k % 32 - 16 by omega]
    have := ha (k % 32 - 16) (by omega)
    rw [show k % 32 - 16 + 16 = k % 32 by omega] at this
    rw [this]; cases (dIterFrom N cp8 (k % 32 - 16)).testBit 87867 <;> rfl

/-- **Zero diagonals to depth 87,866.** -/
theorem zero_diagonals_87866 : ∀ t, T0 ≤ t → ∀ z, z ∈ [2, 7, 28, 399, 53207, 58286, 87866] → D z t = false := by
  intro t ht z hz
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le ht
  have hzN : z ≤ N := by unfold N; simp at hz; omega
  rw [D_T0_add _ _ hzN]
  have h := zero_check
  simp only [List.all_eq_true, List.mem_range, Bool.not_eq_true'] at h
  exact h _ (Nat.mod_lt _ (by omega)) z hz

end Deep
end Rule30ZeroState
