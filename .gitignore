# Lake / Lean build caches
.lake/
**/.lake/
.olean/
**/.olean/

# LexLean working cache (verified-latest/ IS tracked)
.lexlean/
**/.lexlean/

# Release staging directory
dist/

# Repository-local pinned compiler
/.local/

# LaTeX intermediate files (PDFs and .tex files ARE tracked)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
texput.log
deep.log

# Python / scratch data
__pycache__/
*.pyc
*.npy
*.npz


# Large LexLean source-map and coverage dumps inside verified-latest
**/verified-latest/*/coverage/
**/verified-latest/*/maps/
# Historical proof bundles keep their records; current PDFs live at the documented mirrors.
**/verified-latest/**/*.pdf
