/-!
# The integer step of rule 30 is a T-function

`IntegerRows` writes the rows of rule 30 from a single black cell as integers,
`a (t + 1) = Φ (a t)` with `Φ x = x ^^^ ((2 * x) ||| (4 * x))`. This file studies `Φ` on every
natural number.

* `testBit_Phi`: bit `j` of `Φ x` is `x_j ⊕ (x_{j-1} ∨ x_{j-2})`. So `Φ` is a T-function in the
  sense of Klimov and Shamir: the bits of `Φ x` below `n` depend only on the bits of `x` below `n`
  (`Phi_mod`). Bit `j` of `x` enters bit `j` of `Φ x` through `xor`, so `x` is recovered from
  `Φ x` bit by bit. `Φ` permutes `ℤ/2^n` (`mod_of_Phi_mod`) and is injective on `ℕ`
  (`Phi_injective`).
* `row a`: the configuration whose cells at positions `0, -1, -2, …` are the bits `0, 1, 2, …` of
  `a`, white right of `0`. `testBit_orbit`: row `t` of its evolution, read leftwards from position
  `t`, is `Φ^t(a)` (`orbit a t`). Every finite configuration is a translate of some `row a`, so
  `Φ` acting on `ℕ` is rule 30 acting on finite configurations in the frame of the right edge.
* `testBit_orbit_periodic`: for every `a`, bit `j` of `Φ^t(a)` is periodic in `t` with period
  dividing `2^j`. These are the right diagonals of `row a`
  (`Rule30FiniteDiagonals.Rd_periodic`).
* `orbit_two_pow_mod`: **`Φ^(2^j)` is the identity modulo `2^(j+1)`**, whatever the argument. So
  the permutation that `Φ` induces on `ℤ/2^(j+1)` has order dividing `2^j`.
* `orbit_one_eq_a`, `problem1_iff_orbit`: the seed is `a t = Φ^t(1)`, and Problem 1 says that
  `t ↦ bit t of Φ^t(1)` is not eventually periodic.

Read from the least significant bit, `Φ` is computed by a finite transducer that remembers the
two previous input bits. Minimized, it has three states: `c = (c, a)`, `a = σ(b, a)` and
`b = σ(c, a)`, where `c` is `Φ`, `a` is the state after reading a `1`, and `b` the state after
reading `1, 0`. The group they generate is automaton group 2369 in the classification of
groups generated by 3-state automata over a 2-letter alphabet (Bondarenko, Grigorchuk,
Kravchenko, Muntyan, Nekrashevych, Savchuk, Šunić, Algebra Discrete Math. 2008). There it is
self-replicating and not contracting, and its isomorphism type is not identified. As a map of the 2-adic integers it is a measure-preserving isometry: it
is 1-Lipschitz and bijective modulo every `2^n` (Anashin's compatible maps). Its orbits modulo
`2^n` have length a power of two, at most `2^(n-1)`. All of this holds for every argument `a`.
The center column of a finite configuration reads bit `t + d` of `Φ^t(a)` at time `t`, for a fixed
offset `d`. That bit is early in its cycle, so the cycle structure says nothing about the column.

Sources: A. Klimov, A. Shamir, *A new class of invertible mappings*, CHES 2002, LNCS 2523
(T-functions); V. Anashin, A. Khrennikov, *Applied Algebraic Dynamics*, de Gruyter (2009),
compatible maps of `ℤ_p`; OEIS A110240 and A269160.
-/

@[expose] public section

namespace Rule30Equivalents.TFunction

open Ruliology.CellularAutomata
open Rule30Realization (evol)
open Rule30FiniteDiagonals (Rd Rd_periodic evol_eq_false_of_gt)
open IntegerRows (testBit_two_mul testBit_four_mul)

/-- One step of rule 30 on rows written as binary numbers (OEIS A269160). -/
def Phi (x : Nat) : Nat := x ^^^ ((2 * x) ||| (4 * x))

/-- The orbit of `a`: `orbit a t = Φ^t(a)`. -/
def orbit (a : Nat) : Nat → Nat
  | 0 => a
  | t + 1 => Phi (orbit a t)

/-- The part of bit `j` of `Φ x` that comes from the bits below `j`: `x_{j-1} ∨ x_{j-2}`. -/
def low (x j : Nat) : Bool :=
  (decide (1 ≤ j) && x.testBit (j - 1)) || (decide (2 ≤ j) && x.testBit (j - 2))

/-- **Bit `j` of `Φ x` is `x_j ⊕ (x_{j-1} ∨ x_{j-2})`.** -/
theorem testBit_Phi (x j : Nat) : (Phi x).testBit j = xor (x.testBit j) (low x j) := by
  unfold Phi low
  rw [Nat.testBit_xor, Nat.testBit_or, testBit_two_mul, testBit_four_mul]

theorem low_congr {x y j : Nat} (h : ∀ k, k < j → x.testBit k = y.testBit k) :
    low x j = low y j := by
  unfold low
  by_cases h1 : 1 ≤ j
  · by_cases h2 : 2 ≤ j
    · rw [h (j - 1) (by omega), h (j - 2) (by omega)]
    · rw [h (j - 1) (by omega)]
      simp [h2]
  · simp [h1, show ¬ 2 ≤ j by omega]

/-- **`Φ` is a T-function**: the bits of `Φ x` below `n` depend only on the bits of `x` below
`n`. -/
theorem Phi_mod {x y n : Nat} (h : x % 2 ^ n = y % 2 ^ n) : Phi x % 2 ^ n = Phi y % 2 ^ n := by
  have hb : ∀ k, k < n → x.testBit k = y.testBit k := by
    intro k hk
    have := congrArg (fun z => z.testBit k) h
    simpa [Nat.testBit_mod_two_pow, hk] using this
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow]
  by_cases hi : i < n
  · rw [testBit_Phi, testBit_Phi, hb i hi, low_congr (fun k hk => hb k (by omega))]
  · simp [hi]

/-- **`Φ` permutes `ℤ/2^n`**: bit `j` of `x` enters bit `j` of `Φ x` through `xor`, so the bits of
`x` below `n` are recovered from those of `Φ x`, from the lowest up. -/
theorem mod_of_Phi_mod {x y n : Nat} (h : Phi x % 2 ^ n = Phi y % 2 ^ n) :
    x % 2 ^ n = y % 2 ^ n := by
  have hb : ∀ k, k < n → (Phi x).testBit k = (Phi y).testBit k := by
    intro k hk
    have := congrArg (fun z => z.testBit k) h
    simpa [Nat.testBit_mod_two_pow, hk] using this
  have key : ∀ i, i ≤ n → ∀ k, k < i → x.testBit k = y.testBit k := by
    intro i
    induction i with
    | zero => intro _ k hk; omega
    | succ i ih =>
      intro hin k hk
      have ih' := ih (by omega)
      rcases Nat.lt_or_ge k i with hlt | hge
      · exact ih' k hlt
      · have hki : k = i := by omega
        rw [hki]
        have := hb i (by omega)
        rw [testBit_Phi, testBit_Phi, low_congr ih'] at this
        exact Bool.xor_left_inj.1 this
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow]
  by_cases hi : i < n
  · rw [key n (Nat.le_refl n) i hi]
  · simp [hi]

/-- `Φ` is injective on `ℕ`. -/
theorem Phi_injective {x y : Nat} (h : Phi x = Phi y) : x = y := by
  apply Nat.eq_of_testBit_eq
  intro i
  have hm := mod_of_Phi_mod (x := x) (y := y) (n := i + 1) (by rw [h])
  have := congrArg (fun z => z.testBit i) hm
  simpa [Nat.testBit_mod_two_pow] using this

/-! ### Every finite configuration, in the frame of its right edge -/

/-- The configuration whose cells at positions `0, -1, -2, …` are the bits `0, 1, 2, …` of `a`,
white right of `0`. -/
def row (a : Nat) (p : Int) : Bool := if p ≤ 0 then a.testBit (-p).toNat else false

theorem row_white (a : Nat) : ∀ p, (0 : Int) < p → row a p = false := by
  intro p hp
  unfold row
  rw [ite_eq_right (by omega)]

/-- **Row `t` of the evolution of `row a`, read leftwards from position `t`, is `Φ^t(a)`.** -/
theorem testBit_orbit (a : Nat) : ∀ t j, (orbit a t).testBit j = evol (row a) t ((t : Int) - j)
  | 0, j => by
    show a.testBit j = row a (((0 : Nat) : Int) - (j : Int))
    unfold row
    rw [ite_eq_left (by omega)]
    congr 1; omega
  | t + 1, j => by
    have hw := evol_eq_false_of_gt (row_white a)
    rw [show orbit a (t + 1) = Phi (orbit a t) from rfl, Phi, Nat.testBit_xor, Nat.testBit_or,
      testBit_two_mul, testBit_four_mul, testBit_orbit a t j]
    rw [show evol (row a) (t + 1) (((t + 1 : Nat) : Int) - (j : Int)) =
      Rule30Jen.rule (evol (row a) t (((t + 1 : Nat) : Int) - (j : Int) - 1))
        (evol (row a) t (((t + 1 : Nat) : Int) - (j : Int)))
        (evol (row a) t (((t + 1 : Nat) : Int) - (j : Int) + 1)) from rfl]
    unfold Rule30Jen.rule
    have e1 : ((t + 1 : Nat) : Int) - (j : Int) - 1 = (t : Int) - (j : Int) := by omega
    rw [e1]
    rcases j with _ | _ | k
    · -- j = 0: positions `t + 1` and `t + 2` are white
      have d1 : decide (1 ≤ 0) = false := decide_eq_false (by omega)
      have d2 : decide (2 ≤ 0) = false := decide_eq_false (by omega)
      have h3 : evol (row a) t (((t + 1 : Nat) : Int) - ((0 : Nat) : Int) + 1) = false :=
        hw t _ (by omega)
      have h2 : evol (row a) t (((t + 1 : Nat) : Int) - ((0 : Nat) : Int)) = false :=
        hw t _ (by omega)
      rw [d1, d2, h3, h2]
      simp
    · -- j = 1: position `t + 1` is white
      have d1 : decide (1 ≤ 0 + 1) = true := decide_eq_true (by omega)
      have d2 : decide (2 ≤ 0 + 1) = false := decide_eq_false (by omega)
      have h3 : evol (row a) t (((t + 1 : Nat) : Int) - ((0 + 1 : Nat) : Int) + 1) = false :=
        hw t _ (by omega)
      have e2 : ((t + 1 : Nat) : Int) - ((0 + 1 : Nat) : Int) = (t : Int) - ((0 : Nat) : Int) := by
        omega
      rw [d1, d2, Bool.true_and, Bool.false_and, Bool.or_false, show 0 + 1 - 1 = 0 from rfl,
        testBit_orbit a t 0, h3, e2, Bool.or_false]
    · -- j = k + 2
      have d1 : decide (1 ≤ k + 1 + 1) = true := decide_eq_true (by omega)
      have d2 : decide (2 ≤ k + 1 + 1) = true := decide_eq_true (by omega)
      have e2 : ((t + 1 : Nat) : Int) - ((k + 1 + 1 : Nat) : Int) =
          (t : Int) - ((k + 1 : Nat) : Int) := by omega
      have e3 : ((t + 1 : Nat) : Int) - ((k + 1 + 1 : Nat) : Int) + 1 =
          (t : Int) - ((k : Nat) : Int) := by omega
      rw [d1, d2, Bool.true_and, Bool.true_and, show k + 1 + 1 - 1 = k + 1 from rfl,
        show k + 1 + 1 - 2 = k from rfl, testBit_orbit a t (k + 1), testBit_orbit a t k, e3, e2]

/-! ### The bits of every orbit cycle with period a power of two -/

/-- **Bit `j` of `Φ^t(a)` is periodic in `t` with period dividing `2^j`**, for every `a`. -/
theorem testBit_orbit_periodic (a j t : Nat) :
    (orbit a (t + 2 ^ j)).testBit j = (orbit a t).testBit j := by
  have := Rd_periodic (row_white a) j t
  simp only [Rd, Int.zero_add] at this
  rw [testBit_orbit, testBit_orbit, this]

theorem testBit_orbit_periodic_mul (a i k t : Nat) :
    (orbit a (t + k * 2 ^ i)).testBit i = (orbit a t).testBit i := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [show t + (k + 1) * 2 ^ i = (t + k * 2 ^ i) + 2 ^ i by rw [Nat.succ_mul]; omega,
      testBit_orbit_periodic, ih]

/-- **`Φ^(2^j)` is the identity modulo `2^(j+1)`**, for every argument: the permutation that `Φ`
induces on `ℤ/2^(j+1)` has order dividing `2^j`. -/
theorem orbit_two_pow_mod (a j : Nat) : orbit a (2 ^ j) % 2 ^ (j + 1) = a % 2 ^ (j + 1) := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow]
  by_cases hi : i < j + 1
  · have hk : 2 ^ j = 0 + 2 ^ (j - i) * 2 ^ i := by
      rw [Nat.zero_add, ← Nat.pow_add, Nat.sub_add_cancel (by omega)]
    rw [hk, testBit_orbit_periodic_mul]
    rfl
  · simp [hi]

/-! ### The seed -/

/-- The single-seed rows are the orbit of `1`. -/
theorem orbit_one_eq_a (t : Nat) : orbit 1 t = IntegerRows.a t := by
  induction t with
  | zero => rfl
  | succ t ih =>
    show Phi (orbit 1 t) = IntegerRows.a (t + 1)
    rw [ih]
    rfl

/-- **Problem 1 in terms of `Φ`**: Problem 1 holds iff `t ↦ bit t of Φ^t(1)` is not eventually
periodic, while bit `j` of `Φ^t(1)` alone has period dividing `2^j` in `t`. -/
theorem problem1_iff_orbit :
    Rule30Prize.Problem1 ↔ ¬ EventuallyPeriodic (fun t => (orbit 1 t).testBit t) := by
  have h : (fun t => (orbit 1 t).testBit t) = fun t => (IntegerRows.a t).testBit t :=
    funext fun t => by rw [orbit_one_eq_a]
  rw [h]
  exact IntegerRows.problem1_iff_integer_rows

end Rule30Equivalents.TFunction
