module

public import Ruliology.CellularAutomata.Rule30PeriodTwoLanguage

/-!
# Period 2, right half: constraints at strip width `5` (kernel-checked)

A bad-class certificate for `w = 01` at strip width `5` (data generated by
`progB-avoid/lean/skel_export.py`: `23` ranks, bad rank `0`), checked with
`Rule30PeriodFourSkeleton.Cert.checkb` / `checkGb`, and subset-simulation checks (`occurs = false`)
that no path inside the bad class reads the listed column-`1` words at consecutive white phases
(`Rule30PeriodTwoLanguage.no_pattern`).

* `col1_constraints`: eventually column `1` at consecutive white times never spells `11`,
  `00000`, `100101` (gap pair `21`) or `10010001` (gap pair `23`).
* `free_bit_constraints`: the free bits (column `-1` at the white times) never spell the
  complements `00`, `11111`, `011010`, `01101110`.

Width `5` is the smallest strip width whose bad class forbids more than `11` and `00000`
(computation). The constraints are conditional on an eventual period `2`; they do not exclude it.
-/

@[expose] public section

namespace Ruliology.CellularAutomata
namespace Rule30PeriodTwoWidth5

open Rule30Jen Rule30StripCertificates Rule30PeriodFourSkeleton
open Rule30PeriodTwoLanguage

def K5_rankP : Nat := 1916006697153380937360263237906755339243478325919156926869724031338820374257454389840633441827951308775851825704337976778053550730613960774094856402924046469556548990329304071540468508619649998703744586215821759752547933608947913293083594467966317958753561671369113459695555118084349734135267328
def K5_posP : Nat := 0
def K5_perP : Nat := 96156582956291065622484519350607635050587552764461313
def K5_wordP : Nat := 0

def K5 : Cert where
  w := [false, true]
  b := 5
  nranks := 23
  rankP := K5_rankP
  posP := K5_posP
  perP := K5_perP
  wordP := K5_wordP

theorem K5_checkb : Cert.checkb K5 0 = true := by decide +kernel
theorem K5_checkGb : Cert.checkGb K5 0 = true := by decide +kernel

theorem occ_p11 : occurs K5 0 [true, true] = false := by decide +kernel
theorem occ_p00000 : occurs K5 0 [false, false, false, false, false] = false := by decide +kernel
theorem occ_g21 : occurs K5 0 [true, false, false, true, false, true] = false := by decide +kernel
theorem occ_g23 : occurs K5 0 [true, false, false, true, false, false, false, true] = false := by decide +kernel

theorem wAt_eq (t T : Nat) : K5.wAt ((t - T) % K5.P) = ((t - T) % 2 == 1) := by
  show [false, true].getD ((t - T) % 2) false = _
  rcases Nat.mod_two_eq_zero_or_one (t - T) with h | h <;> rw [h] <;> rfl

/-- The column-`1` words at consecutive white times that are excluded. -/
def col1Forbidden : List (List Bool) := [[true, true], [false, false, false, false, false], [true, false, false, true, false, true], [true, false, false, true, false, false, false, true]]

/-- **Period 2, right half, width `5`.** If the center column is `(01)^∞` from time `T` (white at
`T + 2k`), then from some time on, column `1` read at consecutive white times never spells a word of
`col1Forbidden` (`11`, `00000`, and the gap words listed there). -/
theorem col1_constraints (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = ((t - T) % 2 == 1)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 2 = 0 → ∀ pat ∈ col1Forbidden,
      ¬ ∀ i, i < pat.length → cell (t + 2 * i) 1 = pat.getD i false := by
  have h' : ∀ t, T ≤ t → cell t 0 = K5.wAt ((t - T) % K5.P) := fun t ht => by rw [wAt_eq, h t ht]
  obtain ⟨T', hT', hbad⟩ := Cert.sound_bad K5 0 K5_checkb K5_checkGb (by decide) (by decide) T h'
  refine ⟨T', hT', fun t ht hph pat hpat => ?_⟩
  simp only [col1Forbidden, List.mem_cons, List.not_mem_nil, or_false] at hpat
  rcases hpat with rfl | rfl | rfl | rfl
  · exact no_pattern K5 0 rfl T T' hT' h' hbad (by decide) _ occ_p11 t ht hph
  · exact no_pattern K5 0 rfl T T' hT' h' hbad (by decide) _ occ_p00000 t ht hph
  · exact no_pattern K5 0 rfl T T' hT' h' hbad (by decide) _ occ_g21 t ht hph
  · exact no_pattern K5 0 rfl T T' hT' h' hbad (by decide) _ occ_g23 t ht hph

/-- The same for the free bits (column `-1` at the white times): under the alternating center,
column `-1` is the complement of column `1` at the white times (`Rule30ZeroBoundary.left_right_white`),
so the free bits never spell the complement of a word of `col1Forbidden` (`00`, `11111`, …). -/
theorem free_bit_constraints (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = ((t - T) % 2 == 1)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 2 = 0 → ∀ pat ∈ col1Forbidden,
      ¬ ∀ i, i < pat.length → cell (t + 2 * i) (-1) = !pat.getD i false := by
  obtain ⟨T', hT', hc⟩ := col1_constraints T h
  refine ⟨T', hT', fun t ht hph pat hpat hm => hc t ht hph pat hpat fun i hi => ?_⟩
  have e := Rule30ZeroBoundary.left_right_white (t + 2 * i)
    (by show cell (t + 2 * i) 0 = false; rw [h _ (by omega), show (t + 2 * i - T) % 2 = 0 by omega]; rfl)
    (by show cell (t + 2 * i + 1) 0 = true; rw [h _ (by omega), show (t + 2 * i + 1 - T) % 2 = 1 by omega]; rfl)
  rw [e, hm i hi, Bool.not_not]

end Rule30PeriodTwoWidth5
end Ruliology.CellularAutomata
