def nwD (d0 d1 d2 : Nat) (φ : Nat) : Nat := if φ = 0 then d0 else if φ = 1 then d1 else d2

theorem nwCheck_0 : nwCheck 0 12 (nwD nw0_12_d0 nw0_12_d1 nw0_12_d2) (nwD nw0_12_z0 nw0_12_z1 nw0_12_z2) = true := by
  decide +kernel
theorem nwCheck_1 : nwCheck 1 12 (nwD nw1_12_d0 nw1_12_d1 nw1_12_d2) (nwD nw1_12_z0 nw1_12_z1 nw1_12_z2) = true := by
  decide +kernel
theorem nwCheck_2 : nwCheck 2 12 (nwD nw2_12_d0 nw2_12_d1 nw2_12_d2) (nwD nw2_12_z0 nw2_12_z1 nw2_12_z2) = true := by
  decide +kernel
theorem nwCheck_3 : nwCheck 3 12 (nwD nw3_12_d0 nw3_12_d1 nw3_12_d2) (nwD nw3_12_z0 nw3_12_z1 nw3_12_z2) = true := by
  decide +kernel

/-- No wall of width `12` at the attachment columns `0, 1, 2, 3` (phases `< 3`). -/
theorem no_wall_12_small (a : Nat) (ha : a < 4) {W : Nat → Nat → Prop} (hW : WallOK a 12 W) :
    ∀ φ r, φ < 3 → ¬ W φ r := by
  have : a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3 := by omega
  rcases this with rfl | rfl | rfl | rfl
  · exact nw_sound nwCheck_0 hW
  · exact nw_sound nwCheck_1 hW
  · exact nw_sound nwCheck_2 hW
  · exact nw_sound nwCheck_3 hW

/-- No wall of width `12` at any attachment column (phases `< 3`). -/
theorem no_wall_12 (a : Nat) {W : Nat → Nat → Prop} (hW : WallOK a 12 W) :
    ∀ φ r, φ < 3 → ¬ W φ r := by
  have hW' := wallOK_mod hW
  have ha : a % 12 < 12 := Nat.mod_lt _ (by decide)
  intro φ r hφ hWr
  by_cases h4 : a % 12 < 4
  · exact no_wall_12_small (a % 12) h4 hW' φ r hφ hWr
  · by_cases h8 : a % 12 < 8
    · obtain ⟨c, hc⟩ : ∃ c, a % 12 = c + 4 := ⟨a % 12 - 4, by omega⟩
      rw [hc] at hW'
      have hb := wallOK_back hW'
      -- the state (φ, r) is the state ((φ + 1) % 3, r) of the shifted wall
      refine no_wall_12_small c (by omega) hb ((φ + 1) % 3) r (Nat.mod_lt _ (by decide)) ?_
      show W (((φ + 1) % 3 + 2) % 3) r
      rwa [show ((φ + 1) % 3 + 2) % 3 = φ by omega]
    · obtain ⟨c, hc⟩ : ∃ c, a % 12 = c + 4 + 4 := ⟨a % 12 - 8, by omega⟩
      rw [hc] at hW'
      have hb := wallOK_back (wallOK_back hW')
      refine no_wall_12_small c (by omega) hb ((φ + 2) % 3) r (Nat.mod_lt _ (by decide)) ?_
      show W ((((φ + 2) % 3 + 2) % 3 + 2) % 3) r
      rwa [show (((φ + 2) % 3 + 2) % 3 + 2) % 3 = φ by omega]

/-- **No period-3 ether wall of width at most 12.** For every attachment column `a` and width
`1 ≤ b ≤ 12`, every `W` with `WallOK a b W` is empty. -/
theorem no_wall_le_12 (a b : Nat) (hb : 0 < b) (hb12 : b ≤ 12) {W : Nat → Nat → Prop}
    (hW : WallOK a b W) : ∀ φ r, ¬ W φ r := by
  intro φ r hWr
  have hL := wallOK_lift (b := 12) hb hb12 hW
  -- one step brings the phase below 3
  have hr : r < 2 ^ b := hW.1 φ r hWr
  have h1 := hW.2.2 φ r false hWr
  have hs : stripStep b (ether3 a φ) false r < 2 ^ 12 :=
    Nat.lt_of_lt_of_le (stripStep_lt _ _ _ _) (Nat.pow_le_pow_right (by decide) hb12)
  refine no_wall_12 a hL ((φ + 1) % 3) (stripStep b (ether3 a φ) false r) (Nat.mod_lt _ (by decide))
    ⟨hs, ?_⟩
  rwa [Nat.mod_eq_of_lt (stripStep_lt _ _ _ _)]

