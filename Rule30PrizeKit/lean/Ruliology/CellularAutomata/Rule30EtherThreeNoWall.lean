module

public import Ruliology.CellularAutomata.Rule30EtherThree

/-!
# Rule 30, least period 3: no wall of width at most 12

`no_wall_le_12`: for every attachment column `a` of the 12 × 3 ether and every width
`1 ≤ b ≤ 12`, a predicate `W` satisfying `WallOK a b W` is empty. So the period-3 ether-and-wall
family of `Rule30EtherThree` has no member with a wall of width `≤ 12`.

Proof: walls lift to wider strips (`wallOK_lift`), and the glide symmetry of the ether moves a wall
four columns to the left with a phase shift (`wallOK_back`), so it suffices to treat the
attachment columns `0, 1, 2, 3` at width `12`. For these, a kernel-checked certificate gives every
strip state a right input and a distance such that following the inputs strictly decreases the
distance until the U-property fails (`nwCheck`, `nw_sound`): every closed set contains a state that
violates the U-property.

The exhaustive search behind the certificates (and a C search, not kernel-checked) also finds no
wall for widths `13..23`.
-/

@[expose] public section

namespace Ruliology.CellularAutomata
namespace Rule30EtherThree

open Rule30Jen Rule30StripCertificates

/-! ### Glide and lifting -/

theorem wallOK_mod {a b : Nat} {W : Nat → Nat → Prop} (h : WallOK a b W) : WallOK (a % 12) b W := by
  refine ⟨h.1, fun φ r hr hw => ?_, fun φ r z hr => ?_⟩
  · have e1 : ether3 a φ = false := by rw [← hw]; exact ether3_congr (by omega) rfl
    rw [h.2.1 φ r hr e1]; exact ether3_congr (by omega) rfl
  · have e := h.2.2 φ r z hr
    rwa [show ether3 a φ = ether3 (a % 12) φ from ether3_congr (by omega) rfl] at e

/-- A wall at column `a + 4` gives a wall at column `a`, with the phase shifted by two. -/
theorem wallOK_back {a b : Nat} {W : Nat → Nat → Prop} (h : WallOK (a + 4) b W) :
    WallOK a b (fun φ r => W ((φ + 2) % 3) r) := by
  have hg : ∀ φ, ether3 (a + 4) ((φ + 2) % 3) = ether3 a φ := by
    intro φ; rw [ether3_glide]; exact ether3_congr rfl (by omega)
  have hg1 : ∀ φ, ether3 (a + 4 + 1) ((φ + 2) % 3) = ether3 (a + 1) φ := by
    intro φ; rw [show a + 4 + 1 = (a + 1) + 4 by omega, ether3_glide]; exact ether3_congr rfl (by omega)
  refine ⟨fun φ r hr => h.1 _ r hr, fun φ r hr hw => ?_, fun φ r z hr => ?_⟩
  · have e := h.2.1 _ r hr (by rw [hg]; exact hw)
    rw [e, hg1]
  · have e := h.2.2 _ r z hr
    rw [hg] at e
    show W (((φ + 1) % 3 + 2) % 3) _
    rwa [show ((φ + 2) % 3 + 1) % 3 = ((φ + 1) % 3 + 2) % 3 by omega] at e

theorem testBit_stripStep_mod {b b' : Nat} (hbb : b' ≤ b) (x z : Bool) (r : Nat)
    (hr : r < 2 ^ b) (i : Nat) :
    (stripStep b x z r % 2 ^ b').testBit i =
      (stripStep b' x (if b' = b then z else r.testBit b') (r % 2 ^ b')).testBit i := by
  rw [Nat.testBit_mod_two_pow]
  have hr' : r % 2 ^ b' < 2 ^ b' := Nat.mod_lt _ (Nat.two_pow_pos _)
  by_cases hi : i < b'
  · rw [decide_eq_true hi, Bool.true_and, testBit_stripStep b x z r hr i (by omega),
      testBit_stripStep b' x _ (r % 2 ^ b') hr' i hi]
    have m1 : ∀ j, j < b' → (r % 2 ^ b').testBit j = r.testBit j := by
      intro j hj; rw [Nat.testBit_mod_two_pow, decide_eq_true hj, Bool.true_and]
    congr 1
    · split
      · rfl
      · rw [m1 (i - 1) (by omega)]
    · rw [m1 i hi]
    · by_cases h1 : i + 1 = b'
      · rw [ite_eq_left h1]
        by_cases hbe : b' = b
        · rw [ite_eq_left (by omega), ite_eq_left hbe]
        · rw [ite_eq_right (by omega), ite_eq_right hbe, h1]
      · rw [ite_eq_right h1, ite_eq_right (by omega), m1 (i + 1) (by omega)]
  · rw [decide_eq_false hi, Bool.false_and]
    exact (Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le (stripStep_lt b' x _ _)
      (Nat.pow_le_pow_right (by decide) (by omega)))).symm

/-- **Walls lift.** A wall of width `b'` gives a wall of every width `b ≥ b'`. -/
theorem wallOK_lift {a b b' : Nat} {W : Nat → Nat → Prop} (hb' : 0 < b') (hbb : b' ≤ b)
    (h : WallOK a b' W) : WallOK a b (fun φ r => r < 2 ^ b ∧ W φ (r % 2 ^ b')) := by
  refine ⟨fun φ r hr => hr.1, fun φ r hr hw => ?_, fun φ r z hr => ⟨stripStep_lt _ _ _ _, ?_⟩⟩
  · have e := h.2.1 φ _ hr.2 hw
    rw [Nat.testBit_mod_two_pow, decide_eq_true hb', Bool.true_and] at e
    exact e
  · have e := h.2.2 φ _ (if b' = b then z else r.testBit b') hr.2
    have hx : stripStep b (ether3 a φ) z r % 2 ^ b' =
        stripStep b' (ether3 a φ) (if b' = b then z else r.testBit b') (r % 2 ^ b') :=
      Nat.eq_of_testBit_eq (testBit_stripStep_mod hbb _ z r hr.1)
    rw [hx]; exact e

/-! ### Certificates: every strip state is driven to a U-violation -/

/-- The strip after one step with right input `z`. -/
def nwSucc (a b φ r : Nat) (z : Bool) : Nat := stripStep b (ether3 a φ) z r

/-- The U-property fails at `(φ, r)`. -/
def nwViol (a φ r : Nat) : Bool := !ether3 a φ && (r.testBit 0 != ether3 (a + 1) φ)

/-- Distance table: 5-bit fields, one table per phase. -/
def nwDist (d : Nat → Nat) (φ r : Nat) : Nat := (d φ >>> (5 * r)) % 32
/-- Move table: the right input to choose. -/
def nwMove (z : Nat → Nat) (φ r : Nat) : Bool := (z φ).testBit r

def nwNodeOK (a b : Nat) (d z : Nat → Nat) (φ r : Nat) : Bool :=
  if nwDist d φ r = 0 then nwViol a φ r
  else decide (nwDist d ((φ + 1) % 3) (nwSucc a b φ r (nwMove z φ r)) < nwDist d φ r)

def nwCheck (a b : Nat) (d z : Nat → Nat) : Bool :=
  allBelowT (fun r => nwNodeOK a b d z 0 r && nwNodeOK a b d z 1 r && nwNodeOK a b d z 2 r) (2 ^ b)

theorem nwNodeOK_of_check {a b : Nat} {d z : Nat → Nat} (hc : nwCheck a b d z = true) (φ r : Nat)
    (hφ : φ < 3) (hr : r < 2 ^ b) : nwNodeOK a b d z φ r = true := by
  have h := allBelowT_spec hc r hr
  simp only [Bool.and_eq_true] at h
  obtain ⟨⟨h0, h1⟩, h2⟩ := h
  have : φ = 0 ∨ φ = 1 ∨ φ = 2 := by omega
  rcases this with rfl | rfl | rfl
  · exact h0
  · exact h1
  · exact h2

/-- **Soundness**: a checked certificate leaves no state for a wall. -/
theorem nw_sound {a b : Nat} {d z : Nat → Nat} (hc : nwCheck a b d z = true)
    {W : Nat → Nat → Prop} (hW : WallOK a b W) : ∀ φ r, φ < 3 → ¬ W φ r := by
  have key : ∀ n φ r, nwDist d φ r < n → φ < 3 → ¬ W φ r := by
    intro n
    induction n with
    | zero => intro φ r hn; exact absurd hn (Nat.not_lt_zero _)
    | succ n ih =>
      intro φ r hn hφ hWr
      have hr := hW.1 φ r hWr
      have hok := nwNodeOK_of_check hc φ r hφ hr
      unfold nwNodeOK at hok
      by_cases h0 : nwDist d φ r = 0
      · rw [ite_eq_left h0] at hok
        unfold nwViol at hok
        simp only [Bool.and_eq_true, Bool.not_eq_true', bne_iff_ne, ne_eq] at hok
        exact hok.2 (hW.2.1 φ r hWr hok.1)
      · rw [ite_eq_right h0] at hok
        have hlt := of_decide_eq_true hok
        exact ih ((φ + 1) % 3) (nwSucc a b φ r (nwMove z φ r)) (by omega) (Nat.mod_lt _ (by decide))
          (hW.2.2 φ r (nwMove z φ r) hWr)
  exact fun φ r hφ => key _ φ r (Nat.lt_succ_self _) hφ

