module

public import Ruliology.CellularAutomata.Rule30Window

/-!
# Rule 30: an eventual period needs `T + P ≥ 16359`

If the center column `c` has period `P` from time `T`, the factors (blocks of consecutive
values) of length `26` starting at `T` and at `T + P` are equal. The first `16384` center bits
(`Rule30Window.centerBits`, computed by the kernel there) have `16359` pairwise distinct factors
of length `26`, starting at `0, …, 16358` (`win_inj`). Hence:

* `transient_add_period_ge`: **if `c (t + P) = c t` for all `t ≥ T`, with `P > 0`, then
  `T + P ≥ 16359`.**

This complements `Rule30Window.no_small_eventual_period` (`P ≤ 4096` with `T ≤ 8192`): it also
excludes, for example, every period `P ≤ 16358 - T`. Distinctness is certified by the list of
factor start positions sorted by factor value (`permAt`, packed 14 bits per entry): the kernel
checks that the list covers `0, …, 16358` (`cover_ok`) and that the factor values strictly
increase along it (`sorted_ok`).
-/

@[expose] public section

namespace Ruliology.CellularAutomata
namespace Rule30FactorWindow

open Rule30Jen Rule30Prize Rule30Window

/-- Window length. -/
def W : Nat := 26
/-- Number of windows of length `W` in the first `windowN` bits. -/
def M : Nat := 16359

/-- Certificate chunk 0: indices `0`.. of the windows sorted by value, 14 bits each. -/
def permChunk0 : Nat := 

/-- Certificate chunk 1: indices `4096`.. of the windows sorted by value, 14 bits each. -/
def permChunk1 : Nat := 

/-- Certificate chunk 2: indices `8192`.. of the windows sorted by value, 14 bits each. -/
def permChunk2 : Nat := 

/-- Certificate chunk 3: indices `12288`.. of the windows sorted by value, 14 bits each. -/
def permChunk3 : Nat := 

def permChunk : Nat → Nat
  | 0 => permChunk0
  | 1 => permChunk1
  | 2 => permChunk2
  | 3 => permChunk3
  | _ => 0

/-- The `k`-th window start position in increasing order of window value. -/
def permAt (k : Nat) : Nat := (permChunk (k / 4096) >>> (14 * (k % 4096))) % 2 ^ 14

/-- The window of length `W` starting at `i`, bit `j` being `c(i + j)`. -/
def win (i : Nat) : Nat := (centerBits >>> i) % 2 ^ W

/-- Check `win (permAt j) < win (permAt (j+1))` for `j = k, …, k + n - 1`. -/
def sortedLoop : Nat → Nat → Bool
  | 0, _ => true
  | n + 1, k => cond (Nat.blt (win (permAt k)) (win (permAt (k + 1)))) (sortedLoop n (k + 1)) false

/-- Set bit `permAt j` for `j = k, …, k + n - 1`; `Nat.ble 0` forces each value. -/
def coverLoop : Nat → Nat → Nat → Nat
  | 0, _, acc => acc
  | n + 1, k, acc =>
    if Nat.ble 0 (acc ||| (1 <<< permAt k)) = true then coverLoop n (k + 1) (acc ||| (1 <<< permAt k))
    else 0

set_option maxRecDepth 100000 in
theorem sorted_ok : sortedLoop (M - 1) 0 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem cover_ok : coverLoop M 0 0 = 2 ^ M - 1 := by decide +kernel

theorem coverLoop_succ (n k acc : Nat) :
    coverLoop (n + 1) k acc = coverLoop n (k + 1) (acc ||| (1 <<< permAt k)) := by
  rw [coverLoop, Nat.ble_eq_true_of_le (Nat.zero_le _)]
  rfl

theorem coverLoop_spec : ∀ n k acc i, (coverLoop n k acc).testBit i = true →
    acc.testBit i = true ∨ ∃ j, j < n ∧ permAt (k + j) = i
  | 0, _, _, _, h => Or.inl h
  | n + 1, k, acc, i, h => by
    rw [coverLoop_succ] at h
    rcases coverLoop_spec n (k + 1) _ i h with h1 | ⟨j, hj, e⟩
    · rw [Nat.testBit_or, Nat.one_shiftLeft, Nat.testBit_two_pow] at h1
      rcases Bool.or_eq_true_iff.1 h1 with h2 | h2
      · exact Or.inl h2
      · exact Or.inr ⟨0, by omega, by simpa using of_decide_eq_true h2⟩
    · exact Or.inr ⟨j + 1, by omega, by rw [show k + (j + 1) = k + 1 + j by omega]; exact e⟩

/-- Every window position `< M` occurs in the certificate. -/
theorem covered (i : Nat) (hi : i < M) : ∃ j, j < M ∧ permAt j = i := by
  have h : (coverLoop M 0 0).testBit i = true := by
    rw [cover_ok, Nat.testBit_two_pow_sub_one]; exact decide_eq_true hi
  rcases coverLoop_spec M 0 0 i h with h0 | ⟨j, hj, e⟩
  · simp at h0
  · exact ⟨j, hj, by simpa using e⟩

theorem sortedLoop_spec : ∀ n k, sortedLoop n k = true →
    ∀ j, j < n → win (permAt (k + j)) < win (permAt (k + j + 1))
  | 0, _, _, _, hj => absurd hj (Nat.not_lt_zero _)
  | n + 1, k, h, j, hj => by
    simp only [sortedLoop] at h
    cases hb : Nat.blt (win (permAt k)) (win (permAt (k + 1)))
    · rw [hb] at h; simp at h
    · rw [hb] at h
      cases j with
      | zero => simpa [Nat.blt_eq] using hb
      | succ j =>
        have := sortedLoop_spec n (k + 1) h j (by omega)
        rwa [show k + 1 + j = k + (j + 1) by omega] at this

theorem sorted_lt : ∀ d a, a + d + 1 < M → win (permAt a) < win (permAt (a + d + 1))
  | 0, a, h => by
    have := sortedLoop_spec (M - 1) 0 sorted_ok a (by omega)
    simpa using this
  | d + 1, a, h => by
    have h1 := sorted_lt d a (by omega)
    have h2 := sortedLoop_spec (M - 1) 0 sorted_ok (a + d + 1) (by omega)
    rw [Nat.zero_add] at h2
    rw [show a + (d + 1) + 1 = a + d + 1 + 1 by omega]
    exact Nat.lt_trans h1 h2

/-- **The windows of length `W` starting below `M` are pairwise distinct.** -/
theorem win_inj {i j : Nat} (hi : i < M) (hj : j < M) (e : win i = win j) : i = j := by
  obtain ⟨a, ha, rfl⟩ := covered i hi
  obtain ⟨b, hb, rfl⟩ := covered j hj
  rcases Nat.lt_trichotomy a b with h | h | h
  · have := sorted_lt (b - a - 1) a (by omega)
    rw [show a + (b - a - 1) + 1 = b by omega] at this
    omega
  · rw [h]
  · have := sorted_lt (a - b - 1) b (by omega)
    rw [show b + (a - b - 1) + 1 = a by omega] at this
    omega

theorem testBit_win (i k : Nat) : (win i).testBit k = (decide (k < W) && centerBits.testBit (i + k)) := by
  rw [win, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight]

/-- **Complexity window**: an eventual period `P` from `T` forces `T + P ≥ 16359`. -/
theorem transient_add_period_ge (T P : Nat) (hP : 0 < P)
    (h : ∀ t, T ≤ t → center (t + P) = center t) : M ≤ T + P := by
  refine Nat.le_of_not_lt fun hlt => ?_
  have e : win T = win (T + P) := by
    apply Nat.eq_of_testBit_eq
    intro k
    rw [testBit_win, testBit_win]
    by_cases hk : k < W
    · rw [decide_eq_true hk, Bool.true_and, Bool.true_and]
      have hk' : k < 26 := hk
      have hM : M = 16359 := rfl
      rw [← center_eq_bit (T + k) (by simp [windowN]; omega),
        ← center_eq_bit (T + P + k) (by simp [windowN]; omega),
        show T + P + k = (T + k) + P by omega, h (T + k) (by omega)]
    · rw [decide_eq_false hk, Bool.false_and, Bool.false_and]
  have := win_inj (by omega) (by omega) e
  omega


end Rule30FactorWindow
end Ruliology.CellularAutomata
