module

public import Ruliology.CellularAutomata.Rule30EtherThreeLeft
public import Ruliology.CellularAutomata.Rule30PeriodFourSkeleton

/-!
# Rule 30, least period 3: forced skeletons of the right half

Bad-class strip certificates (`Rule30PeriodFourSkeleton.Cert.sound_bad`, which works for any
period) for the words `001` and `011`:

* `skeleton_001`: if the center column is `001`-periodic from `T`, then eventually column `1` is
  white at phase `0`. (Strip width `4`; the bad class is the unique minimal closed set of the
  strip relaxation. Wider strips up to `13` force nothing more.)
* `skeleton_011`: if the center column is `011`-periodic from `T`, then eventually column `1` is
  black at phase `1` and white at phase `2` (strip width `3`; nothing more up to width `10`).

Consequence for the left half (`Rule30EtherThreeLeft`):
* `col_m1_001_skeleton`: under `001^∞`, column `-1` is eventually (white, `!` column `1`, black)
  at the phases (`0, 1, 2`); so `C3s001` (no finitely supported zero-boundary left configuration
  keeps column `-1` equal to `(0, *, 1)` for all large times) excludes `001^∞`
  (`not_eventually_001_of_C3s`). `C3s001` is weaker than the eventual form of `Q001`.
* For `011` the skeleton fixes column `1` only at the black phases, where column `-1` is already
  forced, so the left-only statement stays `C3w w011`.

Evidence for `C3s001` (C, not kernel-checked): every start of width `W ≤ 70` (all three phases)
violates the constraint `(0, *, 1)` by time `103`.
-/

@[expose] public section

namespace Ruliology.CellularAutomata
namespace Rule30EtherThree

open Rule30Jen Rule30StripCertificates Rule30PeriodFourSkeleton Rule30DrivenLeft

-- bad-class certificate for w = 001, strip width b = 4; generated by skel_export.py
def k001_w : List Bool := [false, false, true]
def k001_b : Nat := 4
def k001_nranks : Nat := 24
def k001_bad : Nat := 0
def k001_rankP : Nat := 213212421303344427838508674649118400400190746419365602602856074386364289303573589485016640806080348657122565938096435897015198183459314958195800626709598419339004665122940424266126163329678634322028496437612431562459608332173321
def k001_posP : Nat := 18347988927920572092886567162416695526372519918173340224413068222485105075154573938542859905789036108709888
def k001_perP : Nat := 24616085236810512799356036953755568740049862116637737217
def k001_wordP : Nat := 2967964817677254408726030252235766280421576189214542078968756673114766701278382406043796812734916539875172057112193672072216380411681014519610553861222718014999281265784389632

def K001 : Cert :=
  { w := k001_w, b := k001_b, nranks := k001_nranks, rankP := k001_rankP, posP := k001_posP, perP := k001_perP, wordP := k001_wordP }

/-- Skeleton predicate for `001` on the strip of columns `1..4`: column `1` white at phase `0`. -/
def skel001 (φ : Nat) (s : List Bool) : Bool := if φ = 0 then !(s.getD 0 false) else true

theorem K001_checkb : Cert.checkb K001 k001_bad = true := by decide +kernel
theorem K001_checkGb : Cert.checkGb K001 k001_bad = true := by decide +kernel
theorem K001_badImp : Cert.badImp K001 k001_bad skel001 = true := by decide +kernel

/-- **Skeleton for `001`.** If the center column is `001`-periodic from `T`, then eventually column
`1` is white at phase `0`. -/
theorem skeleton_001 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 3 = 0 → cell t 1 = false := by
  have hP : K001.P = 3 := by decide
  have h' : ∀ t, T ≤ t → cell t 0 = K001.wAt ((t - T) % K001.P) := by
    intro t ht; rw [h t ht, hP]; rfl
  obtain ⟨T', hT', hp⟩ := Cert.eventually_pred K001 k001_bad skel001 K001_checkb K001_checkGb
    K001_badImp (by decide) (by decide) T h'
  refine ⟨T', hT', fun t ht hφ => ?_⟩
  have e := hp t ht
  rw [hP, hφ] at e
  have h0 : (rowR t K001.b).getD 0 false = cell t 1 := rowR_getD t K001.b 0 (by decide)
  simp only [skel001, h0] at e
  simpa using e

-- bad-class certificate for w = 011, strip width b = 3; generated by skel_export.py
def k011_w : List Bool := [false, true, true]
def k011_b : Nat := 3
def k011_nranks : Nat := 10
def k011_bad : Nat := 0
def k011_rankP : Nat := 3607361407700544023876026429907536790974072451887713670943892148761564917026271248421661018053444207673140576262
def k011_posP : Nat := 0
def k011_perP : Nat := 4740885567116192841985
def k011_wordP : Nat := 0

def K011 : Cert :=
  { w := k011_w, b := k011_b, nranks := k011_nranks, rankP := k011_rankP, posP := k011_posP, perP := k011_perP, wordP := k011_wordP }

/-- Skeleton predicate for `011` on the strip of columns `1..3`: column `1` black at phase `1`,
white at phase `2`. -/
def skel011 (φ : Nat) (s : List Bool) : Bool :=
  if φ = 1 then s.getD 0 false else if φ = 2 then !(s.getD 0 false) else true

theorem K011_checkb : Cert.checkb K011 k011_bad = true := by decide +kernel
theorem K011_checkGb : Cert.checkGb K011 k011_bad = true := by decide +kernel
theorem K011_badImp : Cert.badImp K011 k011_bad skel011 = true := by decide +kernel

/-- **Skeleton for `011`.** If the center column is `011`-periodic from `T`, then eventually column
`1` is black at phase `1` and white at phase `2`. -/
theorem skeleton_011 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w011 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t →
      ((t - T) % 3 = 1 → cell t 1 = true) ∧ ((t - T) % 3 = 2 → cell t 1 = false) := by
  have hP : K011.P = 3 := by decide
  have h' : ∀ t, T ≤ t → cell t 0 = K011.wAt ((t - T) % K011.P) := by
    intro t ht; rw [h t ht, hP]; rfl
  obtain ⟨T', hT', hp⟩ := Cert.eventually_pred K011 k011_bad skel011 K011_checkb K011_checkGb
    K011_badImp (by decide) (by decide) T h'
  refine ⟨T', hT', fun t ht => ⟨fun hφ => ?_, fun hφ => ?_⟩⟩
  · have e := hp t ht
    rw [hP, hφ] at e
    have h0 : (rowR t K011.b).getD 0 false = cell t 1 := rowR_getD t K011.b 0 (by decide)
    simp only [skel011, h0] at e
    exact e
  · have e := hp t ht
    rw [hP, hφ] at e
    have h0 : (rowR t K011.b).getD 0 false = cell t 1 := rowR_getD t K011.b 0 (by decide)
    simp only [skel011, h0] at e
    simpa using e

/-! ### The left half for `001` with the skeleton -/

/-- **Column `-1` under `001`, with the skeleton**: eventually (white, `!` column `1`, black) at the
phases (`0, 1, 2`). -/
theorem col_m1_001_skeleton (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t →
      ((t - T) % 3 = 0 → cell t (-1) = false) ∧ ((t - T) % 3 = 1 → cell t (-1) = !cell t 1) ∧
      ((t - T) % 3 = 2 → cell t (-1) = true) := by
  obtain ⟨T', hT', hs⟩ := skeleton_001 T h
  refine ⟨T', hT', fun t ht => ⟨fun hφ => ?_, fun hφ => ?_, fun hφ => ?_⟩⟩
  · rw [(col_m1_001 T h t (by omega)).1 hφ]; exact hs t ht hφ
  · exact (col_m1_001 T h t (by omega)).2.1 hφ
  · exact (col_m1_001 T h t (by omega)).2.2 hφ

/-- The pattern `(0, *, 1)` for column `-1` under `001` with the skeleton. -/
def colPattern001s : List (Option Bool) := [some false, none, some true]

/-- **`C3s001`** (open). No finitely supported left configuration of the zero-boundary left half
keeps column `-1` equal to `(0, *, 1)` (phases `0, 1, 2`) for all large times. -/
def C3s001 : Prop :=
  ∀ s : Int → Bool, (∃ M : Nat, ∀ p : Int, p < -(M : Int) → s p = false) →
    ¬ ∃ K, ∀ k, K ≤ k → fits3 colPattern001s (k % 3) (L (fun _ => false) s k (-1)) = true

theorem fits3_001s (φ : Nat) (b : Bool) :
    fits3 colPattern001s φ b = (if φ = 0 then b == false else if φ = 2 then b == true else true) := by
  rcases Nat.lt_or_ge φ 3 with h | h
  · have : φ = 0 ∨ φ = 1 ∨ φ = 2 := by omega
    rcases this with rfl | rfl | rfl <;> rfl
  · unfold fits3
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp [colPattern001s]; omega)]
    simp [show φ ≠ 0 by omega, show φ ≠ 2 by omega]

/-- **`C3s001` excludes `001^∞`** as a tail of the center column, for every transient. -/
theorem not_eventually_001_of_C3s (hC : C3s001) :
    ¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T) := by
  rintro ⟨T, hT⟩
  obtain ⟨T', hT', hs⟩ := col_m1_001_skeleton T hT
  have hfun : (fun k => Rule30Prize.center (T + k) && Rule30Prize.center (T + k + 1)) = fun _ => false := by
    funext k
    show (cell (T + k) 0 && cell (T + k + 1) 0) = false
    rw [hT (T + k) (by omega), hT (T + k + 1) (by omega), wordAt3_001, wordAt3_001,
      show T + k - T = k by omega, show T + k + 1 - T = k + 1 by omega]
    have : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by omega
    rcases this with h | h | h
    · rw [h, show (k + 1) % 3 = 1 by omega]; rfl
    · rw [h, show (k + 1) % 3 = 2 by omega]; rfl
    · rw [h, show (k + 1) % 3 = 0 by omega]; rfl
  refine hC (fun p => cell T p) ⟨T, fun p hp => cell_eq_false_of_lt T p hp⟩ ⟨T' - T, fun k hk => ?_⟩
  have e := cell_eq_L_effective T k (-1) (by omega)
  rw [hfun] at e
  rw [e, fits3_001s]
  obtain ⟨s0, -, s2⟩ := hs (T + k) (by omega)
  have hk3 : (T + k - T) % 3 = k % 3 := by rw [show T + k - T = k by omega]
  have : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by omega
  rcases this with h | h | h
  · rw [ite_eq_left h, s0 (by omega)]; rfl
  · rw [ite_eq_right (by omega), ite_eq_right (by omega)]
  · rw [ite_eq_right (by omega), ite_eq_left h, s2 (by omega)]; rfl

end Rule30EtherThree
end Ruliology.CellularAutomata
