module

public import Ruliology.CellularAutomata.Rule30StripCertificates
public import Ruliology.CellularAutomata.Rule30DrivenLeft
public import Ruliology.CellularAutomata.Rule30Ether

/-!
# Rule 30, least period 4: forced skeletons of the right half, and a left-half reduction

If the center column is eventually periodic with least period `4`, its tail is `w^∞` for `w` one of
`0001`, `0011`, `0111` (the primitive binary necklaces of length `4`; a rotation of `w` from time
`T` is `w` itself from a later time). For these words the right half near the center is forced
into a skeleton, proved with the rank certificates of `Rule30StripCertificates` extended by an
exempt ("bad") rank class.

**Certificates with a bad class.** `Cert.checkb`, `Cert.checkGb`, `Cert.badImp`;
`Cert.sound_bad`: along the true history the strip of columns `1..b` eventually stays in the bad
class (otherwise column `1` at the white times would be periodic, against masked Jen);
`Cert.eventually_pred`: every predicate checked on the bad class holds eventually.

**Skeletons.**
* `skeleton_0001`, `skeleton_0001_explicit`: if `c(t) = [ (t - T) % 4 = 3 ]` from `T`, then
  eventually column `1` is white at phase `0` and black at phases `2, 3`, column `2` is black at
  phase `1` and white at phase `3`, column `3` is black at phase `0`, and column `-1` is
  (white, = column `1`, white, black) at phases (`0, 1, 2, 3`). `no11_0001`: the free bits of
  column `1` at phase `1` never repeat a black cell.
* `skeleton_0011`, `skeleton_0011_explicit`: for `0011`, eventually column `1` is black at phases
  `1, 2` and white at phase `3`, and column `-1` is (= column `1`, white, white, black).
* `column_m1_0111`: for `0111`, column `-1` is (= not column `1`, white, white, black) from `T` on.

**Reduction to the left half (`C3`).** `C3 w` says that no finitely supported left configuration,
run as rule 30 on `p ≤ -1` with column `0` replaced by the 4-periodic effective boundary
`c'_w(t) = w(t) && w(t + 1)` (`0000`, `0010`, `0110` for `0001`, `0011`, `0111`), keeps column `-1`
equal to the skeleton pattern `P_w` (`(0, *, 0, 1)`, `(*, 0, 0, 1)`, `(*, 0, 0, 1)`) for all large
times. `not_eventually_0001_of_C3`, `not_eventually_0011_of_C3`, `not_eventually_0111_of_C3`,
`least_period_four_of_C3`: `C3 w` excludes `w^∞` as a tail of the center column, for every
transient. The statements `C3 w` are open.

The left-half reduction uses `Rule30MaskedJen.effective_step` through
`Rule30DrivenLeft.cell_eq_L_effective`.
-/

@[expose] public section

namespace Ruliology.CellularAutomata
namespace Rule30PeriodFourSkeleton

open Rule30Jen Rule30StripCertificates

/-! ### Certificates with an exempt ("bad") rank class -/

namespace Cert
variable (C : Cert)

/-- Edge condition with the rank class `bad` exempt from the labelling requirement. -/
def edgeOKb (bad φ : Nat) (s s' : List Bool) : Bool :=
  let φ' := (φ + 1) % C.P
  let r := C.rk φ s
  decide (C.rk φ' s' ≤ r) &&
  (!(C.rk φ' s' == r) || (r == bad) ||
    ((C.ps φ' s' == C.nextPos r (C.ps φ s) φ) && (C.wAt φ || (s.headD false == C.u r (C.ps φ s)))))

def checkb (bad : Nat) : Bool :=
  (List.range C.P).all fun φ => (allLists C.b).all fun s =>
    [false, true].all fun x => Cert.edgeOKb C bad φ s (lin3 (C.wAt φ :: (s ++ [x])))

/-- Every node outside the bad class has its position below the counter period of its rank. -/
def checkGb (bad : Nat) : Bool :=
  (List.range C.P).all fun φ => (allLists C.b).all fun s =>
    (C.rk φ s == bad) || decide (C.ps φ s < C.m (C.rk φ s))

/-- Every node of the bad class satisfies `pred`. -/
def badImp (bad : Nat) (pred : Nat → List Bool → Bool) : Bool :=
  (List.range C.P).all fun φ => (allLists C.b).all fun s => !(C.rk φ s == bad) || pred φ s

end Cert

/-- **Soundness with a bad class.** If the center column is `w`-periodic from `T`, the strip of
the true right half eventually stays in the bad class. -/
theorem Cert.sound_bad (C : Cert) (bad : Nat) (hC : Cert.checkb C bad = true) (hG : Cert.checkGb C bad = true)
    (hP : 0 < C.P) (hb : 0 < C.b)
    (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = C.wAt ((t - T) % C.P)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → C.rk ((t - T) % C.P) (rowR t C.b) = bad := by
  let ph : Nat → Nat := fun t => (t - T) % C.P
  let st : Nat → List Bool := fun t => rowR t C.b
  have hph : ∀ t, T ≤ t → ph (t + 1) = (ph t + 1) % C.P := by
    intro t ht
    show (t + 1 - T) % C.P = ((t - T) % C.P + 1) % C.P
    rw [show t + 1 - T = (t - T) + 1 by omega]
    exact (Nat.mod_add_mod (t - T) C.P 1).symm
  have hphlt : ∀ t, ph t < C.P := fun t => Nat.mod_lt _ hP
  have hedge : ∀ t, T ≤ t → Cert.edgeOKb C bad (ph t) (st t) (st (t + 1)) = true := by
    intro t ht
    have hall := hC
    unfold Cert.checkb at hall
    have h1 := List.all_eq_true.1 hall (ph t) (List.mem_range.2 (hphlt t))
    have h2 := List.all_eq_true.1 h1 (st t) (allLists_mem _ _ (rowR_length t C.b))
    have h3 := List.all_eq_true.1 h2 (cell t ((C.b : Int) + 1)) (by cases cell t ((C.b : Int) + 1) <;> simp)
    have hs : st (t + 1) = lin3 (C.wAt (ph t) :: (st t ++ [cell t ((C.b : Int) + 1)])) := by
      show rowR (t + 1) C.b = _
      rw [rowR_succ, h t ht]
    rw [hs]; exact h3
  let R : Nat → Nat := fun t => C.rk (ph t) (st t)
  have hRle : ∀ t, T ≤ t → R (t + 1) ≤ R t := by
    intro t ht
    have e := hedge t ht
    unfold Cert.edgeOKb at e
    simp only [Bool.and_eq_true, decide_eq_true_eq] at e
    show C.rk (ph (t + 1)) (st (t + 1)) ≤ C.rk (ph t) (st t)
    rw [hph t ht]; exact e.1
  obtain ⟨T', hT', hconst⟩ := antitone_eventually_const R T hRle
  refine ⟨T', hT', fun t₀ ht₀ => ?_⟩
  show R t₀ = bad
  rw [hconst t₀ ht₀]
  refine Classical.byContradiction fun hne => ?_
  let r := R T'
  have hrne : r ≠ bad := hne
  have hrb : (r == bad) = false := by
    cases hq : (r == bad) with
    | false => rfl
    | true => exact absurd (beq_iff_eq.1 hq) hne
  have hstep : ∀ t, T' ≤ t →
      C.ps (ph (t + 1)) (st (t + 1)) = C.nextPos r (C.ps (ph t) (st t)) (ph t) ∧
      (C.wAt (ph t) = false → cell t 1 = C.u r (C.ps (ph t) (st t))) := by
    intro t ht
    have e := hedge t (by omega)
    have hRt : R t = r := hconst t ht
    have hRt1 : R (t + 1) = r := hconst (t + 1) (by omega)
    unfold Cert.edgeOKb at e
    rw [← hph t (by omega)] at e
    have hr1 : C.rk (ph (t + 1)) (st (t + 1)) = C.rk (ph t) (st t) := by
      show R (t + 1) = R t; rw [hRt, hRt1]
    have hrt : C.rk (ph t) (st t) = r := hRt
    simp only [hr1, hrt, hrb, beq_self_eq_true, Bool.not_true, Bool.false_or, Bool.and_eq_true, beq_iff_eq,
      decide_eq_true_eq] at e
    refine ⟨e.2.1, fun hw => ?_⟩
    have e2 := e.2.2
    rw [hw, Bool.false_or, beq_iff_eq] at e2
    rw [← rowR_head t C.b hb]; exact e2
  let q : Nat → Nat × Nat := fun t => (C.ps (ph t) (st t), ph t)
  have hq : ∀ t, T' ≤ t → q (t + 1) = C.G r (q t) := by
    intro t ht
    show (C.ps (ph (t + 1)) (st (t + 1)), ph (t + 1)) = (C.nextPos r (C.ps (ph t) (st t)) (ph t), (ph t + 1) % C.P)
    rw [(hstep t ht).1, hph t (by omega)]
  have hqiter : ∀ t, T' ≤ t → ∀ n, q (t + n) = C.iterG r n (q t) := by
    intro t ht n
    induction n with
    | zero => rfl
    | succ n ih =>
      rw [show t + (n + 1) = (t + n) + 1 by omega, hq (t + n) (by omega), ih,
        show n + 1 = n + 1 from rfl, iterG_add C r n 1 (q t)]
      rfl
  have hGn : ∀ φ, φ < C.P → ∀ s, s ∈ allLists C.b → C.rk φ s = bad ∨ C.ps φ s < C.m (C.rk φ s) := by
    have hG' := hG
    unfold Cert.checkGb at hG'
    simp only [List.all_eq_true, List.mem_range, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq] at hG'
    exact hG'
  have hposr : ∀ t, T' ≤ t → C.ps (ph t) (st t) < C.m r := by
    intro t ht
    have hrt : C.rk (ph t) (st t) = r := hconst t ht
    rcases hGn (ph t) (hphlt t) (st t) (allLists_mem _ _ (rowR_length t C.b)) with h' | h'
    · rw [hrt] at h'; exact absurd h' hrne
    · rw [hrt] at h'; exact h'
  have hm : 0 < C.m r := by have := hposr T' (Nat.le_refl _); omega
  have hper : ∀ t, T' ≤ t → q (t + C.m r * C.P) = q t := by
    intro t ht
    rw [hqiter t ht]
    exact C.iterG_period r hm hP _ _ (hposr t ht) (hphlt t)
  refine Rule30MaskedJen.masked_jen 0 (P := C.m r * C.P) (Nat.mul_pos hm hP) (T := T') ?_ ?_
  · intro t ht
    rw [h (t + C.m r * C.P) (by omega), h t (by omega)]
    congr 1
    rw [show t + C.m r * C.P - T = (t - T) + C.P * C.m r by rw [Nat.mul_comm]; omega, Nat.add_mul_mod_self_left]
  · intro t ht hw
    rw [show (0 : Int) + 1 = 1 by rfl]
    have hwt : C.wAt (ph t) = false := by rw [← h t (by omega)]; exact hw
    have hqe := hper t ht
    have hph' : ph (t + C.m r * C.P) = ph t := congrArg Prod.snd hqe
    have hps' : C.ps (ph (t + C.m r * C.P)) (st (t + C.m r * C.P)) = C.ps (ph t) (st t) := congrArg Prod.fst hqe
    have hwt' : C.wAt (ph (t + C.m r * C.P)) = false := by rw [hph']; exact hwt
    rw [(hstep (t + C.m r * C.P) (by omega)).2 hwt', (hstep t ht).2 hwt, hps']

/-- Every predicate checked on the bad class holds eventually along the true history. -/
theorem Cert.eventually_pred (C : Cert) (bad : Nat) (pred : Nat → List Bool → Bool)
    (hC : Cert.checkb C bad = true) (hG : Cert.checkGb C bad = true) (hI : Cert.badImp C bad pred = true)
    (hP : 0 < C.P) (hb : 0 < C.b)
    (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = C.wAt ((t - T) % C.P)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → pred ((t - T) % C.P) (rowR t C.b) = true := by
  obtain ⟨T', hT', hbad⟩ := Cert.sound_bad C bad hC hG hP hb T h
  refine ⟨T', hT', fun t ht => ?_⟩
  have hall := hI
  unfold Cert.badImp at hall
  have h1 := List.all_eq_true.1 hall ((t - T) % C.P) (List.mem_range.2 (Nat.mod_lt _ hP))
  have h2 := List.all_eq_true.1 h1 (rowR t C.b) (allLists_mem _ _ (rowR_length t C.b))
  rw [hbad t ht] at h2
  simpa using h2

theorem seg_getD (f : Nat → Bool) : ∀ (n i : Nat), i < n → (seg f n).getD i false = f i
  | 0, i, h => absurd h (Nat.not_lt_zero _)
  | n + 1, 0, _ => rfl
  | n + 1, i + 1, h => by
    show (seg (fun j => f (j + 1)) n).getD i false = f (i + 1)
    exact seg_getD (fun j => f (j + 1)) n i (by omega)

theorem rowR_getD (t m i : Nat) (h : i < m) : (rowR t m).getD i false = cell t ((i : Int) + 1) :=
  seg_getD _ m i h

theorem col_m1 (t : Nat) : cell t (-1) = xor (cell (t + 1) 0) (cell t 0 || cell t 1) := by
  have := cell_left t 0
  rw [show (0 : Int) - 1 = -1 by rfl, show (0 : Int) + 1 = 1 by rfl] at this
  exact this

theorem phase_succ (t T : Nat) (ht : T ≤ t) : (t + 1 - T) % 4 = ((t - T) % 4 + 1) % 4 := by
  rw [show t + 1 - T = (t - T) + 1 by omega]; omega

/-! ### The word `0001` -/

-- bad-class certificate for w = 0001, strip width b = 9 (generated by computer search)
def k0001_w : List Bool := [false, false, false, true]
def k0001_b : Nat := 9
def k0001_nranks : Nat := 1740
def k0001_bad : Nat := 0
def k0001_rankP : Nat := 
def k0001_posP : Nat := 
def k0001_perP : Nat := 
def k0001_wordP : Nat := 

def K0001 : Cert := { w := k0001_w, b := k0001_b, nranks := k0001_nranks, rankP := k0001_rankP, posP := k0001_posP, perP := k0001_perP, wordP := k0001_wordP }

/-- Skeleton predicate for `w = 0001` (phases `0..3` = `0, 0, 0, 1`) on the strip `s` = columns
`1..9`. -/
def skel0001 (φ : Nat) (s : List Bool) : Bool :=
  if φ = 0 then !(s.getD 0 false) && s.getD 2 false
  else if φ = 1 then s.getD 1 false
  else if φ = 2 then s.getD 0 false
  else if φ = 3 then s.getD 0 false && !(s.getD 1 false)
  else true

theorem K0001_checkb : Cert.checkb K0001 k0001_bad = true := by decide +kernel
theorem K0001_checkGb : Cert.checkGb K0001 k0001_bad = true := by decide +kernel
theorem K0001_badImp : Cert.badImp K0001 k0001_bad skel0001 = true := by decide +kernel

/-- **Skeleton for `0001`.** If the center column is `0001`-periodic from time `T` (phase
`(t - T) % 4`), then eventually: at phase `0` column `1` is white and column `3` black; at phase `1`
column `2` is black; at phase `2` column `1` is black; at phase `3` column `1` is black and column
`2` white. -/
theorem skeleton_0001 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = K0001.wAt ((t - T) % 4)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t →
      ((t - T) % 4 = 0 → cell t 1 = false ∧ cell t 3 = true) ∧
      ((t - T) % 4 = 1 → cell t 2 = true) ∧
      ((t - T) % 4 = 2 → cell t 1 = true) ∧
      ((t - T) % 4 = 3 → cell t 1 = true ∧ cell t 2 = false) := by
  have hP : K0001.P = 4 := by decide
  obtain ⟨T', hT', hp⟩ := Cert.eventually_pred K0001 k0001_bad skel0001 K0001_checkb K0001_checkGb
    K0001_badImp (by decide) (by decide) T (by rw [hP]; exact h)
  refine ⟨T', hT', fun t ht => ?_⟩
  have e := hp t ht
  rw [hP] at e
  have h0 : (rowR t K0001.b).getD 0 false = cell t 1 := rowR_getD t K0001.b 0 (by decide)
  have h1 : (rowR t K0001.b).getD 1 false = cell t 2 := rowR_getD t K0001.b 1 (by decide)
  have h2 : (rowR t K0001.b).getD 2 false = cell t 3 := rowR_getD t K0001.b 2 (by decide)
  refine ⟨fun hφ => ?_, fun hφ => ?_, fun hφ => ?_, fun hφ => ?_⟩
  · rw [hφ] at e; simp only [skel0001] at e
    simp only [h0, h2, ite_true, Bool.and_eq_true, Bool.not_eq_true'] at e
    exact ⟨e.1, e.2⟩
  · rw [hφ] at e; simp only [skel0001] at e; simp only [h1] at e; simpa using e
  · rw [hφ] at e; simp only [skel0001] at e; simp only [h0] at e; simpa using e
  · rw [hφ] at e; simp only [skel0001] at e; simp only [h0, h1] at e; simpa using e

theorem wAt_0001 (φ : Nat) (hφ : φ < 4) : K0001.wAt φ = decide (φ = 3) := by
  have : φ = 0 ∨ φ = 1 ∨ φ = 2 ∨ φ = 3 := by omega
  rcases this with h | h | h | h <;> subst h <;> decide

/-- **Skeleton for `0001`, explicit form.** If `c(t) = [ (t - T) % 4 = 3 ]` for `t ≥ T`, then
eventually column `1` is white at phase `0` and black at phases `2, 3`; column `2` is black at
phase `1` and white at phase `3`; column `3` is black at phase `0`; and column `-1` is
(white, = column `1`, white, black) at phases (`0, 1, 2, 3`). -/
theorem skeleton_0001_explicit (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = decide ((t - T) % 4 = 3)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t →
      ((t - T) % 4 = 0 → cell t 1 = false ∧ cell t 3 = true ∧ cell t (-1) = false) ∧
      ((t - T) % 4 = 1 → cell t 2 = true ∧ cell t (-1) = cell t 1) ∧
      ((t - T) % 4 = 2 → cell t 1 = true ∧ cell t (-1) = false) ∧
      ((t - T) % 4 = 3 → cell t 1 = true ∧ cell t 2 = false ∧ cell t (-1) = true) := by
  have h' : ∀ t, T ≤ t → cell t 0 = K0001.wAt ((t - T) % 4) := by
    intro t ht; rw [h t ht, wAt_0001 _ (Nat.mod_lt _ (by decide))]
  obtain ⟨T', hT', hs⟩ := skeleton_0001 T h'
  refine ⟨T', hT', fun t ht => ?_⟩
  obtain ⟨s0, s1, s2, s3⟩ := hs t ht
  have c0 := h t (by omega)
  have c1 := h (t + 1) (by omega)
  rw [phase_succ t T (by omega)] at c1
  refine ⟨fun hφ => ?_, fun hφ => ?_, fun hφ => ?_, fun hφ => ?_⟩
  · obtain ⟨a, b⟩ := s0 hφ
    refine ⟨a, b, ?_⟩
    rw [col_m1, c1, c0, a, hφ]; decide
  · refine ⟨s1 hφ, ?_⟩
    rw [col_m1, c1, c0, hφ]; cases cell t 1 <;> decide
  · have a := s2 hφ
    refine ⟨a, ?_⟩
    rw [col_m1, c1, c0, a, hφ]; decide
  · obtain ⟨a, b⟩ := s3 hφ
    refine ⟨a, b, ?_⟩
    rw [col_m1, c1, c0, hφ]; cases cell t 1 <;> decide

/-- One strip step at phase `φ` with input `x` at column `b + 1`. -/
def stepS (C : Cert) (φ : Nat) (s : List Bool) (x : Bool) : List Bool := lin3 (C.wAt φ :: (s ++ [x]))

/-- In the bad class of `K0001`, a black column-`1` cell at phase `1` is followed four steps later
(phase `1` again) by a white one, whatever the inputs at column `10`. -/
def no11check : Bool :=
  (allLists 9).all fun s => !(K0001.rk 1 s == k0001_bad) || !(s.headD false) ||
    ([false, true].all fun x0 => [false, true].all fun x1 => [false, true].all fun x2 =>
      [false, true].all fun x3 =>
        let s4 := stepS K0001 0 (stepS K0001 3 (stepS K0001 2 (stepS K0001 1 s x0) x1) x2) x3
        !(K0001.rk 1 s4 == k0001_bad) || !(s4.headD false))

theorem no11check_true : no11check = true := by decide +kernel

theorem step_true (T t : Nat) (ht : T ≤ t) (h : ∀ t, T ≤ t → cell t 0 = K0001.wAt ((t - T) % 4)) :
    rowR (t + 1) K0001.b = stepS K0001 ((t - T) % 4) (rowR t K0001.b) (cell t ((K0001.b : Int) + 1)) := by
  rw [rowR_succ, h t ht]; rfl

/-- **The free bits of `0001` never repeat a black cell.** If the center column is
`0001`-periodic from `T`, then eventually, at phase `1`, a black cell in column `1` is followed
four steps later by a white one. -/
theorem no11_0001 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = K0001.wAt ((t - T) % 4)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 4 = 1 → cell t 1 = true → cell (t + 4) 1 = false := by
  have hP : K0001.P = 4 := by decide
  obtain ⟨T', hT', hbad⟩ := Cert.sound_bad K0001 k0001_bad K0001_checkb K0001_checkGb (by decide)
    (by decide) T (by rw [hP]; exact h)
  rw [hP] at hbad
  refine ⟨T', hT', fun t ht hφ h1 => ?_⟩
  have p1 : (t + 1 - T) % 4 = 2 := by omega
  have p2 : (t + 2 - T) % 4 = 3 := by omega
  have p3 : (t + 3 - T) % 4 = 0 := by omega
  have p4 : (t + 4 - T) % 4 = 1 := by omega
  have e1 : rowR (t + 1) K0001.b = stepS K0001 1 (rowR t K0001.b) (cell t ((K0001.b : Int) + 1)) := by
    have := step_true T t (by omega) h; rw [hφ] at this; exact this
  have e2 : rowR (t + 2) K0001.b =
      stepS K0001 2 (rowR (t + 1) K0001.b) (cell (t + 1) ((K0001.b : Int) + 1)) := by
    have := step_true T (t + 1) (by omega) h; rw [p1] at this; exact this
  have e3 : rowR (t + 3) K0001.b =
      stepS K0001 3 (rowR (t + 2) K0001.b) (cell (t + 2) ((K0001.b : Int) + 1)) := by
    have := step_true T (t + 2) (by omega) h; rw [p2] at this; exact this
  have e4 : rowR (t + 4) K0001.b =
      stepS K0001 0 (rowR (t + 3) K0001.b) (cell (t + 3) ((K0001.b : Int) + 1)) := by
    have := step_true T (t + 3) (by omega) h; rw [p3] at this; exact this
  have hb0 := hbad t ht
  rw [hφ] at hb0
  have hb4 := hbad (t + 4) (by omega)
  rw [p4] at hb4
  have hc := no11check_true
  unfold no11check at hc
  have hs := List.all_eq_true.1 hc (rowR t K0001.b) (allLists_mem _ _ (rowR_length t K0001.b))
  have hhead : (rowR t K0001.b).headD false = true := by rw [rowR_head t K0001.b (by decide)]; exact h1
  rw [hb0, hhead] at hs
  simp only [beq_self_eq_true, Bool.not_true, Bool.false_or] at hs
  have hx := List.all_eq_true.1 hs (cell t ((K0001.b : Int) + 1))
    (by cases cell t ((K0001.b : Int) + 1) <;> simp)
  have hx1 := List.all_eq_true.1 hx (cell (t + 1) ((K0001.b : Int) + 1))
    (by cases cell (t + 1) ((K0001.b : Int) + 1) <;> simp)
  have hx2 := List.all_eq_true.1 hx1 (cell (t + 2) ((K0001.b : Int) + 1))
    (by cases cell (t + 2) ((K0001.b : Int) + 1) <;> simp)
  have hx3 := List.all_eq_true.1 hx2 (cell (t + 3) ((K0001.b : Int) + 1))
    (by cases cell (t + 3) ((K0001.b : Int) + 1) <;> simp)
  rw [← e1, ← e2, ← e3, ← e4, hb4] at hx3
  simp only [beq_self_eq_true, Bool.not_true, Bool.false_or, Bool.not_eq_true'] at hx3
  rw [← rowR_head (t + 4) K0001.b (by decide)]
  exact hx3

/-! ### The words `0011` and `0111` -/

-- bad-class certificate for w = 0011, strip width b = 3 (generated by computer search)
def k0011_w : List Bool := [false, false, true, true]
def k0011_b : Nat := 3
def k0011_nranks : Nat := 13
def k0011_bad : Nat := 0
def k0011_rankP : Nat := 1636695304138607345681430566450342879541164928147624093384226552632404513874232764790848370478092089357155105678346690372348660919069330654870135373832
def k0011_posP : Nat := 0
def k0011_perP : Nat := 79538861190790864407636279553
def k0011_wordP : Nat := 0

def K0011 : Cert := { w := k0011_w, b := k0011_b, nranks := k0011_nranks, rankP := k0011_rankP, posP := k0011_posP, perP := k0011_perP, wordP := k0011_wordP }

/-- Skeleton predicate for `w = 0011` (phases `0..3` = `0, 0, 1, 1`): column `1` is black at phases
`1, 2` and white at phase `3`. -/
def skel0011 (φ : Nat) (s : List Bool) : Bool :=
  if φ = 1 then s.getD 0 false else if φ = 2 then s.getD 0 false else if φ = 3 then !(s.getD 0 false) else true

theorem K0011_checkb : Cert.checkb K0011 k0011_bad = true := by decide +kernel
theorem K0011_checkGb : Cert.checkGb K0011 k0011_bad = true := by decide +kernel
theorem K0011_badImp : Cert.badImp K0011 k0011_bad skel0011 = true := by decide +kernel

/-- **Skeleton for `0011`.** If the center column is `0011`-periodic from time `T` (phase
`(t - T) % 4`), then eventually column `1` is black at phases `1, 2` and white at phase `3`. -/
theorem skeleton_0011 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = K0011.wAt ((t - T) % 4)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t →
      ((t - T) % 4 = 1 → cell t 1 = true) ∧ ((t - T) % 4 = 2 → cell t 1 = true) ∧
      ((t - T) % 4 = 3 → cell t 1 = false) := by
  have hP : K0011.P = 4 := by decide
  obtain ⟨T', hT', hp⟩ := Cert.eventually_pred K0011 k0011_bad skel0011 K0011_checkb K0011_checkGb
    K0011_badImp (by decide) (by decide) T (by rw [hP]; exact h)
  refine ⟨T', hT', fun t ht => ?_⟩
  have e := hp t ht
  rw [hP] at e
  have h0 : (rowR t K0011.b).getD 0 false = cell t 1 := rowR_getD t K0011.b 0 (by decide)
  refine ⟨fun h1 => ?_, fun h2 => ?_, fun h3 => ?_⟩
  · rw [h1] at e; simp only [skel0011] at e; simp at e; rw [← h0]; exact e
  · rw [h2] at e; simp only [skel0011] at e; simp at e; rw [← h0]; exact e
  · rw [h3] at e; simp only [skel0011] at e; simp at e; rw [← h0]; simpa using e

theorem wAt_0011 (φ : Nat) (hφ : φ < 4) : K0011.wAt φ = decide (2 ≤ φ) := by
  have : φ = 0 ∨ φ = 1 ∨ φ = 2 ∨ φ = 3 := by omega
  rcases this with h | h | h | h <;> subst h <;> decide

/-- **Skeleton for `0011`, explicit form.** If `c(t) = [ (t - T) % 4 ≥ 2 ]` for `t ≥ T`, then
eventually column `1` is black at phases `1, 2` and white at phase `3`, and column `-1` is
(= column `1`, white, white, black) at phases (`0, 1, 2, 3`). -/
theorem skeleton_0011_explicit (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = decide (2 ≤ (t - T) % 4)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t →
      ((t - T) % 4 = 0 → cell t (-1) = cell t 1) ∧
      ((t - T) % 4 = 1 → cell t 1 = true ∧ cell t (-1) = false) ∧
      ((t - T) % 4 = 2 → cell t 1 = true ∧ cell t (-1) = false) ∧
      ((t - T) % 4 = 3 → cell t 1 = false ∧ cell t (-1) = true) := by
  have h' : ∀ t, T ≤ t → cell t 0 = K0011.wAt ((t - T) % 4) := by
    intro t ht; rw [h t ht, wAt_0011 _ (Nat.mod_lt _ (by decide))]
  obtain ⟨T', hT', hs⟩ := skeleton_0011 T h'
  refine ⟨T', hT', fun t ht => ?_⟩
  obtain ⟨s1, s2, s3⟩ := hs t ht
  have c0 := h t (by omega)
  have c1 := h (t + 1) (by omega)
  rw [phase_succ t T (by omega)] at c1
  refine ⟨fun hφ => ?_, fun hφ => ?_, fun hφ => ?_, fun hφ => ?_⟩
  · rw [col_m1, c1, c0, hφ]; cases cell t 1 <;> decide
  · have a := s1 hφ
    refine ⟨a, ?_⟩
    rw [col_m1, c1, c0, a, hφ]; decide
  · have a := s2 hφ
    refine ⟨a, ?_⟩
    rw [col_m1, c1, c0, hφ]; cases cell t 1 <;> decide
  · have a := s3 hφ
    refine ⟨a, ?_⟩
    rw [col_m1, c1, c0, hφ]; cases cell t 1 <;> decide

/-- **Column `-1` for `0111` (no skeleton needed).** If `c(t) = [ (t - T) % 4 ≥ 1 ]` for `t ≥ T`, then
for all `t ≥ T` column `-1` is (= not column `1`, white, white, black) at phases (`0, 1, 2, 3`). -/
theorem column_m1_0111 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = decide (1 ≤ (t - T) % 4)) :
    ∀ t, T ≤ t →
      ((t - T) % 4 = 0 → cell t (-1) = !cell t 1) ∧
      ((t - T) % 4 = 1 → cell t (-1) = false) ∧
      ((t - T) % 4 = 2 → cell t (-1) = false) ∧
      ((t - T) % 4 = 3 → cell t (-1) = true) := by
  intro t ht
  have c0 := h t ht
  have c1 := h (t + 1) (by omega)
  rw [phase_succ t T ht] at c1
  refine ⟨fun hφ => ?_, fun hφ => ?_, fun hφ => ?_, fun hφ => ?_⟩ <;>
    (rw [col_m1, c1, c0, hφ]; cases cell t 1 <;> decide)

/-! ### Least period 4 from left-half statements -/

open Rule30Ether (wordAt w0001 w0011 w0111)

/-- The 4-periodic effective boundary `c'_w(φ) = w(φ) && w(φ + 1)` of a 4-periodic center word. -/
def effWord (w : List Bool) : List Bool :=
  (List.range 4).map fun φ => wordAt w φ && wordAt w (φ + 1)

theorem effWord_0001 : effWord w0001 = [false, false, false, false] := by decide
theorem effWord_0011 : effWord w0011 = [false, false, true, false] := by decide
theorem effWord_0111 : effWord w0111 = [false, true, true, false] := by decide

theorem wordAt_effWord (w : List Bool) (k : Nat) :
    wordAt (effWord w) k = (wordAt w k && wordAt w (k + 1)) := by
  show ((List.range 4).map fun φ => wordAt w φ && wordAt w (φ + 1)).getD (k % 4) false = _
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range (Nat.mod_lt _ (by decide))]
  simp only [Option.map_some, Option.getD_some]
  unfold wordAt
  rw [Nat.mod_mod, show (k % 4 + 1) % 4 = (k + 1) % 4 by omega]

/-- Whether `b` fits the pattern `P` at phase `φ` (`none` = unconstrained). -/
def fits (P : List (Option Bool)) (φ : Nat) (b : Bool) : Bool :=
  match P.getD φ none with
  | none => true
  | some v => b == v

/-- `P_w`: the values of column `-1` fixed by the skeletons at three of the four phases. -/
def colPattern : List Bool → List (Option Bool)
  | [false, false, false, true] => [some false, none, some false, some true]
  | [false, false, true, true] => [none, some false, some false, some true]
  | [false, true, true, true] => [none, some false, some false, some true]
  | _ => [none, none, none, none]

/-- **`C3 w`** (open). No finitely supported left configuration, run as rule 30 on the positions
`p ≤ -1` with column `0` replaced by the 4-periodic effective boundary `c'_w`, keeps column `-1`
equal to `P_w` at its fixed phases for all large times. -/
def C3 (w : List Bool) : Prop :=
  ∀ s : Int → Bool, (∃ M : Nat, ∀ p : Int, p < -(M : Int) → s p = false) →
    ¬ ∃ K, ∀ k, K ≤ k →
      fits (colPattern w) (k % 4) (Rule30DrivenLeft.L (fun k => wordAt (effWord w) k) s k (-1)) = true

/-- The common step: a `w`-periodic tail whose column `-1` eventually fits `P_w` contradicts
`C3 w`. -/
theorem not_tail_of_C3 (w : List Bool) (hC : C3 w) (T : Nat)
    (hT : ∀ t, T ≤ t → cell t 0 = wordAt w (t - T))
    (hskel : ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → fits (colPattern w) ((t - T) % 4) (cell t (-1)) = true) :
    False := by
  obtain ⟨T', hT', hP⟩ := hskel
  have hdrv : (fun k => Rule30Prize.center (T + k) && Rule30Prize.center (T + k + 1)) =
      fun k => wordAt (effWord w) k := by
    funext k
    rw [wordAt_effWord]
    show (cell (T + k) 0 && cell (T + k + 1) 0) = _
    rw [hT (T + k) (by omega), hT (T + k + 1) (by omega), show T + k - T = k by omega,
      show T + k + 1 - T = k + 1 by omega]
  refine hC (fun p => cell T p) ⟨T, fun p hp => cell_eq_false_of_lt T p hp⟩ ⟨T' - T, fun k hk => ?_⟩
  have e := Rule30DrivenLeft.cell_eq_L_effective T k (-1) (by omega)
  rw [hdrv] at e
  rw [e]
  have := hP (T + k) (by omega)
  rwa [show T + k - T = k by omega] at this

theorem fits_0001 (φ : Nat) (b : Bool) :
    fits (colPattern w0001) φ b = (if φ = 0 then b == false else if φ = 2 then b == false
      else if φ = 3 then b == true else true) := by
  rcases Nat.lt_or_ge φ 4 with h | h
  · have : φ = 0 ∨ φ = 1 ∨ φ = 2 ∨ φ = 3 := by omega
    rcases this with rfl | rfl | rfl | rfl <;> rfl
  · unfold fits
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp [colPattern, w0001]; omega)]
    simp [show φ ≠ 0 by omega, show φ ≠ 2 by omega, show φ ≠ 3 by omega]

theorem fits_0011 (w : List Bool) (hw : w = w0011 ∨ w = w0111) (φ : Nat) (b : Bool) :
    fits (colPattern w) φ b = (if φ = 1 then b == false else if φ = 2 then b == false
      else if φ = 3 then b == true else true) := by
  have hp : colPattern w = [none, some false, some false, some true] := by
    rcases hw with rfl | rfl <;> rfl
  rw [hp]
  rcases Nat.lt_or_ge φ 4 with h | h
  · have : φ = 0 ∨ φ = 1 ∨ φ = 2 ∨ φ = 3 := by omega
    rcases this with rfl | rfl | rfl | rfl <;> rfl
  · unfold fits
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp; omega)]
    simp [show φ ≠ 1 by omega, show φ ≠ 2 by omega, show φ ≠ 3 by omega]

theorem wordAt_0001 (x : Nat) : wordAt w0001 x = decide (x % 4 = 3) := by
  unfold wordAt
  have : x % 4 = 0 ∨ x % 4 = 1 ∨ x % 4 = 2 ∨ x % 4 = 3 := by omega
  rcases this with h | h | h | h <;> rw [h] <;> rfl

theorem wordAt_0011 (x : Nat) : wordAt w0011 x = decide (2 ≤ x % 4) := by
  unfold wordAt
  have : x % 4 = 0 ∨ x % 4 = 1 ∨ x % 4 = 2 ∨ x % 4 = 3 := by omega
  rcases this with h | h | h | h <;> rw [h] <;> rfl

theorem wordAt_0111 (x : Nat) : wordAt w0111 x = decide (1 ≤ x % 4) := by
  unfold wordAt
  have : x % 4 = 0 ∨ x % 4 = 1 ∨ x % 4 = 2 ∨ x % 4 = 3 := by omega
  rcases this with h | h | h | h <;> rw [h] <;> rfl

/-- **`C3` excludes `0001`.** -/
theorem not_eventually_0001_of_C3 (hC : C3 w0001) :
    ¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt w0001 (t - T) := by
  rintro ⟨T, hT⟩
  refine not_tail_of_C3 w0001 hC T hT ?_
  obtain ⟨T', hT', hs⟩ := skeleton_0001_explicit T (fun t ht => by rw [hT t ht, wordAt_0001])
  refine ⟨T', hT', fun t ht => ?_⟩
  obtain ⟨s0, -, s2, s3⟩ := hs t ht
  rw [fits_0001]
  have : (t - T) % 4 = 0 ∨ (t - T) % 4 = 1 ∨ (t - T) % 4 = 2 ∨ (t - T) % 4 = 3 := by omega
  rcases this with h | h | h | h
  · rw [ite_eq_left h, (s0 h).2.2]; rfl
  · rw [ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
  · rw [ite_eq_right (by omega), ite_eq_left h, (s2 h).2]; rfl
  · rw [ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_left h, (s3 h).2.2]; rfl

/-- **`C3` excludes `0011`.** -/
theorem not_eventually_0011_of_C3 (hC : C3 w0011) :
    ¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt w0011 (t - T) := by
  rintro ⟨T, hT⟩
  refine not_tail_of_C3 w0011 hC T hT ?_
  obtain ⟨T', hT', hs⟩ := skeleton_0011_explicit T (fun t ht => by rw [hT t ht, wordAt_0011])
  refine ⟨T', hT', fun t ht => ?_⟩
  obtain ⟨-, s1, s2, s3⟩ := hs t ht
  rw [fits_0011 w0011 (Or.inl rfl)]
  have : (t - T) % 4 = 0 ∨ (t - T) % 4 = 1 ∨ (t - T) % 4 = 2 ∨ (t - T) % 4 = 3 := by omega
  rcases this with h | h | h | h
  · rw [ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
  · rw [ite_eq_left h, (s1 h).2]; rfl
  · rw [ite_eq_right (by omega), ite_eq_left h, (s2 h).2]; rfl
  · rw [ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_left h, (s3 h).2]; rfl

/-- **`C3` excludes `0111`.** -/
theorem not_eventually_0111_of_C3 (hC : C3 w0111) :
    ¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt w0111 (t - T) := by
  rintro ⟨T, hT⟩
  refine not_tail_of_C3 w0111 hC T hT ⟨T, Nat.le_refl T, fun t ht => ?_⟩
  obtain ⟨-, s1, s2, s3⟩ := column_m1_0111 T (fun t ht => by rw [hT t ht, wordAt_0111]) t ht
  rw [fits_0011 w0111 (Or.inr rfl)]
  have : (t - T) % 4 = 0 ∨ (t - T) % 4 = 1 ∨ (t - T) % 4 = 2 ∨ (t - T) % 4 = 3 := by omega
  rcases this with h | h | h | h
  · rw [ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
  · rw [ite_eq_left h, s1 h]; rfl
  · rw [ite_eq_right (by omega), ite_eq_left h, s2 h]; rfl
  · rw [ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_left h, s3 h]; rfl

/-- **Least period 4 from `C3`.** If `C3` holds for `0001`, `0011` and `0111`, the center column is
not eventually equal to any of these words, with any transient. -/
theorem least_period_four_of_C3 (h1 : C3 w0001) (h2 : C3 w0011) (h3 : C3 w0111) :
    (¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt w0001 (t - T)) ∧
    (¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt w0011 (t - T)) ∧
    (¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt w0111 (t - T)) :=
  ⟨not_eventually_0001_of_C3 h1, not_eventually_0011_of_C3 h2, not_eventually_0111_of_C3 h3⟩

end Rule30PeriodFourSkeleton
end Ruliology.CellularAutomata
