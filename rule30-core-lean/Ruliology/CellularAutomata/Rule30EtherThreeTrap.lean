module

public import Ruliology.CellularAutomata.Rule30EtherThree

/-!
# Rule 30, least period 3: a period-21 trap for `001`

The period-3 ether admits no wall of width `≤ 12` (`Rule30EtherThreeNoWall`; a C search finds none
up to width `23`). Instead, the right half driven by `001^∞` can form a different structure: a
strip of `47` columns next to the center whose first `38` columns repeat with period `21`, shielded
on the right by `9` columns that absorb every input. `t001` lists its `815` states, each with a
time label modulo `21`; it is closed under both values of column `48`, and at the white phases of
the center column `1` is a fixed function `u` of the label.

* `PTrap`, `PTrap.check`: labelled traps as packed tables (strip, label, successor indices).
* `PTrap.invariant`, `PTrap.trap`: once the true right half enters a checked trap after the center
  became `w`-periodic, column `1` at the white times is `m`-periodic, against masked Jen.
* `t001_check` (kernel), `trap_001`: the trap for `001`.
* `AbsorptionT`, `absorptionT_excludes`, `not_eventually_001_of_absorption`: if every finite right
  half driven by `w^∞` enters the trap, the center column is not eventually `w^∞`. Whether this
  holds for `001` is open; in the period-3 study all `18,258` tested right halves entered `t001`,
  with delays up to about `2 · 10^5` steps (computation, not a proof).
-/

@[expose] public section

namespace Ruliology.CellularAutomata
namespace Rule30EtherThree

open Rule30Jen Rule30StripCertificates Rule30Ether

/-- A labelled trap for the 3-periodic word `w`, as packed tables: state `i < n` has strip
`st i` (`b` bits), label `lab i` (modulo `m`, `lb` bits) and successors `nxt i z` (`ib` bits);
`u` gives column `1` (bit `l`) at the white phases. The driver phase at label `l` is `l % 3`. -/
structure PTrap where
  w : List Bool
  b : Nat
  m : Nat
  n : Nat
  lb : Nat
  ib : Nat
  u : Nat
  R : Nat
  L : Nat
  S : Nat

namespace PTrap
variable (C : PTrap)

def st (i : Nat) : Nat := (C.R >>> (C.b * i)) % 2 ^ C.b
def lab (i : Nat) : Nat := (C.L >>> (C.lb * i)) % 2 ^ C.lb
def nxt (i : Nat) (z : Bool) : Nat := (C.S >>> (C.ib * (2 * i + z.toNat))) % 2 ^ C.ib

def edgeOK (i : Nat) (z : Bool) : Bool :=
  decide (C.nxt i z < C.n) &&
  (C.st (C.nxt i z) == stripStep C.b (wordAt3 C.w (C.lab i % 3)) z (C.st i)) &&
  (C.lab (C.nxt i z) == (C.lab i + 1) % C.m)

def nodeOK (i : Nat) : Bool :=
  decide (C.lab i < C.m) &&
  (wordAt3 C.w (C.lab i % 3) || ((C.st i).testBit 0 == C.u.testBit (C.lab i))) &&
  C.edgeOK i false && C.edgeOK i true

def check : Bool := decide (0 < C.m) && decide (C.m % 3 = 0) && allBelowT C.nodeOK C.n

end PTrap

theorem PTrap.st_lt (C : PTrap) (i : Nat) : C.st i < 2 ^ C.b := Nat.mod_lt _ (Nat.two_pow_pos _)

theorem PTrap.facts (C : PTrap) (hC : C.check = true) :
    0 < C.m ∧ C.m % 3 = 0 ∧ ∀ i, i < C.n → C.nodeOK i = true := by
  unfold PTrap.check at hC
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hC
  exact ⟨hC.1.1, hC.1.2, allBelowT_spec hC.2⟩

theorem PTrap.step (C : PTrap) (hC : C.check = true) {i : Nat} (hi : i < C.n) (z : Bool) :
    C.nxt i z < C.n ∧ C.st (C.nxt i z) = stripStep C.b (wordAt3 C.w (C.lab i % 3)) z (C.st i) ∧
      C.lab (C.nxt i z) = (C.lab i + 1) % C.m ∧ C.lab i < C.m ∧
      (wordAt3 C.w (C.lab i % 3) = false → (C.st i).testBit 0 = C.u.testBit (C.lab i)) := by
  have h := (PTrap.facts C hC).2.2 i hi
  unfold PTrap.nodeOK PTrap.edgeOK at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.or_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨hl, hu⟩, ⟨⟨f0, f1⟩, f2⟩⟩, ⟨⟨t0, t1⟩, t2⟩⟩ := h
  refine ⟨?_, ?_, ?_, hl, fun hw => ?_⟩
  · cases z
    · exact f0
    · exact t0
  · cases z
    · exact f1
    · exact t1
  · cases z
    · exact f2
    · exact t2
  · rcases hu with hu | hu
    · rw [hw] at hu; exact absurd hu (by decide)
    · exact hu

theorem PTrap.phase_lab (C : PTrap) (hC : C.check = true) (x y : Nat) (h : x % 3 = y % 3) (n : Nat) :
    (x + n) % 3 = (y + n) % C.m % 3 := by
  rw [Nat.mod_mod_of_dvd _ (Nat.dvd_of_mod_eq_zero (PTrap.facts C hC).2.1)]; omega

/-- **Trap invariant.** If column `0` of `F` is `w`-periodic from `T` and at `t1 ≥ T` the strip of
columns `1..b` is trap state `i` (with the label of the right phase), the strip stays in the trap
and the label advances by one per step. -/
theorem PTrap.invariant (C : PTrap) (hC : C.check = true) {F : Nat → Nat → Bool} (hF : IsR30 F)
    (T : Nat) (hc : ∀ t, T ≤ t → F t 0 = wordAt3 C.w (t - T))
    (t1 i : Nat) (ht1 : T ≤ t1) (hi : i < C.n) (hph : (t1 - T) % 3 = C.lab i % 3)
    (hr : EncF F C.b t1 0 (C.st i)) :
    ∀ n, ∃ j, j < C.n ∧ EncF F C.b (t1 + n) 0 (C.st j) ∧ C.lab j = (C.lab i + n) % C.m := by
  have hm := (PTrap.facts C hC).1
  have hli : C.lab i < C.m := (PTrap.step C hC hi false).2.2.2.1
  intro n
  induction n with
  | zero => exact ⟨i, hi, by simpa using hr, by rw [Nat.add_zero, Nat.mod_eq_of_lt hli]⟩
  | succ n ih =>
    obtain ⟨j, hj, hr', hl'⟩ := ih
    have hphase : (t1 + n - T) % 3 = C.lab j % 3 := by
      rw [hl', show t1 + n - T = (t1 - T) + n by omega]
      exact PTrap.phase_lab C hC _ _ hph n
    have hc0 : F (t1 + n) 0 = wordAt3 C.w (C.lab j % 3) := by
      rw [hc (t1 + n) (by omega)]; unfold wordAt3; rw [Nat.mod_mod, hphase]
    obtain ⟨hnj, hst, hlab, -, -⟩ := PTrap.step C hC hj (F (t1 + n) (0 + 1 + C.b))
    refine ⟨C.nxt j (F (t1 + n) (0 + 1 + C.b)), hnj, ?_, ?_⟩
    · rw [hst, ← hc0, show t1 + (n + 1) = t1 + n + 1 by omega]
      exact encF_step hF hr'
    · rw [hlab, hl', Nat.mod_add_mod]; rfl

/-- **The trap for the true pattern.** If the center column is `w`-periodic from `T` and at some
`t1 ≥ T` the strip of columns `1..b` is a state of a checked trap with the label of the right
phase, we get a contradiction. -/
theorem PTrap.trap (C : PTrap) (hC : C.check = true) (hb : 0 < C.b)
    (T : Nat) (hc : ∀ t, T ≤ t → cell t 0 = wordAt3 C.w (t - T))
    (t1 i : Nat) (ht1 : T ≤ t1) (hi : i < C.n) (hph : (t1 - T) % 3 = C.lab i % 3)
    (hr : EncF trueRight C.b t1 0 (C.st i)) : False := by
  obtain ⟨hm, hm3, -⟩ := PTrap.facts C hC
  have inv := PTrap.invariant C hC trueRight_isR30 T (fun t ht => hc t ht) t1 i ht1 hi hph hr
  -- column `1` at the white times is the label function `u`
  have key : ∀ t, t1 ≤ t → cell t 0 = false →
      cell t 1 = C.u.testBit ((C.lab i + (t - t1)) % C.m) := by
    intro t ht hw
    obtain ⟨j, hj, hr', hl'⟩ := inv (t - t1)
    rw [show t1 + (t - t1) = t by omega] at hr'
    obtain ⟨-, -, -, -, hu⟩ := PTrap.step C hC hj false
    have hphase : (t - T) % 3 = C.lab j % 3 := by
      rw [hl', show t - T = (t1 - T) + (t - t1) by omega]
      exact PTrap.phase_lab C hC _ _ hph _
    have hw' : wordAt3 C.w (C.lab j % 3) = false := by
      rw [← hw, hc t (by omega)]; unfold wordAt3; rw [Nat.mod_mod, hphase]
    rw [← hl', ← hu hw', encF_head hr' hb]
    rfl
  have hper0 : ∀ t, t1 ≤ t → cell (t + C.m) 0 = cell t 0 := by
    intro t ht
    rw [hc (t + C.m) (by omega), hc t (by omega)]
    unfold wordAt3
    congr 1
    obtain ⟨q, hq⟩ := Nat.dvd_of_mod_eq_zero hm3
    rw [hq, show t + 3 * q - T = (t - T) + 3 * q by omega, Nat.add_mul_mod_self_left]
  refine Rule30MaskedJen.masked_jen 0 (P := C.m) (T := t1) hm hper0 ?_
  intro t ht hw
  have hwm : cell (t + C.m) 0 = false := by rw [hper0 t ht]; exact hw
  rw [show (0 : Int) + 1 = 1 by rfl, key (t + C.m) (by omega) hwm, key t ht hw,
    show C.lab i + (t + C.m - t1) = (C.lab i + (t - t1)) + C.m * 1 by omega, Nat.add_mul_mod_self_left]

/-- **Absorption into a trap** (a `Prop`): every finitely supported right half driven by `w^∞`
(any phase `φ`) eventually enters the trap with the label of the right phase. -/
def AbsorptionT (C : PTrap) : Prop :=
  ∀ (x : Nat → Bool) (n : Nat), (∀ p, n < p → x p = false) → ∀ φ : Nat,
    ∃ t1 i, i < C.n ∧ (t1 + φ) % 3 = C.lab i % 3 ∧
      EncF (drv (fun t => wordAt3 C.w (t + φ)) x) C.b t1 0 (C.st i)

/-- **Absorption into a checked trap excludes `w^∞`** as a tail of the center column. -/
theorem absorptionT_excludes (C : PTrap) (hC : C.check = true) (hb : 0 < C.b)
    (hA : AbsorptionT C) : ¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt3 C.w (t - T) := by
  rintro ⟨T, hT⟩
  have hc : (fun t => cell (T + t) 0) = (fun t => wordAt3 C.w (t + 0)) := by
    funext t; rw [hT (T + t) (by omega)]; congr 1; omega
  have hfin : ∀ p, T < p → (fun p : Nat => cell T (p : Int)) p = false :=
    fun p hp => Rule30Diagonals.cell_eq_false_of_gt T p (by omega)
  obtain ⟨t1, i, hi, hph, hr⟩ := hA (fun p => cell T (p : Int)) T hfin 0
  rw [← hc] at hr
  have hr' : EncF trueRight C.b (T + t1) 0 (C.st i) := by
    refine ⟨hr.1, fun k hk => ?_⟩
    rw [hr.2 k hk, ← cell_eq_drv T t1 (0 + 1 + k)]
    rfl
  exact PTrap.trap C hC hb T hT (T + t1) i (by omega) hi (by rw [← hph]; omega) hr'

-- trap for w = 001: closure of the seed at T0 = 3000 (driver c(0)=1 then w), width 47, labels mod 21
-- 815 states; fields: strip 47 bits, label 5 bits, successor index 10 bits (index 2i+z)
def t001_n : Nat := 815
def t001_lb : Nat := 5
def t001_ib : Nat := 10
def t001_u : Nat := 524290
def t001_R : Nat := 
def t001_L : Nat := 
def t001_S : Nat := 

/-- The period-21 trap for `001`: width `47`, `815` labelled states. -/
def t001 : PTrap :=
  { w := w001, b := 47, m := 21, n := t001_n, lb := t001_lb, ib := t001_ib, u := t001_u,
    R := t001_R, L := t001_L, S := t001_S }

theorem t001_check : t001.check = true := by decide +kernel

/-- **The `001` trap.** If the center column is `001`-periodic from `T` (`c(t) = 1` iff
`(t - T) % 3 = 2`) and at some `t1 ≥ T` columns `1..47` form state `i` of `t001` with the label of
the right phase, contradiction. -/
theorem trap_001 (T : Nat) (hc : ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T))
    (t1 i : Nat) (ht1 : T ≤ t1) (hi : i < t001.n) (hph : (t1 - T) % 3 = t001.lab i % 3)
    (hr : EncF trueRight 47 t1 0 (t001.st i)) : False :=
  PTrap.trap t001 t001_check (by decide) T hc t1 i ht1 hi hph hr

/-- **Absorption into `t001` excludes `001^∞`.** -/
theorem not_eventually_001_of_absorption (hA : AbsorptionT t001) :
    ¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T) :=
  absorptionT_excludes t001 t001_check (by decide) hA

end Rule30EtherThree
end Ruliology.CellularAutomata
