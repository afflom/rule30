module

public import Ruliology.CellularAutomata.Rule30PeriodTwoLanguage

/-!
# Period 2, right half: constraints at strip width `6` (kernel-checked)

A bad-class certificate for `w = 01` at strip width `6` (data generated by
`progB-avoid/lean/skel_export.py`: `54` ranks, bad rank `0`), checked with
`Rule30PeriodFourSkeleton.Cert.checkb` / `checkGb`, and subset-simulation checks (`occurs = false`)
that no path inside the bad class reads the listed column-`1` words at consecutive white phases
(`Rule30PeriodTwoLanguage.no_pattern`).

* `col1_constraints`: eventually column `1` at consecutive white times never spells `11`,
  `00000`, the gap pairs `21`, `23`, `12` or the gap triples `114`, `132`, `241`, `243`.
* `free_bit_constraints`: the same for the free bits (column `-1` at the white times),
  complemented.

The constraints are conditional on an eventual period `2`; they do not exclude it.
-/

@[expose] public section

namespace Ruliology.CellularAutomata
namespace Rule30PeriodTwoWidth6

open Rule30Jen Rule30StripCertificates Rule30PeriodFourSkeleton
open Rule30PeriodTwoLanguage

def K6_rankP : Nat := 
def K6_posP : Nat := 0
def K6_perP : Nat := 43492857946993174267896693084597391426453914907855946277183993421405824436166676439842735782025718872115940564100448185552535809
def K6_wordP : Nat := 0

def K6 : Cert where
  w := [false, true]
  b := 6
  nranks := 54
  rankP := K6_rankP
  posP := K6_posP
  perP := K6_perP
  wordP := K6_wordP

theorem K6_checkb : Cert.checkb K6 0 = true := by decide +kernel
theorem K6_checkGb : Cert.checkGb K6 0 = true := by decide +kernel

theorem occ_p11 : occurs K6 0 [true, true] = false := by decide +kernel
theorem occ_p00000 : occurs K6 0 [false, false, false, false, false] = false := by decide +kernel
theorem occ_g21 : occurs K6 0 [true, false, false, true, false, true] = false := by decide +kernel
theorem occ_g23 : occurs K6 0 [true, false, false, true, false, false, false, true] = false := by decide +kernel
theorem occ_g12 : occurs K6 0 [true, false, true, false, false, true] = false := by decide +kernel
theorem occ_g114 : occurs K6 0 [true, false, true, false, true, false, false, false, false, true] = false := by decide +kernel
theorem occ_g132 : occurs K6 0 [true, false, true, false, false, false, true, false, false, true] = false := by decide +kernel
theorem occ_g241 : occurs K6 0 [true, false, false, true, false, false, false, false, true, false, true] = false := by decide +kernel
theorem occ_g243 : occurs K6 0 [true, false, false, true, false, false, false, false, true, false, false, false, true] = false := by decide +kernel

theorem wAt_eq (t T : Nat) : K6.wAt ((t - T) % K6.P) = ((t - T) % 2 == 1) := by
  show [false, true].getD ((t - T) % 2) false = _
  rcases Nat.mod_two_eq_zero_or_one (t - T) with h | h <;> rw [h] <;> rfl

/-- The column-`1` words at consecutive white times that are excluded. -/
def col1Forbidden : List (List Bool) := [[true, true], [false, false, false, false, false], [true, false, false, true, false, true], [true, false, false, true, false, false, false, true], [true, false, true, false, false, true], [true, false, true, false, true, false, false, false, false, true], [true, false, true, false, false, false, true, false, false, true], [true, false, false, true, false, false, false, false, true, false, true], [true, false, false, true, false, false, false, false, true, false, false, false, true]]

/-- **Period 2, right half, width `6`.** If the center column is `(01)^∞` from time `T` (white at
`T + 2k`), then from some time on, column `1` read at consecutive white times never spells a word of
`col1Forbidden` (`11`, `00000`, and the gap words listed there). -/
theorem col1_constraints (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = ((t - T) % 2 == 1)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 2 = 0 → ∀ pat ∈ col1Forbidden,
      ¬ ∀ i, i < pat.length → cell (t + 2 * i) 1 = pat.getD i false := by
  have h' : ∀ t, T ≤ t → cell t 0 = K6.wAt ((t - T) % K6.P) := fun t ht => by rw [wAt_eq, h t ht]
  obtain ⟨T', hT', hbad⟩ := Cert.sound_bad K6 0 K6_checkb K6_checkGb (by decide) (by decide) T h'
  refine ⟨T', hT', fun t ht hph pat hpat => ?_⟩
  simp only [col1Forbidden, List.mem_cons, List.not_mem_nil, or_false] at hpat
  rcases hpat with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact no_pattern K6 0 rfl T T' hT' h' hbad (by decide) _ occ_p11 t ht hph
  · exact no_pattern K6 0 rfl T T' hT' h' hbad (by decide) _ occ_p00000 t ht hph
  · exact no_pattern K6 0 rfl T T' hT' h' hbad (by decide) _ occ_g21 t ht hph
  · exact no_pattern K6 0 rfl T T' hT' h' hbad (by decide) _ occ_g23 t ht hph
  · exact no_pattern K6 0 rfl T T' hT' h' hbad (by decide) _ occ_g12 t ht hph
  · exact no_pattern K6 0 rfl T T' hT' h' hbad (by decide) _ occ_g114 t ht hph
  · exact no_pattern K6 0 rfl T T' hT' h' hbad (by decide) _ occ_g132 t ht hph
  · exact no_pattern K6 0 rfl T T' hT' h' hbad (by decide) _ occ_g241 t ht hph
  · exact no_pattern K6 0 rfl T T' hT' h' hbad (by decide) _ occ_g243 t ht hph

/-- The same for the free bits (column `-1` at the white times): under the alternating center,
column `-1` is the complement of column `1` at the white times (`Rule30ZeroBoundary.left_right_white`),
so the free bits never spell the complement of a word of `col1Forbidden` (`00`, `11111`, …). -/
theorem free_bit_constraints (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = ((t - T) % 2 == 1)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 2 = 0 → ∀ pat ∈ col1Forbidden,
      ¬ ∀ i, i < pat.length → cell (t + 2 * i) (-1) = !pat.getD i false := by
  obtain ⟨T', hT', hc⟩ := col1_constraints T h
  refine ⟨T', hT', fun t ht hph pat hpat hm => hc t ht hph pat hpat fun i hi => ?_⟩
  have e := Rule30ZeroBoundary.left_right_white (t + 2 * i)
    (by show cell (t + 2 * i) 0 = false; rw [h _ (by omega), show (t + 2 * i - T) % 2 = 0 by omega]; rfl)
    (by show cell (t + 2 * i + 1) 0 = true; rw [h _ (by omega), show (t + 2 * i + 1 - T) % 2 = 1 by omega]; rfl)
  rw [e, hm i hi, Bool.not_not]

end Rule30PeriodTwoWidth6
end Ruliology.CellularAutomata
